 *
 * 载荷形态对齐 V2 融合算子: 4MB chunk×8、每代 signal 全量→quiet→按序 wait、对端读改写回投。
 * r0(产): fill→clean→signal×8 → quiet → wait×8(逐封校验 imm/dst/len + 逐字数据校验)
 * r1(消): wait(校验)→INC→clean→signal 回投, FIFO 序回带 imm=全局件号
 *
 * 检测与取证(任一命中即触发 host 全量 dump):
 *   failKind: 1=wait 超时 2=imm 错 3=dst 错 4=len 错 5=数据错 6=kernel 被击杀(sync 错)
 *   kernel 失败时快照: 本端 ARR_HEAD/被等槽 stamp/mail、双端 REQ_HEAD/REQ_TAIL
 *   host 1Hz sampler: 游标帧(冻结检测); 失败后 +5s 迟到落地复查 + 双端 48KB 保留区全量落盘
 * 分类判据(读 dump 即可裁决):
 *   对端 REQ_TAIL 未过被等件号 → 请求未被 AICPU 消费(AICore→AICPU 可见性类)
 *   对端 REQ_TAIL 已过而 stamp 永缺 → MemFabric 执行域丢失(C2R2 类)
 *   +5s 后 stamp 迟到 → 跨 die 写延迟(D1R4 观测窗伪影类)
 */
#include <chrono>
#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <string>
#include <thread>
#include <mpi.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

#define HUNTER_TAG 0x9Cu
#define HUNTER_INC 0x100u
#define HUNTER_CHUNKS 8u
#define HUNTER_CHUNK_BYTES (4UL * 1024UL * 1024UL)
#define HUNTER_CHUNK_WORDS (HUNTER_CHUNK_BYTES / 4u)
#define HUNTER_LOCAL_SIZE (128UL * 1024UL * 1024UL)
#define HUNTER_RESULT_MAGIC 0x4855544552533121ULL

static int g_rank = -1;
static int g_devId = -1;

struct HunterResult {
    uint64_t magic;
    uint64_t progress;
    uint64_t done;
    uint64_t failKind;
    uint64_t failSeq;
    uint64_t failRound;
    uint64_t failChunk;
    uint64_t failOff;
    uint64_t dataGot;
    uint64_t dataWant;
    uint64_t headSnap;
    uint64_t slotSnap;
    uint64_t mailSeqSnap;
    uint64_t ownReqHead;
    uint64_t ownReqTail;
    uint64_t peerReqHead;
    uint64_t peerReqTail;
    uint64_t resOffOwn;
    uint64_t resOffPeer;
    uint64_t rsv[5];
};

#define H_AICORE __attribute__((always_inline)) __aicore__ __inline__

H_AICORE void hClean(__gm__ uint8_t *p, uint64_t bytes)
{
    AscendC::GlobalTensor<int32_t> gm;
    for (uint64_t off = 0; off < bytes; off += 64) {
        gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(p + off), 16);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(gm);
    }
}

H_AICORE uint32_t hWord(uint32_t rd, uint32_t c, uint32_t i)
{
    return ((HUNTER_TAG ^ ((rd << 4) ^ c)) << 16) | (i & 0xFFFFu);
}

H_AICORE void hCommit(__gm__ HunterResult *r)
{
    hClean(reinterpret_cast<__gm__ uint8_t *>(r), sizeof(HunterResult));
}

H_AICORE void hSnap(__gm__ uint8_t *res, __gm__ uint8_t *peerRes, __gm__ HunterResult *r)
{
    const uint64_t head = SdmaReadCell(res, SMEM_SHM_SDMA_RS_ARR_HEAD);
    const uint64_t slot = head % SMEM_SHM_SDMA_RS_ARR_SLOTS;
    r->headSnap = head;
    r->slotSnap = SdmaReadCell(res, SMEM_SHM_SDMA_RS_ARR_STAMP + slot * 8);
    r->mailSeqSnap = SdmaReadCell(res, SMEM_SHM_SDMA_RS_ARR_MAIL + slot * 32);
    r->ownReqHead = SdmaReadCell(res, SMEM_SHM_SDMA_RS_REQ_HEAD);
    r->ownReqTail = SdmaReadCell(res, SMEM_SHM_SDMA_RS_REQ_TAIL);
    r->peerReqHead = SdmaReadCell(peerRes, SMEM_SHM_SDMA_RS_REQ_HEAD);
    r->peerReqTail = SdmaReadCell(peerRes, SMEM_SHM_SDMA_RS_REQ_TAIL);
}

H_AICORE void hFail(__gm__ HunterResult *out, uint64_t kind, uint64_t seq, uint64_t rd, uint64_t c,
                    uint64_t got, uint64_t want, __gm__ uint8_t *res, __gm__ uint8_t *peerRes)
{
    out->failKind = kind;
    out->failSeq = seq;
    out->failRound = rd;
    out->failChunk = c;
    out->dataGot = got;
    out->dataWant = want;
    hSnap(res, peerRes, out);
    out->done = 2;
    hCommit(out);
}

extern "C" __global__ __aicore__ void hunterKernel(__gm__ uint8_t *gva, __gm__ uint64_t *resultRaw,
                                                   uint32_t chunks, uint32_t rounds)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    const uint64_t phys = smem_shm_get_phys_size(0);
    __gm__ uint8_t *ownSeg = gva + symm * rank;
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);
    __gm__ uint8_t *res = smem_shm_sdma_reserved(gva);
    __gm__ uint8_t *peerRes = peerSeg + (phys - SMEM_SHM_SDMA_RESERVED);
    __gm__ HunterResult *out = reinterpret_cast<__gm__ HunterResult *>(resultRaw);
    __gm__ uint32_t *data = reinterpret_cast<__gm__ uint32_t *>(ownSeg);
    const uint64_t bytes = HUNTER_CHUNK_BYTES;
    const uint64_t words = HUNTER_CHUNK_WORDS;
    out->magic = HUNTER_RESULT_MAGIC;
    out->progress = 0;
    out->done = 0;
    out->failKind = 0;
    out->resOffOwn = symm * rank + (phys - SMEM_SHM_SDMA_RESERVED);
    out->resOffPeer = symm * (1 - rank) + (phys - SMEM_SHM_SDMA_RESERVED);
    hCommit(out);
    if (rank == 0) {
        for (uint32_t rd = 0; rd < rounds; rd++) {
            for (uint32_t c = 0; c < chunks; c++) {
                __gm__ uint32_t *chunk = data + (uint64_t)c * words;
                for (uint32_t i = 0; i < words; i++) {
                    chunk[i] = hWord(rd, c, i);
                }
                hClean(reinterpret_cast<__gm__ uint8_t *>(chunk), bytes);
                (void)smem_shm_sdma_signal_at(res, reinterpret_cast<__gm__ uint8_t *>(chunk),
                                               peerSeg + (uint64_t)c * bytes, bytes,
                                               (uint64_t)rd * chunks + c);
            }
            (void)smem_shm_sdma_quiet_at(res);
            for (uint32_t c = 0; c < chunks; c++) {
                const uint64_t seq = (uint64_t)rd * chunks + c;
                smem_shm_sdma_mail_t m = smem_shm_sdma_wait_at(res);
                out->progress = seq + 1;
                hCommit(out);
                if (m.status != SMEM_SHM_SDMA_MAIL_OK) {
                    hFail(out, 1, seq, rd, c, m.status, 0, res, peerRes);
                    return;
                }
                if (m.imm != seq) {
                    hFail(out, 2, seq, rd, c, m.imm, seq, res, peerRes);
                    return;
                }
                if (m.dst != reinterpret_cast<uint64_t>(ownSeg + (uint64_t)c * bytes)) {
                    hFail(out, 3, seq, rd, c, m.dst,
                          reinterpret_cast<uint64_t>(ownSeg + (uint64_t)c * bytes), res, peerRes);
                    return;
                }
                if (m.len != bytes) {
                    hFail(out, 4, seq, rd, c, m.len, bytes, res, peerRes);
                    return;
                }
                __gm__ uint32_t *chunk = data + (uint64_t)c * words;
                hClean(reinterpret_cast<__gm__ uint8_t *>(chunk), bytes);
                for (uint32_t i = 0; i < words; i++) {
                    const uint32_t want = hWord(rd, c, i) + HUNTER_INC;
                    if (chunk[i] != want) {
                        hFail(out, 5, seq, rd, c, chunk[i], want, res, peerRes);
                        out->failOff = i;
                        hCommit(out);
                        return;
                    }
                }
            }
        }
    } else {
        const uint64_t total = (uint64_t)rounds * chunks;
        for (uint64_t k = 0; k < total; k++) {
            smem_shm_sdma_mail_t m = smem_shm_sdma_wait_at(res);
            out->progress = k + 1;
            hCommit(out);
            if (m.status != SMEM_SHM_SDMA_MAIL_OK) {
                hFail(out, 1, k, k / chunks, k % chunks, m.status, 0, res, peerRes);
                return;
            }
            if (m.imm != k) {
                hFail(out, 2, k, k / chunks, k % chunks, m.imm, k, res, peerRes);
                return;
            }
            if (m.dst != reinterpret_cast<uint64_t>(ownSeg + (k % chunks) * bytes)) {
                hFail(out, 3, k, k / chunks, k % chunks, m.dst,
                      reinterpret_cast<uint64_t>(ownSeg + (k % chunks) * bytes), res, peerRes);
                return;
            }
            if (m.len != bytes) {
                hFail(out, 4, k, k / chunks, k % chunks, m.len, bytes, res, peerRes);
                return;
            }
            __gm__ uint32_t *chunk = reinterpret_cast<__gm__ uint32_t *>(m.dst);
            for (uint64_t i = 0; i < m.len / 4; i++) {
                chunk[i] = chunk[i] + HUNTER_INC;
            }
            hClean(reinterpret_cast<__gm__ uint8_t *>(chunk), m.len);
            (void)smem_shm_sdma_signal_at(res, reinterpret_cast<__gm__ uint8_t *>(chunk),
                                           peerSeg + (k % chunks) * bytes, m.len, k);
        }
    }
    out->done = 1;
    hCommit(out);
}

/* ============================ host 侧 ============================ */

static void *g_gva = nullptr;
static void *g_result = nullptr;
static volatile bool g_stop = false;
static volatile bool g_launchPending = false;
static uint64_t g_freezeLimit = 12;
static char g_dumpDir[256];

static uint64_t HostPeek(void *base, uint64_t off)
{
    uint64_t v = 0;
    (void)aclrtMemcpy(&v, sizeof(v), static_cast<uint8_t *>(base) + off, sizeof(v),
                      ACL_MEMCPY_DEVICE_TO_HOST);
    return v;
}

static void HostResult(HunterResult *r)
{
    (void)memset(r, 0, sizeof(*r));
    (void)aclrtMemcpy(r, sizeof(*r), g_result, sizeof(*r), ACL_MEMCPY_DEVICE_TO_HOST);
}

static void DumpReserved(const HunterResult &r, const char *tag)
{
    uint8_t *buf = static_cast<uint8_t *>(malloc(SMEM_SHM_SDMA_RESERVED));
    if (buf == nullptr) {
        return;
    }
    for (int side = 0; side < 2; side++) {
        const uint64_t off = (side == 0) ? r.resOffOwn : r.resOffPeer;
        if (off == 0) {
            continue;
        }
        if (aclrtMemcpy(buf, SMEM_SHM_SDMA_RESERVED, static_cast<uint8_t *>(g_gva) + off,
                        SMEM_SHM_SDMA_RESERVED, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            printf("[FSC r%d] dump side=%d FAILED\n", g_rank, side);
            continue;
        }
        char path[320];
        (void)snprintf(path, sizeof(path), "%s/r%d_%s_%s.bin", g_dumpDir, g_rank,
                       (side == 0) ? "own" : "peer", tag);
        FILE *f = fopen(path, "wb");
        if (f != nullptr) {
            (void)fwrite(buf, 1, SMEM_SHM_SDMA_RESERVED, f);
            (void)fclose(f);
            printf("[FSC r%d] dumped %s\n", g_rank, path);
        }
    }
    free(buf);
}

static void PrintResult(const HunterResult &r, const char *tag)
{
    printf("[FSC r%d %s] magic=0x%llx progress=%llu done=%llu failKind=%llu seq=%llu rd=%llu c=%llu "
           "off=%llu got=0x%llx want=0x%llx\n",
           g_rank, tag, (unsigned long long)r.magic, (unsigned long long)r.progress,
           (unsigned long long)r.done, (unsigned long long)r.failKind, (unsigned long long)r.failSeq,
           (unsigned long long)r.failRound, (unsigned long long)r.failChunk,
           (unsigned long long)r.failOff, (unsigned long long)r.dataGot,
           (unsigned long long)r.dataWant);
    printf("[FSC r%d %s] arrHead=%llu slotStamp=%llu slotMailSeq=%llu | ownReq %llu/%llu "
           "peerReq %llu/%llu\n",
           g_rank, tag, (unsigned long long)r.headSnap, (unsigned long long)r.slotSnap,
           (unsigned long long)r.mailSeqSnap, (unsigned long long)r.ownReqHead,
           (unsigned long long)r.ownReqTail, (unsigned long long)r.peerReqHead,
           (unsigned long long)r.peerReqTail);
    (void)fflush(stdout);
}

static void LateLandingCheck(const HunterResult &r)
{
    if (r.resOffOwn == 0 || r.headSnap == 0) {
        return;
    }
    const uint64_t slot = r.headSnap % SMEM_SHM_SDMA_RS_ARR_SLOTS;
    const uint64_t expect = r.headSnap + 1;
    std::this_thread::sleep_for(std::chrono::seconds(5));
    const uint64_t head2 = HostPeek(g_gva, r.resOffOwn + SMEM_SHM_SDMA_RS_ARR_HEAD);
    const uint64_t stamp2 = HostPeek(g_gva, r.resOffOwn + SMEM_SHM_SDMA_RS_ARR_STAMP + slot * 8);
    const uint64_t mail2 = HostPeek(g_gva, r.resOffOwn + SMEM_SHM_SDMA_RS_ARR_MAIL + slot * 32);
    printf("[FSC r%d late] +5s: arrHead=%llu(was %llu) slot%llu stamp=%llu expect=%llu mailSeq=%llu "
           "→ %s\n",
           g_rank, (unsigned long long)head2, (unsigned long long)r.headSnap,
           (unsigned long long)slot, (unsigned long long)stamp2, (unsigned long long)expect,
           (unsigned long long)mail2,
           stamp2 == expect ? "LANDED_LATE(延迟落地)" : "STILL_MISSING(真丢失)");
    (void)fflush(stdout);
}

static void Forensic(const char *reason)
{
    static bool entered = false;
    if (entered) {
        return;
    }
    entered = true;
    printf("[FSC r%d] === FORENSIC reason=%s ===\n", g_rank, reason);
    (void)fflush(stdout);
    HunterResult r;
    HostResult(&r);
    PrintResult(r, "t0");
    DumpReserved(r, "t0");
    LateLandingCheck(r);
    HunterResult r5;
    HostResult(&r5);
    PrintResult(r5, "t5");
    DumpReserved(r5, "t5");
    printf("[FSC r%d] dump dir: %s\n", g_rank, g_dumpDir);
    (void)fflush(stdout);
    MPI_Abort(MPI_COMM_WORLD, 1);
}

static void SamplerMain()
{
    if (aclrtSetDevice(g_devId) != ACL_SUCCESS) {
        printf("[SMP r%d] set device failed\n", g_rank);
        return;
    }
    uint64_t lastProgress = ~0ULL;
    uint64_t freeze = 0;
    uint64_t tick = 0;
    HunterResult lastSnap = {};
    while (!g_stop) {
        std::this_thread::sleep_for(std::chrono::milliseconds(1000));
        tick++;
        HunterResult r;
        HostResult(&r);
        if (r.magic != HUNTER_RESULT_MAGIC || r.resOffOwn == 0) {
            continue;
        }
        uint64_t ownArr = HostPeek(g_gva, r.resOffOwn + SMEM_SHM_SDMA_RS_ARR_HEAD);
        uint64_t ownRqH = HostPeek(g_gva, r.resOffOwn + SMEM_SHM_SDMA_RS_REQ_HEAD);
        uint64_t ownRqT = HostPeek(g_gva, r.resOffOwn + SMEM_SHM_SDMA_RS_REQ_TAIL);
        uint64_t peerRqH = HostPeek(g_gva, r.resOffPeer + SMEM_SHM_SDMA_RS_REQ_HEAD);
        uint64_t peerRqT = HostPeek(g_gva, r.resOffPeer + SMEM_SHM_SDMA_RS_REQ_TAIL);
        const bool changed = (r.progress != lastSnap.progress) || (ownArr != lastSnap.headSnap);
        if (changed || (tick % 30) == 0) {
            printf("[SMP r%d t%llu] prog=%llu arrHead=%llu ownReq=%llu/%llu peerReq=%llu/%llu\n",
                   g_rank, (unsigned long long)tick, (unsigned long long)r.progress,
                   (unsigned long long)ownArr, (unsigned long long)ownRqH,
                   (unsigned long long)ownRqT, (unsigned long long)peerRqH,
                   (unsigned long long)peerRqT);
            (void)fflush(stdout);
        }
        if (g_launchPending && r.progress == lastProgress) {
            freeze++;
            if (freeze >= g_freezeLimit) {
                printf("[SMP r%d] progress frozen %llu s → forensic\n", g_rank,
                       (unsigned long long)freeze);
                Forensic("sampler-stall");
                return;
            }
        } else {
            freeze = 0;
        }
        lastProgress = r.progress;
        lastSnap = r;
    }
}

static double NowMs()
{
    return std::chrono::duration<double, std::milli>(
               std::chrono::steady_clock::now().time_since_epoch())
        .count();
}

int main(int argc, char *argv[])
{
    int provided = 0;
    (void)MPI_Init_thread(&argc, &argv, MPI_THREAD_MULTIPLE, &provided);
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank);
    int world = 0;
    MPI_Comm_size(MPI_COMM_WORLD, &world);
    if (world != 2) {
        printf("expect mpirun -np 2\n");
        MPI_Finalize();
        return 1;
    }
    g_devId = g_rank;
    const char *storeUrl = getenv("HUNTER_STORE_URL");
    if (storeUrl == nullptr) {
        storeUrl = "tcp://127.0.0.1:8583";
    }
    uint64_t launches = (getenv("HUNTER_LAUNCHES") != nullptr)
                            ? strtoull(getenv("HUNTER_LAUNCHES"), nullptr, 0)
                            : 0;
    uint32_t rounds = (getenv("HUNTER_ROUNDS") != nullptr)
                          ? static_cast<uint32_t>(atoi(getenv("HUNTER_ROUNDS")))
                          : 16;
    uint64_t soakS = (getenv("HUNTER_SOAK_S") != nullptr)
                         ? strtoull(getenv("HUNTER_SOAK_S"), nullptr, 0)
                         : 1800;
    if (getenv("HUNTER_FREEZE_S") != nullptr) {
        g_freezeLimit = strtoull(getenv("HUNTER_FREEZE_S"), nullptr, 0);
    }
    const char *dumpRoot = (getenv("HUNTER_DUMP_DIR") != nullptr) ? getenv("HUNTER_DUMP_DIR")
                                                                  : "/tmp/opencode/repro/dumps";
    (void)snprintf(g_dumpDir, sizeof(g_dumpDir), "%s", dumpRoot);
    (void)system(("mkdir -p " + std::string(dumpRoot)).c_str());

    printf("[r%d] hunter start: store=%s rounds=%u soakS=%llu freezeS=%llu\n", g_rank, storeUrl,
           rounds, (unsigned long long)soakS, (unsigned long long)g_freezeLimit);
    if (aclInit(nullptr) != ACL_SUCCESS) {
        printf("[r%d FAIL] aclInit\n", g_rank);
        return 1;
    }
    if (smem_init(0) != 0) {
        printf("[r%d FAIL] smem_init: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    smem_shm_config_t cfg;
    (void)smem_shm_config_init(&cfg);
    cfg.startConfigStoreServer = (g_rank == 0);
    if (smem_shm_init(storeUrl, 2, static_cast<uint32_t>(g_rank),
                      static_cast<uint16_t>(g_devId), &cfg) != 0) {
        printf("[r%d FAIL] smem_shm_init: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, 2, static_cast<uint32_t>(g_rank), HUNTER_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) {
        printf("[r%d FAIL] smem_shm_create: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    if (smem_shm_sdma_get_workspace(shm) == nullptr) {
        printf("[r%d FAIL] sdma orchestration not ready\n", g_rank);
        return 1;
    }
    g_gva = gva;
    printf("[r%d] pool ready gva=%p local=%lluMB\n", g_rank, gva,
           (unsigned long long)(HUNTER_LOCAL_SIZE >> 20));
    if (aclrtMalloc(&g_result, 256, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        printf("[r%d FAIL] result malloc\n", g_rank);
        return 1;
    }
    (void)aclrtMemset(g_result, 256, 0, 256);
    aclrtStream stream = nullptr;
    (void)aclrtCreateStream(&stream);
    MPI_Barrier(MPI_COMM_WORLD);

    std::thread sampler(SamplerMain);
    const double t0 = NowMs();
    uint64_t launch = 0;
    uint64_t mails = 0;
    int rc = 0;
    for (launch = 0; launches == 0 || launch < launches; launch++) {
        g_launchPending = true;
        hunterKernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva),
                                       static_cast<uint64_t *>(g_result), HUNTER_CHUNKS, rounds);
        const int32_t sync = aclrtSynchronizeStream(stream);
        g_launchPending = false;
        if (sync != 0) {
            char buf[64];
            (void)snprintf(buf, sizeof(buf), "kernel-killed rc=%d", sync);
            Forensic(buf);
            rc = 1;
            break;
        }
        HunterResult r;
        HostResult(&r);
        if (r.done == 2) {
            char buf[64];
            (void)snprintf(buf, sizeof(buf), "kernel-fail kind=%llu",
                           (unsigned long long)r.failKind);
            Forensic(buf);
            rc = 1;
            break;
        }
        if (r.done != 1) {
            Forensic("kernel-incomplete");
            rc = 1;
            break;
        }
        mails += static_cast<uint64_t>(rounds) * HUNTER_CHUNKS;
        if ((launch % 50) == 0 && launch > 0) {
            const double el = (NowMs() - t0) / 1000.0;
            printf("[r%d] launch=%llu mails=%llu/%s elapsed=%.1fs rate=%.0f/s\n", g_rank,
                   (unsigned long long)launch, (unsigned long long)mails, "dir", el,
                   el > 0 ? mails / el : 0.0);
            (void)fflush(stdout);
        }
        if (soakS > 0 && (NowMs() - t0) / 1000.0 > static_cast<double>(soakS)) {
            break;
        }
    }
    g_stop = true;
    sampler.join();
    const double el = (NowMs() - t0) / 1000.0;
    printf("=== HUNTER r%d %s: launches=%llu mails/dir=%llu elapsed=%.1fs rate=%.0f/s ===\n", g_rank,
           rc == 0 ? "CLEAN(no loss)" : "FORENSIC-DONE", (unsigned long long)launch,
           (unsigned long long)mails, el, el > 0 ? mails / el : 0.0);
    (void)aclrtDestroyStream(stream);
    (void)aclrtFree(g_result);
    (void)smem_shm_destroy(shm, 0);
    smem_shm_uninit(0);
    smem_uninit();
    (void)aclrtResetDevice(g_devId);
    (void)aclFinalize();
    MPI_Finalize();
    return rc;
}
