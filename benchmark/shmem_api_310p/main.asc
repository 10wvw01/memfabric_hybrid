#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cerrno>
#include <climits>
#include <dlfcn.h>
#include <string>
#include <vector>
#include <csignal>
#include <sys/socket.h>
#include <sys/wait.h>
#include <unistd.h>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "../../examples/memory_pool/01_basic/sdma_ready.h"

constexpr size_t MAX_BYTES = 64ULL * 1024 * 1024;
constexpr uint64_t DEST = MAX_BYTES;
constexpr uint64_t FLAG_BASE = 2 * MAX_BYTES + 4096;
static int rankId;
enum Operation {
    PUT,
    GET,
    PUT_NBI,
    GET_NBI,
    PUT_SIGNAL,
    PUT_SIGNAL_NBI,
    SIGNAL_SET,
    SIGNAL_SET_NBI,
    QUIET_IDLE,
    QUIET_PENDING,
    SIGNAL_TEST,
    SIGNAL_WAIT,
    ADD_FP32,
    ADD_FP16,
    CTX
};
static const char *names[] = {"put",          "get",
                              "put-nbi",      "get-nbi",
                              "put-signal",   "put-signal-nbi",
                              "signal-set",   "signal-set-nbi",
                              "quiet-idle",   "quiet-after-put",
                              "signal-test",  "signal-wait-ready",
                              "put-add-fp32", "put-add-fp16",
                              "ctx"};

__aicore__ inline bool execute(const smem_shm_sdma_ctx_t &ctx, __gm__ uint8_t *own, __gm__ uint8_t *peer,
                               uint64_t bytes, uint64_t sequence, uint32_t op)
{
    auto flag = reinterpret_cast<__gm__ uint64_t *>(peer + FLAG_BASE);
    switch (op) {
        case PUT:
            return smem_shm_sdma_put_at(ctx, own, peer + DEST, bytes);
        case GET:
            return smem_shm_sdma_get_at(ctx, peer, own + DEST, bytes);
        case PUT_NBI:
            return smem_shm_sdma_put_nbi_at(ctx, own, peer + DEST, bytes);
        case GET_NBI:
            return smem_shm_sdma_get_nbi_at(ctx, peer, own + DEST, bytes);
        case PUT_SIGNAL:
            return smem_shm_sdma_put_signal_at(ctx, own, peer + DEST, bytes, flag, sequence);
        case PUT_SIGNAL_NBI:
            return smem_shm_sdma_put_signal_nbi_at(ctx, own, peer + DEST, bytes, flag, sequence);
        case SIGNAL_SET:
            return smem_shm_sdma_signal_set_at(ctx, flag, sequence);
        case SIGNAL_SET_NBI:
            return smem_shm_sdma_signal_set_nbi_at(ctx, flag, sequence);
        case QUIET_IDLE:
        case QUIET_PENDING:
            return smem_shm_sdma_quiet_at(ctx);
        case SIGNAL_TEST:
            return smem_shm_signal_test(reinterpret_cast<__gm__ uint64_t *>(own + FLAG_BASE), SMEM_SHM_CMP_EQ,
                                        sequence);
        case SIGNAL_WAIT:
            return smem_shm_signal_wait_until(reinterpret_cast<__gm__ uint64_t *>(own + FLAG_BASE), SMEM_SHM_CMP_EQ,
                                              sequence);
        case ADD_FP32:
            return smem_shm_sdma_put_at(ctx, own, peer + DEST, bytes, SMEM_SHM_SDMA_OP_ADD_FP32);
        case ADD_FP16:
            return smem_shm_sdma_put_at(ctx, own, peer + DEST, bytes, SMEM_SHM_SDMA_OP_ADD_FP16);
    }
    return false;
}

// gva入口在每次调用中取得上下文，用于与复用上下文的_at入口比较。
__aicore__ inline bool executeWrapped(__gm__ uint8_t *gva, __gm__ uint8_t *own, __gm__ uint8_t *peer, uint64_t bytes,
                                      uint64_t sequence, uint32_t op)
{
    auto flag = reinterpret_cast<__gm__ uint64_t *>(peer + FLAG_BASE);
    switch (op) {
        case PUT:
            return smem_shm_sdma_put(gva, own, peer + DEST, bytes);
        case GET:
            return smem_shm_sdma_get(gva, peer, own + DEST, bytes);
        case PUT_NBI:
            return smem_shm_sdma_put_nbi(gva, own, peer + DEST, bytes);
        case GET_NBI:
            return smem_shm_sdma_get_nbi(gva, peer, own + DEST, bytes);
        case PUT_SIGNAL:
            return smem_shm_sdma_put_signal(gva, own, peer + DEST, bytes, flag, sequence);
        case PUT_SIGNAL_NBI:
            return smem_shm_sdma_put_signal_nbi(gva, own, peer + DEST, bytes, flag, sequence);
        case SIGNAL_SET:
            return smem_shm_sdma_signal_set(gva, flag, sequence);
        case SIGNAL_SET_NBI:
            return smem_shm_sdma_signal_set_nbi(gva, flag, sequence);
        case QUIET_IDLE:
        case QUIET_PENDING:
            return smem_shm_sdma_quiet(gva);
        case ADD_FP32:
            return smem_shm_sdma_put(gva, own, peer + DEST, bytes, SMEM_SHM_SDMA_OP_ADD_FP32);
        case ADD_FP16:
            return smem_shm_sdma_put(gva, own, peer + DEST, bytes, SMEM_SHM_SDMA_OP_ADD_FP16);
    }
    return false;
}

// 只有rank 0启动一个block；rank 1只准备和检查内存。
extern "C" __global__ __aicore__ void measure(__gm__ uint8_t *gva, __gm__ uint64_t *result, uint64_t bytes,
                                              uint64_t sequence, uint32_t op, uint32_t wrapped)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const auto ctx = smem_shm_sdma_ctx(gva);
    auto own = gva + ctx.rank * ctx.symm;
    auto peer = gva + (1 - ctx.rank) * ctx.symm;
    bool ok = true;
    if (op == CTX) {
        const auto fresh = smem_shm_sdma_ctx(gva);
        result[3] = fresh.symm;
    } else {
        const bool wrap = wrapped && op != SIGNAL_TEST && op != SIGNAL_WAIT;
        ok = (wrap ? executeWrapped(gva, own, peer, bytes, sequence, op)
                   : execute(ctx, own, peer, bytes, sequence, op)) &&
             ok;
    }
    const bool nbi = op == PUT_NBI || op == GET_NBI || op == PUT_SIGNAL_NBI || op == SIGNAL_SET_NBI;
    if (nbi)
        ok = (wrapped ? smem_shm_sdma_quiet(gva) : smem_shm_sdma_quiet_at(ctx)) && ok;
    result[0] = ok ? 0 : 1;
    SdmaMaintainCache(result, 64);
}

static void check(const char *api, int ret)
{
    if (!ret)
        return;
    fprintf(stderr, "ERROR rank=%d api=%s ret=%d errno=%d\n", rankId, api, ret, errno);
    exit(1);
}

static void transfer(int fd, void *buffer, size_t bytes, bool sending)
{
    auto data = static_cast<char *>(buffer);
    while (bytes) {
        const ssize_t n = sending ? write(fd, data, bytes) : read(fd, data, bytes);
        if (n < 0 && errno == EINTR)
            continue;
        check(sending ? "socket write" : "socket read", n > 0 ? 0 : -1);
        data += n;
        bytes -= n;
    }
}

static void barrier(int fd)
{
    char value = 0;
    transfer(fd, &value, 1, true);
    transfer(fd, &value, 1, false);
}

struct Context {
    smem_shm_t shm{};
    uint8_t *gva{}, *own{};
    void *backup{};
    uint64_t *status{};
    aclrtStream stream{};
    aclrtEvent start{}, end{};
    int fd{};
};

static void initBackend(Context &c, int device, const char *url)
{
    check("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    check("config", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = rankId == 0;
    cfg.shmInitTimeout = cfg.shmCreateTimeout = cfg.controlOperationTimeout = 60;
    check("shm_init", smem_shm_init(url, 2, rankId, device, &cfg));
    void *base = nullptr;
    c.shm = smem_shm_create(0, 2, rankId, 256ULL * 1024 * 1024, SMEMS_DATA_OP_SDMA, 0, &base);
    check("shm_create", c.shm && base ? 0 : -1);
    check("SDMA workspace", smem_shm_sdma_get_workspace(c.shm) ? 0 : -1);
    uint32_t protocol[6]{};
    check("protocol snapshot", aclrtMemcpy(protocol, sizeof(protocol), smem_shm_sdma_get_workspace(c.shm),
                                           sizeof(protocol), ACL_MEMCPY_DEVICE_TO_HOST));
    printf("PROTOCOL rank=%d magic=%x exit_reason=%u\n", rankId, protocol[0], protocol[3]);
    c.gva = static_cast<uint8_t *>(base);
    c.own = c.gva + rankId * smem_shm_get_symmetric_size(c.shm);
    check("clear readiness", aclrtMemset(c.own + FLAG_BASE, 4096, 0, 4096));
}

static Context initialize(int device, int fd, const char *url)
{
    check("aclInit", aclInit(nullptr));
    check("set device", aclrtSetDevice(device));
    Context c{};
    c.fd = fd;
    check("backup alloc", aclrtMalloc(&c.backup, MAX_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    check("status alloc", aclrtMalloc(reinterpret_cast<void **>(&c.status), 64, ACL_MEM_MALLOC_HUGE_FIRST));
    check("stream", aclrtCreateStream(&c.stream));
    check("start event", aclrtCreateEvent(&c.start));
    check("end event", aclrtCreateEvent(&c.end));
    initBackend(c, device, url);
    Dl_info library{};
    dladdr(reinterpret_cast<void *>(smem_init), &library);
    printf("LIBRARY rank=%d path=%s\n", rankId, library.dli_fname ? library.dli_fname : "unknown");
    printf("CONFIG rank=%d device=%d soc=%s backend=%s active_rank=0 blocks=1\n", rankId, device, aclrtGetSocName(),
           "mf");
    return c;
}

static bool hasPayload(unsigned op)
{
    return op <= PUT_SIGNAL_NBI || op == QUIET_PENDING || op == ADD_FP32 || op == ADD_FP16;
}

static void prepare(Context &c, size_t bytes, unsigned op, uint64_t sequence)
{
    std::vector<uint32_t> data(bytes / 4);
    for (size_t i = 0; i < data.size(); ++i)
        data[i] = op == ADD_FP32 ? 0x3f800000 : (op == ADD_FP16 ? 0x3c003c00 : uint32_t(i % 127 + 1));
    check("source upload", aclrtMemcpy(c.own, bytes, data.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    for (auto &value : data)
        value = op == ADD_FP32 ? 0x40000000 : (op == ADD_FP16 ? 0x40004000 : 0);
    check("destination backup", aclrtMemcpy(c.backup, bytes, data.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    check("prepare local ready signal", aclrtMemcpy(c.own + FLAG_BASE, 8, &sequence, 8, ACL_MEMCPY_HOST_TO_DEVICE));
}

static void validate(Context &c, size_t bytes, unsigned op, uint64_t sequence)
{
    if (!rankId) {
        uint64_t result[4]{};
        check("read result", aclrtMemcpy(result, sizeof(result), c.status, sizeof(result), ACL_MEMCPY_DEVICE_TO_HOST));
        check(names[op], result[0] ? -1 : 0);
        if (op == CTX)
            check("context symmetric size", result[3] == smem_shm_get_symmetric_size(c.shm) ? 0 : -1);
    }
    const bool get = op == GET || op == GET_NBI;
    if (hasPayload(op) && rankId == (get ? 0 : 1)) {
        std::vector<uint32_t> data(bytes / 4);
        check("download payload", aclrtMemcpy(data.data(), bytes, c.own + DEST, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
        for (size_t i = 0; i < data.size(); ++i) {
            const uint32_t expected =
                op == ADD_FP32 ? 0x40400000 : (op == ADD_FP16 ? 0x42004200 : uint32_t(i % 127 + 1));
            if (data[i] != expected) {
                fprintf(stderr, "ERROR api=%s rank=%d index=%zu actual=%x expected=%x\n", names[op], rankId, i, data[i],
                        expected);
                exit(1);
            }
        }
    }
    if (rankId && op >= PUT_SIGNAL && op <= SIGNAL_SET_NBI) {
        uint64_t actual = 0;
        check("download signal", aclrtMemcpy(&actual, 8, c.own + FLAG_BASE, 8, ACL_MEMCPY_DEVICE_TO_HOST));
        check("signal value", actual == sequence ? 0 : -1);
    }
}

extern "C" __global__ __aicore__ void preparePending(__gm__ uint8_t *gva, __gm__ uint64_t *result, uint64_t bytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const auto ctx = smem_shm_sdma_ctx(gva);
    auto own = gva + ctx.rank * ctx.symm;
    auto peer = gva + (1 - ctx.rank) * ctx.symm;
    result[0] = smem_shm_sdma_put_nbi_at(ctx, own, peer + DEST, bytes) ? 0 : 1;
    SdmaMaintainCache(result, 64);
}

static void prepareQuiet(Context &c, size_t bytes)
{
    preparePending<<<1, 0, c.stream>>>(c.gva, c.status, bytes);
    check("prepare quiet stream", aclrtSynchronizeStreamWithTimeout(c.stream, 60000));
    uint64_t result = 0;
    check("prepare quiet result", aclrtMemcpy(&result, 8, c.status, 8, ACL_MEMCPY_DEVICE_TO_HOST));
    check("prepare quiet put_nbi", result ? -1 : 0);
}

static void sample(Context &c, size_t bytes, unsigned op, uint64_t sequence, bool record, unsigned iteration)
{
    check("restore destination", aclrtMemcpy(c.own + DEST, bytes, c.backup, bytes, ACL_MEMCPY_DEVICE_TO_DEVICE));
    const uint64_t flag = rankId ? 0 : sequence;
    check("reset signal", aclrtMemcpy(c.own + FLAG_BASE, 8, &flag, 8, ACL_MEMCPY_HOST_TO_DEVICE));
    barrier(c.fd);
    if (!rankId) {
        if (op == QUIET_PENDING)
            prepareQuiet(c, bytes);
        const auto start = std::chrono::steady_clock::now();
        check("record start", aclrtRecordEvent(c.start, c.stream));
        measure<<<1, 0, c.stream>>>(c.gva, c.status, bytes, sequence, op,
                                    getenv("API_STYLE") && std::string(getenv("API_STYLE")) == "gva");
        check("record end", aclrtRecordEvent(c.end, c.stream));
        check("stream sync", aclrtSynchronizeStreamWithTimeout(c.stream, 60000));
        const auto end = std::chrono::steady_clock::now();
        float ms = 0;
        check("event elapsed", aclrtEventElapsedTime(&ms, c.start, c.end));
        if (record)
            printf("SAMPLE api=%s bytes=%zu iteration=%u event_us=%.3f host_us=%.3f\n", names[op],
                   hasPayload(op) ? bytes : 0, iteration, ms * 1000,
                   std::chrono::duration<double, std::micro>(end - start).count());
    }
    barrier(c.fd);
    validate(c, bytes, op, sequence);
    barrier(c.fd);
}

static void runCase(Context &c, unsigned op, size_t bytes, unsigned warmup, unsigned rounds)
{
    prepare(c, bytes, op, 1);
    for (unsigned r = 0; r < warmup + rounds; ++r)
        sample(c, bytes, op, r + 1, r >= warmup, r < warmup ? 0 : r - warmup);
    printf("PASS rank=%d api=%s bytes=%zu full_payload_checked=1 warmup=%u rounds=%u\n", rankId, names[op],
           hasPayload(op) ? bytes : 0, warmup, rounds);
}

static void cleanup(Context &c, int device)
{
    check("destroy shm", smem_shm_destroy(c.shm, 0));
    smem_shm_uninit(0);
    smem_uninit();
    check("destroy start", aclrtDestroyEvent(c.start));
    check("destroy end", aclrtDestroyEvent(c.end));
    check("destroy stream", aclrtDestroyStream(c.stream));
    check("free status", aclrtFree(c.status));
    check("free backup", aclrtFree(c.backup));
    check("reset device", aclrtResetDevice(device));
    check("finalize", aclFinalize());
}

static void runRank(int rank, int device, int fd, const char *directory, unsigned warmup, unsigned rounds,
                    const char *url)
{
    rankId = rank;
    const std::string logfile = std::string(directory) + "/rank" + std::to_string(rank) + ".log";
    check("stdout", freopen(logfile.c_str(), "w", stdout) ? 0 : -1);
    check("stderr", dup2(fileno(stdout), fileno(stderr)) < 0 ? -1 : 0);
    setvbuf(stdout, nullptr, _IOLBF, 0);
    auto c = initialize(device, fd, url);
    const std::string filter = getenv("API_FILTER") ? getenv("API_FILTER") : "all";
    printf("CONFIG api_style=%s api_filter=%s warmup=%u rounds=%u timing=acl_event\n",
           getenv("API_STYLE") ? getenv("API_STYLE") : "at", filter.c_str(), warmup, rounds);
    for (unsigned op : {unsigned(CTX), unsigned(SIGNAL_TEST), unsigned(SIGNAL_WAIT), unsigned(QUIET_IDLE),
                        unsigned(SIGNAL_SET), unsigned(SIGNAL_SET_NBI), unsigned(PUT), unsigned(GET), unsigned(PUT_NBI),
                        unsigned(GET_NBI), unsigned(PUT_SIGNAL), unsigned(PUT_SIGNAL_NBI), unsigned(QUIET_PENDING),
                        unsigned(ADD_FP32), unsigned(ADD_FP16)}) {
        if (filter != "all" && filter != names[op])
            continue;
        for (size_t bytes : {64ULL, 4096ULL, 262144ULL, 1048576ULL, 4194304ULL, 16777216ULL, 67108864ULL}) {
            runCase(c, op, bytes, warmup, rounds);
            if (!hasPayload(op))
                break;
        }
    }
    cleanup(c, device);
    close(fd);
    printf("PASS rank=%d cleanup_complete=1\n", rankId);
}

static unsigned parseNumber(const char *value, unsigned maximum)
{
    char *end = nullptr;
    errno = 0;
    const unsigned long number = strtoul(value, &end, 10);
    if (!*value || *value == '-' || *end || errno || number > maximum) {
        fprintf(stderr, "ERROR invalid numeric argument: %s (maximum %u)\n", value, maximum);
        exit(1);
    }
    return static_cast<unsigned>(number);
}

static int waitChildren(pid_t (&children)[2])
{
    int result = 0;
    for (unsigned remaining = 2; remaining > 0; --remaining) {
        int status = 0;
        const pid_t child = waitpid(-1, &status, 0);
        check("waitpid", child < 0 ? -1 : 0);
        for (pid_t &known : children)
            if (known == child)
                known = 0;
        if (WIFEXITED(status) && WEXITSTATUS(status) == 0)
            continue;
        result = 1;
        for (pid_t other : children)
            if (other > 0)
                kill(other, SIGTERM);
    }
    return result;
}

static int launchRanks(int base, const char *directory, unsigned warmup, unsigned rounds, const char *url)
{
    int sockets[2];
    check("socketpair", socketpair(AF_UNIX, SOCK_STREAM, 0, sockets));
    fflush(stdout);
    pid_t children[2];
    for (int rank = 0; rank < 2; ++rank) {
        children[rank] = fork();
        check("fork", children[rank] < 0 ? -1 : 0);
        if (children[rank])
            continue;
        close(sockets[1 - rank]);
        runRank(rank, base + rank, sockets[rank], directory, warmup, rounds, url);
        _Exit(0);
    }
    close(sockets[0]);
    close(sockets[1]);
    return waitChildren(children);
}

int main(int argc, char **argv)
{
    if (argc != 6) {
        fprintf(stderr, "ERROR usage: %s device_base log_dir warmup rounds store_url\n", argv[0]);
        return 1;
    }
    const unsigned base = parseNumber(argv[1], INT_MAX - 1);
    const unsigned warmup = parseNumber(argv[3], 10000), rounds = parseNumber(argv[4], 10000);
    const std::string style = getenv("API_STYLE") ? getenv("API_STYLE") : "at";
    if (!rounds || (style != "at" && style != "gva")) {
        fprintf(stderr, "ERROR rounds must be positive and API_STYLE must be at or gva\n");
        return 1;
    }
    const std::string filter = getenv("API_FILTER") ? getenv("API_FILTER") : "all";
    bool valid = filter == "all";
    for (const auto *name : names)
        valid = valid || filter == name;
    if (!valid) {
        fprintf(stderr, "ERROR unknown API_FILTER: %s\n", filter.c_str());
        return 1;
    }
    return launchRanks(base, argv[2], warmup, rounds, argv[5]);
}
