#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cerrno>
#include <dlfcn.h>
#include <string>
#include <vector>
#include <csignal>
#include <sys/socket.h>
#include <sys/wait.h>
#include <unistd.h>
#include "acl/acl.h"
#include "hccl/hccl.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "../shmem_310p/sdma_ready.h"

constexpr uint64_t FLAG_BASE = 64ULL * 1024 * 1024 + 4096;
constexpr size_t MAX_BYTES = 64ULL * 1024 * 1024;
static int rankId;
static bool useMf;

__aicore__ inline void reducePhase(__gm__ uint8_t *gva, __gm__ uint32_t *status, uint64_t half, uint64_t sequence,
                                   uint32_t gather, uint32_t chunks = 1, uint32_t nbi = 0, uint32_t blocks = 1,
                                   uint32_t fused = 0, uint32_t batched = 0)
{
    const auto ctx = smem_shm_sdma_ctx(gva);
    auto own = gva + ctx.rank * ctx.symm;
    auto peer = gva + (1 - ctx.rank) * ctx.symm;
    const uint64_t offset = (gather ? ctx.rank : 1 - ctx.rank) * half + ctx.block * (half / blocks);
    const uint64_t flag = FLAG_BASE + (ctx.block * 2 + gather) * SDMA_READY_SLOT_STRIDE;
    const auto op = gather ? SMEM_SHM_SDMA_OP_COPY : SMEM_SHM_SDMA_OP_ADD_FP32;
    *status = 1;
    // The payload is produced/restored by host DMA and never cached by this AICore kernel.
    const uint64_t chunkBytes = half / blocks / chunks;
    if (batched) {
        const bool ok = fused
            ? smem_shm_sdma_put_signal_batch_nbi_at(ctx, own + offset, peer + offset, chunkBytes, chunks,
                reinterpret_cast<__gm__ uint64_t *>(peer + flag), sequence, op)
            : smem_shm_sdma_put_batch_nbi_at(ctx, own + offset, peer + offset, chunkBytes, chunks, op);
        if (!ok)
            return;
    } else {
        for (uint32_t i = 0; i < chunks; ++i) {
            auto src = own + offset + i * chunkBytes;
            auto dst = peer + offset + i * chunkBytes;
            bool ok;
            if (fused && i + 1 == chunks) {
                ok = nbi ? smem_shm_sdma_put_signal_nbi_at(ctx, src, dst, chunkBytes,
                                                           reinterpret_cast<__gm__ uint64_t *>(peer + flag),
                                                           sequence, op)
                         : smem_shm_sdma_put_signal_at(ctx, src, dst, chunkBytes,
                                                       reinterpret_cast<__gm__ uint64_t *>(peer + flag), sequence, op);
            } else {
                ok = nbi ? smem_shm_sdma_put_nbi_at(ctx, src, dst, chunkBytes, op)
                         : smem_shm_sdma_put_at(ctx, src, dst, chunkBytes, op);
            }
            if (!ok)
                return;
        }
    }
    if (nbi && !smem_shm_sdma_quiet_at(ctx))
        return;
    *status = 2;
    if (!fused && !SdmaPublishReady(ctx, own, peer, flag, flag, sequence))
        return;
    *status = 3;
    if (!SdmaWaitReady(own, flag, sequence))
        return;
    *status = 0;
    SdmaMaintainCache(status, 4);
}

extern "C" __global__ __aicore__ void mfAllReduce(__gm__ uint8_t *gva, __gm__ uint32_t *status, uint64_t half,
                                                  uint64_t sequence, uint32_t chunks, uint32_t nbi, uint32_t blocks,
                                                  uint32_t fused, uint32_t batched)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    status += AscendC::GetBlockIdx() * 32;
    reducePhase(gva, status, half, sequence, 0, chunks, nbi, blocks, fused, batched);
    if (status[0])
        return;
    reducePhase(gva, status + 16, half, sequence, 1, chunks, nbi, blocks, fused, batched);
}

extern "C" __global__ __aicore__ void CheckBatchArguments(__gm__ uint8_t *gva, __gm__ uint32_t *status)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const auto ctx = smem_shm_sdma_ctx(gva);
    auto own = gva + ctx.rank * ctx.symm;
    auto peer = gva + (1 - ctx.rank) * ctx.symm;
    const uint32_t queue = SmemShmSdmaQueueIdx(0, ctx.block);
    const uint64_t off = SMEM_SHM_SDMA_RS_REQ_TAIL + queue * SMEM_SHM_SDMA_RS_CURSOR_STRIDE;
    const uint64_t before = SdmaReadCell(ctx.res, off);
    const bool accepted = smem_shm_sdma_put_batch_nbi_at(ctx, own, peer, 4, 0) ||
        smem_shm_sdma_put_batch_nbi_at(ctx, own, peer, 4, 65) ||
        smem_shm_sdma_put_batch_nbi_at(ctx, own, peer, 3, 8) ||
        smem_shm_sdma_put_batch_nbi_at(ctx, own, peer, UINT32_MAX - 3ULL, 2) ||
        smem_shm_sdma_put_signal_batch_nbi_at(ctx, own, peer, 4, 1, nullptr, 1) ||
        smem_shm_sdma_put_signal_batch_nbi_at(ctx, own, peer, 4, 1,
            reinterpret_cast<__gm__ uint64_t *>(own + FLAG_BASE), 1);
    status[0] = accepted || SdmaReadCell(ctx.res, off) != before ? 1 : 0;
    SdmaMaintainCache(status, sizeof(uint32_t));
}

static void check(const char *api, int ret)
{
    if (!ret)
        return;
    fprintf(stderr, "ERROR rank=%d api=%s ret=%d errno=%d\n", rankId, api, ret, errno);
    exit(1);
}

static void transfer(int fd, void *buffer, size_t bytes, bool sending)
{
    auto data = static_cast<char *>(buffer);
    while (bytes) {
        const ssize_t n = sending ? write(fd, data, bytes) : read(fd, data, bytes);
        if (n < 0 && errno == EINTR)
            continue;
        check(sending ? "socket write" : "socket read", n > 0 ? 0 : -1);
        data += n;
        bytes -= n;
    }
}

static void barrier(int fd)
{
    char value = 0;
    transfer(fd, &value, 1, true);
    transfer(fd, &value, 1, false);
}

struct Context {
    HcclComm comm{};
    smem_shm_t shm{};
    uint8_t *gva{}, *own{};
    void *backup{};
    uint32_t *status{};
    aclrtStream stream{};
    aclrtEvent start{}, end{};
    int fd{};
};

static void initBackend(Context &c, int device, const char *url)
{
    if (!useMf) {
        HcclRootInfo root{};
        if (!rankId)
            check("HcclGetRootInfo", HcclGetRootInfo(&root));
        transfer(c.fd, &root, sizeof(root), rankId == 0);
        check("HcclCommInitRootInfo", HcclCommInitRootInfo(2, &root, rankId, &c.comm));
        check("input alloc", aclrtMalloc(reinterpret_cast<void **>(&c.own), MAX_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
        return;
    }
    check("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    check("config", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = rankId == 0;
    cfg.shmInitTimeout = cfg.shmCreateTimeout = cfg.controlOperationTimeout = 60;
    check("shm_init", smem_shm_init(url, 2, rankId, device, &cfg));
    void *base = nullptr;
    c.shm = smem_shm_create(0, 2, rankId, 128ULL * 1024 * 1024, SMEMS_DATA_OP_SDMA, 0, &base);
    check("shm_create", c.shm && base ? 0 : -1);
    check("SDMA workspace", smem_shm_sdma_get_workspace(c.shm) ? 0 : -1);
    uint32_t protocol[6]{};
    check("protocol snapshot", aclrtMemcpy(protocol, sizeof(protocol), smem_shm_sdma_get_workspace(c.shm),
                                           sizeof(protocol), ACL_MEMCPY_DEVICE_TO_HOST));
    printf("PROTOCOL rank=%d magic=%x exit_reason=%u\n", rankId, protocol[0], protocol[3]);
    c.gva = static_cast<uint8_t *>(base);
    c.own = c.gva + rankId * smem_shm_get_symmetric_size(c.shm);
    check("clear readiness", aclrtMemset(c.own + FLAG_BASE, 4096, 0, 4096));
}

static Context initialize(int device, int fd, const char *url)
{
    check("aclInit", aclInit(nullptr));
    check("set device", aclrtSetDevice(device));
    Context c{};
    c.fd = fd;
    check("backup alloc", aclrtMalloc(&c.backup, MAX_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    check("status alloc", aclrtMalloc(reinterpret_cast<void **>(&c.status), 1024, ACL_MEM_MALLOC_HUGE_FIRST));
    check("stream", aclrtCreateStream(&c.stream));
    check("start event", aclrtCreateEvent(&c.start));
    check("end event", aclrtCreateEvent(&c.end));
    initBackend(c, device, url);
    Dl_info library{};
    dladdr(useMf ? reinterpret_cast<void *>(smem_init) : reinterpret_cast<void *>(HcclAllReduce), &library);
    printf("LIBRARY rank=%d path=%s\n", rankId, library.dli_fname ? library.dli_fname : "unknown");
    printf("CONFIG rank=%d device=%d soc=%s backend=%s dtype=fp32 tp=2 inplace=1\n", rankId, device, aclrtGetSocName(),
           useMf ? "mf" : "hccl");
    return c;
}

static float input(int rank, size_t index)
{
    return static_cast<float>((index * (rank + 1)) % 127 + rank + 1);
}

static void validate(Context &c, std::vector<float> &result)
{
    if (useMf) {
        uint32_t code[256]{};
        check("read status", aclrtMemcpy(code, sizeof(code), c.status, sizeof(code), ACL_MEMCPY_DEVICE_TO_HOST));
        const int blocks = getenv("BLOCKS") ? atoi(getenv("BLOCKS")) : 1;
        for (int block = 0; block < blocks; ++block) {
            check("reduce-scatter status", code[block * 32]);
            check("allgather status", code[block * 32 + 16]);
        }
    }
    const size_t bytes = result.size() * sizeof(float);
    check("download", aclrtMemcpy(result.data(), bytes, c.own, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    for (size_t i = 0; i < result.size(); ++i) {
        const float expected = input(0, i) + input(1, i);
        if (result[i] == expected)
            continue;
        fprintf(stderr, "ERROR rank=%d index=%zu actual=%f expected=%f\n", rankId, i, result[i], expected);
        exit(1);
    }
}

static void submit(Context &c, size_t bytes, uint64_t sequence)
{
    if (!useMf) {
        check("HcclAllReduce",
              HcclAllReduce(c.own, c.own, bytes / 4, HCCL_DATA_TYPE_FP32, HCCL_REDUCE_SUM, c.comm, c.stream));
    } else {
        const unsigned blocks = getenv("BLOCKS") ? atoi(getenv("BLOCKS")) : 1;
        mfAllReduce<<<blocks, 0, c.stream>>>(c.gva, c.status, bytes / 2, sequence,
                                             getenv("CHUNKS") ? atoi(getenv("CHUNKS")) : 1, getenv("NBI") ? 1 : 0,
                                             blocks, getenv("FUSED_SIGNAL") ? 1 : 0, getenv("BATCHED") ? 1 : 0);
    }
}

static void runSize(Context &c, int dim, unsigned warmup, unsigned rounds)
{
    const size_t bytes = size_t(dim) * dim * sizeof(float);
    std::vector<float> data(bytes / 4), result(bytes / 4);
    for (size_t i = 0; i < data.size(); ++i)
        data[i] = input(rankId, i);
    check("prepare input", aclrtMemcpy(c.backup, bytes, data.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    for (unsigned r = 0; r < warmup + rounds; ++r) {
        check("restore input", aclrtMemcpy(c.own, bytes, c.backup, bytes, ACL_MEMCPY_DEVICE_TO_DEVICE));
        barrier(c.fd);
        const auto t0 = std::chrono::steady_clock::now();
        check("record start", aclrtRecordEvent(c.start, c.stream));
        const auto t1 = std::chrono::steady_clock::now();
        submit(c, bytes, (uint64_t(dim) << 32) | (r + 1));
        const auto t2 = std::chrono::steady_clock::now();
        check("record end", aclrtRecordEvent(c.end, c.stream));
        check("stream sync", aclrtSynchronizeStreamWithTimeout(c.stream, 60000));
        const auto t3 = std::chrono::steady_clock::now();
        float ms = 0;
        check("event elapsed", aclrtEventElapsedTime(&ms, c.start, c.end));
        validate(c, result);
        if (r >= warmup) {
            printf("SAMPLE rank=%d dim=%d iteration=%u event_us=%.3f host_us=%.3f enqueue_us=%.3f\n", rankId, dim,
                   r - warmup, ms * 1000, std::chrono::duration<double, std::micro>(t3 - t0).count(),
                   std::chrono::duration<double, std::micro>(t2 - t1).count());
        }
        barrier(c.fd);
    }
    printf("PASS rank=%d dim=%d full_payload_checked=1 warmup=%u rounds=%u\n", rankId, dim, warmup, rounds);
}

static void cleanup(Context &c, int device)
{
    if (useMf) {
        check("destroy shm", smem_shm_destroy(c.shm, 0));
        smem_shm_uninit(0);
        smem_uninit();
    } else {
        check("destroy comm", HcclCommDestroy(c.comm));
        check("free input", aclrtFree(c.own));
    }
    check("destroy start", aclrtDestroyEvent(c.start));
    check("destroy end", aclrtDestroyEvent(c.end));
    check("destroy stream", aclrtDestroyStream(c.stream));
    check("free status", aclrtFree(c.status));
    check("free backup", aclrtFree(c.backup));
    check("reset device", aclrtResetDevice(device));
    check("finalize", aclFinalize());
}

static void validateBatchArguments(Context &c)
{
    if (!getenv("BATCHED"))
        return;
    CheckBatchArguments<<<1, 0, c.stream>>>(c.gva, c.status);
    check("batch arguments stream sync", aclrtSynchronizeStreamWithTimeout(c.stream, 60000));
    uint32_t status = 1;
    check("batch arguments status", aclrtMemcpy(&status, sizeof(status), c.status,
                                               sizeof(status), ACL_MEMCPY_DEVICE_TO_HOST));
    check("batch arguments validation", status);
    printf("PASS rank=%d batch_arguments_checked=1\n", rankId);
}

static void runRank(int rank, int device, int fd, const char *directory, unsigned warmup, unsigned rounds,
                    const char *url)
{
    rankId = rank;
    const std::string logfile = std::string(directory) + "/rank" + std::to_string(rank) + ".log";
    check("stdout", freopen(logfile.c_str(), "w", stdout) ? 0 : -1);
    check("stderr", dup2(fileno(stdout), fileno(stderr)) < 0 ? -1 : 0);
    setvbuf(stdout, nullptr, _IOLBF, 0);
    auto c = initialize(device, fd, url);
    validateBatchArguments(c);
    for (int dim : {256, 512, 1024, 2048, 4096})
        runSize(c, dim, warmup, rounds);
    cleanup(c, device);
    close(fd);
    printf("PASS rank=%d cleanup_complete=1\n", rankId);
}

static bool configureBackend(const char *name)
{
    const std::string backend = name;
    if (backend != "hccl" && backend != "mf-sync" && backend != "mf-nbi" && backend != "mf-signal" &&
        backend != "mf-signal-nbi" && backend != "mf-batch-nbi" && backend != "mf-batch-signal-nbi") {
        fprintf(stderr, "ERROR unknown backend: %s\n", name);
        return false;
    }
    useMf = backend != "hccl";
    const bool batched = backend == "mf-batch-nbi" || backend == "mf-batch-signal-nbi";
    if (batched)
        setenv("BATCHED", "1", 1);
    else
        unsetenv("BATCHED");
    if (batched || backend == "mf-nbi" || backend == "mf-signal-nbi")
        setenv("NBI", "1", 1);
    else
        unsetenv("NBI");
    if (backend == "mf-signal" || backend == "mf-signal-nbi" || backend == "mf-batch-signal-nbi")
        setenv("FUSED_SIGNAL", "1", 1);
    else
        unsetenv("FUSED_SIGNAL");
    const int blocks = getenv("BLOCKS") ? atoi(getenv("BLOCKS")) : 1;
    const int chunks = getenv("CHUNKS") ? atoi(getenv("CHUNKS")) : 1;
    if (blocks < 1 || blocks > 8 || chunks < 1 || chunks > 64 || (chunks & (chunks - 1)) || (blocks & (blocks - 1))) {
        fprintf(stderr, "ERROR blocks must be 1/2/4/8 and chunks a power of two up to 64\n");
        return false;
    }
    printf("CONFIG backend=%s blocks=%d chunks=%d\n", name, blocks, chunks);
    return true;
}

int main(int argc, char **argv)
{
    if (argc != 7) {
        fprintf(stderr, "ERROR usage: %s backend device_base log_dir warmup rounds store_url\n", argv[0]);
        return 1;
    }
    if (!configureBackend(argv[1]))
        return 1;
    const int base = atoi(argv[2]);
    const unsigned warmup = strtoul(argv[4], nullptr, 10), rounds = strtoul(argv[5], nullptr, 10);
    if (base < 0 || !rounds || rounds > 10000 || warmup > 10000) {
        fprintf(stderr, "ERROR invalid arguments\n");
        return 1;
    }
    int sockets[2];
    check("socketpair", socketpair(AF_UNIX, SOCK_STREAM, 0, sockets));
    fflush(stdout);
    pid_t children[2];
    for (int rank = 0; rank < 2; ++rank) {
        children[rank] = fork();
        check("fork", children[rank] < 0 ? -1 : 0);
        if (children[rank])
            continue;
        close(sockets[1 - rank]);
        runRank(rank, base + rank, sockets[rank], argv[3], warmup, rounds, argv[6]);
        return 0;
    }
    close(sockets[0]);
    close(sockets[1]);
    int result = 0;
    for (unsigned remaining = 2; remaining > 0; --remaining) {
        int status = 0;
        const pid_t child = waitpid(-1, &status, 0);
        check("waitpid", child < 0 ? -1 : 0);
        for (pid_t &known : children)
            if (known == child)
                known = 0;
        if (WIFEXITED(status) && WEXITSTATUS(status) == 0)
            continue;
        result = 1;
        for (pid_t other : children)
            if (other > 0)
                kill(other, SIGTERM);
    }
    return result;
}
