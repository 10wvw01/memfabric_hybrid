#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <string>
#include <vector>
#include <mpi.h>
#include <unistd.h>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

constexpr size_t kMaxBytes = 64ULL * 1024 * 1024;
constexpr size_t kFlagOffset = 2 * kMaxBytes;
constexpr size_t kPoolBytes = 256ULL * 1024 * 1024;
static int rankId;

struct Arguments {
    uint64_t bytes;
    uint64_t sequence;
    unsigned mode;
    bool contextApi;
};

__aicore__ inline bool DataApi(const Arguments &a, const smem_shm_sdma_ctx_t &ctx, __gm__ uint8_t *gva,
                               __gm__ uint8_t *src, __gm__ uint8_t *dst, __gm__ uint64_t *flag)
{
    switch (a.mode) {
        case 1:
            return a.contextApi ? smem_shm_sdma_put_at(ctx, src, dst, a.bytes)
                                : smem_shm_sdma_put(gva, src, dst, a.bytes);
        case 2:
            return a.contextApi ? smem_shm_sdma_put_nbi_at(ctx, src, dst, a.bytes)
                                : smem_shm_sdma_put_nbi(gva, src, dst, a.bytes);
        case 3:
            return a.contextApi ? smem_shm_sdma_get_at(ctx, src, dst, a.bytes)
                                : smem_shm_sdma_get(gva, src, dst, a.bytes);
        case 4:
            return a.contextApi ? smem_shm_sdma_get_nbi_at(ctx, src, dst, a.bytes)
                                : smem_shm_sdma_get_nbi(gva, src, dst, a.bytes);
        case 5:
            return a.contextApi ? smem_shm_sdma_put_signal_at(ctx, src, dst, a.bytes, flag, a.sequence)
                                : smem_shm_sdma_put_signal(gva, src, dst, a.bytes, flag, a.sequence);
        case 6:
            return a.contextApi ? smem_shm_sdma_put_signal_nbi_at(ctx, src, dst, a.bytes, flag, a.sequence)
                                : smem_shm_sdma_put_signal_nbi(gva, src, dst, a.bytes, flag, a.sequence);
        default:
            return false;
    }
}

__aicore__ inline bool NotificationApi(const Arguments &a, const smem_shm_sdma_ctx_t &ctx, __gm__ uint8_t *gva,
                                       __gm__ uint64_t *localFlag, __gm__ uint64_t *remoteFlag)
{
    switch (a.mode) {
        case 7:
            return a.contextApi ? smem_shm_sdma_signal_set_at(ctx, remoteFlag, a.sequence)
                                : smem_shm_sdma_signal_set(gva, remoteFlag, a.sequence);
        case 8:
            return a.contextApi ? smem_shm_sdma_signal_set_nbi_at(ctx, remoteFlag, a.sequence)
                                : smem_shm_sdma_signal_set_nbi(gva, remoteFlag, a.sequence);
        case 9:
        case 10:
            return a.contextApi ? smem_shm_sdma_quiet_at(ctx) : smem_shm_sdma_quiet(gva);
        case 11:
            return smem_shm_signal_test(localFlag, SMEM_SHM_CMP_EQ, a.sequence);
        case 12:
            return smem_shm_signal_wait_until(localFlag, SMEM_SHM_CMP_EQ, a.sequence);
        default:
            return false;
    }
}

extern "C" __global__ __aicore__ void MeasureApi(__gm__ uint8_t *gva, __gm__ uint64_t *result, Arguments a)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const auto ctx = smem_shm_sdma_ctx(gva);
    auto own = gva + ctx.rank * ctx.symm;
    auto peer = gva + (1 - ctx.rank) * ctx.symm;
    auto localFlag = reinterpret_cast<__gm__ uint64_t *>(own + kFlagOffset);
    auto remoteFlag = reinterpret_cast<__gm__ uint64_t *>(peer + kFlagOffset);
    const bool get = a.mode == 3 || a.mode == 4;
    auto src = get ? peer : own;
    auto dst = (get ? own : peer) + kMaxBytes;
    const bool ok =
        a.mode <= 6 ? DataApi(a, ctx, gva, src, dst, remoteFlag) : NotificationApi(a, ctx, gva, localFlag, remoteFlag);
    auto out = result;
    out[0] = ok ? 0 : a.mode;
    out[1] = AscendC::GetBlockIdx();
}

extern "C" __global__ __aicore__ void PrepareQuiet(__gm__ uint8_t *gva, __gm__ uint64_t *result, uint64_t bytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const auto ctx = smem_shm_sdma_ctx(gva);
    auto own = gva + ctx.rank * ctx.symm;
    auto peer = gva + (1 - ctx.rank) * ctx.symm;
    result[0] = smem_shm_sdma_put_nbi_at(ctx, own, peer + kMaxBytes, bytes) ? 0 : 9;
}

extern "C" __global__ __aicore__ void CompleteApi(__gm__ uint8_t *gva, __gm__ uint64_t *result)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!smem_shm_sdma_quiet(gva))
        result[0] = 100;
}

static void Check(const char *api, int ret)
{
    if (ret == 0)
        return;
    fprintf(stderr, "ERROR rank=%d api=%s ret=%d\n", rankId, api, ret);
    MPI_Abort(MPI_COMM_WORLD, 1);
    std::abort();
}

static unsigned ReadCount(const char *name, unsigned fallback, unsigned minimum)
{
    const char *value = getenv(name);
    if (value == nullptr)
        return fallback;
    char *end = nullptr;
    const unsigned long result = strtoul(value, &end, 10);
    Check(name, *value && *end == '\0' && result >= minimum && result <= 10000 ? 0 : -1);
    return static_cast<unsigned>(result);
}

struct Context {
    smem_shm_t pool{};
    uint8_t *gva{}, *own{};
    uint64_t *result{};
    aclrtStream stream{};
    aclrtEvent start{}, finish{}, completed{};
    std::vector<float> source, destination;
};

static Context Initialize(int device)
{
    Check("aclInit", aclInit(nullptr));
    Check("set device", aclrtSetDevice(device));
    Check("smem_init", smem_init(0));
    smem_shm_config_t config{};
    Check("config init", smem_shm_config_init(&config));
    config.startConfigStoreServer = rankId == 0;
    const char *url = getenv("STORE_URL");
    Check("shm init", smem_shm_init(url ? url : "tcp://127.0.0.1:29921", 2, rankId, device, &config));
    Context c{};
    void *base = nullptr;
    c.pool = smem_shm_create(0, 2, rankId, kPoolBytes, SMEMS_DATA_OP_SDMA, 0, &base);
    Check("create pool", c.pool && base ? 0 : -1);
    c.gva = static_cast<uint8_t *>(base);
    c.own = c.gva + rankId * smem_shm_get_symmetric_size(c.pool);
    Check("result alloc", aclrtMalloc(reinterpret_cast<void **>(&c.result), 64, ACL_MEM_MALLOC_HUGE_FIRST));
    Check("stream", aclrtCreateStream(&c.stream));
    Check("start event", aclrtCreateEvent(&c.start));
    Check("finish event", aclrtCreateEvent(&c.finish));
    Check("completion event", aclrtCreateEvent(&c.completed));
    return c;
}

static void Prepare(Context &c, size_t bytes, uint64_t sequence, unsigned mode)
{
    Check("restore source", aclrtMemcpy(c.own, bytes, c.source.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    Check("clear destination", aclrtMemset(c.own + kMaxBytes, bytes, 0, bytes));
    const uint64_t flag = mode >= 11 ? sequence : 0;
    Check("initialize flag", aclrtMemcpy(c.own + kFlagOffset, 8, &flag, 8, ACL_MEMCPY_HOST_TO_DEVICE));
    Check("reset result", aclrtMemset(c.result, 64, 0xFF, 64));
    Check("barrier", MPI_Barrier(MPI_COMM_WORLD));
}

static void Validate(Context &c, size_t bytes, uint64_t sequence, unsigned mode)
{
    if (rankId == 0) {
        uint64_t result[2]{};
        Check("download result",
              aclrtMemcpy(result, sizeof(result), c.result, sizeof(result), ACL_MEMCPY_DEVICE_TO_HOST));
        Check("API status", static_cast<int>(result[0]));
        Check("single AICore", result[1] == 0 ? 0 : -1);
    }
    if (mode <= 6 || mode == 9) {
        Check("download payload",
              aclrtMemcpy(c.destination.data(), bytes, c.own + kMaxBytes, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
        for (size_t i = 0; i < bytes / sizeof(float); ++i) {
            const bool get = mode == 3 || mode == 4;
            const bool receives = get ? rankId == 0 : rankId == 1;
            const float expected = receives ? static_cast<float>(i % 127 + (get ? 4 : 1)) : 0;
            if (c.destination[i] == expected)
                continue;
            fprintf(stderr, "ERROR rank=%d mode=%u index=%zu actual=%f expected=%f\n", rankId, mode, i,
                    c.destination[i], expected);
            Check("payload", -1);
        }
    }
    if (mode >= 5 && mode != 9 && mode != 10) {
        uint64_t flag = 0;
        Check("download flag", aclrtMemcpy(&flag, 8, c.own + kFlagOffset, 8, ACL_MEMCPY_DEVICE_TO_HOST));
        Check("notification", flag == (mode >= 11 || rankId == 1 ? sequence : 0) ? 0 : -1);
    }
}

struct Timings {
    float apiMs{}, completedMs{};
    double hostUs{};
};

static Timings Measure(Context &c, const Arguments &args)
{
    if (args.mode == 9) {
        PrepareQuiet<<<1, 0, c.stream>>>(c.gva, c.result, args.bytes);
        Check("prepare quiet sync", aclrtSynchronizeStreamWithTimeout(c.stream, 60000));
        uint64_t prepared = 0;
        Check("read preparation", aclrtMemcpy(&prepared, 8, c.result, 8, ACL_MEMCPY_DEVICE_TO_HOST));
        Check("prepare quiet", static_cast<int>(prepared));
    }
    const auto t0 = std::chrono::steady_clock::now();
    Check("record start", aclrtRecordEvent(c.start, c.stream));
    MeasureApi<<<1, 0, c.stream>>>(c.gva, c.result, args);
    Check("record finish", aclrtRecordEvent(c.finish, c.stream));
    // Keep NBI completion outside the API Event interval.
    CompleteApi<<<1, 0, c.stream>>>(c.gva, c.result);
    Check("record completed", aclrtRecordEvent(c.completed, c.stream));
    Check("stream sync", aclrtSynchronizeStreamWithTimeout(c.stream, 60000));
    const auto t1 = std::chrono::steady_clock::now();
    Timings times{};
    times.hostUs = std::chrono::duration<double, std::micro>(t1 - t0).count();
    Check("event elapsed", aclrtEventElapsedTime(&times.apiMs, c.start, c.finish));
    Check("completion elapsed", aclrtEventElapsedTime(&times.completedMs, c.start, c.completed));
    return times;
}

static void RunCase(Context &c, unsigned mode, bool contextApi, size_t bytes, unsigned warmup, unsigned rounds)
{
    c.source.resize(bytes / sizeof(float));
    c.destination.resize(bytes / sizeof(float));
    for (size_t i = 0; i < c.source.size(); ++i)
        c.source[i] = static_cast<float>(i % 127 + rankId * 3 + 1);
    for (unsigned r = 0; r < warmup + rounds; ++r) {
        const uint64_t sequence = r + 1;
        Prepare(c, bytes, sequence, mode);
        const Arguments args{bytes, sequence, mode, contextApi};
        const Timings times = rankId == 0 ? Measure(c, args) : Timings{};
        Check("completion barrier", MPI_Barrier(MPI_COMM_WORLD));
        Validate(c, bytes, sequence, mode);
        if (rankId == 0 && r >= warmup) {
            printf("SAMPLE rank=%d mode=%u context=%u bytes=%zu iteration=%u event_us=%.3f completed_us=%.3f "
                   "host_us=%.3f\n",
                   rankId, mode, contextApi, bytes, r - warmup, times.apiMs * 1000, times.completedMs * 1000,
                   times.hostUs);
        }
        Check("validation barrier", MPI_Barrier(MPI_COMM_WORLD));
    }
    printf("PASS rank=%d mode=%u context=%u bytes=%zu full_payload_checked=1 rounds=%u\n", rankId, mode, contextApi,
           bytes, rounds);
}

static void RunAll(Context &c, unsigned warmup, unsigned rounds)
{
    for (unsigned mode = 1; mode <= 12; ++mode) {
        const bool payload = mode <= 6 || mode == 9;
        const unsigned variants = mode >= 11 ? 1 : 2;
        for (unsigned variant = 0; variant < variants; ++variant) {
            for (size_t bytes : {size_t(256 * 1024), size_t(1024 * 1024), size_t(4 * 1024 * 1024),
                                 size_t(16 * 1024 * 1024), kMaxBytes}) {
                if (!payload && bytes != 256 * 1024)
                    continue;
                RunCase(c, mode, variant != 0, payload ? bytes : 4, warmup, rounds);
            }
        }
    }
}

static void Finalize(Context &c, int device)
{
    Check("destroy events", aclrtDestroyEvent(c.start));
    Check("destroy finish", aclrtDestroyEvent(c.finish));
    Check("destroy completed", aclrtDestroyEvent(c.completed));
    Check("destroy stream", aclrtDestroyStream(c.stream));
    Check("free result", aclrtFree(c.result));
    smem_shm_destroy(c.pool, 0);
    smem_shm_uninit(0);
    smem_uninit();
    Check("reset device", aclrtResetDevice(device));
    Check("aclFinalize", aclFinalize());
}

int main(int argc, char **argv)
{
    MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &rankId);
    int size = 0;
    MPI_Comm_size(MPI_COMM_WORLD, &size);
    Check("two ranks", size == 2 ? 0 : -1);
    const char *directory = getenv("LOG_DIR");
    Check("LOG_DIR", directory ? 0 : -1);
    const std::string log = std::string(directory) + "/rank" + std::to_string(rankId) + ".log";
    Check("stdout", freopen(log.c_str(), "w", stdout) ? 0 : -1);
    Check("stderr", dup2(fileno(stdout), fileno(stderr)) >= 0 ? 0 : -1);
    setvbuf(stdout, nullptr, _IOLBF, 0);
    const int device = static_cast<int>(ReadCount("DEVICE_BASE", 0, 0)) + rankId;
    auto c = Initialize(device);
    printf("CONFIG rank=%d device=%d soc=%s active_rank=0 blocks=%u dtype=fp32\n", rankId, device, aclrtGetSocName(),
           rankId == 0 ? 1U : 0U);
    RunAll(c, ReadCount("WARMUP", 10, 0), ReadCount("ROUNDS", 100, 1));
    Finalize(c, device);
    printf("PASS rank=%d cleanup_complete=1\n", rankId);
    MPI_Finalize();
    return 0;
}
