#include <algorithm>
#include <cerrno>
#include <chrono>
#include <csignal>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
#include <sys/socket.h>
#include <sys/wait.h>
#include <unistd.h>
#include "acl/acl.h"
#include "hccl/hccl.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "../sdma_ready.h"

constexpr uint64_t ACC_BASE = 2ULL << 20;
constexpr uint64_t FLAG_BASE = 4ULL << 20;
constexpr uint64_t MAX_BYTES = 1ULL << 20;
#include "gm_collective.h"

static int rankId, mode;
static bool fp16;
static unsigned rows, tileRows;
static const char *backend;

static void Check(const char *api, int ret)
{
    if (!ret)
        return;
    fprintf(stderr, "ERROR rank=%d api=%s ret=%d errno=%d\n", rankId, api, ret, errno);
    exit(1);
}

static void Exchange(int fd, void *ptr, size_t bytes, bool sending)
{
    auto p = static_cast<char *>(ptr);
    while (bytes) {
        ssize_t n = sending ? write(fd, p, bytes) : read(fd, p, bytes);
        if (n < 0 && errno == EINTR)
            continue;
        Check("socket transfer", n > 0 ? 0 : -1);
        p += n;
        bytes -= n;
    }
}

static void Barrier(int fd)
{
    char c = 0;
    Exchange(fd, &c, 1, true);
    Exchange(fd, &c, 1, false);
}

struct Context {
    HcclComm comm{};
    smem_shm_t shm{};
    uint8_t *gva{}, *input{}, *acc{}, *output{};
    uint32_t *status{};
    aclrtStream stream{};
    aclrtEvent start{}, end{};
    int fd{};
};

static void BackendInit(Context &c, int device, const char *url)
{
    if (mode < 0) {
        HcclRootInfo root{};
        if (!rankId)
            Check("HcclGetRootInfo", HcclGetRootInfo(&root));
        Exchange(c.fd, &root, sizeof(root), rankId == 0);
        Check("HcclCommInitRootInfo", HcclCommInitRootInfo(2, &root, rankId, &c.comm));
        Check("input alloc", aclrtMalloc(reinterpret_cast<void **>(&c.input), MAX_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
        Check("acc alloc", aclrtMalloc(reinterpret_cast<void **>(&c.acc), MAX_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
        return;
    }
    Check("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    Check("config", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = rankId == 0;
    cfg.shmInitTimeout = cfg.shmCreateTimeout = cfg.controlOperationTimeout = 60;
    Check("shm_init", smem_shm_init(url, 2, rankId, device, &cfg));
    void *base = nullptr;
    c.shm = smem_shm_create(0, 2, rankId, 16ULL << 20, SMEMS_DATA_OP_SDMA, 0, &base);
    Check("shm_create", c.shm && base ? 0 : -1);
    Check("workspace", smem_shm_sdma_get_workspace(c.shm) ? 0 : -1);
    c.gva = static_cast<uint8_t *>(base);
    c.input = c.gva + rankId * smem_shm_get_symmetric_size(c.shm);
    c.acc = c.input + ACC_BASE;
    Check("clear flags", aclrtMemset(c.input + FLAG_BASE, 4096, 0, 4096));
}

static Context Init(int device, int fd, const char *url)
{
    Check("aclInit", aclInit(nullptr));
    Check("set device", aclrtSetDevice(device));
    Context c{};
    c.fd = fd;
    Check("stream", aclrtCreateStream(&c.stream));
    Check("start event", aclrtCreateEvent(&c.start));
    Check("end event", aclrtCreateEvent(&c.end));
    Check("status alloc", aclrtMalloc(reinterpret_cast<void **>(&c.status), 1024, ACL_MEM_MALLOC_HUGE_FIRST));
    Check("output alloc", aclrtMalloc(reinterpret_cast<void **>(&c.output), MAX_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    BackendInit(c, device, url);
    printf("CONFIG rank=%d device=%d soc=%s backend=%s rows=%u width=2048 dtype=%s tile_rows=%u\n", rankId, device,
           aclrtGetSocName(), backend, rows, fp16 ? "fp16" : "fp32", tileRows);
    return c;
}

static float Input(int rank, size_t index, unsigned iteration)
{
    return static_cast<float>(int((index * 13 + iteration * 7 + rank * 5) % 31) - 15);
}

static float Read(const uint8_t *p)
{
    if (fp16) {
        __fp16 v;
        memcpy(&v, p, 2);
        return static_cast<float>(v);
    }
    float v;
    memcpy(&v, p, 4);
    return v;
}

static void Prepare(Context &c, unsigned iteration, std::vector<uint8_t> &data)
{
    size_t unit = fp16 ? 2 : 4;
    for (size_t i = 0; i < data.size() / unit; ++i) {
        float v = Input(rankId, i, iteration);
        if (fp16) {
            __fp16 h = static_cast<__fp16>(v);
            memcpy(data.data() + i * unit, &h, unit);
        } else
            memcpy(data.data() + i * unit, &v, unit);
    }
    Check("restore input", aclrtMemcpy(c.input, data.size(), data.data(), data.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    Check("poison output", aclrtMemset(c.output, MAX_BYTES, 0x55, MAX_BYTES));
    Check("poison accumulator", aclrtMemset(c.acc, MAX_BYTES, 0x33, MAX_BYTES));
    Check("init status", aclrtMemset(c.status, 1024, 0x7f, 1024));
}

static void Submit(Context &c, uint64_t epoch)
{
    if (mode < 0) {
        Check("HcclAllReduce",
              HcclAllReduce(c.input, c.acc, uint64_t(rows) * 2048, fp16 ? HCCL_DATA_TYPE_FP16 : HCCL_DATA_TYPE_FP32,
                            HCCL_REDUCE_SUM, c.comm, c.stream));
        if (fp16)
            Consume<half><<<1, 0, c.stream>>>(reinterpret_cast<half *>(c.acc), reinterpret_cast<half *>(c.output), rows,
                                              tileRows);
        else
            Consume<float><<<1, 0, c.stream>>>(reinterpret_cast<float *>(c.acc), reinterpret_cast<float *>(c.output),
                                               rows, tileRows);
    } else if (fp16) {
        Collective<half>
            <<<1, 0, c.stream>>>(c.gva, reinterpret_cast<half *>(c.output), c.status, rows, tileRows, mode, epoch);
    } else {
        Collective<float>
            <<<1, 0, c.stream>>>(c.gva, reinterpret_cast<float *>(c.output), c.status, rows, tileRows, mode, epoch);
    }
}

static void Validate(Context &c, unsigned iteration, const std::vector<uint8_t> &input)
{
    size_t unit = fp16 ? 2 : 4;
    std::vector<uint8_t> data(input.size()), source(input.size()), tail(256);
    Check("download output", aclrtMemcpy(data.data(), data.size(), c.output, data.size(), ACL_MEMCPY_DEVICE_TO_HOST));
    Check("download source",
          aclrtMemcpy(source.data(), source.size(), c.input, source.size(), ACL_MEMCPY_DEVICE_TO_HOST));
    Check("source unchanged", source == input ? 0 : -1);
    Check("download guard",
          aclrtMemcpy(tail.data(), tail.size(), c.output + data.size(), tail.size(), ACL_MEMCPY_DEVICE_TO_HOST));
    Check("output guard", std::all_of(tail.begin(), tail.end(), [](uint8_t x) { return x == 0x55; }) ? 0 : -1);
    if (mode >= 0) {
        uint32_t status = 0;
        Check("status download",
              aclrtMemcpy(&status, sizeof(status), c.status, sizeof(status), ACL_MEMCPY_DEVICE_TO_HOST));
        Check("collective stage", status);
    }
    for (size_t i = 0; i < data.size() / unit; ++i) {
        float want = Input(0, i, iteration) + Input(1, i, iteration);
        if (Read(data.data() + i * unit) == want)
            continue;
        fprintf(stderr, "ERROR rank=%d iteration=%u index=%zu expected=%g actual=%g\n", rankId, iteration, i, want,
                Read(data.data() + i * unit));
        exit(1);
    }
}

static void Run(Context &c, unsigned warmup, unsigned rounds)
{
    std::vector<uint8_t> input(uint64_t(rows) * 2048 * (fp16 ? 2 : 4));
    for (unsigned r = 0; r < warmup + rounds; ++r) {
        Prepare(c, r, input);
        Barrier(c.fd);
        auto t0 = std::chrono::steady_clock::now();
        Check("start", aclrtRecordEvent(c.start, c.stream));
        auto t1 = std::chrono::steady_clock::now();
        Submit(c, r + 1);
        auto t2 = std::chrono::steady_clock::now();
        Check("end", aclrtRecordEvent(c.end, c.stream));
        Check("sync", aclrtSynchronizeStreamWithTimeout(c.stream, 60000));
        auto t3 = std::chrono::steady_clock::now();
        float ms = 0;
        Check("elapsed", aclrtEventElapsedTime(&ms, c.start, c.end));
        Validate(c, r, input);
        if (r >= warmup)
            printf("SAMPLE rank=%d iteration=%u event_us=%.3f host_us=%.3f enqueue_us=%.3f\n", rankId, r - warmup,
                   ms * 1000, std::chrono::duration<double, std::micro>(t3 - t0).count(),
                   std::chrono::duration<double, std::micro>(t2 - t1).count());
        Barrier(c.fd);
    }
    printf("PASS rank=%d full_payload_checked=1 source_unchanged=1 output_guard=1 rounds=%u\n", rankId, rounds);
}

static void Cleanup(Context &c, int device)
{
    if (mode >= 0) {
        Check("shm destroy", smem_shm_destroy(c.shm, 0));
        smem_shm_uninit(0);
        smem_uninit();
    } else {
        Check("comm destroy", HcclCommDestroy(c.comm));
        Check("free input", aclrtFree(c.input));
        Check("free acc", aclrtFree(c.acc));
    }
    Check("free output", aclrtFree(c.output));
    Check("free status", aclrtFree(c.status));
    Check("destroy events", aclrtDestroyEvent(c.start));
    Check("destroy end", aclrtDestroyEvent(c.end));
    Check("destroy stream", aclrtDestroyStream(c.stream));
    Check("reset", aclrtResetDevice(device));
    Check("finalize", aclFinalize());
}

static void Child(int rank, int device, int fd, char **argv)
{
    rankId = rank;
    std::string path = std::string(argv[3]) + "/rank" + std::to_string(rank) + ".log";
    Check("log", freopen(path.c_str(), "w", stdout) ? 0 : -1);
    Check("stderr", dup2(fileno(stdout), fileno(stderr)) < 0 ? -1 : 0);
    setvbuf(stdout, nullptr, _IOLBF, 0);
    auto c = Init(device, fd, argv[6]);
    Run(c, strtoul(argv[4], nullptr, 10), strtoul(argv[5], nullptr, 10));
    Cleanup(c, device);
    close(fd);
    printf("PASS rank=%d cleanup_complete=1\n", rank);
}

int main(int argc, char **argv)
{
    if (argc != 7) {
        fprintf(stderr, "ERROR usage: demo backend device_base log_dir warmup rounds store_url\n");
        return 1;
    }
    backend = argv[1];
    std::vector<std::string> modes{"tiled-sync", "bulk-sync", "bulk-fused", "bulk-owned"};
    auto it = std::find(modes.begin(), modes.end(), backend);
    mode = std::string(backend) == "hccl" ? -1 : int(it - modes.begin());
    fp16 = getenv("SCENARIO") && std::string(getenv("SCENARIO")) == "gdn";
    rows = getenv("ROWS") ? strtoul(getenv("ROWS"), nullptr, 10) : 80;
    tileRows = fp16 ? 8 : 20;
    if (mode == 4 || rows == 0 || rows > 80 || atoi(argv[2]) < 0 || !strtoul(argv[5], nullptr, 10)) {
        fprintf(stderr, "ERROR invalid backend/rows/device/rounds\n");
        return 1;
    }
    int fd[2];
    Check("socketpair", socketpair(AF_UNIX, SOCK_STREAM, 0, fd));
    pid_t kids[2];
    for (int rank = 0; rank < 2; ++rank) {
        kids[rank] = fork();
        Check("fork", kids[rank] < 0 ? -1 : 0);
        if (kids[rank])
            continue;
        close(fd[1 - rank]);
        Child(rank, atoi(argv[2]) + rank, fd[rank], argv);
        return 0;
    }
    close(fd[0]);
    close(fd[1]);
    int result = 0;
    for (int left = 2; left; --left) {
        int status;
        pid_t done = waitpid(-1, &status, 0);
        Check("waitpid", done < 0 ? -1 : 0);
        for (auto &kid : kids)
            if (kid == done)
                kid = 0;
        if (WIFEXITED(status) && WEXITSTATUS(status) == 0)
            continue;
        result = 1;
        for (auto kid : kids)
            if (kid > 0)
                kill(kid, SIGTERM);
    }
    return result;
}
