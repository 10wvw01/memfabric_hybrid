/* 09_310p_aicore_aicpu_sdma_4rank — 310P 双卡四 die 4-rank AICore×AICPU 协同示例
 *
 * 场景: 4 rank(dev0/dev1=卡0, dev2/dev3=卡1)SHM 对称内存池上, 全对全(p2p×12 有向对)
 * 设备侧自驱搬运——AICore kernel 内 signal 投递 → AICPU epoch kernel 代投 SDMA SQE
 * (跨 die 走 HCCS, 跨卡走 P2P+PCIe) → 对端 AICore wait 收件。全程 host 零数据面。
 *
 * 与 08(单卡双 die 2-rank)的差异: 请求环与到达环均按对端划分(v29 per-peer 环布局),
 * wait 双形态齐用——wait_any(归并收件, m.peer 标来源)与 wait_peer(显式按对端)。
 *
 * 验证内容(4-rank 协同协议的核心风险点):
 *   ① 全对全搬运: 12 有向对各 1 块(128KB), 接收方 INC 回件, 发起方 wait_peer 收齐,
 *      host D2H 逐字校验(终态=pattern+INC) —— 多发送方并发同一接收方的槽位隔离
 *   ② 多目的地交错序号连续性: 每 rank 向 3 对端交错发 32 封(4KB), 接收方 wait_any
 *      归并收齐并校验 m.peer 路由正确 + m.seq 每发送方连续无空洞(旧单环协议在
 *      交错多目的地下序号断档, 本阶段即其真机回归用例) + m.imm 轮次对账
 *
 * 拓扑要求: 2 张 Atlas 300I Duo(dev0/1+dev2/3)或 4 卡各 1 die; 每卡 8 个 P2P 槽位
 * 预算下 4-rank 全 mesh 每卡 4/8 通过(库内拓扑预检, 超限建池显式拒绝)。
 * 拉起: mpirun -np 4(bash run.sh 一键编译+运行)。
 */
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <ctime>
#include <thread>
#include <mpi.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

#define STORE_URL "tcp://127.0.0.1:8584" /* 配置存储地址(本示例独立端口) */
#define EX_LOCAL_SIZE (64UL * 1024UL * 1024UL) /* 每 rank 物理贡献 64MB(③ 数据区 40MB) */
#define EX_RANKS 4u                           /* 本示例固定 4-rank */
#define EX_CHUNK_BYTES (128UL * 1024UL)        /* ① 每对端数据块 128KB */
#define EX_CHUNK_WORDS (EX_CHUNK_BYTES / 4u)   /* 每块字数 */
#define EX_SMALL_BYTES (4UL * 1024UL)           /* ② 交错小块 4KB */
#define EX_SEQ_ROUNDS 32u                       /* ② 每对端交错封数(≤ 请求环深 64) */
#define EX_INC 0x100u                           /* 接收方 AICore 增量 */
#define EX_TAG 0x9Au                            /* pattern 标识(区别于 08 的 0x8B) */
#define EX_IMM_RETURN 0x1000u                   /* ① imm 邮件类别位: 置位=回件(未置=入件) */
/* 段内区偏移(段内自定义布局, 出/入区按共享映射函数 SmemShmSdmaPeerRingIdx 索引) */
#define EX_OFF_OUT (0UL)                        /* ① 出区基址(发往对端 p 的块) */
#define EX_OFF_IN (3UL * EX_CHUNK_BYTES)         /* ① 入区基址(来自对端 s 的块) */
#define EX_OFF_SEQ (6UL * EX_CHUNK_BYTES)        /* ② 源小区基址(每对端一块) */
#define EX_OFF_SEQIN (EX_OFF_SEQ + 3UL * EX_SMALL_BYTES) /* ② 目的小区基址(每发送方一块) */
#define EX_OFF_STATUS (12UL * 1024UL * 1024UL)   /* ①② kernel 判定词(12MB 处, 避开数据区) */
/* ③ 多 AICore AllReduce 段内布局(每 rank 64MB 内) */
#define EX_ALLRED_SLICE (1024UL * 1024UL)          /* 每 block 分片 1MB(单封, fp32) */
#define EX_ALLRED_WORDS (EX_ALLRED_SLICE / 4u)     /* 每分片字数 */
#define EX_OFF_MY (16UL * 1024UL * 1024UL)         /* 本端贡献 8MB(8 分片) */
#define EX_OFF_RECV (24UL * 1024UL * 1024UL)        /* 接收区 24MB(3 对端 × 8 分片) */
#define EX_OFF_RSLT (48UL * 1024UL * 1024UL)        /* 结果 8MB(8 分片) */
#define EX_OFF_ARSTAT (60UL * 1024UL * 1024UL)      /* ③ 每 block 判定词(8×64B 独占行 + 块数探针行) */
#define EX_AR_BLOCKS 8u                             /* ③ 启动 AICore block 数 */
/* kernel 判定词编码: [31:24]=示例魔数 0x09, [23:20]=阶段, [19:16]=对端, [15:8]=细分, [7:0]=码 */
#define EX_ST_MAGIC 0x09000000u
#define EX_ST_CODE_PASS 0u  /* 通过 */
#define EX_ST_CODE_WAIT 1u  /* wait 异常(细分=[15:8]: 1=TIMEOUT, 2=OVERRUN) */
#define EX_ST_CODE_PEER 2u  /* 对端 rank 非法(m.peer 路由异常) */
#define EX_ST_CODE_SEQ 3u   /* m.seq 序号断档(旧协议空洞缺陷复发) */
#define EX_ST_CODE_IMM 4u   /* m.imm 轮次对账失败 */
#define EX_ST_CODE_SIGNAL 5u /* signal 拒投(满环预算耗尽/目的非法) */
#define EX_ST_CODE_MISMATCH 6u /* ③ 分片自校验失败(规约结果与期望不符) */

static int g_rank = -1; /* 本进程 rank(0..3) */

/* ============================ AICore kernel(设备头原语) ============================ */
#define EX_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__ /* AICore 内联属性 */

EX_AICORE_INLINE void ExCleanRegion(__gm__ uint32_t *base, uint64_t words)
{
    AscendC::GlobalTensor<int32_t> gm;
    const uint64_t bytes = words * 4;
    /* 逐 64B 行 clean(只刷目标区域, 不扰动整个数据缓存——用户模板代码的推荐姿势) */
    for (uint64_t off = 0; off < bytes; off += 64) {
        gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(reinterpret_cast<uintptr_t>(base) + off), 16);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(gm);
    }
}

/* 判定词写回(AICore 写 → host D2H 读, 写后整行 clean) */
EX_AICORE_INLINE void ExWriteStatus(__gm__ uint8_t *ownSeg, uint32_t phase, uint32_t peer, uint32_t code)
{
    __gm__ uint32_t *st = reinterpret_cast<__gm__ uint32_t *>(ownSeg + EX_OFF_STATUS);
    *st = EX_ST_MAGIC | (phase << 20) | (peer << 16) | code;
    ExCleanRegion(st, 1);
}

/* wait 异常判定词(细分=mail status: 1=TIMEOUT, 2=OVERRUN) */
EX_AICORE_INLINE void ExWriteWaitStatus(__gm__ uint8_t *ownSeg, uint32_t phase, uint32_t peer,
                                        const smem_shm_sdma_mail_t &m)
{
    ExWriteStatus(ownSeg, phase, peer, EX_ST_CODE_WAIT | (m.status << 8));
}

/* ① 全对全搬运 kernel: 发(每对端一块, pattern 含源/目的)→ quiet → 统一收件循环
 * (共 3 入件 + 3 回件, imm 类别位区分: 入件 INC 后 signal 回件(imm 置回件位),
 * 回件仅计数)。统一循环对任意到达交错鲁棒——回件可能早于部分跨卡入件到达,
 * 按类别计数而非按调用次数, 不会把早到回件当入件处理再发出多余的回件。 */
extern "C" __global__ __aicore__ void ex09AllToAllKernel(__gm__ uint8_t *gva)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE); // 声明 AICore 任务类型
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单 block 纪律 */
    }
    const uint32_t rank = smem_shm_get_global_rank(0);    /* 本端 rank(meta 自取) */
    const uint64_t symm = smem_shm_get_symmetric_size(0); /* 对称段大小(meta 自取) */
    __gm__ uint8_t *ownSeg = gva + symm * rank;           /* 本端段基址(指针算术) */
    smem_shm_sdma_ctx_t sdmaCtx = smem_shm_sdma_ctx(gva); /* 入口一次预计算 */

    /* 发送: 每对端一块, 出区按环下标索引; 目的=对端入区[其视角的环下标]
     * (收发两侧各自经 SmemShmSdmaPeerRingIdx 定位, 与库内 kernel/原语同一公式) */
    for (uint32_t p = 0; p < EX_RANKS; p++) {
        if (p == rank) {
            continue; /* 不自送 */
        }
        const uint32_t ring = SmemShmSdmaPeerRingIdx(rank, p); /* 本端出区块下标 */
        __gm__ uint32_t *chunk = reinterpret_cast<__gm__ uint32_t *>(ownSeg + EX_OFF_OUT + ring * EX_CHUNK_BYTES);
        for (uint64_t i = 0; i < EX_CHUNK_WORDS; i++) { /* pattern 含源/目的, 可溯源 */
            chunk[i] = ((EX_TAG + rank * 4u + p) << 24) | static_cast<uint32_t>(i);
        }
        ExCleanRegion(chunk, EX_CHUNK_WORDS); /* clean 后 SDMA 可见 */
        if (!smem_shm_sdma_signal_at(sdmaCtx, chunk,
                                     gva + symm * p + EX_OFF_IN +
                                         SmemShmSdmaPeerRingIdx(p, rank) * EX_CHUNK_BYTES,
                                     EX_CHUNK_BYTES, (rank << 8) | p)) {
            ExWriteStatus(ownSeg, 1u, p, EX_ST_CODE_SIGNAL); /* 拒投(满环/目的非法) */
            return;
        }
    }
    (void)smem_shm_sdma_quiet_at(sdmaCtx); /* 等全部发出落地(源缓冲语义上可复用) */

    /* 统一收件循环: 3 入件(INC+回件)+3 回件(仅计数), 到达序任意 */
    uint32_t inbound = 0;
    uint32_t returns = 0;
    while (inbound < EX_RANKS - 1u || returns < EX_RANKS - 1u) {
        smem_shm_sdma_mail_t m = smem_shm_sdma_wait_any_at(sdmaCtx); /* 归并收件(m.peer 携来源) */
        if (m.status != SMEM_SHM_SDMA_MAIL_OK) {
            ExWriteWaitStatus(ownSeg, 1u, m.peer, m);
            return;
        }
        if (m.peer >= EX_RANKS || m.peer == rank) {
            ExWriteStatus(ownSeg, 1u, m.peer, EX_ST_CODE_PEER); /* m.peer 路由非法 */
            return;
        }
        if ((m.imm & EX_IMM_RETURN) != 0) { /* 回件: 仅计数(数据落本端出区, D2H 校验) */
            returns++;
            continue;
        }
        __gm__ uint32_t *chunk = reinterpret_cast<__gm__ uint32_t *>(m.dst); /* 落点自描述 */
        for (uint64_t w = 0; w < m.len / 4; w++) {
            chunk[w] = chunk[w] + EX_INC;
        }
        ExCleanRegion(chunk, m.len / 4); /* clean 后 SDMA 可见 */
        /* 回件: 源=本端入区(已 INC), 目的=发送方出区[其视角的环下标], imm 置回件位 */
        if (!smem_shm_sdma_signal_at(sdmaCtx, reinterpret_cast<__gm__ uint8_t *>(chunk),
                                      gva + symm * m.peer + EX_OFF_OUT +
                                          SmemShmSdmaPeerRingIdx(m.peer, rank) * EX_CHUNK_BYTES,
                                      m.len, m.imm | EX_IMM_RETURN)) {
            ExWriteStatus(ownSeg, 1u, m.peer, EX_ST_CODE_SIGNAL);
            return;
        }
        inbound++;
    }
    (void)smem_shm_sdma_quiet_at(sdmaCtx); /* 回件全部落地 */
    ExWriteStatus(ownSeg, 1u, 0u, EX_ST_CODE_PASS); /* ① 判定词: 通过 */
}

/* ② 多目的地交错序号连续性 kernel: 每 rank 向 3 对端交错各发 32 封(轮间交错),
 * 接收方显式按对端 wait_peer 逐封收齐, 校验每发送方环内 m.seq 连续无空洞(交错多
 * 目的地下单环协议必断档, per-peer 环序号恒连续) + m.imm 轮次对账。 */
extern "C" __global__ __aicore__ void ex09SeqKernel(__gm__ uint8_t *gva)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单 block 纪律 */
    }
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    __gm__ uint8_t *ownSeg = gva + symm * rank;
    smem_shm_sdma_ctx_t sdmaCtx = smem_shm_sdma_ctx(gva);

    /* 发送: 逐轮向全部对端交错各一封(imm=轮次; 源块按对端划分, 内容恒定免复写) */
    for (uint32_t r = 0; r < EX_SEQ_ROUNDS; r++) {
        for (uint32_t p = 0; p < EX_RANKS; p++) {
            if (p == rank) {
                continue;
            }
            __gm__ uint32_t *src = reinterpret_cast<__gm__ uint32_t *>(
                ownSeg + EX_OFF_SEQ + SmemShmSdmaPeerRingIdx(rank, p) * EX_SMALL_BYTES);
            if (!smem_shm_sdma_signal_at(sdmaCtx, src,
                                          gva + symm * p + EX_OFF_SEQIN +
                                              SmemShmSdmaPeerRingIdx(p, rank) * EX_SMALL_BYTES,
                                          EX_SMALL_BYTES, r)) {
                ExWriteStatus(ownSeg, 2u, p, EX_ST_CODE_SIGNAL);
                return;
            }
        }
    }
    (void)smem_shm_sdma_quiet_at(sdmaCtx); /* 等全部发出落地 */

    /* 接收: 显式按对端 wait_peer 逐封收齐(每发送方 ROUNDS 封),
     * 校验环内序号连续(无跨目的地空洞) + imm 轮次对账。
     * 序号基址: 请求环序号跨阶段累计(阶段① 每对端已用 2 封), 首封 seq 即该对端
     * 环的当前基址, 后续逐封 +1——校验连续性而非绝对值, 对前序流量不敏感 */
    int64_t base[EX_RANKS] = {-1, -1, -1, -1};
    for (uint32_t p = 0; p < EX_RANKS; p++) {
        if (p == rank) {
            continue;
        }
        for (uint32_t r = 0; r < EX_SEQ_ROUNDS; r++) {
            smem_shm_sdma_mail_t m = smem_shm_sdma_wait_peer_at(sdmaCtx, p);
            if (m.status != SMEM_SHM_SDMA_MAIL_OK) {
                ExWriteWaitStatus(ownSeg, 2u, p, m);
                return;
            }
            if (m.peer != p) {
                ExWriteStatus(ownSeg, 2u, p, EX_ST_CODE_PEER); /* wait_peer 与 m.peer 不一致 */
                return;
            }
            if (base[p] < 0) {
                base[p] = static_cast<int64_t>(m.seq); /* 首封: 记基址 */
            } else if (m.seq != static_cast<uint32_t>(base[p]) + r) {
                /* 序号断档=旧单环协议"多目的地空洞"缺陷复发; per-peer 环下序号恒连续 */
                ExWriteStatus(ownSeg, 2u, p, EX_ST_CODE_SEQ);
                return;
            }
            if (m.imm != r) { /* imm=轮次回带(交错下仍按发送方对账) */
                ExWriteStatus(ownSeg, 2u, p, EX_ST_CODE_IMM);
                return;
            }
        }
    }
    ExWriteStatus(ownSeg, 2u, 0u, EX_ST_CODE_PASS); /* ② 判定词: 通过 */
}

/* ③ 多 AICore AllReduce kernel: <<<8>>> 起 8 个 AICore block, 每 block 独立流水
 * (无块间同步)——发(本 block 分片 → 3 对端, 走独占队列 (对端, 本 block))→ 收
 * (本 block 列子环, 收齐 3 对端同列分片)→ 规约(本分片 = Σ 四 rank 贡献)→ 自校验。
 * 分片间完全并行: block b 算完即发, 不等其它 block——通信与计算在 block 间重叠。 */
extern "C" __global__ __aicore__ void ex09AllReduceKernel(__gm__ uint8_t *gva)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    __gm__ uint8_t *ownSeg = gva + symm * rank;
    smem_shm_sdma_ctx_t sdmaCtx = smem_shm_sdma_ctx(gva); /* ctx.block = GetBlockIdx() */
    const uint32_t b = sdmaCtx.block;
    /* 本 block 判定词(独占 64B 行, 多 block 并发写不共行) */
    __gm__ uint32_t *st = reinterpret_cast<__gm__ uint32_t *>(ownSeg + EX_OFF_ARSTAT + b * 64);
    *st = EX_ST_MAGIC | (3u << 20) | (b << 16) | 0xFFFFu; /* 入口先写非通过值(块未完成可判) */
    ExCleanRegion(st, 1);
    if (b == 0) { /* 块数探针: block 0 记录实际启动块数(独占行 8) */
        __gm__ uint32_t *bn = reinterpret_cast<__gm__ uint32_t *>(ownSeg + EX_OFF_ARSTAT + 8u * 64u);
        *bn = static_cast<uint32_t>(AscendC::GetBlockNum());
        ExCleanRegion(bn, 1);
    }
    if (b >= EX_AR_BLOCKS) { /* 超出本示例分片数的块(不应发生): 直接报通过外退出 */
        *st = EX_ST_MAGIC | (3u << 20) | (b << 16) | EX_ST_CODE_PEER;
        ExCleanRegion(st, 1);
        return;
    }

    /* 1. 填充本 block 分片: pattern = rank*4096 + (i & 0xFFF), 可溯源(规约=SUM, u32;
     * fp32 引擎内联 reduce 已由 08 ⑤ 的 SQE opcode 验证, 协议同构) */
    __gm__ uint32_t *my = reinterpret_cast<__gm__ uint32_t *>(ownSeg + EX_OFF_MY + b * EX_ALLRED_SLICE);
    for (uint64_t i = 0; i < EX_ALLRED_WORDS; i++) {
        my[i] = rank * 4096u + static_cast<uint32_t>(i & 0xFFFu);
    }
    ExCleanRegion(my, EX_ALLRED_WORDS); /* clean 后 SDMA 可见 */

    /* 2. 发本 block 分片到 3 个对端: 队列 (对端, 本 block) 独占, 算完即发不等其它 block;
     * 落点 = 对端接收区[(对端视角本端环下标) × 8 + 本 block] 分片槽(指针域算术) */
    for (uint32_t p = 0; p < EX_RANKS; p++) {
        if (p == rank) {
            continue;
        }
        __gm__ uint8_t *dst = gva + symm * p + EX_OFF_RECV +
                              (SmemShmSdmaPeerRingIdx(p, rank) * SMEM_SHM_SDMA_MAX_BLOCKS + b) * EX_ALLRED_SLICE;
        if (!smem_shm_sdma_signal_at(sdmaCtx, my, dst, EX_ALLRED_SLICE, (rank << 8) | p)) {
            *st = EX_ST_MAGIC | (3u << 20) | (p << 16) | EX_ST_CODE_SIGNAL;
            ExCleanRegion(st, 1);
            return;
        }
    }
    (void)smem_shm_sdma_quiet_at(sdmaCtx); /* 等 3 队列末封落地(完成戳, 不依赖对端消费) */

    /* 3. 收齐 3 个对端的同列分片: 到达子环 (对端, 本 block) 独占, 逐对端显式 wait */
    for (uint32_t p = 0; p < EX_RANKS; p++) {
        if (p == rank) {
            continue;
        }
        smem_shm_sdma_mail_t m = smem_shm_sdma_wait_peer_at(sdmaCtx, p);
        if (m.status != SMEM_SHM_SDMA_MAIL_OK) { /* wait 超时/溢出(细分=mail status 写入码) */
            *st = EX_ST_MAGIC | (3u << 20) | (p << 16) | (EX_ST_CODE_WAIT | (m.status << 8));
            ExCleanRegion(st, 1);
            return;
        }
        if (m.peer != p || m.imm != ((static_cast<uint64_t>(p) << 8) | rank)) { /* 路由对账 */
            *st = EX_ST_MAGIC | (3u << 20) | (p << 16) | EX_ST_CODE_PEER;
            ExCleanRegion(st, 1);
            return;
        }
    }

    /* 4. 规约本 block 分片: 结果 = Σ 四个 rank 的同位贡献(逐元素 u32 SUM) */
    __gm__ uint32_t *out = reinterpret_cast<__gm__ uint32_t *>(ownSeg + EX_OFF_RSLT + b * EX_ALLRED_SLICE);
    __gm__ uint32_t *recv[EX_RANKS];
    uint32_t peerCnt = 0;
    for (uint32_t p = 0; p < EX_RANKS; p++) { /* 接收区槽 = (本端视角对端环下标 × 8 + 本 block) */
        if (p == rank) {
            continue;
        }
        recv[peerCnt++] = reinterpret_cast<__gm__ uint32_t *>(
            ownSeg + EX_OFF_RECV +
            (SmemShmSdmaPeerRingIdx(rank, p) * SMEM_SHM_SDMA_MAX_BLOCKS + b) * EX_ALLRED_SLICE);
    }
    for (uint64_t i = 0; i < EX_ALLRED_WORDS; i++) {
        uint32_t acc = my[i];
        for (uint32_t k = 0; k < peerCnt; k++) {
            acc += recv[k][i];
        }
        out[i] = acc;
    }
    ExCleanRegion(out, EX_ALLRED_WORDS); /* host D2H 前可见 */

    /* 5. 分片自校验: 期望 = Σ_{r=0..3}(r*4096 + (i&0xFFF)) = 6*4096 + 4*(i&0xFFF) */
    for (uint64_t i = 0; i < EX_ALLRED_WORDS; i++) {
        const uint32_t expect = 6u * 4096u + 4u * static_cast<uint32_t>(i & 0xFFFu);
        if (out[i] != expect) {
            *st = EX_ST_MAGIC | (3u << 20) | (b << 16) | EX_ST_CODE_MISMATCH;
            ExCleanRegion(st, 1);
            return;
        }
    }
    *st = EX_ST_MAGIC | (3u << 20) | (b << 16) | EX_ST_CODE_PASS;
    ExCleanRegion(st, 1);
}

/* ============================ host 侧(仅建池/起 kernel/收结果) ============================ */
static void Step(const char *name, int32_t ret)
{
    if (ret != 0) {
        printf("[r%d FAIL] %-28s ret=%d\n", g_rank, name, ret);
        exit(1);
    }
    printf("[r%d OK]   %-28s\n", g_rank, name);
}

static double NowMs()
{
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
}

/* 4 rank 栅栏(建池会合/阶段栅栏共用) */
static void SyncPeers()
{
    MPI_Barrier(MPI_COMM_WORLD);
}

/* 状态观测线程: 每 5s 从设备内存读回常驻 kernel 的结果区(magic/mainRet/consumed/
 * exitReason)与 3 个到达环的游标、首槽戳值, 用于定位 kernel 是在运行、已退出还是
 * 卡在某个环等某封邮件(挂起/超时类故障的现场数据) */
static void EpochStatusThread(const volatile bool &stop, uint64_t wsAddr, uint64_t resAddr, uint64_t phys, int devId)
{
    if (wsAddr == 0) {
        return;
    }
    (void)aclrtSetDevice(devId); /* 本线程独立设备上下文(ACL 上下文线程局部) */
    uint32_t lastConsumed = 0xFFFFFFFFu;
    uint32_t lastStatus = 0xFFFFFFFFu;
    while (!stop) {
        struct timespec ts = {5, 0}; /* 5s 轮询 */
        nanosleep(&ts, nullptr);
        if (stop) {
            break;
        }
        uint32_t res[6] = {0, 0, 0, 0, 0, 0}; /* result 24B: magic/mainRet/consumed/exitReason/headAfter */
        if (aclrtMemcpy(res, 24, reinterpret_cast<void *>(wsAddr), 24, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            printf("[r%d WATCH] result D2H failed\n", g_rank);
            continue;
        }
        /* 到达子环快照(紧凑单行, block 0 列): 每队列 head 槽戳值——N=空(E=空等待, R=就绪未消费) */
        uint32_t stuckRings = 0;
        for (uint32_t r = 0; r < EX_RANKS - 1u; r++) { /* v31: 队列 = 对端环下标 × 8 + block 0 */
            uint64_t cells[2] = {0, 0};
            const uint64_t ring = resAddr + SMEM_SHM_SDMA_RS_PEER_RINGS +
                                  SmemShmSdmaQueueIdx(r, 0u) * SMEM_SHM_SDMA_RS_PEER_STRIDE;
            if (aclrtMemcpy(cells, 16, reinterpret_cast<void *>(ring + SMEM_SHM_SDMA_RS_PEER_HEAD), 16,
                            ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
                printf("[r%d WATCH] ring%u head D2H failed\n", g_rank, r);
                continue;
            }
            const uint64_t head = cells[0];
            uint64_t stamp = 0;
            (void)aclrtMemcpy(&stamp, 8, reinterpret_cast<void *>(ring + SMEM_SHM_SDMA_RS_PEER_STAMP +
                                                                        (head % SMEM_SHM_SDMA_RS_PEER_SLOTS) * 8),
                               8, ACL_MEMCPY_DEVICE_TO_HOST);
            const uint32_t peerOfRing = (r < static_cast<uint32_t>(g_rank)) ? r : r + 1u;
            printf("r%u=%llu%s ", peerOfRing, (unsigned long long)head,
                   (stamp == head + 1) ? "R" : "E");
            if (stamp == head + 1) { /* 就绪未消费: 转储最近邮件定位误路由 */
                stuckRings++;
                for (uint64_t k = (head >= 1) ? head - 1 : 0; k <= head; k++) {
                    uint64_t mail[4] = {0, 0, 0, 0};
                    if (aclrtMemcpy(mail, 32,
                                    reinterpret_cast<void *>(ring + SMEM_SHM_SDMA_RS_PEER_MAIL +
                                                             (k % SMEM_SHM_SDMA_RS_PEER_SLOTS) * 32),
                                    32, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS) {
                        printf("\n[r%d WATCH] ring%u mail[%llu] seq=%llu dst=0x%llx imm=0x%llx (s=%u d=%u ret=%u)",
                               g_rank, r, (unsigned long long)k, (unsigned long long)(mail[0] - 1),
                               (unsigned long long)mail[1], (unsigned long long)mail[3],
                               (unsigned)((mail[3] >> 8) & 0xFFu), (unsigned)(mail[3] & 0xFFu),
                               (unsigned)((mail[3] >> 12) & 0x1u));
                    }
                }
            }
        }
        printf("\n");
        /* kernel 判定词快照(变化才打印): 错误码定位 kernel 早退原因 */
        uint32_t st = 0;
        if (aclrtMemcpy(&st, 4, reinterpret_cast<void *>(resAddr - phys + SMEM_SHM_SDMA_RESERVED + EX_OFF_STATUS),
                        4, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS && st != lastStatus) {
            printf("[r%d WATCH] kernel status=0x%x\n", g_rank, st);
            lastStatus = st;
        }
        if (res[2] != lastConsumed) { /* consumed 变化才打印(降噪) */
            printf("[r%d WATCH] epoch alive: mainRet=%u consumed=%u exitReason=%u\n", g_rank, res[1], res[2], res[3]);
            lastConsumed = res[2];
        }
    }
    (void)aclrtResetDevice(devId);
}

/* 判定词解码打印: 通过/定位失败阶段与对端(超时/溢出/断档/对账/拒投) */
static int ReportStatus(uint32_t st, uint32_t phase)
{
    if ((st & EX_ST_MAGIC) != EX_ST_MAGIC) {
        printf("[r%d] 阶段%u: 判定词未落(0x%x, kernel 异常退出) → FAIL\n", g_rank, phase, st);
        return 0;
    }
    const uint32_t stPhase = (st >> 20) & 0xFu;
    const uint32_t peer = (st >> 16) & 0xFu;
    const uint32_t code = st & 0xFFu;
    const uint32_t detail = (st >> 8) & 0xFFu;
    if (stPhase == phase && code == EX_ST_CODE_PASS) {
        printf("[r%d] 阶段%u 判定词: PASS\n", g_rank, phase);
        return 1;
    }
    const char *why = (code == EX_ST_CODE_WAIT) ?   "wait 异常(1=超时 2=溢出)"
                     : (code == EX_ST_CODE_PEER) ?  "m.peer 路由非法"
                     : (code == EX_ST_CODE_SEQ) ?   "m.seq 序号断档"
                     : (code == EX_ST_CODE_IMM) ?   "m.imm 对账失败"
                                                  : "signal 拒投";
    printf("[r%d] 判定词: FAIL(阶段%u 对端%u 码=%u 细分=%u: %s)\n", g_rank, stPhase, peer, code, detail, why);
    return 0;
}

// 示例入口: rank 由 MPI 分配(mpirun -np 4 拉起)
int main(int argc, char *argv[])
{
    (void)argv;
    int mpiRet = MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank); // 先取 rank, 步骤日志才能带 [rN] 前缀
    Step("MPI_Init", mpiRet);
    int worldSize = 0;
    MPI_Comm_size(MPI_COMM_WORLD, &worldSize);
    if (worldSize != EX_RANKS) { /* 本示例固定 4-rank(两卡四 die 全 mesh) */
        printf("expect exactly 4 ranks (mpirun -np 4), got %d\n"
               "topology: 2x Atlas300I Duo (dev0/1 + dev2/3) or 4 single-die cards\n",
               worldSize);
        MPI_Finalize();
        return 1;
    }
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1);

    /* ---- 建池(SHM + SDMA 位 → 310P 协同自动启用; 库内拓扑预检 P2P 槽位预算) ---- */
    Step("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    Step("smem_shm_config_init", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = (g_rank == 0); /* r0 起配置存储 */
    Step("smem_shm_init", smem_shm_init(STORE_URL, EX_RANKS, static_cast<uint32_t>(g_rank),
                                        static_cast<uint16_t>(g_rank), &cfg));
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, EX_RANKS, static_cast<uint32_t>(g_rank), EX_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) {
        printf("[r%d FAIL] smem_shm_create: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    Step("smem_shm_create(SDMA)", 0);
    if (smem_shm_sdma_get_workspace(shm) == nullptr) { /* 协同就绪判定(唯一 host 查询) */
        printf("[r%d FAIL] sdma orchestration not ready\n", g_rank);
        return 1;
    }
    printf("[r%d INFO] gva=%p\n", g_rank, gva);
    SyncPeers(); /* 会合: 四方建池完成(保留区清零+监督线程就位) */

    /* 状态观测线程(每 5s 读结果区+到达环游标; 挂起类故障的现场定位) */
    const uint64_t symmHost = smem_shm_get_symmetric_size(shm); /* 与 kernel meta 同源 */
    const uint64_t physHost = EX_LOCAL_SIZE; /* 段物理大小(= localSize, 与 meta 同源) */
    const uint64_t resAddr = reinterpret_cast<uint64_t>(gva) + symmHost * g_rank + physHost - SMEM_SHM_SDMA_RESERVED;
    volatile bool statusStop = false;
    std::thread statusThread(EpochStatusThread, std::cref(statusStop),
                             reinterpret_cast<uint64_t>(smem_shm_sdma_get_workspace(shm)), resAddr, physHost, g_rank);

    aclrtStream stream = nullptr;
    (void)aclrtCreateStream(&stream);
    uint8_t *ownSegHost = static_cast<uint8_t *>(gva) + symmHost * g_rank; /* host 侧本端段基址 */
    int overall = 1;

    /* ---- ① 全对全搬运(12 有向对, 全程设备侧自驱) ---- */
    double tAll = 0;
    {
        const double t0 = NowMs();
        ex09AllToAllKernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva));
        Step("sync(allToAll)", aclrtSynchronizeStream(stream));
        tAll = NowMs() - t0;
        SyncPeers(); /* 会合: 四方交换完成 */

        /* 判定词读回(kernel 侧 wait/路由/拒投异常的显式暴露) */
        uint32_t st = 0;
        if (aclrtMemcpy(&st, 4, ownSegHost + EX_OFF_STATUS, 4, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS) {
            overall &= ReportStatus(st, 1u);
        } else {
            printf("[r%d] ①判定词 D2H 失败 → FAIL\n", g_rank);
            overall = 0;
        }

        /* 全量校验: 本端出区 3 块, 每 word == ((tag+r*4+p)<<24|i) + INC */
        const uint64_t total = 3UL * EX_CHUNK_BYTES;
        uint32_t *host = static_cast<uint32_t *>(malloc(total));
        if (host == nullptr ||
            aclrtMemcpy(host, total, ownSegHost + EX_OFF_OUT, total, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            printf("[r%d FAIL] ① D2H 全量读失败\n", g_rank);
            overall = 0;
        } else {
            uint32_t bad = 0;
            for (uint32_t p = 0; p < EX_RANKS; p++) {
                if (p == static_cast<uint32_t>(g_rank)) {
                    continue;
                }
                const uint32_t ring = SmemShmSdmaPeerRingIdx(static_cast<uint32_t>(g_rank), p);
                uint32_t cbad = 0;
                for (uint64_t i = 0; i < EX_CHUNK_WORDS; i++) {
                    if (host[ring * EX_CHUNK_WORDS + i] != (((EX_TAG + g_rank * 4u + p) << 24) | i) + EX_INC) {
                        bad++;
                        cbad++;
                    }
                }
                if (cbad != 0) { /* 打印样本辅助定位(对端 p 维度) */
                    printf("[r%d] ①对端%u bad=%u: [0]=0x%x expect=0x%x\n", g_rank, p, cbad,
                           host[ring * EX_CHUNK_WORDS], (((EX_TAG + g_rank * 4u + p) << 24)) + EX_INC);
                }
            }
            printf("[r%d] ①全对全终态 mismatch=%u/%llu → %s (%.2fms)\n", g_rank, bad,
                   (unsigned long long)(3UL * EX_CHUNK_WORDS), bad == 0 ? "PASS" : "FAIL", tAll);
            overall &= (bad == 0) ? 1 : 0;
        }
        free(host);
    }

    /* ---- ② 多目的地交错序号连续性(单环协议空洞缺陷的真机回归) ---- */
    double tSeq = 0;
    {
        const double t0 = NowMs();
        ex09SeqKernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva));
        Step("sync(seq)", aclrtSynchronizeStream(stream));
        tSeq = NowMs() - t0;
        SyncPeers(); /* 会合: 四方交错收发完成 */
        uint32_t st = 0;
        if (aclrtMemcpy(&st, 4, ownSegHost + EX_OFF_STATUS, 4, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS) {
            overall &= ReportStatus(st, 2u);
        } else {
            printf("[r%d] ②判定词 D2H 失败 → FAIL\n", g_rank);
            overall = 0;
        }
        printf("[r%d] ②交错×%u封/对端 耗时 %.2fms\n", g_rank, EX_SEQ_ROUNDS, tSeq);
    }

    /* ---- ③ 多 AICore AllReduce(8 block 独立流水, 每 block 1MB 分片单封) ---- */
    double tAr = 0;
    {
        const double t0 = NowMs();
        ex09AllReduceKernel<<<EX_AR_BLOCKS, 0, stream>>>(static_cast<uint8_t *>(gva));
        Step("sync(allReduce)", aclrtSynchronizeStream(stream));
        tAr = NowMs() - t0;
        SyncPeers(); /* 会合: 四方 AllReduce 完成 */

        /* 块数探针 + 每 block 判定词(8 行独占缓存行, 逐行 D2H) */
        uint32_t blockNum = 0;
        (void)aclrtMemcpy(&blockNum, 4, ownSegHost + EX_OFF_ARSTAT + 8u * 64u, 4, ACL_MEMCPY_DEVICE_TO_HOST);
        printf("[r%d] ③AICore block 数: %u(启动 %u)\n", g_rank, blockNum, EX_AR_BLOCKS);
        for (uint32_t b = 0; b < EX_AR_BLOCKS; b++) {
            uint32_t st = 0;
            if (aclrtMemcpy(&st, 4, ownSegHost + EX_OFF_ARSTAT + b * 64, 4, ACL_MEMCPY_DEVICE_TO_HOST) ==
                    ACL_SUCCESS &&
                (st & EX_ST_MAGIC) == EX_ST_MAGIC) {
                overall &= ReportStatus(st, 3u);
            } else {
                printf("[r%d] ③block %u 判定词未落(0x%x) → FAIL\n", g_rank, b, st);
                overall = 0;
            }
        }

        /* 全量校验: 结果 8MB 逐元素 == 6*4096 + 4*(i & 0xFFF)(Σ 四 rank 贡献, u32 SUM) */
        const uint64_t total = 8UL * EX_ALLRED_SLICE;
        uint32_t *host = static_cast<uint32_t *>(malloc(total));
        if (host == nullptr ||
            aclrtMemcpy(host, total, ownSegHost + EX_OFF_RSLT, total, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            printf("[r%d FAIL] ③ D2H 全量读失败\n", g_rank);
            overall = 0;
        } else {
            uint32_t bad = 0;
            for (uint64_t i = 0; i < total / 4; i++) {
                const uint32_t expect = 6u * 4096u + 4u * static_cast<uint32_t>(i & 0xFFFu);
                if (host[i] != expect) {
                    bad++;
                }
            }
            /* 口径: 全链 = 填充 8MB + 交换 24MB(收发对称) + 规约 + 逐元素校验, 非
             * 纯通信带宽(填充/规约为 AICore 标量循环, 主导耗时) */
            printf("[r%d] ③AllReduce 结果 mismatch=%u/%llu → %s (全链 %.2fms, 含填充/交换24MB/规约/校验)\n",
                   g_rank, bad, (unsigned long long)(total / 4), bad == 0 ? "PASS" : "FAIL", tAr);
            overall &= (bad == 0) ? 1 : 0;
        }
        free(host);
    }

    (void)aclrtDestroyStream(stream);
    statusStop = true; /* 停状态观测线程(先于销毁/退出路径) */
    statusThread.join();
    Step("smem_shm_destroy", smem_shm_destroy(shm, 0)); /* 监督线程停止, 资源计数-1 */
    smem_shm_uninit(0);
    Step("smem_shm_uninit", 0);
    smem_uninit();
    Step("smem_uninit", 0);

    /* 总判定会合(任一 rank 失败即整体失败) */
    int allOverall = 0;
    (void)MPI_Allreduce(&overall, &allOverall, 1, MPI_INT, MPI_MIN, MPI_COMM_WORLD);
    (void)aclrtResetDevice(g_rank);
    (void)aclFinalize();
    printf("=== EX09 r%d %s ===\n", g_rank, allOverall ? "PASS" : "FAIL");
    MPI_Finalize();
    return allOverall ? 0 : 1;
}
