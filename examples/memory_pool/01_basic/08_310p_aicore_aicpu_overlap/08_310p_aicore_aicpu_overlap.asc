/* 08_310p_aicore_aicpu_overlap — 310P 单卡双 die 2-rank AICore×AICPU 协同示例
 *
 * 场景(310p-aicore-aicpu-开发进展.md P2):
 *   双 rank(dev0/dev1)SHM 池上, AICore 产数据 → GM 邮箱委托 AICPU 编排 SDMA SQE
 *   → 对端 AICore 消费(读改写 INC)→ 回程, 全内存通知链(邮箱/池内标志/SQE 对)。
 *
 * 两阶段验收:
 *   ① 多 chunk 流水(8×128KB): 数据逐字校验 mismatch=0 —— 功能正确性
 *   ② 串行 N 次(chunks=1, 同步逐次): 总时延 Tserial —— 无重叠对照
 *   输出 Tserial vs Tpipe 对比与流水稳态证据(通信开销不再线性叠加)
 *
 * 与 07 示例的关系: 07 是 host 编排(HostDataOpAclMemcpy), 08 是设备发起的
 * 协同编排(SHM API + AICore kernel + AICPU 编排 kernel)。
 *
 * 双 rank 会合与栅栏: MPI_Barrier(mpirun -np 2 拉起, rank 由 MPI 分配;
 * 替代早期 /tmp 文件轮询会合——无文件残留, 同步粒度从 1ms 降到微秒级)。
 */
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <mpi.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_overlap.h"

#define STORE_URL "tcp://127.0.0.1:8581"
#define EX_LOCAL_SIZE (32UL * 1024UL * 1024UL) /* 每 rank 物理贡献 32MB */
#define EX_CHUNKS 8u                           /* 流水 chunk 数 */
#define EX_CHUNK_BYTES (128UL * 1024UL)         /* 每 chunk 128KB */
#define EX_CHUNK_WORDS (EX_CHUNK_BYTES / 4u)    /* 每 chunk 字数 */
#define EX_INC 0x100u                           /* r1 AICore 增量 */
#define EX_TAG 0x8Bu                           /* pattern 标识 */

static int g_rank = -1;

/* ============================ AICore kernel(设备头原语) ============================ */
#define EX_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__

EX_AICORE_INLINE void ExStatusSet(__gm__ uint32_t *status, uint32_t slot, uint32_t val)
{
    status[slot] = val;
    AscendC::GlobalTensor<int32_t> stGm;
    stGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(status + slot), 1);
    AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(stGm);
}

EX_AICORE_INLINE void ExCleanRegion(__gm__ uint32_t *base, uint64_t words)
{
    AscendC::GlobalTensor<int32_t> gm;
    gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(base), words);
    AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::ENTIRE_DATA_CACHE>(gm);
}

/* 产一个 chunk 的 pattern(chunk 内含 chunk 序号, 校验可溯源) */
EX_AICORE_INLINE void ExFillChunk(__gm__ uint32_t *chunkBase, uint64_t words, uint32_t tag, uint32_t chunkIdx)
{
    for (uint64_t i = 0; i < words; i++) {
        chunkBase[i] = ((tag + chunkIdx) << 24) | static_cast<uint32_t>(i);
    }
}

/* 协同 AICore kernel 四角色:
 *   2 = r0 单块产(①②): 产 → 邮箱 → 轮询结果标志
 *   3 = r1 单块消费(①②): 轮询到达 → INC → 回程邮箱
 *   4 = r0 流水产(③): 逐 chunk 产+邮箱(生产流水) → 等最后一块结果标志
 *   5 = r1 流水消费(③): 逐 chunk 轮询到达 → INC → 回程邮箱 */
extern "C" __global__ __aicore__ void ex08Kernel(
    __gm__ uint8_t *ownSeg,        /* 本端段基址 */
    uint64_t physSize,             /* 段物理大小(标志保留区定位) */
    uint64_t chunkWords,           /* 单 chunk 字数(单块模式 = 全量) */
    uint32_t role,                 /* 2/3/4/5 */
    uint32_t chunks,               /* 流水 chunk 数(role4/5) */
    uint32_t incVal, uint32_t tag,
    __gm__ uint8_t *workspace,     /* 协同工作区(邮箱 ring) */
    __gm__ uint64_t *flagArrival,  /* 本端到达标志数组(8B×chunks) */
    __gm__ uint64_t *flagResult,   /* 本端结果标志数组(8B×chunks) */
    __gm__ uint32_t *status)      /* 状态面包屑(GM 限定) */
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单 block 纪律 */
    }
    __gm__ uint32_t *data = reinterpret_cast<__gm__ uint32_t *>(ownSeg);
    __gm__ uint8_t *mb = workspace + SMEM_SHM_OVERLAP_WS_MAILBOX_OFF;

    if (role == 2) { /* r0 单块: ①产 ②邮箱 ⑦等结果 */
        ExStatusSet(status, 0, 0xA0u);
        ExFillChunk(data, chunkWords, tag, 0);
        ExCleanRegion(data, chunkWords);
        ExStatusSet(status, 0, 0xA1u);
        smem_shm_overlap_notify(mb, reinterpret_cast<uint64_t>(ownSeg), chunkWords);
        ExStatusSet(status, 0, 0xA2u);
        uint64_t iters = 0;
        uint64_t v = smem_shm_overlap_poll_flag(reinterpret_cast<__gm__ void *>(flagResult), &iters);
        ExStatusSet(status, 1, static_cast<uint32_t>(iters & 0xFFFFFFFFu));
        ExStatusSet(status, 2, static_cast<uint32_t>(v & 0xFFFFFFFFu));
        ExStatusSet(status, 0, (v != 0) ? 0xA3u : 0xEEu);
        return;
    }
    if (role == 3) { /* r1 单块: ④等到达 ⑤INC ⑥回程邮箱 */
        ExStatusSet(status, 0, 0xB0u);
        uint64_t iters = 0;
        uint64_t v = smem_shm_overlap_poll_flag(reinterpret_cast<__gm__ void *>(flagArrival), &iters);
        ExStatusSet(status, 1, static_cast<uint32_t>(iters & 0xFFFFFFFFu));
        ExStatusSet(status, 2, static_cast<uint32_t>(v & 0xFFFFFFFFu));
        if (v == 0) {
            ExStatusSet(status, 0, 0xEEu);
            return;
        }
        ExStatusSet(status, 0, 0xB1u);
        for (uint64_t i = 0; i < chunkWords; i++) {
            data[i] = data[i] + incVal;
        }
        ExCleanRegion(data, chunkWords);
        ExStatusSet(status, 0, 0xB2u);
        smem_shm_overlap_notify(mb, reinterpret_cast<uint64_t>(ownSeg), chunkWords);
        ExStatusSet(status, 0, 0xB3u);
        return;
    }
    if (role == 4) { /* r0 流水产: 逐 chunk 产+邮箱(生产流水) → 等最后一块结果 */
        ExStatusSet(status, 0, 0xD0u);
        for (uint32_t c = 0; c < chunks; c++) {
            ExFillChunk(data + static_cast<uint64_t>(c) * chunkWords, chunkWords, tag, c);
            ExCleanRegion(data + static_cast<uint64_t>(c) * chunkWords, chunkWords);
            smem_shm_overlap_notify(mb + c * SMEM_SHM_OVERLAP_WS_MAILBOX_SLOT_SIZE,
                                    reinterpret_cast<uint64_t>(ownSeg) +
                                        static_cast<uint64_t>(c) * chunkWords * 4,
                                    chunkWords);
        }
        ExStatusSet(status, 0, 0xD1u);
        /* FIFO 保序: 等最后一块结果标志即全部回程就绪 */
        uint64_t iters = 0;
        uint64_t v = smem_shm_overlap_poll_flag(
            reinterpret_cast<__gm__ void *>(flagResult + (chunks - 1)), &iters);
        ExStatusSet(status, 1, static_cast<uint32_t>(iters & 0xFFFFFFFFu));
        ExStatusSet(status, 2, static_cast<uint32_t>(v & 0xFFFFFFFFu));
        ExStatusSet(status, 0, (v != 0) ? 0xD2u : 0xEEu);
        return;
    }
    if (role == 5) { /* r1 流水消费: 逐 chunk 等到达 → INC → 回程邮箱 */
        ExStatusSet(status, 0, 0xE0u);
        for (uint32_t c = 0; c < chunks; c++) {
            uint64_t iters = 0;
            uint64_t v = smem_shm_overlap_poll_flag(
                reinterpret_cast<__gm__ void *>(flagArrival + c), &iters);
            if (v == 0) {
                ExStatusSet(status, 0, 0xEEu); /* chunk c 到达超时 */
                return;
            }
            __gm__ uint32_t *chunk = data + static_cast<uint64_t>(c) * chunkWords;
            for (uint64_t i = 0; i < chunkWords; i++) {
                chunk[i] = chunk[i] + incVal;
            }
            ExCleanRegion(chunk, chunkWords);
            smem_shm_overlap_notify(mb + c * SMEM_SHM_OVERLAP_WS_MAILBOX_SLOT_SIZE,
                                    reinterpret_cast<uint64_t>(ownSeg) +
                                        static_cast<uint64_t>(c) * chunkWords * 4,
                                    chunkWords);
        }
        ExStatusSet(status, 0, 0xE1u);
        return;
    }
}

/* ============================ host 侧 ============================ */
static void Step(const char *name, int32_t ret)
{
    if (ret != 0) {
        printf("[r%d FAIL] %-28s ret=%d\n", g_rank, name, ret);
        exit(1);
    }
    printf("[r%d OK]   %-28s\n", g_rank, name);
}

static double NowMs()
{
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
}

/* 双 rank 栅栏: MPI_Barrier(替代早期文件会合——原 /tmp 轮询有 1ms 粒度且留残留文件;
 * 串行对照的轮间会合语义不变: 等对端确认收到再发下一块, 防覆写 hazard) */
static void SyncPeer()
{
    MPI_Barrier(MPI_COMM_WORLD);
}

/* 清协同工作区邮箱 ring + kernel result(阶段间复用, 防旧值污染轮询) */
static void ResetWorkspace(void *ws)
{
    (void)aclrtMemset(ws, SMEM_SHM_OVERLAP_WS_SENTINEL_OFF, 0, SMEM_SHM_OVERLAP_WS_SENTINEL_OFF);
}

/* 一轮协同的 host 编排: 起 AICore kernel(role) + overlap 提交 + 双流同步
 * 返回该轮总耗时 ms; chunks>1 走多块流水, chunks=1 即单块
 * arrivalSlot/resultSlot: 本轮标志槽序号(轮次区分, 免清池内标志) */
static double RunOneRound(smem_shm_t shm, aclrtStream aiCoreStream, uint32_t role, uint32_t chunks,
                          uint64_t words, uint64_t ownSeg, uint64_t peerSeg, uint64_t flagBase,
                          uint64_t peerFlagBase, uint32_t arrivalSlot, uint32_t resultSlot, void *ws,
                          __gm__ uint32_t *status)
{
    ResetWorkspace(ws);
    (void)aclrtMemset(status, 64, 0, 64);
    const uint64_t ownArrival = flagBase + arrivalSlot * 8;
    const uint64_t ownResult = flagBase + resultSlot * 8;
    const uint64_t peerArrival = peerFlagBase + arrivalSlot * 8;
    const uint64_t peerResult = peerFlagBase + resultSlot * 8;
    const double t0 = NowMs();
    ex08Kernel<<<1, 0, aiCoreStream>>>(reinterpret_cast<uint8_t *>(ownSeg), EX_LOCAL_SIZE, words, role, chunks,
                                       EX_INC, EX_TAG, static_cast<uint8_t *>(ws),
                                       reinterpret_cast<uint64_t *>(ownArrival),
                                       reinterpret_cast<uint64_t *>(ownResult), status);
    void *dstGva = reinterpret_cast<void *>(peerSeg);
    /* 标志数组目的: r0 → 对端到达数组; r1 → 对端结果数组(kernel 内逐 chunk +8) */
    void *flagGva = reinterpret_cast<void *>((g_rank == 0) ? peerArrival : peerResult);
    Step("overlap_launch", smem_shm_overlap_launch(shm, dstGva, flagGva, chunks));
    Step("overlap_wait", smem_shm_overlap_wait(shm));
    Step("sync(aiCore)", aclrtSynchronizeStream(aiCoreStream));
    return NowMs() - t0;
}

int main(int argc, char *argv[])
{
    (void)argv; /* 参数不再使用: rank 由 MPI 分配(mpirun -np 2 拉起) */
    int mpiRet = MPI_Init(&argc, &argv); /* MPI 初始化(失败由 Step 统一报错) */
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank); /* 先取 rank, 步骤日志才能带 [rN] 前缀 */
    Step("MPI_Init", mpiRet);
    int worldSize = 0;
    MPI_Comm_size(MPI_COMM_WORLD, &worldSize);
    if (worldSize != 2) { /* 本示例固定 2-rank(同卡 die 对) */
        printf("expect exactly 2 ranks (mpirun -np 2), got %d\n", worldSize);
        MPI_Finalize();
        return 1;
    }
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1);

    /* ---- 建池(SHM + SDMA 位 → 310P 协同分支, 初始化含冒烟) ---- */
    Step("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    Step("smem_shm_config_init", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = (g_rank == 0);
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, static_cast<uint32_t>(g_rank),
                                        static_cast<uint16_t>(g_rank), &cfg));
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, 2, static_cast<uint32_t>(g_rank), EX_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) {
        printf("[r%d FAIL] smem_shm_create: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    Step("smem_shm_create(SDMA)", 0);
    const uint64_t symSize = smem_shm_get_symmetric_size(shm);
    const uint64_t ownSeg = reinterpret_cast<uint64_t>(gva) + symSize * g_rank;
    const uint64_t peerSeg = reinterpret_cast<uint64_t>(gva) + symSize * (1 - g_rank);
    /* 标志槽布局(保留区内按槽序号分区, 轮次区分免清池内标志):
     *   8~15: 阶段①流水到达数组   32~39: 阶段①流水结果数组
     *   64+r/96+r: 阶段②串行第 r 轮(到达/结果) */
    const uint64_t flagBase = ownSeg + EX_LOCAL_SIZE - 2UL * 1024UL * 1024UL;
    const uint64_t peerFlagBase = peerSeg + EX_LOCAL_SIZE - 2UL * 1024UL * 1024UL;
    void *ws = smem_shm_overlap_get_workspace(shm);
    if (ws == nullptr) {
        printf("[r%d FAIL] overlap not ready\n", g_rank);
        return 1;
    }
    printf("[r%d INFO] gva=%p symSize=0x%llx own=0x%llx peer=0x%llx\n", g_rank, gva,
           (unsigned long long)symSize, (unsigned long long)ownSeg, (unsigned long long)peerSeg);
    SyncPeer(); /* 会合: 双方建池完成 */

    /* 资源: 状态区 + AICore 流 */
    void *statusBuf = nullptr;
    if (aclrtMalloc(&statusBuf, 64, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMemset(statusBuf, 64, 0, 64) != ACL_SUCCESS) {
        printf("[r%d FAIL] status alloc\n", g_rank);
        return 1;
    }
    aclrtStream aiCoreStream = nullptr;
    (void)aclrtCreateStream(&aiCoreStream);

    /* ---- ① 多 chunk 流水(8×128KB) + 结果检查 ---- */
    double tPipe = 0;
    {
        uint32_t role = (g_rank == 0) ? 4u : 5u;
        tPipe = RunOneRound(shm, aiCoreStream, role, EX_CHUNKS, EX_CHUNK_WORDS, ownSeg, peerSeg, flagBase,
                            peerFlagBase, 8, 32, ws, static_cast<uint32_t *>(statusBuf));
        uint32_t mainRet = 0;
        uint32_t stage = 0;
        uint32_t headAfter = 0;
        Step("overlap_get_result", smem_shm_overlap_get_result(shm, &mainRet, &stage, &headAfter));
        uint32_t st[8] = {0};
        (void)aclrtMemcpy(st, sizeof(st), statusBuf, sizeof(st), ACL_MEMCPY_DEVICE_TO_HOST);
        printf("[r%d] ①流水(%u×%lluB): %.2fms status=0x%X pollIters=%u mainRet=%u head=%u\n", g_rank,
               EX_CHUNKS, (unsigned long long)EX_CHUNK_BYTES, tPipe, st[0], st[1], mainRet, headAfter);
        if (st[0] == 0xEEu || mainRet != 0) {
            printf("[r%d FAIL] ①流水异常\n", g_rank);
            return 1;
        }
    }
    SyncPeer(); /* 会合: 阶段①完成(双方流水结果就绪) */

    /* ---- 全量校验: r0 读 own 段 1MB, 每 chunk == (tag+c)<<24|i + INC ----
     * (校验须在阶段②之前: 串行阶段会复写第 0 块数据区) */
    int overall = 1;
    if (g_rank == 0) {
        const uint64_t total = EX_CHUNKS * EX_CHUNK_BYTES;
        uint32_t *host = static_cast<uint32_t *>(malloc(total));
        if (aclrtMemcpy(host, total, reinterpret_cast<void *>(ownSeg), total, ACL_MEMCPY_DEVICE_TO_HOST) !=
            ACL_SUCCESS) {
            printf("[r0 FAIL] D2H 全量读失败\n");
            overall = 0;
        } else {
            uint32_t bad = 0;
            for (uint32_t c = 0; c < EX_CHUNKS; c++) {
                for (uint32_t i = 0; i < EX_CHUNK_WORDS; i++) {
                    if (host[c * EX_CHUNK_WORDS + i] != (((EX_TAG + c) << 24) | i) + EX_INC) {
                        bad++;
                    }
                }
            }
            printf("[r0] ①流水终态数据 mismatch=%u/%llu → %s\n", bad,
                   (unsigned long long)(EX_CHUNKS * EX_CHUNK_WORDS), bad == 0 ? "PASS" : "FAIL");
            overall &= (bad == 0) ? 1 : 0;
        }
        free(host);
    }

    /* ---- ② 串行对照(chunks=1 × N, 无重叠): 每轮 128KB + 轮次槽 + 轮间会合 ---- */
    double tSerial = 0;
    {
        uint32_t role = (g_rank == 0) ? 2u : 3u;
        const double t0 = NowMs();
        for (uint32_t r = 0; r < EX_CHUNKS; r++) {
            (void)RunOneRound(shm, aiCoreStream, role, 1, EX_CHUNK_WORDS, ownSeg, peerSeg, flagBase,
                              peerFlagBase, 64 + r, 96 + r, ws, static_cast<uint32_t *>(statusBuf));
            /* 轮间会合: 串行语义 = 等对端确认收到再发下一块
             * (防 r1 提前覆写数据区与 r1→r0 回程 SDMA 的数据 hazard) */
            SyncPeer();
        }
        tSerial = NowMs() - t0;
        printf("[r%d] ②串行×%u: %.2fms\n", g_rank, EX_CHUNKS, tSerial);
    }

    /* ---- 掩盖量化: 串行总时延 vs 流水总时延 ---- */
    if (g_rank == 0) {
        printf("[r0] 掩盖量化: ②串行×%u=%.2fms vs ①流水=%.2fms → 加速比 %.2fx\n", EX_CHUNKS, tSerial,
               tPipe, tPipe > 0 ? tSerial / tPipe : 0.0);
    }

    (void)aclrtDestroyStream(aiCoreStream);
    (void)aclrtFree(statusBuf);
    Step("smem_shm_destroy", smem_shm_destroy(shm, 0));
    smem_shm_uninit(0);
    Step("smem_shm_uninit", 0);
    smem_uninit();
    Step("smem_uninit", 0);
    (void)aclrtResetDevice(g_rank);
    (void)aclFinalize();
    printf("=== EX08 r%d %s ===\n", g_rank, overall ? "PASS" : "FAIL");
    MPI_Finalize();
    return overall ? 0 : 1;
}
