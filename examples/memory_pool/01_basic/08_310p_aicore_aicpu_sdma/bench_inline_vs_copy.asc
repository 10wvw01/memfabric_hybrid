/* bench_inline_vs_copy — SDMA inline reduce 三路对比基准(多尺寸矩阵)
 *
 * 对比三条路径, 每条跑多个尺寸 × 多轮:
 *   A 纯搬运:   r0 signal → SDMA 复制 → r1 wait               (基线: 只搬不算)
 *   B 搬运+规约: r0 signal → SDMA 复制 → r1 wait → AICore 读改写加 (两步路径)
 *   C inline:   r0 signal(ADD_FP32) → SDMA 搬运同时加 → r1 wait   (一步路径)
 *
 * 口径: host 侧计时(kernel launch → sync), 含 launch/sync 固定开销;
 *      r1 侧耗时为主要指标(含等待+计算), r0 侧仅供参考(仅 signal+quiet)。
 */
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>
#include <unistd.h>
#include <mpi.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

#define STORE_URL "tcp://127.0.0.1:8587"
#define EX_LOCAL_SIZE (32UL * 1024UL * 1024UL)
#define MAX_WORDS (1024UL * 1024UL)      /* 最大 4MB fp32 */
/* 段内偏移: src(r0 产) / dst(r1 结果) / temp(r1 中转) */
#define OFF_SRC (4UL * 1024UL * 1024UL)
#define OFF_DST (8UL * 1024UL * 1024UL)
#define OFF_TEMP (12UL * 1024UL * 1024UL)
/* 模式 */
#define MODE_COPY_ONLY 0u    /* A: 纯搬运 */
#define MODE_COPY_AICORE 1u /* B: 搬运+AICore 规约 */
#define MODE_INLINE 2u       /* C: inline reduce */
#define N_MODES 3u
#define N_ROUNDS 3u           /* 每尺寸每模式有效轮次(计入统计) */
#define WARMUP_ROUNDS 2u       /* 预热轮(丢弃, 消除冷启动/TLB 偏差) */
#define N_SIZES 5u

/* 尺寸表(words=fp32 字数): 1K/16K/64K/256K/1M → 4KB/64KB/256KB/1MB/4MB */
static const uint64_t SIZE_WORDS[N_SIZES] = {1024, 16 * 1024, 64 * 1024, 256 * 1024, 1024 * 1024};
static const uint32_t SIZE_ITERS[N_SIZES] = {1000, 500, 200, 100, 25};
static const char *SIZE_LABELS[N_SIZES] = {"4KB", "64KB", "256KB", "1MB", "4MB"};
static const char *MODE_NAMES[N_MODES] = {"A_pure_copy", "B_copy+aicore", "C_inline_reduce"};

static int g_rank = -1;
static void Step(const char *name, int32_t ret)
{
    if (ret != 0) { printf("[r%d FAIL] %s ret=%d\n", g_rank, name, ret); exit(1); }
}
static double NowMs()
{
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
}
static void SyncPeer() { MPI_Barrier(MPI_COMM_WORLD); }

#define BENCH_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__
BENCH_AICORE_INLINE void CleanRegion(__gm__ uint8_t *base, uint64_t bytes)
{
    AscendC::GlobalTensor<int32_t> t;
    for (uint64_t off = 0; off < bytes; off += 64) {
        t.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(reinterpret_cast<uintptr_t>(base) + off), 16);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(t);
    }
}

extern "C" __global__ __aicore__ void benchKernel(__gm__ uint8_t *gva, uint64_t words, uint32_t mode,
                                                   uint32_t iters)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) return;
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    __gm__ uint8_t *ownSeg = gva + symm * rank;
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);
    smem_shm_sdma_ctx_t ctx = smem_shm_sdma_ctx(gva);

    if (rank == 0) {
        __gm__ float *src = reinterpret_cast<__gm__ float *>(ownSeg + OFF_SRC);
        for (uint64_t i = 0; i < words; i++) { src[i] = 1.0f; }
        CleanRegion(ownSeg + OFF_SRC, words * 4);
        for (uint32_t it = 0; it < iters; it++) {
            if (mode == MODE_INLINE) {
                (void)smem_shm_sdma_signal_at(ctx, src, peerSeg + OFF_DST, words * 4, it,
                                              SMEM_SHM_SDMA_OP_ADD_FP32);
            } else {
                (void)smem_shm_sdma_signal_at(ctx, src, peerSeg + OFF_TEMP, words * 4, it);
            }
        }
        (void)smem_shm_sdma_quiet_at(ctx);
        return;
    }
    __gm__ float *dst = reinterpret_cast<__gm__ float *>(ownSeg + OFF_DST);
    __gm__ float *temp = reinterpret_cast<__gm__ float *>(ownSeg + OFF_TEMP);
    for (uint32_t it = 0; it < iters; it++) {
        smem_shm_sdma_mail_t m = smem_shm_sdma_wait_peer_at(ctx, 0);
        if (m.status != SMEM_SHM_SDMA_MAIL_OK) return;
        if (mode == MODE_COPY_AICORE) {
            for (uint64_t i = 0; i < words; i++) { dst[i] = dst[i] + temp[i]; }
            CleanRegion(ownSeg + OFF_DST, words * 4);
        }
    }
}

int main(int argc, char *argv[])
{
    (void)argv;
    MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank);
    int ws = 0; MPI_Comm_size(MPI_COMM_WORLD, &ws);
    if (ws != 2) { printf("need mpirun -np 2\n"); MPI_Finalize(); return 1; }
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1);
    Step("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    Step("cfg_init", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = (g_rank == 0);
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, g_rank, g_rank, &cfg));
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, 2, g_rank, EX_LOCAL_SIZE, SMEMS_DATA_OP_SDMA, 0, &gva);
    if (!shm || !gva) { printf("[r%d FAIL] create: %s\n", g_rank, smem_get_last_err_msg()); return 1; }
    if (!smem_shm_sdma_get_workspace(shm)) { printf("[r%d FAIL] not ready\n", g_rank); return 1; }
    SyncPeer();
    aclrtStream stream = nullptr; aclrtCreateStream(&stream);
    const uint64_t symmH = smem_shm_get_symmetric_size(shm);
    uint8_t *ownH = static_cast<uint8_t *>(gva) + symmH * g_rank;
    static float preset[MAX_WORDS];
    static float result[MAX_WORDS];

    if (g_rank == 0) printf("size,mode,round,iters,r1_us_per_iter,r1_mismatch\n");
    for (uint32_t si = 0; si < N_SIZES; si++) {
        const uint64_t words = SIZE_WORDS[si];
        const uint32_t iters = SIZE_ITERS[si];
        /* 交错执行: 每轮 A→B→C 轮流(消除执行顺序偏差), 前几轮丢弃 */
        for (uint32_t round = 0; round < N_ROUNDS + WARMUP_ROUNDS; round++) {
            for (uint32_t mode = 0; mode < N_MODES; mode++) {
                const bool warmup = (round < WARMUP_ROUNDS);
                if (g_rank == 1) {
                    for (uint64_t i = 0; i < words; i++) preset[i] = 100.0f;
                    (void)aclrtMemcpy(ownH + OFF_DST, words * 4, preset, words * 4, ACL_MEMCPY_HOST_TO_DEVICE);
                }
                SyncPeer();
                const double t0 = NowMs();
                benchKernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva), words, mode, iters);
                Step("sync", aclrtSynchronizeStream(stream));
                const double dt = NowMs() - t0;
                SyncPeer();
                if (g_rank == 1 && !warmup) { /* 预热轮不计入 */
                    uint32_t bad = 0;
                    (void)aclrtMemcpy(result, words * 4, ownH + OFF_DST, words * 4,
                                      ACL_MEMCPY_DEVICE_TO_HOST);
                    float expect = (mode == MODE_COPY_ONLY) ? 100.0f : 100.0f + iters;
                    for (uint64_t i = 0; i < words; i++) if (result[i] != expect) bad++;
                    printf("%s,%s,%u,%u,%.1f,%u\n", SIZE_LABELS[si], MODE_NAMES[mode],
                           round - WARMUP_ROUNDS, iters, dt / iters * 1000, bad);
                }
            }
        }
    }
    (void)aclrtDestroyStream(stream);
    smem_shm_destroy(shm, 0); smem_shm_uninit(0); smem_uninit();
    (void)aclrtResetDevice(g_rank); (void)aclFinalize();
    printf("=== BENCH r%d DONE ===\n", g_rank);
    MPI_Finalize();
    return 0;
}
