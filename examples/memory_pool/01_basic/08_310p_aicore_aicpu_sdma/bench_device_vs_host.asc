/* bench_device_vs_host — 设备发起 vs host 编排 每次搬运纯通信时延
 *
 * 计时口径:
 *   设备发起: kernel 内连发 N 封 signal/wait(AICPU 全程在忙, 无空闲唤醒),
 *             总时 / N = 每封纯通信时延(signal + AICPU 消费 + SQE + SDMA + 完成)
 *             → 减去 baseDev(kernel launch/sync) 和 AICPU 空闲唤醒(稳态下不存在)
 *   host 编排: 每轮 memcpyAsync + sync(sync 是 host 路径固有成本, 不减)
 *
 * 两者都减去了不是通信的部分(设备: launch+sync+唤醒; host: 无可减项)。
 */
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <unistd.h>
#include <mpi.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

#define STORE_URL "tcp://127.0.0.1:8588"
#define EX_LOCAL_SIZE (32UL * 1024UL * 1024UL)
#define OFF_SRC (4UL * 1024UL * 1024UL)
#define OFF_DST (8UL * 1024UL * 1024UL)
#define N_ITERS 100u    /* 设备 kernel 内连发封数(一次 launch, AICPU 保持忙) */
#define N_HOST 100u     /* host 每轮 memcpyAsync+sync, 重复次数 */
#define WARMUP 5u
#define N_SIZES 5u

static const uint64_t SZ_WORDS[N_SIZES] = {1024, 16*1024, 64*1024, 256*1024, 1024*1024};
static const char *SZ_LABELS[N_SIZES] = {"4KB", "64KB", "256KB", "1MB", "4MB"};

static int g_rank = -1;
static void Step(const char *n, int32_t r)
{
    if (r != 0) { printf("[r%d FAIL] %s ret=%d\n", g_rank, n, r); exit(1); }
}
static double NowMs()
{
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
}
static void SyncPeer() { MPI_Barrier(MPI_COMM_WORLD); }

/* 空 kernel(测 launch+sync 基线) */
extern "C" __global__ __aicore__ void emptyKernel(__gm__ uint8_t *gva)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    (void)gva;
}

/* 设备发起 kernel: r0 连发 N 封 signal + 末尾 quiet; r1 连收 N 封 wait
 * N 封在 kernel 内连续发出 → AICPU 全程在忙, 无空闲唤醒延迟 */
extern "C" __global__ __aicore__ void devCommKernel(__gm__ uint8_t *gva, uint64_t bytes, uint32_t n)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) return;
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    __gm__ uint8_t *ownSeg = gva + symm * rank;
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);
    smem_shm_sdma_ctx_t ctx = smem_shm_sdma_ctx(gva);
    if (rank == 0) {
        for (uint32_t i = 0; i < n; i++) {
            (void)smem_shm_sdma_signal_at(ctx, ownSeg + OFF_SRC, peerSeg + OFF_DST, bytes, i);
        }
        (void)smem_shm_sdma_quiet_at(ctx); /* 等 N 封全部落地(一次 quiet) */
        return;
    }
    for (uint32_t i = 0; i < n; i++) { /* r1: 收齐 N 封到达邮件 */
        smem_shm_sdma_mail_t m = smem_shm_sdma_wait_peer_at(ctx, 0);
        if (m.status != SMEM_SHM_SDMA_MAIL_OK) return;
    }
}

/* 预填 kernel */
extern "C" __global__ __aicore__ void prefillKernel(__gm__ uint8_t *gva, uint64_t words)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) return;
    const uint32_t rank = smem_shm_get_global_rank(0);
    if (rank != 0) return;
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    __gm__ uint32_t *src = reinterpret_cast<__gm__ uint32_t *>(gva + symm * rank + OFF_SRC);
    for (uint64_t i = 0; i < words; i++) { src[i] = static_cast<uint32_t>(i); }
    AscendC::GlobalTensor<int32_t> t;
    for (uint64_t off = 0; off < words * 4; off += 64) {
        t.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(
            reinterpret_cast<uintptr_t>(src) + off), 16);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(t);
    }
}

int main(int argc, char *argv[])
{
    (void)argv;
    MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank);
    int ws = 0; MPI_Comm_size(MPI_COMM_WORLD, &ws);
    if (ws != 2) { printf("need mpirun -np 2\n"); MPI_Finalize(); return 1; }
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1);
    Step("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    Step("cfg", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = (g_rank == 0);
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, g_rank, g_rank, &cfg));
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, 2, g_rank, EX_LOCAL_SIZE, SMEMS_DATA_OP_SDMA, 0, &gva);
    if (!shm || !gva) { printf("[r%d FAIL] create\n", g_rank); return 1; }
    if (!smem_shm_sdma_get_workspace(shm)) { printf("[r%d FAIL] not ready\n", g_rank); return 1; }
    SyncPeer();
    aclrtStream stream = nullptr; aclrtCreateStream(&stream);
    const uint64_t symmH = smem_shm_get_symmetric_size(shm);
    uint8_t *srcH = static_cast<uint8_t *>(gva) + OFF_SRC;
    uint8_t *dstH = static_cast<uint8_t *>(gva) + symmH + OFF_DST;
    static uint32_t result[1024*1024];

    prefillKernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva), SZ_WORDS[N_SIZES-1]);
    Step("prefill", aclrtSynchronizeStream(stream));
    SyncPeer();

    /* baseDev: 空 kernel launch + sync(不是通信成本, 从设备路径减去) */
    double baseDev = 0;
    for (uint32_t it = 0; it < WARMUP + N_ITERS; it++) {
        SyncPeer();
        const double t0 = NowMs();
        emptyKernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva));
        Step("sync", aclrtSynchronizeStream(stream));
        if (it >= WARMUP) baseDev += NowMs() - t0;
    }
    baseDev /= N_ITERS;
    SyncPeer();

    if (g_rank == 0) printf("size,n,dev_us_per_iter,host_us_per_iter\n");
    for (uint32_t si = 0; si < N_SIZES; si++) {
        const uint64_t bytes = SZ_WORDS[si] * 4;
        double sumDev = 0, sumHost = 0;
        for (uint32_t round = 0; round < WARMUP + 3; round++) {
            SyncPeer();
            /* 设备发起: 一次 launch, kernel 内连发 N 封 → AICPU 全程在忙(无唤醒),
             * 总时 / N = 每封纯通信时延(含 signal + AICPU消费 + SQE + SDMA + 完成) */
            double t0 = NowMs();
            devCommKernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva), bytes, N_ITERS);
            Step("sync", aclrtSynchronizeStream(stream));
            double tDev = NowMs() - t0;
            SyncPeer();

            /* host 编排: 每轮 memcpyAsync + sync(sync 是固有成本, 不减任何基线) */
            for (uint32_t i = 0; i < N_HOST; i++) {
                t0 = NowMs();
                Step("memcpy", aclrtMemcpyAsync(dstH, bytes, srcH, bytes,
                                                 ACL_MEMCPY_DEVICE_TO_DEVICE, stream));
                Step("sync", aclrtSynchronizeStream(stream));
                if (round >= WARMUP) sumHost += NowMs() - t0;
            }
            if (round >= WARMUP) sumDev += tDev;
        }
        SyncPeer();
        if (g_rank == 0) {
            /* 设备: 减 baseDev(launch+sync), 除以 N 封 → 每封纯通信
             * host: 不减(sync 固有), 除以 N 次 → 每次全量通信 */
            double devPer = (sumDev / 3.0 - baseDev) / N_ITERS * 1000;
            double hostPer = sumHost / (3.0 * N_HOST) * 1000;
            printf("%s,%u,%.1f,%.1f\n", SZ_LABELS[si], N_ITERS, devPer, hostPer);
        }
        SyncPeer();
        if (g_rank == 0) { /* 校验 */
            (void)aclrtMemcpy(result, bytes, dstH, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
            uint32_t bad = 0;
            for (uint64_t i = 0; i < SZ_WORDS[si]; i++)
                if (result[i] != static_cast<uint32_t>(i)) bad++;
            if (bad) printf("# %s verify FAIL mismatch=%u\n", SZ_LABELS[si], bad);
        }
    }
    if (g_rank == 0) {
        printf("# baseDev(empty kernel+sync)=%.1f us\n", baseDev * 1000);
        printf("# device: kernel-internal N=%d signal/wait batch, AICPU stays busy (no wake-up)\n", N_ITERS);
        printf("# host: per-call memcpyAsync+sync, sync is inherent (not subtracted)\n");
        printf("# all done\n");
    }
    (void)aclrtDestroyStream(stream);
    smem_shm_destroy(shm, 0); smem_shm_uninit(0); smem_uninit();
    (void)aclrtResetDevice(g_rank); (void)aclFinalize();
    MPI_Finalize();
    return 0;
}
