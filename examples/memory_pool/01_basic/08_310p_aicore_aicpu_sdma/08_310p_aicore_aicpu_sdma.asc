/* 08_310p_aicore_aicpu_sdma — 310P 单卡双 die 2-rank AICore×AICPU 协同示例(V5 邮箱化)
 *
 * 场景: 双 rank(dev0/dev1)SHM 池上, AICore kernel 内 signal 投递搬运请求 →
 * AICPU epoch 消费 kernel 代投 SDMA SQE → 对端 AICore wait 按序收件消费(读改写 INC)
 * → 回程 signal 返回 → 原端 wait 收件。全程设备侧自驱, host 仅建池/起 kernel/收结果。
 *
 * 两阶段验收:
 *   ① 多 chunk 流水(8×128KB): 数据逐字校验 mismatch=0 —— 功能正确性
 *   ② 串行 N 次(逐块 signal→wait→回件): 总时延 —— 无重叠对照
 *
 * V5 用户负担清零验证: kernel 签名与 910B RDMADemo 同构(仅 gva 参数); 无槽位算术/
 * 无标志地址方案/无清邮箱/无 role 与 ws 传参/无 host submit——全部由 memfabric 托管。
 *
 * 双 rank 会合与栅栏: MPI_Barrier(mpirun -np 2 拉起, rank 由 MPI 分配)。
 */
#include <chrono>   // 计时(steady_clock)
#include <cstdio>   // printf
#include <cstdlib>  // malloc/free/exit
#include <cstdint>  // 定宽整型
#include <mpi.h>    // MPI(双 rank 拉起/栅栏)
#include "acl/acl.h"      // ACL 运行时(初始化/流/内存)
#include "acl/acl_rt.h"   // aclrt* 接口
#include "kernel_operator.h" // AscendC 原语(cache 维护)
#include "smem.h"     // smem_init/uninit
#include "smem_shm.h" // SHM API(建池)
#include "smem_shm_aicore_base_sdma.h" // V5 设备侧邮箱 API(signal/wait/quiet)

#define STORE_URL "tcp://127.0.0.1:8581" /* 配置存储地址 */
#define EX_LOCAL_SIZE (32UL * 1024UL * 1024UL) /* 每 rank 物理贡献 32MB */
#define EX_CHUNKS 8u                           /* 流水 chunk 数 */
#define EX_CHUNK_BYTES (128UL * 1024UL)         /* 每 chunk 128KB */
#define EX_CHUNK_WORDS (EX_CHUNK_BYTES / 4u)    /* 每 chunk 字数 */
#define EX_INC 0x100u                           /* r1 AICore 增量 */
#define EX_TAG 0x8Bu                           /* pattern 标识 */

static int g_rank = -1; /* 本进程 rank(0/1) */

/* ============================ AICore kernel(设备头原语) ============================ */
#define EX_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__ /* AICore 内联属性 */

EX_AICORE_INLINE void ExCleanRegion(__gm__ uint32_t *base, uint64_t words) // 大块数据 clean
{
    AscendC::GlobalTensor<int32_t> gm; // GM 张量(供 cache 指令寻址)
    const uint64_t bytes = words * 4;  // 总字节数
    /* 逐 64B 行 clean(只刷目标区域, 不扰动整个数据缓存——用户模板代码的推荐姿势) */
    for (uint64_t off = 0; off < bytes; off += 64) { // 逐行推进
        gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(reinterpret_cast<uintptr_t>(base) + off), 16); // 绑定该行
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(gm); // 单行 clean
    }
}

/* 产一个 chunk 的 pattern(chunk 内含 chunk 序号, 校验可溯源) */
EX_AICORE_INLINE void ExFillChunk(__gm__ uint32_t *chunkBase, uint64_t words, uint32_t tag, uint32_t chunkIdx)
{
    for (uint64_t i = 0; i < words; i++) { // 逐字填 pattern
        chunkBase[i] = ((tag + chunkIdx) << 24) | static_cast<uint32_t>(i); // pattern 公式(含 chunk 序号)
    }
}

/* 协同 AICore kernel(V5 邮箱化, 两角色按 rank 自取——与 RDMADemo 同构):
 *   rank0 产: 逐 chunk 产+signal → quiet 等全部落地 → wait 收回件(终态=原值+INC)
 *   rank1 消费: 循环 wait 收件 → 读改写 INC → clean → signal 回件(imm=件序号回带)
 * 两阶段(①流水 8 chunk / ②串行逐块)共用本 kernel, 仅 chunks 参数不同 */
extern "C" __global__ __aicore__ void ex08Kernel(__gm__ uint8_t *gva, uint64_t chunkWords, uint32_t chunks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE); // 声明 AICore 任务类型
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单 block 纪律 */
    }
    const uint32_t rank = smem_shm_get_global_rank(0);    /* 本端 rank(meta 自取) */
    const uint64_t symm = smem_shm_get_symmetric_size(0); /* 对称段大小(meta 自取) */
    __gm__ uint8_t *ownSeg = gva + symm * rank;           /* 本端段基址(指针算术) */
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);    /* 对端段基址(对称算术) */
    __gm__ uint32_t *data = reinterpret_cast<__gm__ uint32_t *>(ownSeg); // 本端数据区
    /* 保留区基址入口一次预计算(免每封 signal/wait 3 次 meta 读, _at 变体复用) */
    __gm__ uint8_t *sdmaRes = smem_shm_sdma_reserved(gva); /* 邮箱保留区基址 */

    if (rank == 0) { /* r0 产: 逐 chunk 产+投递 → quiet → 收回件 */
        for (uint32_t c = 0; c < chunks; c++) { // 逐 chunk 生产流水
            __gm__ uint32_t *chunk = data + static_cast<uint64_t>(c) * chunkWords; // 第 c 块
            ExFillChunk(chunk, chunkWords, EX_TAG, c); // 产第 c 块
            ExCleanRegion(chunk, chunkWords); // clean 后 SDMA 可见
            /* 投递搬运请求(源=本端第 c 块, 目的=对端第 c 块; imm=chunk 序号) */
            (void)smem_shm_sdma_signal_at(sdmaRes, chunk, peerSeg + static_cast<uint64_t>(c) * chunkWords * 4,
                                       chunkWords * 4, c); /* 目的=对端段+c 块字节偏移 */
        }
        (void)smem_shm_sdma_quiet_at(sdmaRes); // 等全部落地(源缓冲语义上可复用)
        /* 收回件: r1 的 INC 结果逐件回传(件数=chunks, imm 回带原 chunk 序号) */
        for (uint32_t c = 0; c < chunks; c++) { // 逐件收件
            smem_shm_sdma_mail_t m = smem_shm_sdma_wait_at(sdmaRes); // 按序收件(阻塞)
            (void)m; // 校验由 host D2H 逐字比对承担(数据即真相)
        }
        return;
    }
    /* r1 消费: 循环收件 → INC → 回件(件数=chunks, imm=件序号) */
    for (uint32_t c = 0; c < chunks; c++) { // 逐件消费
        smem_shm_sdma_mail_t m = smem_shm_sdma_wait_at(sdmaRes); // 按序收件(邮件自描述落点)
        if (m.status != SMEM_SHM_SDMA_MAIL_OK) { // 收件异常(超时/溢出)
            return; /* 异常即退(host 侧校验暴露 */
        }
        __gm__ uint32_t *chunk = reinterpret_cast<__gm__ uint32_t *>(m.dst); // 数据落点(免预约定布局)
        for (uint64_t i = 0; i < m.len / 4; i++) { // 读改写 INC(长度按邮件自描述)
            chunk[i] = chunk[i] + EX_INC; // INC 增量
        }
        ExCleanRegion(chunk, m.len / 4); // clean 后 SDMA 可见
        /* 回件: 源=本端 INC 后块, 目的=对端(imm=原 chunk 序号, 回带对账) */
        (void)smem_shm_sdma_signal_at(sdmaRes, chunk,
                                   reinterpret_cast<__gm__ uint8_t *>(peerSeg) +
                                       static_cast<uint64_t>(m.imm) * chunkWords * 4,
                                   m.len, m.imm); /* 回件目的=对端段+原块字节偏移 */
    }
}

/* ============================ host 侧(V5: 仅建池/起 kernel/收结果) ============================ */
static void Step(const char *name, int32_t ret) // 步骤断言(失败即退出)
{
    if (ret != 0) { // 返回非 0
        printf("[r%d FAIL] %-28s ret=%d\n", g_rank, name, ret); // 打印失败步骤与错误码
        exit(1); // 失败退出
    }
    printf("[r%d OK]   %-28s\n", g_rank, name); // 打印成功步骤
}

static double NowMs() // 当前毫秒数(steady_clock)
{
    // 稳定时钟换算毫秒
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
}

/* 双 rank 栅栏(初始化会合/阶段栅栏/串行轮间会合共用) */
static void SyncPeer()
{
    MPI_Barrier(MPI_COMM_WORLD); // 全体到齐才放行(单机共享内存实现, 微秒级)
}

/* 起一轮 AICore kernel 并同步返回(用户 kernel 仅 gva/块参数, V5 零协同参数) */
static double RunAicore(aclrtStream stream, void *gva, uint32_t chunks)
{
    const double t0 = NowMs(); // 计时起点
    ex08Kernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva), EX_CHUNK_WORDS, chunks); // 起 kernel
    Step("sync(aiCore)", aclrtSynchronizeStream(stream)); // 等全部 signal/wait/quiet 完成
    return NowMs() - t0; // 返回本轮耗时(ms)
}

// 示例入口: rank 由 MPI 分配(mpirun -np 2 拉起)
int main(int argc, char *argv[])
{
    (void)argv;
    int mpiRet = MPI_Init(&argc, &argv); // MPI 初始化
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank); // 先取 rank, 步骤日志才能带 [rN] 前缀
    Step("MPI_Init", mpiRet);
    int worldSize = 0; // 进程总数暂存
    MPI_Comm_size(MPI_COMM_WORLD, &worldSize); // 读进程总数
    if (worldSize != 2) { /* 本示例固定 2-rank(同卡 die 对) */
        printf("expect exactly 2 ranks (mpirun -np 2), got %d\n", worldSize); // 规模提示
        MPI_Finalize(); // 收尾后退出
        return 1; // 规模错误退出
    }
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1); // ACL 初始化

    /* ---- 建池(SHM + SDMA 位 → 310P 协同自动启用, 段尾保留区+epoch 监督线程就位) ---- */
    Step("smem_init", smem_init(0)); // smem 初始化
    smem_shm_config_t cfg; // SHM 配置结构
    Step("smem_shm_config_init", smem_shm_config_init(&cfg)); // 配置初始化
    cfg.startConfigStoreServer = (g_rank == 0); // r0 起配置存储
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, static_cast<uint32_t>(g_rank), // SHM 全局初始化
                                        static_cast<uint16_t>(g_rank), &cfg));
    void *gva = nullptr; // 池 GVA 出参
    smem_shm_t shm = smem_shm_create(0, 2, static_cast<uint32_t>(g_rank), EX_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) { // 建池失败
        printf("[r%d FAIL] smem_shm_create: %s\n", g_rank, smem_get_last_err_msg()); // 错误详情
        return 1; // 失败退出
    }
    Step("smem_shm_create(SDMA)", 0); // 建池成功标记
    if (smem_shm_sdma_get_workspace(shm) == nullptr) { // 协同未就绪(初始化失败)
        printf("[r%d FAIL] sdma orchestration not ready\n", g_rank); // 失败提示
        return 1; // 失败退出
    }
    printf("[r%d INFO] gva=%p\n", g_rank, gva);
    SyncPeer(); /* 会合: 双方建池完成(保留区清零+监督线程就位) */

    aclrtStream stream = nullptr; // AICore 流句柄
    (void)aclrtCreateStream(&stream); // 创建 AICore 流

    /* ---- ① 多 chunk 流水(8×128KB, 全程设备侧自驱) ---- */
    double tPipe = 0; // 阶段①耗时(ms)
    {
        tPipe = RunAicore(stream, gva, EX_CHUNKS); // 一轮 kernel(8 chunk 流水)
        SyncPeer(); /* 会合: 双方流水完成(回件全落) */
    }

    /* ---- 全量校验: r0 读 own 段 1MB, 每 chunk == (tag+c)<<24|i + INC ---- */
    int overall = 1; // 总判定(1=PASS)
    if (g_rank == 0) { // r0 负责全量校验
        const uint64_t total = EX_CHUNKS * EX_CHUNK_BYTES; // 总字节数(1MB)
        uint32_t *host = static_cast<uint32_t *>(malloc(total)); // host 读回缓冲
        // D2H 全量读回本端段
        if (aclrtMemcpy(host, total, gva, total, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            printf("[r0 FAIL] D2H 全量读失败\n"); // 读失败提示
            overall = 0; // 判 FAIL
        } else { // 读回成功
            uint32_t bad = 0; // 失配计数
            for (uint32_t c = 0; c < EX_CHUNKS; c++) { // 逐 chunk 校验
                uint32_t cbad = 0; // 本 chunk 失配数
                for (uint32_t i = 0; i < EX_CHUNK_WORDS; i++) { // 逐字校验
                    if (host[c * EX_CHUNK_WORDS + i] != (((EX_TAG + c) << 24) | i) + EX_INC) { // 期望值公式
                        bad++; // 失配计数
                        cbad++; // 本 chunk 计数
                    }
                }
                if (cbad != 0) { // 本 chunk 有失配: 打印样本定位
                    printf("[r0] chunk %u bad=%u: [0]=0x%x [1]=0x%x [2]=0x%x expect[0]=0x%x\n", c, cbad,
                           host[c * EX_CHUNK_WORDS], host[c * EX_CHUNK_WORDS + 1], host[c * EX_CHUNK_WORDS + 2],
                           (((EX_TAG + c) << 24)) + EX_INC);
                }
            }
            // 打印校验结果
            printf("[r0] ①流水终态数据 mismatch=%u/%llu → %s\n", bad,
                   (unsigned long long)(EX_CHUNKS * EX_CHUNK_WORDS), bad == 0 ? "PASS" : "FAIL");
            overall &= (bad == 0) ? 1 : 0; // 零失配才 PASS
        }
        free(host); // 释放读回缓冲
    }

    /* ---- ② 串行对照(逐块 signal→wait→回件, 无重叠) ---- */
    double tSerial = 0; // 阶段②总耗时(ms)
    {
        const double t0 = NowMs(); // 串行总计时起点
        for (uint32_t r = 0; r < EX_CHUNKS; r++) { // N 轮串行
            (void)RunAicore(stream, gva, 1); // 一轮(单块闭环)
            SyncPeer(); // 本轮双端到齐才进下一轮
        }
        tSerial = NowMs() - t0; // 串行总耗时
        printf("[r%d] ②串行×%u: %.2fms\n", g_rank, EX_CHUNKS, tSerial); // 打印②
    }

    /* ---- 掩盖量化: 串行总时延 vs 流水总时延 ---- */
    if (g_rank == 0) { // r0 输出加速比
        // 打印掩盖量化(串行 vs 流水加速比)
        printf("[r0] 掩盖量化: ②串行×%u=%.2fms vs ①流水=%.2fms → 加速比 %.2fx\n", EX_CHUNKS, tSerial,
               tPipe, tPipe > 0 ? tSerial / tPipe : 0.0);
    }

    (void)aclrtDestroyStream(stream); // 销毁 AICore 流
    Step("smem_shm_destroy", smem_shm_destroy(shm, 0)); // 销毁池(监督线程停止, 资源计数-1)
    smem_shm_uninit(0); // SHM 反初始化
    Step("smem_shm_uninit", 0); // 标记成功
    smem_uninit(); // smem 反初始化
    Step("smem_uninit", 0); // 标记成功
    (void)aclrtResetDevice(g_rank); // 复位设备
    (void)aclFinalize(); // ACL 收尾
    printf("=== EX08 r%d %s ===\n", g_rank, overall ? "PASS" : "FAIL"); // 打印总判定
    MPI_Finalize(); // MPI 收尾
    return overall ? 0 : 1; // PASS 返回 0
}
