/* 08_310p_aicore_aicpu_sdma — 310P 单卡双 die 2-rank AICore×AICPU 协同示例(邮箱化)
 *
 * 场景: 双 rank(dev0/dev1)SHM 池上, AICore kernel 内 signal 投递搬运请求 →
 * AICPU epoch 消费 kernel 代投 SDMA SQE → 对端 AICore wait 按序收件消费(读改写 INC)
 * → 回程 signal 返回 → 原端 wait 收件。全程设备侧自驱, host 仅建池/起 kernel/收结果。
 *
 * 两阶段验收:
 *   ① 多 chunk 流水(8×128KB): 数据逐字校验 mismatch=0 —— 功能正确性
 *   ② 串行 N 次(逐块 signal→wait→回件): 总时延 —— 无重叠对照
 *
 * 用户负担清零验证: kernel 签名与 910B RDMADemo 同构(仅 gva 参数); 无槽位算术/
 * 无标志地址方案/无清邮箱/无 role 与 ws 传参/无 host submit——全部由 memfabric 托管。
 *
 * 双 rank 会合与栅栏: MPI_Barrier(mpirun -np 2 拉起, rank 由 MPI 分配)。
 */
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <mpi.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

#define STORE_URL "tcp://127.0.0.1:8581" /* 配置存储地址 */
#define EX_LOCAL_SIZE (32UL * 1024UL * 1024UL) /* 每 rank 物理贡献 32MB */
#define EX_CHUNKS 8u                           /* 流水 chunk 数 */
#define EX_CHUNK_BYTES (128UL * 1024UL)         /* 每 chunk 128KB */
#define EX_CHUNK_WORDS (EX_CHUNK_BYTES / 4u)    /* 每 chunk 字数 */
#define EX_INC 0x100u                           /* r1 AICore 增量 */
#define EX_TAG 0x8Bu                           /* pattern 标识 */

static int g_rank = -1; /* 本进程 rank(0/1) */

/* ============================ AICore kernel(设备头原语) ============================ */
#define EX_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__ /* AICore 内联属性 */

EX_AICORE_INLINE void ExCleanRegion(__gm__ uint32_t *base, uint64_t words)
{
    AscendC::GlobalTensor<int32_t> gm;
    const uint64_t bytes = words * 4;
    /* 逐 64B 行 clean(只刷目标区域, 不扰动整个数据缓存——用户模板代码的推荐姿势) */
    for (uint64_t off = 0; off < bytes; off += 64) {
        gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(reinterpret_cast<uintptr_t>(base) + off), 16);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(gm);
    }
}

/* 产一个 chunk 的 pattern(chunk 内含 chunk 序号, 校验可溯源) */
EX_AICORE_INLINE void ExFillChunk(__gm__ uint32_t *chunkBase, uint64_t words, uint32_t tag, uint32_t chunkIdx)
{
    for (uint64_t i = 0; i < words; i++) {
        chunkBase[i] = ((tag + chunkIdx) << 24) | static_cast<uint32_t>(i);
    }
}

/* 协同 AICore kernel(邮箱化, 两角色按 rank 自取——与 RDMADemo 同构):
 *   rank0 产: 逐 chunk 产+signal → quiet 等全部落地 → wait 收回件(终态=原值+INC)
 *   rank1 消费: 循环 wait 收件 → 读改写 INC → clean → signal 回件(imm=件序号回带)
 * 两阶段(①流水 8 chunk / ②串行逐块)共用本 kernel, 仅 chunks 参数不同 */
extern "C" __global__ __aicore__ void ex08Kernel(__gm__ uint8_t *gva, uint64_t chunkWords, uint32_t chunks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE); // 声明 AICore 任务类型
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单 block 纪律 */
    }
    const uint32_t rank = smem_shm_get_global_rank(0);    /* 本端 rank(meta 自取) */
    const uint64_t symm = smem_shm_get_symmetric_size(0); /* 对称段大小(meta 自取) */
    __gm__ uint8_t *ownSeg = gva + symm * rank;           /* 本端段基址(指针算术) */
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);    /* 对端段基址(对称算术) */
    __gm__ uint32_t *data = reinterpret_cast<__gm__ uint32_t *>(ownSeg);
    /* 保留区基址入口一次预计算(免每封 signal/wait 3 次 meta 读, _at 变体复用) */
    __gm__ uint8_t *sdmaRes = smem_shm_sdma_reserved(gva);

    if (rank == 0) { /* r0 产: 逐 chunk 产+投递 → quiet → 收回件 */
        for (uint32_t c = 0; c < chunks; c++) {
            __gm__ uint32_t *chunk = data + static_cast<uint64_t>(c) * chunkWords;
            ExFillChunk(chunk, chunkWords, EX_TAG, c);
            ExCleanRegion(chunk, chunkWords); // clean 后 SDMA 可见
            /* 投递搬运请求(源=本端第 c 块, 目的=对端第 c 块; imm=chunk 序号) */
            (void)smem_shm_sdma_signal_at(sdmaRes, chunk,
                                       peerSeg + static_cast<uint64_t>(c) * chunkWords * 4, chunkWords * 4, c);
        }
        (void)smem_shm_sdma_quiet_at(sdmaRes); // 等全部落地(源缓冲语义上可复用)
        for (uint32_t c = 0; c < chunks; c++) { // 收回件(校验由 host D2H 逐字比对承担)
            smem_shm_sdma_mail_t m = smem_shm_sdma_wait_at(sdmaRes);
            (void)m;
        }
        return;
    }
    /* r1 消费: 循环收件 → INC → 回件(件数=chunks, imm=件序号) */
    for (uint32_t c = 0; c < chunks; c++) {
        smem_shm_sdma_mail_t m = smem_shm_sdma_wait_at(sdmaRes); // 按序收件(邮件自描述落点)
        if (m.status != SMEM_SHM_SDMA_MAIL_OK) {
            return; /* 异常即退(host 侧校验暴露) */
        }
        __gm__ uint32_t *chunk = reinterpret_cast<__gm__ uint32_t *>(m.dst); // 数据落点(免预约定布局)
        for (uint64_t i = 0; i < m.len / 4; i++) {
            chunk[i] = chunk[i] + EX_INC;
        }
        ExCleanRegion(chunk, m.len / 4); // clean 后 SDMA 可见
        /* 回件: 源=本端 INC 后块, 目的=对端(imm=原 chunk 序号, 回带对账) */
        (void)smem_shm_sdma_signal_at(sdmaRes, chunk,
                                   reinterpret_cast<__gm__ uint8_t *>(peerSeg) +
                                       static_cast<uint64_t>(m.imm) * chunkWords * 4,
                                   m.len, m.imm);
    }
}

/* ============================ host 侧(仅建池/起 kernel/收结果) ============================ */
static void Step(const char *name, int32_t ret)
{
    if (ret != 0) {
        printf("[r%d FAIL] %-28s ret=%d\n", g_rank, name, ret);
        exit(1);
    }
    printf("[r%d OK]   %-28s\n", g_rank, name);
}

static double NowMs()
{
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
}

/* 双 rank 栅栏(初始化会合/阶段栅栏/串行轮间会合共用) */
static void SyncPeer()
{
    MPI_Barrier(MPI_COMM_WORLD);
}

/* 起一轮 AICore kernel 并同步返回(用户 kernel 仅 gva/块参数, 零协同参数) */
static double RunAicore(aclrtStream stream, void *gva, uint32_t chunks)
{
    const double t0 = NowMs();
    ex08Kernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva), EX_CHUNK_WORDS, chunks);
    Step("sync(aiCore)", aclrtSynchronizeStream(stream));
    return NowMs() - t0;
}

// 示例入口: rank 由 MPI 分配(mpirun -np 2 拉起)
int main(int argc, char *argv[])
{
    (void)argv;
    int mpiRet = MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank); // 先取 rank, 步骤日志才能带 [rN] 前缀
    Step("MPI_Init", mpiRet);
    int worldSize = 0;
    MPI_Comm_size(MPI_COMM_WORLD, &worldSize);
    if (worldSize != 2) { /* 本示例固定 2-rank(同卡 die 对) */
        printf("expect exactly 2 ranks (mpirun -np 2), got %d\n", worldSize);
        MPI_Finalize();
        return 1;
    }
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1);

    /* ---- 建池(SHM + SDMA 位 → 310P 协同自动启用, 段尾保留区+epoch 监督线程就位) ---- */
    Step("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    Step("smem_shm_config_init", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = (g_rank == 0); // r0 起配置存储
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, static_cast<uint32_t>(g_rank),
                                        static_cast<uint16_t>(g_rank), &cfg));
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, 2, static_cast<uint32_t>(g_rank), EX_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) {
        printf("[r%d FAIL] smem_shm_create: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    Step("smem_shm_create(SDMA)", 0);
    if (smem_shm_sdma_get_workspace(shm) == nullptr) { // 协同就绪判定(唯一 host 查询)
        printf("[r%d FAIL] sdma orchestration not ready\n", g_rank);
        return 1;
    }
    printf("[r%d INFO] gva=%p\n", g_rank, gva);
    SyncPeer(); /* 会合: 双方建池完成(保留区清零+监督线程就位) */

    aclrtStream stream = nullptr;
    (void)aclrtCreateStream(&stream);

    /* ---- ① 多 chunk 流水(8×128KB, 全程设备侧自驱) ---- */
    double tPipe = 0;
    {
        tPipe = RunAicore(stream, gva, EX_CHUNKS);
        SyncPeer(); /* 会合: 双方流水完成(回件全落) */
    }

    /* ---- 全量校验: r0 读 own 段 1MB, 每 chunk == (tag+c)<<24|i + INC ---- */
    int overall = 1;
    if (g_rank == 0) {
        const uint64_t total = EX_CHUNKS * EX_CHUNK_BYTES;
        uint32_t *host = static_cast<uint32_t *>(malloc(total));
        if (aclrtMemcpy(host, total, gva, total, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            printf("[r0 FAIL] D2H 全量读失败\n");
            overall = 0;
        } else {
            uint32_t bad = 0;
            for (uint32_t c = 0; c < EX_CHUNKS; c++) {
                uint32_t cbad = 0;
                for (uint32_t i = 0; i < EX_CHUNK_WORDS; i++) {
                    if (host[c * EX_CHUNK_WORDS + i] != (((EX_TAG + c) << 24) | i) + EX_INC) {
                        bad++;
                        cbad++;
                    }
                }
                if (cbad != 0) { // 打印样本辅助定位
                    printf("[r0] chunk %u bad=%u: [0]=0x%x [1]=0x%x [2]=0x%x expect[0]=0x%x\n", c, cbad,
                           host[c * EX_CHUNK_WORDS], host[c * EX_CHUNK_WORDS + 1], host[c * EX_CHUNK_WORDS + 2],
                           (((EX_TAG + c) << 24)) + EX_INC);
                }
            }
            printf("[r0] ①流水终态数据 mismatch=%u/%llu → %s\n", bad,
                   (unsigned long long)(EX_CHUNKS * EX_CHUNK_WORDS), bad == 0 ? "PASS" : "FAIL");
            overall &= (bad == 0) ? 1 : 0;
        }
        free(host);
    }

    /* ---- ② 串行对照(逐块 signal→wait→回件, 无重叠) ---- */
    double tSerial = 0;
    {
        const double t0 = NowMs();
        for (uint32_t r = 0; r < EX_CHUNKS; r++) {
            (void)RunAicore(stream, gva, 1); // 一轮(单块闭环)
            SyncPeer(); // 本轮双端到齐才进下一轮
        }
        tSerial = NowMs() - t0;
        printf("[r%d] ②串行×%u: %.2fms\n", g_rank, EX_CHUNKS, tSerial);
    }

    /* ---- 掩盖量化: 串行总时延 vs 流水总时延 ---- */
    if (g_rank == 0) {
        printf("[r0] 掩盖量化: ②串行×%u=%.2fms vs ①流水=%.2fms → 加速比 %.2fx\n", EX_CHUNKS, tSerial,
               tPipe, tPipe > 0 ? tSerial / tPipe : 0.0);
    }

    /* ---- ③ 长驻 soak(可选): EX08_SOAK_ROUNDS>0 启用, 跨 epoch 续命边界持续收发 ---- */
    const char *soakEnv = getenv("EX08_SOAK_ROUNDS");
    const uint32_t soakRounds = (soakEnv != nullptr) ? static_cast<uint32_t>(atoi(soakEnv)) : 0;
    if (soakRounds > 0) {
        const double t0 = NowMs();
        for (uint32_t r = 0; r < soakRounds; r++) { // 单块闭环逐轮(产→signal→INC→回件→wait)
            (void)RunAicore(stream, gva, 1);
            SyncPeer();
        }
        const double soakMs = NowMs() - t0;
        /* 时延上界断言: 若某轮 wait 落入无消费的死等(续命失效), 轮询预算(分钟级)会撑爆总时延 */
        const double budgetMs = static_cast<double>(soakRounds) * 20.0 + 30000.0;
        if (soakMs > budgetMs) {
            printf("[r0 FAIL] ③soak 超时上界: %.0fms > %.0fms (疑似续命失效死等)\n", soakMs, budgetMs);
            overall = 0;
        }
        printf("[r%d] ③soak×%u: %.0fms (avg %.2fms/轮, 跨 ≥%.0f 次 epoch 续命)\n", g_rank, soakRounds,
               soakMs, soakMs / soakRounds, soakMs / 15000.0);
        /* 终态校验: 末轮回件 = pattern + INC(逐轮 r0 重产覆盖, 终态只含末轮增量) */
        if (g_rank == 0) {
            uint32_t expect[4] = {0, 0, 0, 0};
            (void)aclrtMemcpy(expect, sizeof(expect), gva, sizeof(expect), ACL_MEMCPY_DEVICE_TO_HOST);
            for (uint32_t i = 0; i < 4; i++) {
                if (expect[i] != (((EX_TAG) << 24) | i) + EX_INC) {
                    printf("[r0 FAIL] ③soak 终态失配 [%u]=0x%x\n", i, expect[i]);
                    overall = 0;
                    break;
                }
            }
        }
        SyncPeer();
    }

    (void)aclrtDestroyStream(stream);
    Step("smem_shm_destroy", smem_shm_destroy(shm, 0)); // 监督线程停止, 资源计数-1
    smem_shm_uninit(0);
    Step("smem_shm_uninit", 0);
    smem_uninit();
    Step("smem_uninit", 0);
    (void)aclrtResetDevice(g_rank);
    (void)aclFinalize();
    printf("=== EX08 r%d %s ===\n", g_rank, overall ? "PASS" : "FAIL");
    MPI_Finalize();
    return overall ? 0 : 1;
}
