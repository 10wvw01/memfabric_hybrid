/* 08_310p_aicore_aicpu_sdma — 310P 单卡双 die 2-rank AICore×AICPU 协同示例(邮箱化)
 *
 * 场景: 双 rank(dev0/dev1)SHM 池上, AICore kernel 内 signal 投递搬运请求 →
 * AICPU epoch 消费 kernel 代投 SDMA SQE → 对端 AICore wait 按序收件消费(读改写 INC)
 * → 回程 signal 返回 → 原端 wait 收件。全程设备侧自驱, host 仅建池/起 kernel/收结果。
 *
 * 能力演示(长稳压测/全设备同步探针等测试内容已迁 test/integration/310p_sdma_stability):
 *   ① 多 chunk 流水(8×128KB): 数据逐字校验 mismatch=0 —— 功能正确性
 *   ② 串行 N 次(逐块 signal→wait→回件): 总时延 —— 无重叠对照
 *   ⑤ SDMA inline reduce(搬运同时累加, 310P3 实测支持域 SUM×{FP32,FP16})
 *   ⑥ 多 AICore block 并发(<<<8>>> 起 8 block, 每 block 在独占邮箱队列上独立跑
 *      "产→发→收→改→回"闭环——48 队列编码下 block b 恒用队列 b, SPSC 逐队列保持)
 *
 * 用户负担清零验证: kernel 签名与 910B RDMADemo 同构(仅 gva 参数); 无槽位算术/
 * 无标志地址方案/无清邮箱/无 role 与 ws 传参/无 host submit——全部由 memfabric 托管。
 *
 * 双 rank 会合与栅栏: MPI_Barrier(mpirun -np 2 拉起, rank 由 MPI 分配)。
 */
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <unistd.h>
#include <mpi.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

#define STORE_URL "tcp://127.0.0.1:8581" /* 配置存储地址 */
#define EX_LOCAL_SIZE (32UL * 1024UL * 1024UL) /* 每 rank 物理贡献 32MB */
#define EX_CHUNKS 8u                           /* 流水 chunk 数 */
#define EX_CHUNK_BYTES (128UL * 1024UL)         /* 每 chunk 128KB */
#define EX_CHUNK_WORDS (EX_CHUNK_BYTES / 4u)    /* 每 chunk 字数 */
#define EX_INC 0x100u                           /* r1 AICore 增量 */
#define EX_TAG 0x8Bu                           /* pattern 标识 */
#define EX_REDUCE_OFF (8UL * 1024UL * 1024UL)  /* ⑤ reduce 块段内偏移(8MB 处, 避开 ①②③ 数据区) */
/* ⑥ 多 AICore block 并发(<<<8>>>, 每 block 独占队列跑"产→发→收→改→回"闭环) */
#define EX_MB_BLOCKS 8u                          /* 并发 AICore block 数(= 每 die 上限) */
#define EX_MB_CHUNK_BYTES (128UL * 1024UL)       /* 每 block 独立 chunk 128KB */
#define EX_MB_CHUNK_WORDS (EX_MB_CHUNK_BYTES / 4u) /* 每 chunk 字数 */
#define EX_MB_OFF (4UL * 1024UL * 1024UL)        /* ⑥ 数据区(8×128KB, 4MB 处, 避开 ① 1MB 与 ⑤ 8MB) */
#define EX_MBSTAT_OFF (12UL * 1024UL * 1024UL)  /* ⑥ 每 block 状态字(8×64B 独占行, 12MB 处) */
#define EX_MB_ST_MAGIC 0x8B000000u               /* ⑥ 状态字魔数 */
#define EX_MB_ST_CODE_PASS 0u                    /* 通过 */
#define EX_MB_ST_CODE_SIGNAL 1u                  /* signal 拒投 */
#define EX_MB_ST_CODE_WAIT 2u                    /* wait 异常/imm 对账失败 */
#define EX_MB_ST_STG_SIG 3u                      /* 阶段码: signal 已投递 */
#define EX_MB_ST_STG_QUIET 4u                    /* 阶段码: quiet 已过, 进入 wait */

static int g_rank = -1; /* 本进程 rank(0/1) */

/* ============================ AICore kernel(设备头原语) ============================ */
#define EX_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__ /* AICore 内联属性 */

EX_AICORE_INLINE void ExCleanRegion(__gm__ uint32_t *base, uint64_t words)
{
    AscendC::GlobalTensor<int32_t> gm;
    const uint64_t bytes = words * 4;
    /* 逐 64B 行 clean(只刷目标区域, 不扰动整个数据缓存——用户模板代码的推荐姿势) */
    for (uint64_t off = 0; off < bytes; off += 64) {
        gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(reinterpret_cast<uintptr_t>(base) + off), 16);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(gm);
    }
}

/* 产一个 chunk 的 pattern(chunk 内含 chunk 序号, 校验可溯源) */
EX_AICORE_INLINE void ExFillChunk(__gm__ uint32_t *chunkBase, uint64_t words, uint32_t tag, uint32_t chunkIdx)
{
    for (uint64_t i = 0; i < words; i++) {
        chunkBase[i] = ((tag + chunkIdx) << 24) | static_cast<uint32_t>(i);
    }
}

/* 协同 AICore kernel(邮箱化, 两角色按 rank 自取——与 RDMADemo 同构):
 *   rank0 产: 逐 chunk 产+signal → quiet 等全部落地 → wait 收回件(终态=原值+INC)
 *   rank1 消费: 循环 wait 收件 → 读改写 INC → clean → signal 回件(imm=件序号回带)
 * 两阶段(①流水 8 chunk / ②串行逐块)共用本 kernel, 仅 chunks 参数不同 */
extern "C" __global__ __aicore__ void ex08Kernel(__gm__ uint8_t *gva, uint64_t chunkWords, uint32_t chunks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE); // 声明 AICore 任务类型
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单 block 纪律 */
    }
    const uint32_t rank = smem_shm_get_global_rank(0);    /* 本端 rank(meta 自取) */
    const uint64_t symm = smem_shm_get_symmetric_size(0); /* 对称段大小(meta 自取) */
    __gm__ uint8_t *ownSeg = gva + symm * rank;           /* 本端段基址(指针算术) */
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);    /* 对端段基址(对称算术) */
    __gm__ uint32_t *data = reinterpret_cast<__gm__ uint32_t *>(ownSeg);
    /* 保留区基址入口一次预计算(免每封 signal/wait 3 次 meta 读, _at 变体复用) */
    smem_shm_sdma_ctx_t sdmaCtx = smem_shm_sdma_ctx(gva); /* 入口一次预计算 */

    if (rank == 0) { /* r0 产: 逐 chunk 产+投递 → quiet → 收回件 */
        for (uint32_t c = 0; c < chunks; c++) {
            __gm__ uint32_t *chunk = data + static_cast<uint64_t>(c) * chunkWords;
            ExFillChunk(chunk, chunkWords, EX_TAG, c);
            ExCleanRegion(chunk, chunkWords); // clean 后 SDMA 可见
            /* 投递搬运请求(源=本端第 c 块, 目的=对端第 c 块; imm=chunk 序号) */
            (void)smem_shm_sdma_signal_at(sdmaCtx, chunk,
                                       peerSeg + static_cast<uint64_t>(c) * chunkWords * 4, chunkWords * 4, c);
        }
        (void)smem_shm_sdma_quiet_at(sdmaCtx); // 等全部落地(源缓冲语义上可复用)
        for (uint32_t c = 0; c < chunks; c++) { // 收回件(校验由 host D2H 逐字比对承担)
            smem_shm_sdma_mail_t m = smem_shm_sdma_wait_any_at(sdmaCtx);
            (void)m;
        }
        return;
    }
    /* r1 消费: 循环收件 → INC → 回件(件数=chunks, imm=件序号) */
    for (uint32_t c = 0; c < chunks; c++) {
        smem_shm_sdma_mail_t m = smem_shm_sdma_wait_any_at(sdmaCtx); // 按序收件(邮件自描述落点)
        if (m.status != SMEM_SHM_SDMA_MAIL_OK) {
            return; /* 异常即退(host 侧校验暴露) */
        }
        __gm__ uint32_t *chunk = reinterpret_cast<__gm__ uint32_t *>(m.dst); // 数据落点(免预约定布局)
        for (uint64_t i = 0; i < m.len / 4; i++) {
            chunk[i] = chunk[i] + EX_INC;
        }
        ExCleanRegion(chunk, m.len / 4); // clean 后 SDMA 可见
        /* 回件: 源=本端 INC 后块, 目的=对端(imm=原 chunk 序号, 回带对账) */
        (void)smem_shm_sdma_signal_at(sdmaCtx, chunk,
                                   reinterpret_cast<__gm__ uint8_t *>(peerSeg) +
                                       static_cast<uint64_t>(m.imm) * chunkWords * 4,
                                   m.len, m.imm);
    }
}

/* ⑥ 多 AICore block 并发 kernel: <<<8>>> 起 8 个 AICore block, 每 block 在自己的
 * 独占队列((对端, 本 block); 2-rank 下对端环下标恒 0, block b ⇔ 队列 b)上独立跑
 * "产→发→收→改→回"闭环。rank0 各 block 产各自 chunk 并投递, rank1 各 block 收件
 * 读改写 INC 后回件——8 路流水完全并行, 验证多 block 并发 signal/wait 的队列隔离。 */
extern "C" __global__ __aicore__ void ex08MultiBlockKernel(__gm__ uint8_t *gva, uint64_t chunkWords)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    __gm__ uint8_t *ownSeg = gva + symm * rank;
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);
    smem_shm_sdma_ctx_t sdmaCtx = smem_shm_sdma_ctx(gva); /* ctx.block = GetBlockIdx(), 队列路由源 */
    const uint32_t b = sdmaCtx.block;
    /* 本 block 状态字(独占 64B 行, 多 block 并发写不共行) */
    __gm__ uint32_t *st = reinterpret_cast<__gm__ uint32_t *>(ownSeg + EX_MBSTAT_OFF + b * 64);
    *st = EX_MB_ST_MAGIC | (b << 16) | 0xFFFFu; /* 入口先写非通过值(块未完成可判) */
    ExCleanRegion(st, 1);
    if (b >= EX_MB_BLOCKS) { /* 超出本阶段分片数的块(不应发生) */
        *st = EX_MB_ST_MAGIC | (b << 16) | EX_MB_ST_CODE_WAIT;
        ExCleanRegion(st, 1);
        return;
    }
    __gm__ uint32_t *chunk = reinterpret_cast<__gm__ uint32_t *>(ownSeg + EX_MB_OFF + b * chunkWords * 4);
    if (rank == 0) { /* r0 block b: 产(含 block 标识) → 发(队列 b) → 收回件 */
        for (uint64_t i = 0; i < chunkWords; i++) {
            chunk[i] = ((EX_TAG + 0x10u + b) << 24) | static_cast<uint32_t>(i & 0xFFFFFFu);
        }
        ExCleanRegion(chunk, chunkWords); /* clean 后 SDMA 可见 */
        if (!smem_shm_sdma_signal_at(sdmaCtx, chunk, peerSeg + EX_MB_OFF + b * chunkWords * 4,
                                      chunkWords * 4, b)) { /* imm=b, 回带对账 */
            *st = EX_MB_ST_MAGIC | (b << 16) | EX_MB_ST_CODE_SIGNAL;
            ExCleanRegion(st, 1);
            return;
        }
        *st = EX_MB_ST_MAGIC | (b << 16) | EX_MB_ST_STG_SIG;
        ExCleanRegion(st, 1);
        (void)smem_shm_sdma_quiet_at(sdmaCtx); /* 等本队列末封落地 */
        *st = EX_MB_ST_MAGIC | (b << 16) | EX_MB_ST_STG_QUIET;
        ExCleanRegion(st, 1);
        smem_shm_sdma_mail_t m = smem_shm_sdma_wait_peer_at(sdmaCtx, 1); /* 到达子环 b */
        if (m.status != SMEM_SHM_SDMA_MAIL_OK || m.imm != b) {
            *st = EX_MB_ST_MAGIC | (b << 16) | EX_MB_ST_CODE_WAIT;
            ExCleanRegion(st, 1);
            return;
        }
        *st = EX_MB_ST_MAGIC | (b << 16) | EX_MB_ST_CODE_PASS;
        ExCleanRegion(st, 1);
        return;
    }
    /* r1 block b: 收件 → 读改写 INC → 回件(队列 b) */
    smem_shm_sdma_mail_t m = smem_shm_sdma_wait_peer_at(sdmaCtx, 0); /* 到达子环 b */
    if (m.status != SMEM_SHM_SDMA_MAIL_OK || m.imm != b) {
        *st = EX_MB_ST_MAGIC | (b << 16) | EX_MB_ST_CODE_WAIT;
        ExCleanRegion(st, 1);
        return;
    }
    *st = EX_MB_ST_MAGIC | (b << 16) | EX_MB_ST_STG_SIG; /* 已收件, 规约回件中 */
    ExCleanRegion(st, 1);
    __gm__ uint32_t *dst = reinterpret_cast<__gm__ uint32_t *>(m.dst); /* 落点自描述 */
    for (uint64_t i = 0; i < m.len / 4; i++) {
        dst[i] = dst[i] + EX_INC;
    }
    ExCleanRegion(dst, m.len / 4); /* clean 后 SDMA 可见 */
    if (!smem_shm_sdma_signal_at(sdmaCtx, dst, peerSeg + EX_MB_OFF + b * chunkWords * 4, m.len, m.imm)) {
        *st = EX_MB_ST_MAGIC | (b << 16) | EX_MB_ST_CODE_SIGNAL;
        ExCleanRegion(st, 1);
        return;
    }
    *st = EX_MB_ST_MAGIC | (b << 16) | EX_MB_ST_CODE_PASS;
    ExCleanRegion(st, 1);
}

/* ============================ host 侧(仅建池/起 kernel/收结果) ============================ */
static void Step(const char *name, int32_t ret)
{
    if (ret != 0) {
        printf("[r%d FAIL] %-28s ret=%d\n", g_rank, name, ret);
        exit(1);
    }
    printf("[r%d OK]   %-28s\n", g_rank, name);
}

static double NowMs()
{
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
}

/* 双 rank 栅栏(初始化会合/阶段栅栏/串行轮间会合共用) */
static void SyncPeer()
{
    MPI_Barrier(MPI_COMM_WORLD);
}

/* ⑤ SDMA inline reduce kernel: r0 填 fp32=1.0 → signal(ADD_FP32) 搬运同时累加到对端
 * (对端块由 host 预置 100.0, 期望终态 101.0 —— 替代"搬运后 AICore 读改写"的两步路径) */
extern "C" __global__ __aicore__ void ex08ReduceKernel(__gm__ uint8_t *gva, uint64_t words)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单 block 纪律 */
    }
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    smem_shm_sdma_ctx_t sdmaCtx = smem_shm_sdma_ctx(gva); /* 入口一次预计算 */
    if (rank != 0) {
        /* r1: 收下这封 reduce 邮件——数据由 SDMA inline reduce 落地(dst += src),
         * 此处仅取走邮件, 保证到达环不留未消费邮件(后续阶段 block0 按序收件
         * 才不会被这封旧邮件挡住/错拿, 实测⑥卡死根因) */
        (void)smem_shm_sdma_wait_peer_at(sdmaCtx, 0);
        return;
    }
    __gm__ uint8_t *ownSeg = gva + symm * rank;
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);
    __gm__ float *src = reinterpret_cast<__gm__ float *>(ownSeg + EX_REDUCE_OFF);
    for (uint64_t i = 0; i < words; i++) {
        src[i] = 1.0f; /* 源: 逐元素 1.0 */
    }
    ExCleanRegion(reinterpret_cast<__gm__ uint32_t *>(src), words);
    /* 投递 reduce 请求: 搬运的同时对端 dst += src(fp32); imm=0x5(对账标签) */
    (void)smem_shm_sdma_signal_at(sdmaCtx, src, peerSeg + EX_REDUCE_OFF, words * 4, 0x5,
                                  SMEM_SHM_SDMA_OP_ADD_FP32);
    (void)smem_shm_sdma_quiet_at(sdmaCtx); /* 等落地(host 侧随即可校验) */
}

/* 起一轮 AICore kernel 并同步返回(用户 kernel 仅 gva/块参数, 零协同参数) */
static double RunAicore(aclrtStream stream, void *gva, uint32_t chunks)
{
    const double t0 = NowMs();
    ex08Kernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva), EX_CHUNK_WORDS, chunks);
    Step("sync(aiCore)", aclrtSynchronizeStream(stream));
    return NowMs() - t0;
}

// 示例入口: rank 由 MPI 分配(mpirun -np 2 拉起)
int main(int argc, char *argv[])
{
    (void)argv;
    int mpiRet = MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank); // 先取 rank, 步骤日志才能带 [rN] 前缀
    Step("MPI_Init", mpiRet);
    int worldSize = 0;
    MPI_Comm_size(MPI_COMM_WORLD, &worldSize);
    if (worldSize != 2) { /* 本示例固定 2-rank(同卡 die 对) */
        printf("expect exactly 2 ranks (mpirun -np 2), got %d\n", worldSize);
        MPI_Finalize();
        return 1;
    }
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1);

    /* ---- 建池(SHM + SDMA 位 → 310P 协同自动启用, 段尾保留区+epoch 监督线程就位) ---- */
    Step("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    Step("smem_shm_config_init", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = (g_rank == 0); // r0 起配置存储
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, static_cast<uint32_t>(g_rank),
                                        static_cast<uint16_t>(g_rank), &cfg));
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, 2, static_cast<uint32_t>(g_rank), EX_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) {
        printf("[r%d FAIL] smem_shm_create: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    Step("smem_shm_create(SDMA)", 0);
    if (smem_shm_sdma_get_workspace(shm) == nullptr) { // 协同就绪判定(唯一 host 查询)
        printf("[r%d FAIL] sdma orchestration not ready\n", g_rank);
        return 1;
    }
    printf("[r%d INFO] gva=%p\n", g_rank, gva);
    SyncPeer(); /* 会合: 双方建池完成(保留区清零+监督线程就位) */

    aclrtStream stream = nullptr;
    (void)aclrtCreateStream(&stream);

    /* ---- ① 多 chunk 流水(8×128KB, 全程设备侧自驱) ---- */
    double tPipe = 0;
    {
        tPipe = RunAicore(stream, gva, EX_CHUNKS);
        SyncPeer(); /* 会合: 双方流水完成(回件全落) */
    }

    /* ---- 全量校验: r0 读 own 段 1MB, 每 chunk == (tag+c)<<24|i + INC ---- */
    int overall = 1;
    if (g_rank == 0) {
        const uint64_t total = EX_CHUNKS * EX_CHUNK_BYTES;
        uint32_t *host = static_cast<uint32_t *>(malloc(total));
        if (aclrtMemcpy(host, total, gva, total, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            printf("[r0 FAIL] D2H 全量读失败\n");
            overall = 0;
        } else {
            uint32_t bad = 0;
            for (uint32_t c = 0; c < EX_CHUNKS; c++) {
                uint32_t cbad = 0;
                for (uint32_t i = 0; i < EX_CHUNK_WORDS; i++) {
                    if (host[c * EX_CHUNK_WORDS + i] != (((EX_TAG + c) << 24) | i) + EX_INC) {
                        bad++;
                        cbad++;
                    }
                }
                if (cbad != 0) { // 打印样本辅助定位
                    printf("[r0] chunk %u bad=%u: [0]=0x%x [1]=0x%x [2]=0x%x expect[0]=0x%x\n", c, cbad,
                           host[c * EX_CHUNK_WORDS], host[c * EX_CHUNK_WORDS + 1], host[c * EX_CHUNK_WORDS + 2],
                           (((EX_TAG + c) << 24)) + EX_INC);
                }
            }
            printf("[r0] ①流水终态数据 mismatch=%u/%llu → %s\n", bad,
                   (unsigned long long)(EX_CHUNKS * EX_CHUNK_WORDS), bad == 0 ? "PASS" : "FAIL");
            overall &= (bad == 0) ? 1 : 0;
        }
        free(host);
    }

    /* ---- ② 串行对照(逐块 signal→wait→回件, 无重叠) ---- */
    double tSerial = 0;
    {
        const double t0 = NowMs();
        for (uint32_t r = 0; r < EX_CHUNKS; r++) {
            (void)RunAicore(stream, gva, 1); // 一轮(单块闭环)
            SyncPeer(); // 本轮双端到齐才进下一轮
        }
        tSerial = NowMs() - t0;
        printf("[r%d] ②串行×%u: %.2fms\n", g_rank, EX_CHUNKS, tSerial);
    }

    /* ---- 掩盖量化: 串行总时延 vs 流水总时延 ---- */
    if (g_rank == 0) {
        printf("[r0] 掩盖量化: ②串行×%u=%.2fms vs ①流水=%.2fms → 加速比 %.2fx\n", EX_CHUNKS, tSerial,
               tPipe, tPipe > 0 ? tSerial / tPipe : 0.0);
    }

    /* ---- ⑤ SDMA inline reduce: r1 预置 100.0 → r0 signal(ADD_FP32) 搬 1.0 累加 → 校验 101.0 ----
     * 验证搬运通路自带 ALU(dst += src), 替代"搬运后 AICore 读改写"两步; 310P3 支持域 SUM×{FP32,FP16} */
    {
        const uint64_t rwords = 1024; /* 4KB 块 */
        /* host 侧本端段基址: 对称窗口内按 rank 加槽位偏移(kernel 侧 ownSeg 同算术);
         * symm 与 kernel meta 同源(host API, = ALIGN_UP(localSize,1G)), 勿硬编码 EX_LOCAL_SIZE */
        const uint64_t symmHost = smem_shm_get_symmetric_size(shm);
        uint8_t *ownSegHost = static_cast<uint8_t *>(gva) + symmHost * g_rank;
        if (g_rank == 1) { /* r1: own 段 reduce 块预置初值 100.0 */
            static float init[1024];
            for (uint64_t i = 0; i < rwords; i++) {
                init[i] = 100.0f;
            }
            (void)aclrtMemcpy(ownSegHost + EX_REDUCE_OFF, rwords * 4, init, rwords * 4, ACL_MEMCPY_HOST_TO_DEVICE);
        }
        SyncPeer(); /* 预置完成会合 */
        /* 双端启动: r0 发起 reduce, r1 收下邮件(到达环不留未消费邮件, 后续阶段按序收件) */
        ex08ReduceKernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva), rwords);
        Step("sync(reduce)", aclrtSynchronizeStream(stream));
        SyncPeer(); /* 搬运落地会合 */
        if (g_rank == 1) { /* r1: D2H 读回校验 100.0+1.0=101.0 */
            static float out[1024];
            (void)aclrtMemcpy(out, rwords * 4, ownSegHost + EX_REDUCE_OFF, rwords * 4, ACL_MEMCPY_DEVICE_TO_HOST);
            uint32_t bad = 0;
            for (uint64_t i = 0; i < rwords; i++) {
                if (out[i] != 101.0f) {
                    bad++;
                }
            }
            printf("[r1] ⑤inline reduce(SUM×FP32): mismatch=%u/%llu (期望 100.0+1.0=101.0) → %s\n", bad,
                   (unsigned long long)rwords, bad == 0 ? "PASS" : "FAIL");
            overall &= (bad == 0) ? 1 : 0;
        }
    }

    /* ---- ⑥ 多 AICore block 并发(8 block 各走各队列, 2-rank 同卡) ---- */
    double tMb = 0;
    {
        const uint64_t symmHost = smem_shm_get_symmetric_size(shm); /* 与 kernel meta 同源 */
        uint8_t *ownSegHost = static_cast<uint8_t *>(gva) + symmHost * g_rank;
        const double t0 = NowMs();
        ex08MultiBlockKernel<<<EX_MB_BLOCKS, 0, stream>>>(static_cast<uint8_t *>(gva), EX_MB_CHUNK_WORDS);
        /* 轮询每 block 阶段码(D2H 与 kernel 并行; 卡点按 block 定位, 超时不挂死):
         * 3=已 signal / 4=已 quiet 进 wait / 0=通过; 0xFFFF=尚未到 signal */
        int allPass = 0;
        for (int poll = 0; poll < 40 && !allPass; poll++) { /* 40×0.5s = 20s 上限 */
            usleep(500 * 1000);
            allPass = 1;
            for (uint32_t b = 0; b < EX_MB_BLOCKS; b++) {
                uint32_t st = 0;
                if (aclrtMemcpy(&st, 4, ownSegHost + EX_MBSTAT_OFF + b * 64, 4,
                                ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS ||
                    (st & EX_MB_ST_MAGIC) != EX_MB_ST_MAGIC || (st & 0xFFu) != EX_MB_ST_CODE_PASS) {
                    allPass = 0;
                }
            }
        }
        tMb = NowMs() - t0;
        if (!allPass) { /* 卡点现场: 打印每 block 阶段码后失败退出(kernel 仍在自旋) */
            for (uint32_t b = 0; b < EX_MB_BLOCKS; b++) {
                uint32_t st = 0;
                (void)aclrtMemcpy(&st, 4, ownSegHost + EX_MBSTAT_OFF + b * 64, 4, ACL_MEMCPY_DEVICE_TO_HOST);
                printf("[r%d] ⑥block %u 阶段码 0x%x(3=已signal 4=quiet后等回件)\n", g_rank, b, st);
            }
            printf("[r%d FAIL] ⑥多block并发超时(%.2fms)\n", g_rank, tMb);
            overall = 0;
            SyncPeer(); /* 双方都到齐再退出(对方也在等) */
            (void)aclrtDestroyStream(stream);
            smem_shm_uninit(0);
            smem_uninit();
            (void)aclrtResetDevice(g_rank);
            (void)aclFinalize();
            MPI_Finalize();
            return 1;
        }
        Step("sync(multiBlock)", aclrtSynchronizeStream(stream));
        SyncPeer(); /* 会合: 双方 8 block 闭环完成 */

        /* 全量校验: rank0 的 8×128KB 逐字 == pattern+INC(pattern 含 block 标识可溯源) */
        if (g_rank == 0) {
            const uint64_t total = EX_MB_BLOCKS * EX_MB_CHUNK_BYTES;
            uint32_t *host = static_cast<uint32_t *>(malloc(total));
            if (host == nullptr || aclrtMemcpy(host, total, static_cast<uint8_t *>(gva) + EX_MB_OFF, total,
                                               ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
                printf("[r0 FAIL] ⑥ D2H 全量读失败\n");
                overall = 0;
            } else {
                uint32_t bad = 0;
                for (uint32_t b = 0; b < EX_MB_BLOCKS; b++) {
                    for (uint64_t i = 0; i < EX_MB_CHUNK_WORDS; i++) {
                        if (host[b * EX_MB_CHUNK_WORDS + i] !=
                            (((EX_TAG + 0x10u + b) << 24) | (i & 0xFFFFFFu)) + EX_INC) {
                            bad++;
                        }
                    }
                }
                printf("[r0] ⑥多block并发终态 mismatch=%u/%llu → %s (%.2fms)\n", bad,
                       (unsigned long long)(EX_MB_BLOCKS * EX_MB_CHUNK_WORDS), bad == 0 ? "PASS" : "FAIL", tMb);
                overall &= (bad == 0) ? 1 : 0;
            }
            free(host);
        }
    }

    (void)aclrtDestroyStream(stream);
    Step("smem_shm_destroy", smem_shm_destroy(shm, 0)); // 监督线程停止, 资源计数-1
    smem_shm_uninit(0);
    Step("smem_shm_uninit", 0);
    smem_uninit();
    Step("smem_uninit", 0);
    (void)aclrtResetDevice(g_rank);
    (void)aclFinalize();
    printf("=== EX08 r%d %s ===\n", g_rank, overall ? "PASS" : "FAIL");
    MPI_Finalize();
    return overall ? 0 : 1;
}
