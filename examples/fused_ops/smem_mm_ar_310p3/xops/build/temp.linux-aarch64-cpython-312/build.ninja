ninja_required_version = 1.3
cxx = c++

cflags = -fno-strict-overflow -Wsign-compare -DNDEBUG -g -O3 -Wall -fPIC -I/usr/local/python3.12.13/lib/python3.12/site-packages/torch_npu/include -I/usr/local/python3.12.13/lib/python3.12/site-packages/torch_npu/include/third_party/acl/inc -I/usr/local/python3.12.13/lib/python3.12/site-packages/torch_npu/include/third_party/hccl/inc -I/usr/local/python3.12.13/lib/python3.12/site-packages/torch/include -I/usr/local/python3.12.13/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/usr/local/python3.12.13/include/python3.12 -c
post_cflags = -I/usr/local/python3.12.13/lib/python3.12/site-packages/torch_npu/include/third_party/acl/inc -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=xops_lib -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=xops_lib -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc







