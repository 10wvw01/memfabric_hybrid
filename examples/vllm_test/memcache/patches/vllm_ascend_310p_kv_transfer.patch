+def _resolve_physical_device_id(local_rank: int) -> int:
+    """Resolve the physical NPU device ID from ASCEND_RT_VISIBLE_DEVICES.
+
+    When ASCEND_RT_VISIBLE_DEVICES remaps device IDs (e.g. "6,7" makes
+    logical 0 → physical 6), the HYBM library requires the *physical* ID
+    for SDID lookup.  Without remapping the function returns *local_rank*
+    unchanged.
+    """
+    visible = os.environ.get("ASCEND_RT_VISIBLE_DEVICES", "")
+    if not visible:
+        return local_rank
+    device_ids = [int(d.strip()) for d in visible.split(",") if d.strip().isdigit()]
+    if 0 <= local_rank < len(device_ids):
+        return device_ids[local_rank]
+    return local_rank
+
