#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <vector>
#include <unistd.h>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

extern "C" __global__ __aicore__ void exchange(__gm__ uint8_t *gva, __gm__ uint32_t *result,
                                             uint64_t bytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const auto rank = smem_shm_get_global_rank(0);
    const auto symm = smem_shm_get_symmetric_size(0);
    auto src = gva + (1 - rank) * symm;
    auto dst = gva + rank * symm + bytes;
    result[0] = 1;
    if (!smem_shm_sdma_get(gva, src, dst, bytes)) return;
    result[0] = 0;
}

extern "C" __global__ __aicore__ void metadata(__gm__ uint64_t *result)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    result[0] = smem_shm_get_symmetric_size(0);
}

extern "C" int prepare_round(void *pool, int rank, size_t bytes, unsigned round)
{
    aclrtStream stream = nullptr;
    uint64_t *status = nullptr;
    if (aclrtCreateStream(&stream) || aclrtMalloc((void **)&status, 32, ACL_MEM_MALLOC_HUGE_FIRST)) return 1;
    metadata<<<1, 0, stream>>>(status);
    uint64_t stride = 0;
    int ret = aclrtSynchronizeStreamWithTimeout(stream, 60000);
    ret |= aclrtMemcpy(&stride, 8, status, 8, ACL_MEMCPY_DEVICE_TO_HOST);
    if (!ret && stride) {
        std::vector<uint32_t> input(bytes / 4);
        for (size_t i = 0; i < input.size(); ++i)
            input[i] = uint32_t(0x12340000u ^ (rank * 0x87654321u) ^ i ^ round);
        ret = aclrtMemcpy(static_cast<uint8_t *>(pool) + rank * stride, bytes, input.data(), bytes,
                          ACL_MEMCPY_HOST_TO_DEVICE);
    } else {
        ret = 1;
    }
    aclrtFree(status);
    aclrtDestroyStream(stream);
    return ret;
}

extern "C" int run_round(void *pool, int rank, size_t bytes, unsigned round)
{
    aclrtStream stream = nullptr;
    uint64_t *status = nullptr;
    auto check = [](int ret) { if (ret) fprintf(stderr, "ERROR ACL ret=%d\n", ret); return ret; };
    if (check(aclrtCreateStream(&stream))) return 1;
    if (check(aclrtMalloc((void **)&status, 32, ACL_MEM_MALLOC_HUGE_FIRST))) return 1;
    metadata<<<1, 0, stream>>>(status);
    uint64_t stride = 0;
    int ret = aclrtSynchronizeStreamWithTimeout(stream, 60000);
    ret |= aclrtMemcpy(&stride, 8, status, 8, ACL_MEMCPY_DEVICE_TO_HOST);
    if (check(ret) || !stride) return 1;
    auto own = static_cast<uint8_t *>(pool) + rank * stride;
    std::vector<uint32_t> output(bytes / 4);
    auto pattern = [round](int peer, size_t i) { return uint32_t(0x12340000u ^ (peer * 0x87654321u) ^ i ^ round); };
    exchange<<<1, 0, stream>>>(static_cast<uint8_t *>(pool), reinterpret_cast<uint32_t *>(status), bytes);
    ret = aclrtSynchronizeStreamWithTimeout(stream, 60000);
    uint32_t stage = 99;
    ret |= aclrtMemcpy(&stage, 4, status, 4, ACL_MEMCPY_DEVICE_TO_HOST);
    ret |= aclrtMemcpy(output.data(), bytes, own + bytes, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    if (check(ret) || stage) { fprintf(stderr, "ERROR stage=%u\n", stage); return 1; }
    for (size_t i = 0; i < output.size(); ++i) {
        if (output[i] != pattern(1-rank, i)) {
            fprintf(stderr, "ERROR rank=%d round=%u index=%zu\n", rank, round, i);
            return 1;
        }
    }
    aclrtFree(status);
    aclrtDestroyStream(stream);
    return 0;
}
