#include <cstdio>
#include <cstdlib>
#include <vector>
#include <mpi.h>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

constexpr uint64_t kFlagBase = 1024 * 1024;
constexpr uint64_t kBlockBytes = 8192;
constexpr unsigned kWords = 64;

__aicore__ inline void Maintain(__gm__ void *ptr, unsigned bytes)
{
    for (unsigned i = 0; i < bytes; i += 64) {
        AscendC::GlobalTensor<int32_t> gm;
        gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(static_cast<__gm__ uint8_t *>(ptr) + i), 16);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(gm);
    }
}

__aicore__ inline bool Exchange(const smem_shm_sdma_ctx_t &ctx, __gm__ uint64_t *local, __gm__ uint64_t *remote,
                                uint64_t value, bool nbi)
{
    bool ok =
        nbi ? smem_shm_sdma_signal_set_nbi_at(ctx, remote, value) : smem_shm_sdma_signal_set_at(ctx, remote, value);
    if (!ok || (nbi && !smem_shm_sdma_quiet_at(ctx)))
        return false;
    return smem_shm_signal_wait_until(local, SMEM_SHM_CMP_EQ, value);
}

__aicore__ inline bool Comparisons(__gm__ uint64_t *flag, uint64_t value)
{
    return smem_shm_signal_test(flag, SMEM_SHM_CMP_EQ, value) &&
           smem_shm_signal_test(flag, SMEM_SHM_CMP_NE, value + 1) &&
           smem_shm_signal_test(flag, SMEM_SHM_CMP_GT, value - 1) &&
           smem_shm_signal_test(flag, SMEM_SHM_CMP_GE, value) &&
           smem_shm_signal_test(flag, SMEM_SHM_CMP_LT, value + 1) &&
           smem_shm_signal_test(flag, SMEM_SHM_CMP_LE, value) &&
           !smem_shm_signal_test(flag, SMEM_SHM_CMP_EQ, value + 1) &&
           !smem_shm_signal_wait_until(flag, SMEM_SHM_CMP_EQ, value + 1, 2);
}

__aicore__ inline bool InvalidArguments(const smem_shm_sdma_ctx_t &ctx, __gm__ uint8_t *own, __gm__ uint8_t *peer,
                                        __gm__ uint64_t *flag)
{
    return !smem_shm_sdma_put_signal_nbi_at(ctx, own, peer, 4, nullptr, 1) &&
           !smem_shm_sdma_signal_set_nbi_at(ctx, reinterpret_cast<__gm__ uint64_t *>(own), 1) &&
           !smem_shm_sdma_signal_set_nbi_at(ctx, reinterpret_cast<__gm__ uint64_t *>(peer + 1), 1) &&
           !smem_shm_sdma_signal_set_nbi_at(
               ctx, reinterpret_cast<__gm__ uint64_t *>(peer + ctx.phys - SMEM_SHM_SDMA_RESERVED), 1) &&
           !smem_shm_signal_test(nullptr, SMEM_SHM_CMP_EQ, 0) &&
           !smem_shm_signal_test(flag, static_cast<smem_shm_cmp_t>(99), 0) &&
           !smem_shm_signal_wait_until(flag, SMEM_SHM_CMP_EQ, 0, 0);
}

template<typename T>
__aicore__ inline bool DataRound(const smem_shm_sdma_ctx_t &ctx, __gm__ uint8_t *own, __gm__ uint8_t *peer,
                                 uint64_t seq, unsigned mode)
{
    auto src = reinterpret_cast<__gm__ T *>(own + ctx.block * kBlockBytes);
    auto dst = reinterpret_cast<__gm__ T *>(own + ctx.block * kBlockBytes + 4096);
    auto remote = reinterpret_cast<__gm__ T *>(peer + ctx.block * kBlockBytes + 4096);
    auto flags = reinterpret_cast<__gm__ uint64_t *>(own + kFlagBase + ctx.block * 4096);
    auto peerFlags = reinterpret_cast<__gm__ uint64_t *>(peer + kFlagBase + ctx.block * 4096);
    const bool add = mode >= 2, nbi = mode & 1;
    for (unsigned i = 0; i < kWords; ++i) {
        src[i] = static_cast<T>(static_cast<int32_t>(i + ctx.rank * 7 + seq % 13));
        dst[i] = static_cast<T>(3);
    }
    Maintain(src, kWords * sizeof(T));
    Maintain(dst, kWords * sizeof(T));
    if (!Exchange(ctx, flags + 16, peerFlags + 16, seq, nbi))
        return false;
    const auto op =
        !add ? SMEM_SHM_SDMA_OP_COPY : (sizeof(T) == 2 ? SMEM_SHM_SDMA_OP_ADD_FP16 : SMEM_SHM_SDMA_OP_ADD_FP32);
    bool ok;
    if (!nbi && !add && (seq & 1)) {
        auto gva = own - ctx.rank * ctx.symm;
        ok = smem_shm_sdma_put_signal(gva, src, remote, kWords * sizeof(T), peerFlags, seq, op);
    } else {
        ok = nbi ? smem_shm_sdma_put_signal_nbi_at(ctx, src, remote, kWords * sizeof(T), peerFlags, seq, op)
                 : smem_shm_sdma_put_signal_at(ctx, src, remote, kWords * sizeof(T), peerFlags, seq, op);
    }
    if (!ok || (nbi && !smem_shm_sdma_quiet_at(ctx)))
        return false;
    const auto cmp = (seq & 1) ? SMEM_SHM_CMP_GE : SMEM_SHM_CMP_EQ;
    if (!smem_shm_signal_wait_until(flags, cmp, seq))
        return false;
    Maintain(dst, kWords * sizeof(T));
    for (unsigned i = 0; i < kWords; ++i) {
        const T expected = static_cast<T>(static_cast<int32_t>(i + (1 - ctx.rank) * 7 + seq % 13 + (add ? 3 : 0)));
        if (static_cast<float>(dst[i]) != static_cast<float>(expected))
            return false;
    }
    return Comparisons(flags, seq) && Exchange(ctx, flags + 32, peerFlags + 32, seq, nbi);
}

__aicore__ inline bool BurstRound(const smem_shm_sdma_ctx_t &ctx, __gm__ uint8_t *gva, __gm__ uint8_t *own,
                                  __gm__ uint8_t *peer, uint64_t seq)
{
    auto src = reinterpret_cast<__gm__ uint32_t *>(own + ctx.block * kBlockBytes);
    auto dst = reinterpret_cast<__gm__ uint32_t *>(own + ctx.block * kBlockBytes + 4096);
    auto remote = reinterpret_cast<__gm__ uint32_t *>(peer + ctx.block * kBlockBytes + 4096);
    auto flags = reinterpret_cast<__gm__ uint64_t *>(own + kFlagBase + ctx.block * 4096);
    auto peerFlags = reinterpret_cast<__gm__ uint64_t *>(peer + kFlagBase + ctx.block * 4096);
    for (unsigned i = 0; i < kWords; ++i) {
        src[i] = ctx.rank * 1000 + i + seq;
        dst[i] = 0;
    }
    Maintain(src, kWords * 4);
    Maintain(dst, kWords * 4);
    if (!Exchange(ctx, flags + 16, peerFlags + 16, seq, true))
        return false;
    for (unsigned i = 0; i < kWords; ++i) {
        const bool lastSignal = (seq & 1) && i + 1 == kWords;
        const bool ok = lastSignal ? smem_shm_sdma_put_signal_nbi(gva, src + i, remote + i, 4, peerFlags, seq)
                                   : smem_shm_sdma_put_nbi_at(ctx, src + i, remote + i, 4);
        if (!ok)
            return false;
    }
    if ((!(seq & 1) && !smem_shm_sdma_put_signal_nbi(gva, nullptr, nullptr, 0, peerFlags, seq)) ||
        !smem_shm_sdma_quiet_at(ctx) || !smem_shm_signal_wait_until(flags, SMEM_SHM_CMP_EQ, seq))
        return false;
    Maintain(dst, kWords * 4);
    for (unsigned i = 0; i < kWords; ++i) {
        if (dst[i] != static_cast<uint32_t>((1 - ctx.rank) * 1000 + i + seq))
            return false;
    }
    return Exchange(ctx, flags + 32, peerFlags + 32, seq, true);
}

extern "C" __global__ __aicore__ void SignalApiTest(__gm__ uint8_t *gva, __gm__ uint32_t *status, unsigned mode,
                                                    unsigned rounds)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const auto ctx = smem_shm_sdma_ctx(gva);
    auto own = gva + ctx.rank * ctx.symm;
    auto peer = gva + (1 - ctx.rank) * ctx.symm;
    auto out = status + ctx.block * 16;
    *out = 1;
    auto localFlag = reinterpret_cast<__gm__ uint64_t *>(own + kFlagBase + ctx.block * 4096 + 512);
    auto remoteFlag = reinterpret_cast<__gm__ uint64_t *>(peer + kFlagBase + ctx.block * 4096 + 512);
    bool ok = InvalidArguments(ctx, own, peer, localFlag);
    for (unsigned r = 0; ok && r < rounds; ++r) {
        const uint64_t seq = (uint64_t(mode + 1) << 32) | (r + 1);
        if (mode < 4)
            ok = DataRound<float>(ctx, own, peer, seq, mode);
        else if (mode == 4)
            ok = DataRound<half>(ctx, own, peer, seq, (r & 1) ? 3 : 2);
        else if (mode == 6) {
            ok = smem_shm_sdma_signal_set_nbi(gva, remoteFlag, seq) && smem_shm_sdma_quiet(gva) &&
                 smem_shm_signal_wait_until(localFlag, SMEM_SHM_CMP_EQ, seq) &&
                 smem_shm_sdma_signal_set(gva, remoteFlag + 16, seq) &&
                 smem_shm_signal_wait_until(localFlag + 16, SMEM_SHM_CMP_EQ, seq);
        } else if (mode == 7)
            ok = BurstRound(ctx, gva, own, peer, seq);
        else {
            ok = smem_shm_sdma_put_signal(gva, nullptr, nullptr, 0, remoteFlag, seq) &&
                 smem_shm_signal_wait_until(localFlag, SMEM_SHM_CMP_EQ, seq) &&
                 Exchange(ctx, localFlag + 16, remoteFlag + 16, seq, true);
        }
    }
    *out = ok ? 0 : mode + 10;
    Maintain(out, 4);
}

static int rankId;
static void Check(const char *name, int ret)
{
    if (!ret)
        return;
    fprintf(stderr, "ERROR rank=%d api=%s ret=%d\n", rankId, name, ret);
    MPI_Abort(MPI_COMM_WORLD, 1);
    std::abort();
}

static void RunTests(void *gva, aclrtStream stream, unsigned blocks, unsigned rounds)
{
    uint32_t *status = nullptr;
    Check("allocate status", aclrtMalloc(reinterpret_cast<void **>(&status), 512, ACL_MEM_MALLOC_HUGE_FIRST));
    for (unsigned mode = 0; mode < 8; ++mode) {
        Check("reset status", aclrtMemset(status, 512, 0xFF, 512));
        MPI_Barrier(MPI_COMM_WORLD);
        SignalApiTest<<<blocks, 0, stream>>>(static_cast<uint8_t *>(gva), status, mode, rounds);
        Check("synchronize", aclrtSynchronizeStreamWithTimeout(stream, 120000));
        uint32_t codes[128]{};
        Check("download status", aclrtMemcpy(codes, sizeof(codes), status, sizeof(codes), ACL_MEMCPY_DEVICE_TO_HOST));
        for (unsigned b = 0; b < blocks; ++b)
            Check("signal case", codes[b * 16]);
        printf("PASS rank=%d mode=%u blocks=%u rounds=%u\n", rankId, mode, blocks, rounds);
    }
    aclrtFree(status);
}

int main(int argc, char **argv)
{
    MPI_Init(&argc, &argv);
    int size = 0;
    MPI_Comm_rank(MPI_COMM_WORLD, &rankId);
    MPI_Comm_size(MPI_COMM_WORLD, &size);
    Check("two ranks required", size == 2 ? 0 : 1);
    const int base = getenv("TEST_DEVICE_BASE") ? atoi(getenv("TEST_DEVICE_BASE")) : 0;
    const unsigned blocks = getenv("BLOCKS") ? atoi(getenv("BLOCKS")) : 8;
    const unsigned rounds = getenv("ROUNDS") ? atoi(getenv("ROUNDS")) : 600;
    Check("arguments", base >= 0 && blocks >= 1 && blocks <= 8 && rounds > 0 ? 0 : 1);
    Check("aclInit", aclInit(nullptr));
    Check("set device", aclrtSetDevice(base + rankId));
    Check("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    Check("config", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = rankId == 0;
    const char *url = getenv("STORE_URL") ? getenv("STORE_URL") : "tcp://127.0.0.1:18883";
    Check("shm_init", smem_shm_init(url, 2, rankId, base + rankId, &cfg));
    void *gva = nullptr;
    auto pool = smem_shm_create(0, 2, rankId, 32ULL * 1024 * 1024, SMEMS_DATA_OP_SDMA, 0, &gva);
    Check("create pool", pool && gva ? 0 : 1);
    auto own = static_cast<uint8_t *>(gva) + rankId * smem_shm_get_symmetric_size(pool);
    Check("clear flags", aclrtMemset(own + kFlagBase, 32768, 0, 32768));
    aclrtStream stream = nullptr;
    Check("create stream", aclrtCreateStream(&stream));
    RunTests(gva, stream, blocks, rounds);
    aclrtDestroyStream(stream);
    smem_shm_destroy(pool, 0);
    smem_shm_uninit(0);
    smem_uninit();
    aclrtResetDevice(base + rankId);
    aclFinalize();
    MPI_Finalize();
    return 0;
}
