/* 310P SDMA稳定性测试。
 * 每轮由rank0发送128KiB，rank1修改数据后传回，rank0等待接收通知。
 * host检查收发总耗时及末轮前4个uint32_t，并检查设备同步能否在指定时间内完成。
 * 单轮最大耗时只作为统计输出。接口失败时结束MPI任务，数据或耗时检查失败时返回1。
 */
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <mpi.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

#define STORE_URL "tcp://127.0.0.1:8582" /* 独立配置存储端口，避免与08示例共用 */
#define EX_LOCAL_SIZE (32UL * 1024UL * 1024UL) /* 每个rank分配32MiB */
#define EX_CHUNK_BYTES (128UL * 1024UL)        /* 每轮数据块大小128KiB */
#define EX_CHUNK_WORDS (EX_CHUNK_BYTES / 4u)   /* 每个数据块的uint32_t数量 */
#define EX_INC 0x100u                          /* rank1修改数据时使用的增量 */
#define EX_TAG 0x8Bu                           /* 数据校验标识 */

static int g_rank = -1;

/* AICore测试kernel */
#define EX_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__

EX_AICORE_INLINE void ExCleanRegion(__gm__ uint32_t *base, uint64_t words)
{
    AscendC::GlobalTensor<int32_t> gm;
    const uint64_t bytes = words * 4;
    for (uint64_t off = 0; off < bytes; off += 64) {
        gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(reinterpret_cast<uintptr_t>(base) + off), 16);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(gm);
    }
}

/* 每轮由rank0发送数据，rank1将各uint32_t加上EX_INC后传回。 */
extern "C" __global__ __aicore__ void exStabKernel(__gm__ uint8_t *gva, uint64_t chunkWords)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单个AICore block生产请求 */
    }
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    __gm__ uint8_t *ownSeg = gva + symm * rank;
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);
    smem_shm_sdma_ctx_t sdmaCtx = smem_shm_sdma_ctx(gva); /* 对端接收通知队列信息 */
    __gm__ uint32_t *chunk = reinterpret_cast<__gm__ uint32_t *>(ownSeg);
    if (rank == 0) {
        for (uint64_t i = 0; i < chunkWords; i++) {
            chunk[i] = (EX_TAG << 24) | static_cast<uint32_t>(i);
        }
        ExCleanRegion(chunk, chunkWords);
        (void)smem_shm_sdma_signal_at(sdmaCtx, reinterpret_cast<__gm__ uint8_t *>(chunk),
                                       reinterpret_cast<__gm__ uint8_t *>(peerSeg), chunkWords * 4, 0);
        (void)smem_shm_sdma_quiet_at(sdmaCtx);
        smem_shm_sdma_mail_t m = smem_shm_sdma_wait_any_at(sdmaCtx);
        (void)m;
        return;
    }
    smem_shm_sdma_mail_t m = smem_shm_sdma_wait_any_at(sdmaCtx);
    if (m.status != SMEM_SHM_SDMA_MAIL_OK) {
        return; /* 收到异常通知后结束本轮，由host检查返回数据 */
    }
    __gm__ uint32_t *dst = reinterpret_cast<__gm__ uint32_t *>(m.dst);
    for (uint64_t i = 0; i < m.len / 4; i++) {
        dst[i] = dst[i] + EX_INC;
    }
    ExCleanRegion(dst, m.len / 4);
    (void)smem_shm_sdma_signal_at(sdmaCtx, reinterpret_cast<__gm__ uint8_t *>(dst),
                                   reinterpret_cast<__gm__ uint8_t *>(peerSeg), m.len, m.imm);
}

/* host侧测试控制 */
static void Step(const char *name, int32_t ret)
{
    if (ret != 0) {
        printf("[r%d ERROR] %-28s ret=%d\n", g_rank, name, ret);
        exit(1);
    }
    printf("[r%d OK]   %-28s\n", g_rank, name);
}

static double NowMs()
{
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
}

/* 任一rank调用失败时结束MPI任务，避免对端继续等待同步。 */
static void CheckAcl(const char *api, aclError ret, uint32_t completedRounds)
{
    if (ret != ACL_SUCCESS) {
        printf("[r%d ERROR] %s失败: ret=%d 已完成轮数=%u\n", g_rank, api, static_cast<int>(ret), completedRounds);
        fflush(stdout);
        MPI_Abort(MPI_COMM_WORLD, 1);
        exit(1);
    }
}

int main(int argc, char *argv[])
{
    (void)argv;
    int mpiRet = MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank);
    Step("MPI_Init", mpiRet);
    int worldSize = 0;
    MPI_Comm_size(MPI_COMM_WORLD, &worldSize);
    if (worldSize != 2) {
        printf("expect exactly 2 ranks (mpirun -np 2), got %d\n", worldSize);
        MPI_Finalize();
        return 1;
    }
    const char *roundsEnv = getenv("STRESS_ROUNDS");
    const uint32_t rounds = (roundsEnv != nullptr) ? static_cast<uint32_t>(strtoul(roundsEnv, nullptr, 0)) : 30000u;
    int devId = g_rank; /* 默认设备索引等于rank，可通过DEVICE_ID指定 */
    const char *devEnv = getenv("DEVICE_ID");
    if (devEnv != nullptr) {
        devId = atoi(devEnv);
    }
    printf("[r%d INFO] devId=%d rounds=%u\n", g_rank, devId, rounds);
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1);

    Step("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    Step("smem_shm_config_init", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = (g_rank == 0);
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, static_cast<uint32_t>(g_rank),
                                        static_cast<uint16_t>(devId), &cfg));
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, 2, static_cast<uint32_t>(g_rank), EX_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) {
        printf("[r%d ERROR] smem_shm_create: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    Step("smem_shm_create(SDMA)", 0);
    if (smem_shm_sdma_get_workspace(shm) == nullptr) {
        printf("[r%d ERROR] AICPU SDMA工作区尚未初始化\n", g_rank);
        return 1;
    }
    MPI_Barrier(MPI_COMM_WORLD);

    aclrtStream stream = nullptr;
    CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream), 0);
    int overall = 1;

    /* 每次启动执行一轮收发，两个rank逐轮同步进度。 */
    double maxRoundMs = 0.0;
    const double t0 = NowMs();
    for (uint32_t r = 0; r < rounds; r++) {
        const double rt0 = NowMs();
        exStabKernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva), EX_CHUNK_WORDS);
        CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream), r);
        const double rt = NowMs() - rt0;
        if (rt > maxRoundMs) {
            maxRoundMs = rt;
        }
        MPI_Barrier(MPI_COMM_WORLD);
    }
    const double totalMs = NowMs() - t0;
    /* 总耗时超过轮数对应的预算时，将本次运行判为失败。 */
    const double budgetMs = static_cast<double>(rounds) * 20.0 + 30000.0;
    if (totalMs > budgetMs) {
        printf("[r%d ERROR] 收发总耗时超过上限: actual=%.0fms limit=%.0fms\n", g_rank, totalMs, budgetMs);
        overall = 0;
    }
    printf("[r%d] 收发测试: rounds=%u total=%.0fms avg=%.2fms max=%.2fms\n", g_rank, rounds, totalMs, totalMs / rounds,
           maxRoundMs);
    /* 读取末轮返回数据的前4个uint32_t，检查是否加上EX_INC */
    uint32_t expect[4] = {0, 0, 0, 0};
    CheckAcl("aclrtMemcpy", aclrtMemcpy(expect, sizeof(expect), gva, sizeof(expect), ACL_MEMCPY_DEVICE_TO_HOST),
             rounds);
    for (uint32_t i = 0; i < 4; i++) {
        if (expect[i] != ((EX_TAG << 24) | i) + EX_INC) {
            printf("[r%d ERROR] 末轮数据抽样检查失败: index=%u actual=0x%x expected=0x%x\n", g_rank, i, expect[i],
                   ((EX_TAG << 24) | i) + EX_INC);
            overall = 0;
            break;
        }
    }

    /* 检查AICPU kernel持续运行期间，设备同步能否在90000ms内完成。 */
    {
        const double s0 = NowMs();
        const aclError sret = aclrtSynchronizeDeviceWithTimeout(90000);
        const double syncMs = NowMs() - s0;
        CheckAcl("aclrtSynchronizeDeviceWithTimeout", sret, rounds);
        printf("[r%d] 设备同步完成: %.1fms\n", g_rank, syncMs);
    }

    CheckAcl("aclrtDestroyStream", aclrtDestroyStream(stream), rounds);
    Step("smem_shm_destroy", smem_shm_destroy(shm, 0));
    smem_shm_uninit(0);
    printf("[r%d] smem_shm_uninit调用结束\n", g_rank);
    smem_uninit();
    printf("[r%d] smem_uninit调用结束\n", g_rank);
    CheckAcl("aclrtResetDevice", aclrtResetDevice(devId), rounds);
    CheckAcl("aclFinalize", aclFinalize(), rounds);
    printf("=== 310P SDMA 稳定性测试 r%d %s ===\n", g_rank, overall ? "PASS" : "FAIL");
    MPI_Finalize();
    return overall ? 0 : 1;
}
