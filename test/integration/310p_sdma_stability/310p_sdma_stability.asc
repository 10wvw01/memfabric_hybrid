/* 310p_sdma_stability — 310P 设备发起 SDMA 长稳压测(真机集成测试)
 *
 * 内容来源: 原 examples/08 ③长稳压测 + ④全设备同步探针(检视意见迁入 test/)。
 * 验证目标(两项都是 serve 长驻场景的防回归):
 *   ① 持续收发长稳: 跨搬运 kernel 换轮边界持续 signal/wait/quiet 闭环,
 *      断言零丢失且单轮最大时延 = 换轮间隙量级(v11 分轮修复的回归防线)
 *   ② 全设备同步共存: AclrtSynchronizeDeviceWithTimeout(90s 预算, 对齐
 *      torch_npu 分配器量级)在分轮运行下必须能完成——永不退出的 kernel
 *      会把该同步拖到超时(507017, serve 实测死因), 此探针即该死因的复现防线
 *
 * 判定: 全部 PASS 输出 overall PASS, 退出码 0; 任一失败退出码 1。
 * 用法: STRESS_ROUNDS=30000 bash run.sh(默认 30000 轮约 46 秒)
 */
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <mpi.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

#define STORE_URL "tcp://127.0.0.1:8582" /* 本测试独立端口(与 08 示例 8581 区分) */
#define EX_LOCAL_SIZE (32UL * 1024UL * 1024UL) /* 每 rank 物理贡献 32MB */
#define EX_CHUNK_BYTES (128UL * 1024UL)        /* 单 chunk 128KB */
#define EX_CHUNK_WORDS (EX_CHUNK_BYTES / 4u)   /* 每 chunk 字数 */
#define EX_INC 0x100u                          /* r1 AICore 增量 */
#define EX_TAG 0x8Bu                           /* pattern 标识 */

static int g_rank = -1;

/* ============================ AICore kernel(设备头原语) ============================ */
#define EX_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__

EX_AICORE_INLINE void ExCleanRegion(__gm__ uint32_t *base, uint64_t words)
{
    AscendC::GlobalTensor<int32_t> gm;
    const uint64_t bytes = words * 4;
    for (uint64_t off = 0; off < bytes; off += 64) {
        gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(reinterpret_cast<uintptr_t>(base) + off), 16);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(gm);
    }
}

/* 单 chunk 闭环 kernel(每轮一次 launch, 与原 08 ③ 同构):
 *   rank0 产: 产 chunk + signal → quiet → wait 收回件(终态=原值+INC)
 *   rank1 消费: wait 收件 → 读改写 INC → clean → signal 回件 */
extern "C" __global__ __aicore__ void exStabKernel(__gm__ uint8_t *gva, uint64_t chunkWords)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单 block 纪律 */
    }
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    __gm__ uint8_t *ownSeg = gva + symm * rank;
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);
    __gm__ uint8_t *sdmaRes = smem_shm_sdma_reserved(gva);
    __gm__ uint32_t *chunk = reinterpret_cast<__gm__ uint32_t *>(ownSeg);
    if (rank == 0) {
        for (uint64_t i = 0; i < chunkWords; i++) {
            chunk[i] = (EX_TAG << 24) | static_cast<uint32_t>(i);
        }
        ExCleanRegion(chunk, chunkWords);
        (void)smem_shm_sdma_signal_at(sdmaRes, reinterpret_cast<__gm__ uint8_t *>(chunk),
                                       reinterpret_cast<__gm__ uint8_t *>(peerSeg), chunkWords * 4, 0);
        (void)smem_shm_sdma_quiet_at(sdmaRes);
        smem_shm_sdma_mail_t m = smem_shm_sdma_wait_at(sdmaRes);
        (void)m;
        return;
    }
    smem_shm_sdma_mail_t m = smem_shm_sdma_wait_at(sdmaRes);
    if (m.status != SMEM_SHM_SDMA_MAIL_OK) {
        return; /* 异常即退(host 侧校验暴露) */
    }
    __gm__ uint32_t *dst = reinterpret_cast<__gm__ uint32_t *>(m.dst);
    for (uint64_t i = 0; i < m.len / 4; i++) {
        dst[i] = dst[i] + EX_INC;
    }
    ExCleanRegion(dst, m.len / 4);
    (void)smem_shm_sdma_signal_at(sdmaRes, reinterpret_cast<__gm__ uint8_t *>(dst),
                                   reinterpret_cast<__gm__ uint8_t *>(peerSeg), m.len, m.imm);
}

/* ============================ host 侧 ============================ */
static void Step(const char *name, int32_t ret)
{
    if (ret != 0) {
        printf("[r%d FAIL] %-28s ret=%d\n", g_rank, name, ret);
        exit(1);
    }
    printf("[r%d OK]   %-28s\n", g_rank, name);
}

static double NowMs()
{
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
}

int main(int argc, char *argv[])
{
    (void)argv;
    int mpiRet = MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank);
    Step("MPI_Init", mpiRet);
    int worldSize = 0;
    MPI_Comm_size(MPI_COMM_WORLD, &worldSize);
    if (worldSize != 2) {
        printf("expect exactly 2 ranks (mpirun -np 2), got %d\n", worldSize);
        MPI_Finalize();
        return 1;
    }
    const char *roundsEnv = getenv("STRESS_ROUNDS");
    const uint32_t rounds = (roundsEnv != nullptr) ? static_cast<uint32_t>(strtoul(roundsEnv, nullptr, 0)) : 30000u;
    int devId = g_rank; /* 设备号默认=rank; DEVICE_ID 环境变量可整体偏移到空闲 die 对 */
    const char *devEnv = getenv("DEVICE_ID");
    if (devEnv != nullptr) {
        devId = atoi(devEnv);
    }
    printf("[r%d INFO] devId=%d rounds=%u\n", g_rank, devId, rounds);
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1);

    Step("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    Step("smem_shm_config_init", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = (g_rank == 0);
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, static_cast<uint32_t>(g_rank),
                                        static_cast<uint16_t>(devId), &cfg));
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, 2, static_cast<uint32_t>(g_rank), EX_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) {
        printf("[r%d FAIL] smem_shm_create: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    Step("smem_shm_create(SDMA)", 0);
    if (smem_shm_sdma_get_workspace(shm) == nullptr) {
        printf("[r%d FAIL] sdma orchestration not ready\n", g_rank);
        return 1;
    }
    MPI_Barrier(MPI_COMM_WORLD);

    aclrtStream stream = nullptr;
    (void)aclrtCreateStream(&stream);
    int overall = 1;

    /* ---- ① 持续收发长稳: 跨换轮边界闭环, 断言零丢失 + 单轮时延上界 ---- */
    double maxRoundMs = 0.0;
    const double t0 = NowMs();
    for (uint32_t r = 0; r < rounds; r++) {
        const double rt0 = NowMs();
        exStabKernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva), EX_CHUNK_WORDS);
        const int32_t syncRet = static_cast<int32_t>(aclrtSynchronizeStream(stream));
        if (syncRet != 0) { /* 逐轮静默同步(失败才打印, 免日志洪泛) */
            printf("[r%d FAIL] sync(kernel) 第 %u 轮 ret=%d\n", g_rank, r, syncRet);
            overall = 0;
            break;
        }
        const double rt = NowMs() - rt0;
        if (rt > maxRoundMs) {
            maxRoundMs = rt;
        }
        MPI_Barrier(MPI_COMM_WORLD);
    }
    const double totalMs = NowMs() - t0;
    /* 时延上界断言: 若某轮 wait 落入无消费的死等(换轮失效), 轮询预算(分钟级)会撑爆总时延 */
    const double budgetMs = static_cast<double>(rounds) * 20.0 + 30000.0;
    if (totalMs > budgetMs) {
        printf("[r%d FAIL] ①长稳超时上界: %.0fms > %.0fms (疑似换轮失效死等)\n", g_rank, totalMs, budgetMs);
        overall = 0;
    }
    printf("[r%d] ①长稳×%u: %.0fms (avg %.2fms/轮, max %.2fms/轮, 跨 ≥%.0f 次换班)\n", g_rank, rounds, totalMs,
           totalMs / rounds, maxRoundMs, totalMs / 15000.0);
    /* 终态校验: 末轮回件 = pattern + INC */
    uint32_t expect[4] = {0, 0, 0, 0};
    (void)aclrtMemcpy(expect, sizeof(expect), gva, sizeof(expect), ACL_MEMCPY_DEVICE_TO_HOST);
    for (uint32_t i = 0; i < 4; i++) {
        if (expect[i] != ((EX_TAG << 24) | i) + EX_INC) {
            printf("[r%d FAIL] ①长稳终态失配 [%u]=0x%x\n", g_rank, i, expect[i]);
            overall = 0;
            break;
        }
    }

    /* ---- ② 全设备同步共存探针: 90s 预算(分配器量级)内必须完成 ----
     * 模拟 torch_npu workspace 分配器内部的全设备同步; 判据=完成即过——
     * 超时即把任务标记死亡(507017, serve 死因), 池报废。分轮运行下
     * 等待=当前轮剩余(≤每轮时长), 换轮间隙的瞬时返回属正常。 */
    {
        const double s0 = NowMs();
        const aclError sret = aclrtSynchronizeDeviceWithTimeout(90000);
        const double syncMs = NowMs() - s0;
        if (sret != ACL_SUCCESS) {
            printf("[r%d FAIL] ②设备同步超时(epoch 被阻塞或预算击穿): ret=%d, %.0fms\n", g_rank,
                   static_cast<int>(sret), syncMs);
            overall = 0;
        } else {
            printf("[r%d] ②设备同步: %.1fms PASS(分轮运行可完成, 等待=轮数×每轮时长)\n", g_rank, syncMs);
        }
    }

    (void)aclrtDestroyStream(stream);
    Step("smem_shm_destroy", smem_shm_destroy(shm, 0));
    smem_shm_uninit(0);
    Step("smem_shm_uninit", 0);
    smem_uninit();
    Step("smem_uninit", 0);
    (void)aclrtResetDevice(devId);
    (void)aclFinalize();
    printf("=== 310P SDMA 长稳 r%d %s ===\n", g_rank, overall ? "PASS" : "FAIL");
    MPI_Finalize();
    return overall ? 0 : 1;
}
