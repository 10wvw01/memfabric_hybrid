#include <cstdio>
#include <cstdint>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "smem_shm_aicore_base_api.h"

namespace {
constexpr uint64_t REQUEST = 0;
constexpr uint64_t READY = 64;
constexpr uint64_t DONE = 128;
constexpr uint64_t TOKEN = 192;
constexpr uint64_t DATA = 4096;
constexpr uint64_t POLL_LIMIT = 20000000;

__aicore__ inline void Cache(__gm__ uint8_t *address, uint64_t bytes)
{
    for (uint64_t i = 0; i < bytes; i += 64) {
        AscendC::GlobalTensor<int32_t> line;
        line.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(address + i), 16);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(line);
    }
}

__aicore__ inline uint32_t Read(__gm__ uint8_t *address)
{
    Cache(address, 64);
    return *reinterpret_cast<__gm__ volatile uint32_t *>(address);
}

__aicore__ inline bool Wait(__gm__ uint8_t *address, uint32_t epoch, __gm__ uint32_t *result)
{
    for (uint64_t i = 0; i < POLL_LIMIT; ++i) {
        if (Read(address) == epoch) return true;
    }
    result[0] = 10;
    return false;
}

// 每个控制槽只有一个写入方，使用 COPY 发布通知即可。
__aicore__ inline bool Notify(const smem_shm_sdma_ctx_t &ctx, __gm__ uint8_t *own,
                             __gm__ uint8_t *peer, uint64_t offset, uint32_t epoch,
                             __gm__ uint32_t *result)
{
    *reinterpret_cast<__gm__ uint32_t *>(own + TOKEN) = epoch;
    Cache(own + TOKEN, 64);
    if (smem_shm_sdma_put_at(ctx, own + TOKEN, peer + offset, 4)) return true;
    result[0] = 11;
    return false;
}

__aicore__ inline uint32_t Pattern(uint32_t rank, uint32_t epoch, uint64_t index)
{
    return 0x12340000u ^ (rank * 0x87654321u) ^ (epoch * 0x9e3779b9u) ^ uint32_t(index);
}

__aicore__ inline bool Produce(const smem_shm_sdma_ctx_t &ctx, __gm__ uint8_t *own,
                              __gm__ uint8_t *peer, uint64_t bytes, uint32_t epoch,
                              __gm__ uint32_t *result)
{
    result[2] = 1;
    if (!Wait(own + REQUEST, epoch, result)) return false;
    // 延迟生产数据，使消费方实际经历等待就绪的过程。
    for (uint32_t i = 0; i < (epoch % 2 ? 100000u : 20000u); ++i) {
        __asm__ __volatile__("" ::: "memory");
    }
    auto source = reinterpret_cast<__gm__ uint32_t *>(own + DATA);
    for (uint64_t i = 0; i < bytes / 4; ++i) source[i] = Pattern(ctx.rank, epoch, i);
    Cache(own + DATA, bytes);
    result[2] = 2;
    if (!Notify(ctx, own, peer, READY, epoch, result)) return false;
    // 收到消费完成通知后才能覆盖源数据。
    result[2] = 3;
    if (!Wait(own + DONE, epoch, result)) return false;
    result[6]++;
    return true;
}

__aicore__ inline bool Consume(const smem_shm_sdma_ctx_t &ctx, __gm__ uint8_t *own,
                              __gm__ uint8_t *peer, uint64_t bytes, uint32_t epoch,
                              __gm__ uint32_t *result)
{
    result[2] = 4;
    // 本端发出 REQUEST 后，生产方才允许发布本轮数据。
    if (Read(own + READY) == epoch) { result[0] = 12; return false; }
    result[5]++;
    auto target = reinterpret_cast<__gm__ uint32_t *>(own + DATA + bytes);
    for (uint64_t i = 0; i < bytes / 4; ++i) target[i] = ~Pattern(1 - ctx.rank, epoch, i);
    Cache(own + DATA + bytes, bytes);
    if (!Notify(ctx, own, peer, REQUEST, epoch, result)) return false;
    if (!Wait(own + READY, epoch, result)) return false;
    result[2] = 5;
    if (!smem_shm_sdma_get_at(ctx, peer + DATA, own + DATA + bytes, bytes)) {
        result[0] = 13;
        return false;
    }
    Cache(own + DATA + bytes, bytes);
    for (uint64_t i = 0; i < bytes / 4; ++i) {
        if (target[i] != Pattern(1 - ctx.rank, epoch, i)) {
            result[0] = 14;
            result[3] = uint32_t(i);
            result[4] = target[i];
            return false;
        }
    }
    result[7]++;
    return Notify(ctx, own, peer, DONE, epoch, result);
}
}  // namespace

extern "C" __global__ __aicore__ void exchange(__gm__ uint8_t *gva, __gm__ uint32_t *result,
                                              uint64_t bytes, uint32_t rounds)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const auto ctx = smem_shm_sdma_ctx(gva);
    auto own = gva + ctx.rank * ctx.symm;
    auto peer = gva + (1 - ctx.rank) * ctx.symm;
    for (uint32_t i = 0; i < 8; ++i) result[i] = 0;
    result[0] = 1;
    for (uint32_t epoch = 1; epoch <= rounds; ++epoch) {
        result[1] = epoch;
        bool ok = ctx.rank == epoch % 2 ? Produce(ctx, own, peer, bytes, epoch, result) :
                                         Consume(ctx, own, peer, bytes, epoch, result);
        if (!ok) return;
    }
    result[0] = 0;
}

extern "C" __global__ __aicore__ void initialize_controls(__gm__ uint8_t *gva)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const auto ctx = smem_shm_sdma_ctx(gva);
    auto own = gva + ctx.rank * ctx.symm;
    for (uint64_t i = 0; i < DATA; i += 4) *reinterpret_cast<__gm__ uint32_t *>(own + i) = 0;
    Cache(own, DATA);
}

extern "C" int prepare_controls(void *pool)
{
    aclrtStream stream = nullptr;
    int ret = aclrtCreateStream(&stream);
    if (!ret) {
        initialize_controls<<<1, 0, stream>>>(static_cast<uint8_t *>(pool));
        ret = aclrtSynchronizeStreamWithTimeout(stream, 60000);
        aclrtDestroyStream(stream);
    }
    if (ret) fprintf(stderr, "ERROR prepare_controls ACL ret=%d\n", ret);
    return ret;
}

extern "C" int run_exchange(void *pool, int rank, uint64_t bytes, uint32_t rounds)
{
    aclrtStream stream = nullptr;
    uint32_t *deviceResult = nullptr;
    int ret = aclrtCreateStream(&stream);
    if (!ret) ret = aclrtMalloc(reinterpret_cast<void **>(&deviceResult), 32, ACL_MEM_MALLOC_HUGE_FIRST);
    if (!ret) {
        exchange<<<1, 0, stream>>>(static_cast<uint8_t *>(pool), deviceResult, bytes, rounds);
        ret = aclrtSynchronizeStreamWithTimeout(stream, 120000);
    }
    uint32_t result[8] = {};
    if (!ret) ret = aclrtMemcpy(result, sizeof(result), deviceResult, sizeof(result), ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret || result[0] || result[5] != (rounds + (rank == 0)) / 2 ||
        result[6] + result[7] != rounds || result[5] != result[7]) {
        fprintf(stderr, "ERROR rank=%d ACL=%d code=%u epoch=%u stage=%u index=%u actual=%u "
                        "not_ready=%u produced=%u consumed=%u\n", rank, ret, result[0], result[1],
                        result[2], result[3], result[4], result[5], result[6], result[7]);
        ret = 1;
    }
    if (deviceResult) aclrtFree(deviceResult);
    if (stream) aclrtDestroyStream(stream);
    if (!ret) printf("PASS rank=%d rounds=%u bytes=%lu not_ready=%u produced=%u consumed=%u "
                     "data_kernel_launches=1 full_payload_checked=1\n", rank, rounds, bytes,
                     result[5], result[6], result[7]);
    return ret;
}
