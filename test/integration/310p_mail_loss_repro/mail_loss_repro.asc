/* 310P 批量传输完成与 epoch 重启测试。
 * 数据 put 后等待 quiet，再发布应用就绪状态、校验数据并回传消费确认。
 * 发送方收到确认后才复用缓冲区，避免覆盖接收方仍在读取的数据。
 * Host 故障注入沿用原状态结构及退出行为。
 */
#include <chrono>
#include <csignal>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>
#include <mpi.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "../../../examples/memory_pool/01_basic/sdma_ready.h"
#include "hybm_sdma_contract.h"

constexpr uint64_t EX09_READY_OFF = 48UL * 1024 * 1024;
constexpr uint64_t EX09_ACK_OFF = 52UL * 1024 * 1024;

#define STORE_URL "tcp://127.0.0.1:8593"       /* 独立配置存储端口，避免与08示例共用。 */
#define EX_LOCAL_SIZE (64UL * 1024UL * 1024UL) /* 每 rank 物理贡献 64MB */
/* 每轮发送的数据块数，默认4。 */
#define EX_SEND_OFF (0UL)                      /* 发送区基址(own 段内) */
#define EX_RECV_OFF (16UL * 1024UL * 1024UL)   /* 接收区与发送区分开，避免覆盖仍待发送的数据。 */
#define EX_TAG 0x9Eu                           /* pattern 标识 */
#define EX_STAT_MAGIC 0x4558303953544154ULL    /* "EX09STAT" */
#define EX_STAT_PROGRESS_OFF 8                 /* offsetof(Ex09Stat, progress) */

static int g_rank = -1;
static volatile sig_atomic_t g_stop = 0;

/* AICore 测试 kernel */
#define EX_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__

/* host 读取的设备状态；统计值在多次 kernel 执行之间累计。 */
struct Ex09Stat {
    uint64_t magic;        /* 状态标识 */
    uint64_t progress;     /* 所有等待循环累计的轮询进度 */
    uint64_t gensDone;
    uint64_t mailsSent;
    uint64_t mailsRecv;
    uint64_t waitPollsTotal;
    uint64_t waitPollsMax;
    uint64_t waitPollsLast;
    uint32_t state;        /* 运行状态及失败时的位置 */
    uint32_t stuckGen;
    uint64_t stuckHead;    /* 失败时的接收通知消费位置 */
    uint64_t stuckExpect;  /* 期望的接收就绪序号，等于 head+1 */
    uint64_t stuckSlot;    /* 正在等待的接收就绪序号数组下标 */
    uint64_t stuckStamp;   /* 失败时读取的接收就绪序号 */
    uint64_t stuckMailF0;  /* 失败时的接收通知字段 */
    uint64_t stuckMailF1;
    uint64_t stuckMailF2;
    uint64_t stuckMailF3;
    uint64_t stuckReqTail; /* reqTail 请求生产位置 */
    uint64_t stuckReqHead; /* reqHead 请求消费位置 */
    uint64_t stuckPolls;   /* 失败前的轮询次数 */
    uint64_t reserved;
};

/* 清理并失效一个缓存行，使 AICore 与 host 读取到更新后的状态。 */
EX_AICORE_INLINE void Ex09FlushLine(__gm__ void *p)
{
    AscendC::GlobalTensor<int32_t> t;
    t.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(p), 2);
    AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(t);
}

/* 每轮询65536次更新进度，供 host 检查运行状态。 */
EX_AICORE_INLINE void Ex09Beat(__gm__ uint8_t *statBase, uint64_t v)
{
    *reinterpret_cast<__gm__ volatile uint64_t *>(statBase + EX_STAT_PROGRESS_OFF) = v;
    Ex09FlushLine(statBase + EX_STAT_PROGRESS_OFF);
}

EX_AICORE_INLINE void Ex09CommitStuck(__gm__ uint8_t *statBase, const smem_shm_sdma_ctx_t &ctx,
    uint32_t state, uint32_t gen, uint64_t slot, uint64_t stamp, uint64_t polls)
{
    auto st = reinterpret_cast<__gm__ Ex09Stat *>(statBase);
    st->state = state;
    st->stuckGen = gen;
    st->stuckHead = gen;
    st->stuckExpect = gen + 1;
    st->stuckSlot = slot;
    st->stuckStamp = stamp;
    st->stuckPolls = polls;
    const uint64_t queue = SmemShmSdmaQueueIdx(0, ctx.block);
    st->stuckReqTail = SdmaReadCell(ctx.res, SMEM_SHM_SDMA_RS_REQ_TAIL +
        queue * SMEM_SHM_SDMA_RS_CURSOR_STRIDE);
    st->stuckReqHead = SdmaReadCell(ctx.res, SMEM_SHM_SDMA_RS_REQ_HEAD +
        queue * SMEM_SHM_SDMA_RS_CURSOR_STRIDE);
    for (uint64_t off = 0; off < sizeof(Ex09Stat); off += 64) Ex09FlushLine(statBase + off);
}

EX_AICORE_INLINE bool Ex09WaitReady(__gm__ uint8_t *own, uint64_t offset, uint64_t expected,
    uint64_t budget, __gm__ uint8_t *statBase, uint64_t *progress, uint64_t *polls, uint64_t *stamp)
{
    auto flag = own + offset;
    for (*polls = 0; *polls < budget; ++*polls) {
        Ex09FlushLine(flag);
        *stamp = *reinterpret_cast<__gm__ volatile uint64_t *>(flag);
        if (*stamp == expected) return true;
        if ((*polls & 0xFFFFu) == 0) {
            *progress += 0x10000u;
            Ex09Beat(statBase, *progress);
        }
    }
    return false;
}

EX_AICORE_INLINE bool Ex09SendBurst(__gm__ uint8_t *own, __gm__ uint8_t *peer,
    const smem_shm_sdma_ctx_t &ctx, __gm__ uint8_t *statBase, uint32_t gen, uint32_t chunks,
    uint64_t chunkBytes, uint64_t budget, uint64_t *sent, uint64_t *progress)
{
    for (uint32_t c = 0; c < chunks; ++c) {
        uint64_t polls = 0, stamp = 0;
        if (gen && !Ex09WaitReady(own, EX09_ACK_OFF + c * 128, gen, budget, statBase,
                                 progress, &polls, &stamp)) {
            Ex09CommitStuck(statBase, ctx, 1, gen, c, stamp, polls);
            return false;
        }
        auto src = reinterpret_cast<__gm__ uint32_t *>(own + EX_SEND_OFF + c * chunkBytes);
        src[0] = (EX_TAG << 24) | (gen << 8) | c;
        src[1] = gen;
        SdmaMaintainCache(src, chunkBytes);
        if (!smem_shm_sdma_put_nbi_at(ctx, src, peer + EX_RECV_OFF + c * chunkBytes, chunkBytes)) {
            Ex09CommitStuck(statBase, ctx, 2, gen, c, 0, 0);
            return false;
        }
        ++*sent;
    }
    if (!smem_shm_sdma_quiet_at(ctx)) {
        Ex09CommitStuck(statBase, ctx, 4, gen, 0, 0, 0);
        return false;
    }
    for (uint32_t c = 0; c < chunks; ++c) {
        const uint64_t flag = EX09_READY_OFF + c * 128;
        if (!SdmaPublishReady(ctx, own, peer, flag, flag, gen + 1)) {
            Ex09CommitStuck(statBase, ctx, 2, gen, c, 0, 0);
            return false;
        }
    }
    return true;
}

EX_AICORE_INLINE bool Ex09RecvLoop(__gm__ uint8_t *own, __gm__ uint8_t *peer,
    const smem_shm_sdma_ctx_t &ctx, __gm__ uint8_t *statBase, uint32_t gen, uint32_t chunks,
    uint64_t chunkBytes, uint64_t budget, uint64_t *recv, uint64_t *pollsTotal,
    uint64_t *pollsMax, uint64_t *progress)
{
    for (uint32_t c = 0; c < chunks; ++c) {
        uint64_t polls = 0, stamp = 0;
        const bool ready = Ex09WaitReady(own, EX09_READY_OFF + c * 128, gen + 1, budget,
                                        statBase, progress, &polls, &stamp);
        *pollsTotal += polls;
        if (polls > *pollsMax) *pollsMax = polls;
        reinterpret_cast<__gm__ Ex09Stat *>(statBase)->waitPollsLast = polls;
        if (!ready) {
            Ex09CommitStuck(statBase, ctx, 1, gen, c, stamp, polls);
            return false;
        }
        auto dst = reinterpret_cast<__gm__ uint32_t *>(own + EX_RECV_OFF + c * chunkBytes);
        SdmaMaintainCache(dst, chunkBytes);
        if (dst[0] != ((EX_TAG << 24) | (gen << 8) | c) || dst[1] != gen) {
            Ex09CommitStuck(statBase, ctx, 6, gen, c, stamp, polls);
            return false;
        }
        const uint64_t flag = EX09_ACK_OFF + c * 128;
        if (!SdmaPublishReady(ctx, own, peer, flag, flag, gen + 1)) {
            Ex09CommitStuck(statBase, ctx, 2, gen, c, 0, 0);
            return false;
        }
        ++*recv;
    }
    return true;
}

/* 每次执行 batchGens 轮。队列位置和累计统计保存在全局内存中，供后续 kernel 执行使用。 */
extern "C" __global__ __aicore__ void SdmaBatchTransferKernel(__gm__ uint8_t *gva, __gm__ Ex09Stat *stat,
                                                 uint64_t chunkBytes, uint32_t batchGens,
                                                 uint64_t waitBudget, uint32_t chunks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 只允许一个 AICore block 生产请求，避免并发写入同一队列。 */
    }
    __gm__ uint8_t *statBase = reinterpret_cast<__gm__ uint8_t *>(stat);
    for (uint64_t off = 0; off < sizeof(Ex09Stat); off += 64) {
        Ex09FlushLine(statBase + off); /* 执行前失效缓存，读取 host 或前一次 kernel 保存的状态。 */
    }
    __gm__ Ex09Stat *st = stat;
    uint64_t gensDone = 0, sent = 0, recv = 0, pollsTotal = 0, pollsMax = 0, progress = 0;
    if (st->magic == EX_STAT_MAGIC) { /* 保留前一次 kernel 执行的累计计数 */
        gensDone = st->gensDone;
        sent = st->mailsSent;
        recv = st->mailsRecv;
        pollsTotal = st->waitPollsTotal;
        pollsMax = st->waitPollsMax;
        progress = st->progress;
    } else {
        st->magic = EX_STAT_MAGIC;
        st->state = 0;
        st->gensDone = 0;
        st->mailsSent = 0;
        st->mailsRecv = 0;
        st->waitPollsTotal = 0;
        st->waitPollsMax = 0;
        st->waitPollsLast = 0;
        st->progress = 0;
        for (uint64_t off = 0; off < sizeof(Ex09Stat); off += 64) {
            Ex09FlushLine(statBase + off);
        }
    }
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    __gm__ uint8_t *ownSeg = gva + symm * rank;
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);
    smem_shm_sdma_ctx_t sdmaCtx = smem_shm_sdma_ctx(gva);
    const uint32_t startGen = static_cast<uint32_t>(gensDone);
    for (uint32_t g = startGen; g < startGen + batchGens; g++) {
        const uint64_t budget = waitBudget;
        if (!Ex09SendBurst(ownSeg, peerSeg, sdmaCtx, statBase, g, chunks, chunkBytes, budget, &sent,
                           &progress)) {
            return;
        }
        if (!Ex09RecvLoop(ownSeg, peerSeg, sdmaCtx, statBase, g, chunks, chunkBytes, budget, &recv, &pollsTotal, &pollsMax,
                          &progress)) {
            return;
        }
        gensDone++;
        st->gensDone = gensDone;
        st->mailsSent = sent;
        st->mailsRecv = recv;
        st->waitPollsTotal = pollsTotal;
        st->waitPollsMax = pollsMax;
        st->progress = progress;
        for (uint64_t off = 0; off < sizeof(Ex09Stat); off += 64) {
            Ex09FlushLine(statBase + off);
        }
    }
}

/* host 侧运行控制和调试日志 */

/* AICPU kernel 工作区结果结构，与 hybm_sdma_contract.h 中的布局一致。 */
struct Ex09WsResult {
    uint32_t magic;
    uint32_t mainRet;
    uint32_t consumed;
    uint32_t exitReason;
    uint64_t headAfter;
};
#define EX09_WS_HEARTBEAT_OFF 136
#define EX09_EXIT_RUNNING 0xFFFFFFFFu

struct Ex09Cfg {
    uint32_t deviceBase; /* DEVICE_ID = base + rank */
    uint32_t chunks;     /* 每轮发送的数据块数，默认4。 */
    uint32_t genDelayUs; /* 两次 kernel 执行之间的间隔，单位为微秒。 */
    uint32_t totalGens;
    uint32_t batchGens;
    uint64_t waitBudget; /* 单次 launch 轮询总量上限 */
    uint64_t chunkBytes;
    uint32_t stallSec;   /* 进度无变化的超时时间，单位为秒 */
};

static void Step(const char *name, int32_t ret)
{
    if (ret != 0) {
        printf("[r%d ERROR] %-28s ret=%d\n", g_rank, name, ret);
        exit(1);
    }
    printf("[r%d OK]   %-28s\n", g_rank, name);
}

static double NowMs()
{
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch())
        .count();
}

static uint64_t EnvU64(const char *name, uint64_t dft)
{
    const char *v = getenv(name);
    return (v != nullptr) ? strtoull(v, nullptr, 0) : dft;
}

static Ex09Cfg LoadCfg()
{
    Ex09Cfg c = {};
    c.deviceBase = static_cast<uint32_t>(EnvU64("EX09_DEVICE_BASE", 4)); /* 默认 dev4/dev5 */
    c.chunks = static_cast<uint32_t>(EnvU64("EX09_CHUNKS", 4));
    c.genDelayUs = static_cast<uint32_t>(EnvU64("EX09_GEN_DELAY_US", 0)); /* 0表示不额外等待。 */
    c.totalGens = static_cast<uint32_t>(EnvU64("EX09_TOTAL_GENS", 10000000));
    c.batchGens = static_cast<uint32_t>(EnvU64("EX09_BATCH_GENS", 1)); /* 默认每次 kernel 执行一轮。 */
    c.waitBudget = EnvU64("EX09_WAIT_BUDGET", 10000000ULL);            /* 轮询次数；实际耗时取决于设备。 */
    c.chunkBytes = EnvU64("EX09_CHUNK_BYTES", 128UL * 1024UL);
    c.stallSec = static_cast<uint32_t>(EnvU64("EX09_STALL_S", 60));
    return c;
}

static bool D2H(void *dst, uint64_t size, const void *devSrc)
{
    return aclrtMemcpy(dst, size, const_cast<void *>(devSrc), size, ACL_MEMCPY_DEVICE_TO_HOST) == 0;
}

// Host 读取请求和 quiet 诊断信息；设备传输仅调用公共 API。
static void DumpReserved(const char *tag, Ex09Stat *, uint8_t *resHost)
{
    uint64_t tail = 0, head = 0;
    if (!D2H(&tail, 8, resHost + SMEM_SHM_SDMA_RS_REQ_TAIL) ||
        !D2H(&head, 8, resHost + SMEM_SHM_SDMA_RS_REQ_HEAD)) return;
    printf("[r%d] %s reqTail=%llu reqHead=%llu pending=%llu\n", g_rank, tag,
           (unsigned long long)tail, (unsigned long long)head, (unsigned long long)(tail - head));
}

static void VerdictStuck(Ex09Stat *st, uint8_t *)
{
    if (st->state && st->state != 5)
        printf("[r%d ERROR] state=%u generation=%u slot=%llu expected=%llu actual=%llu\n",
               g_rank, st->state, st->stuckGen, (unsigned long long)st->stuckSlot,
               (unsigned long long)st->stuckExpect, (unsigned long long)st->stuckStamp);
}

/* 输出 AICPU 处理请求时保存的请求描述符、接收通知地址和硬件提交位置。 */
static void DumpOrchDbg(void *ws)
{
    uint8_t *w = static_cast<uint8_t *>(ws);
    uint64_t doorbell = 0, dbRet = 0, ringCnt = 0;
    if (!D2H(&doorbell, sizeof(doorbell), w + ock::mf::HYBM_SDMA_ORCH_WS_DBG_DOORBELL_OFF) ||
        !D2H(&dbRet, sizeof(dbRet), w + ock::mf::HYBM_SDMA_ORCH_WS_DBG_DBRET_OFF) ||
        !D2H(&ringCnt, sizeof(ringCnt), w + ock::mf::HYBM_SDMA_ORCH_WS_DBG_RING_CNT_OFF)) {
        printf("[r%d] 读取 AICPU 调试信息失败（device→host）\n", g_rank);
        return;
    }
    printf("[r%d] AICPU 调试信息: doorbell提交位置=%llu ret=%llu 请求记录累计=%llu条\n",
           g_rank, (unsigned long long)doorbell, (unsigned long long)dbRet,
           (unsigned long long)ringCnt);
    const uint64_t slots = ock::mf::HYBM_SDMA_ORCH_DBG_RING_SLOTS;
    const uint64_t n = (ringCnt < slots) ? ringCnt : slots;
    const uint64_t first = ringCnt - n;
    for (uint64_t i = 0; i < n; i++) {
        const uint64_t idx = first + i;
        ock::mf::HybmSdmaOrchDbgMail e{};
        (void)D2H(&e, sizeof(e), w + ock::mf::HYBM_SDMA_ORCH_WS_DBG_RING_OFF + (idx % slots) * sizeof(e));
        const bool emptyReq = (e.reqF0 == 0 && e.reqF1 == 0 && e.reqF2 == 0 && e.reqF3 == 0);
        printf("[r%d]   请求记录 seq=%llu src=0x%llx dst=0x%llx len=%llu tag=0x%llx%s "
               "reserved=0x%llx sqTail=%llu→%llu\n",
               g_rank, (unsigned long long)e.seq, (unsigned long long)e.reqF0, (unsigned long long)e.reqF1,
               (unsigned long long)e.reqF2, (unsigned long long)e.reqF3,
               emptyReq ? " 请求描述符的四个字段均为0" : "", (unsigned long long)e.reserved,
               (unsigned long long)e.sqTailBefore, (unsigned long long)e.sqTailAfter);
    }
}
static void DumpStat(const char *tag, Ex09Stat *st)
{
    printf("[r%d] %s stat: state=%u gen=%u gensDone=%llu sent=%llu recv=%llu pollsMax=%llu "
           "pollsLast=%llu stuck(head=%llu expect=%llu slot=%llu stamp=%llu reqTail=%llu reqHead=%llu)\n",
           g_rank, tag, st->state, st->stuckGen, (unsigned long long)st->gensDone,
           (unsigned long long)st->mailsSent, (unsigned long long)st->mailsRecv,
           (unsigned long long)st->waitPollsMax, (unsigned long long)st->waitPollsLast,
           (unsigned long long)st->stuckHead, (unsigned long long)st->stuckExpect,
           (unsigned long long)st->stuckSlot, (unsigned long long)st->stuckStamp,
           (unsigned long long)st->stuckReqTail, (unsigned long long)st->stuckReqHead);
    printf("[r%d] %s 接收通知快照: seq=%llu dst=0x%llx len=%llu tag=0x%llx\n", g_rank, tag,
           (unsigned long long)st->stuckMailF0, (unsigned long long)st->stuckMailF1,
           (unsigned long long)st->stuckMailF2, (unsigned long long)st->stuckMailF3);
}

static void HandleSigint(int)
{
    g_stop = 1;
}

/* 本地失败时结束整个MPI任务，避免对端继续等待。 */
static int AbortTestRun()
{
    fflush(stdout);
    MPI_Abort(MPI_COMM_WORLD, 1);
    return 1;
}

/* 逐次执行 AICore kernel 并读取状态；单轮模式下用 MPI 同步两个 rank。 */
static int RunStress(const Ex09Cfg &cfg, void *gva, uint8_t *resHost, void *statDev, void *ws)
{
    aclrtStream stream = nullptr;
    const int32_t createRet = static_cast<int32_t>(aclrtCreateStream(&stream));
    if (createRet != 0) {
        printf("[r%d ERROR] 创建测试stream失败: aclrtCreateStream ret=%d\n", g_rank, createRet);
        return AbortTestRun();
    }
    Ex09Stat st = {};
    Ex09WsResult wsR = {};
    double t0 = NowMs();
    double tStat = t0;
    double tStall = t0;
    uint64_t lastProgress = 0, lastGens = 0, boundaries = 0, lastHeartbeat = 0;
    uint32_t lastExit = EX09_EXIT_RUNNING;
    while (!g_stop) {
        const uint32_t remaining = (st.gensDone < cfg.totalGens) ? (cfg.totalGens - st.gensDone) : 0;
        const uint32_t batch = (remaining < cfg.batchGens) ? remaining : cfg.batchGens;
        if (batch == 0) {
            break;
        }
        SdmaBatchTransferKernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva), static_cast<Ex09Stat *>(statDev),
                                     cfg.chunkBytes, batch, cfg.waitBudget, cfg.chunks);
        const int32_t syncRet = static_cast<int32_t>(aclrtSynchronizeStream(stream));
        if (syncRet != 0) { /* 正常同步时不打印，避免每轮产生重复日志。 */
            printf("[r%d ERROR] 同步测试kernel失败: aclrtSynchronizeStream ret=%d\n", g_rank, syncRet);
            return AbortTestRun();
        }
        if (!D2H(&st, sizeof(st), statDev)) {
            printf("[r%d ERROR] 读取运行状态失败（device→host）\n", g_rank);
            return AbortTestRun();
        }
        (void)D2H(&wsR, sizeof(wsR), ws);
        uint64_t heartbeat = lastHeartbeat;
        (void)D2H(&heartbeat, 8, static_cast<uint8_t *>(ws) + EX09_WS_HEARTBEAT_OFF);
        // 监督线程在启动下一轮 epoch 前重置心跳。
        if (heartbeat < lastHeartbeat ||
            (lastExit != EX09_EXIT_RUNNING && wsR.exitReason == EX09_EXIT_RUNNING)) {
            boundaries++; /* 观察到 AICPU kernel 从退出状态转为运行状态。 */
        }
        lastHeartbeat = heartbeat;
        lastExit = wsR.exitReason;
        if (st.state != 0) {
            break;
        }
        if (cfg.batchGens <= 1) {
            MPI_Barrier(MPI_COMM_WORLD); /* 同步两个 rank 的执行进度。 */
        }
        if (cfg.genDelayUs > 0) { /* 按配置等待，控制请求发送频率。 */
            usleep(cfg.genDelayUs);
        }
        const double now = NowMs();
        if (st.progress != lastProgress || st.gensDone != lastGens) {
            lastProgress = st.progress;
            lastGens = st.gensDone;
            tStall = now;
        } else if ((now - tStall) / 1000.0 > cfg.stallSec) {
            printf("[r%d ERROR] 运行进度超过%us未更新(state=%u)\n", g_rank, cfg.stallSec, st.state);
            return AbortTestRun();
        }
        if (now - tStat > 5000.0) {
            tStat = now;
            printf("[r%d] %6.0fs gens=%llu (%.0f/s) pollsMax=%llu pollsLast=%llu 观察到的AICPU重启次数=%llu\n", g_rank,
                   (now - t0) / 1000.0, (unsigned long long)st.gensDone,
                   st.gensDone / ((now - t0) / 1000.0), (unsigned long long)st.waitPollsMax,
                   (unsigned long long)st.waitPollsLast, (unsigned long long)boundaries);
        }
    }
    printf("[r%d] 运行结束: %.0fs 观察到的AICPU重启次数=%llu\n", g_rank, (NowMs() - t0) / 1000.0,
           (unsigned long long)boundaries);
    DumpStat("终态", &st);
    DumpReserved("终态", &st, resHost);
    DumpOrchDbg(ws);
    VerdictStuck(&st, resHost);
    const uint64_t expectedMessages = static_cast<uint64_t>(cfg.totalGens) * cfg.chunks;
    if (g_stop || (st.state != 0 && st.state != 5) || st.gensDone != cfg.totalGens ||
        st.mailsSent != expectedMessages || st.mailsRecv != expectedMessages) {
        printf("[r%d ERROR] 运行结果检查失败: interrupted=%d state=%u gensDone=%llu expectedGens=%u "
               "sent=%llu recv=%llu expectedMessages=%llu\n",
               g_rank, static_cast<int>(g_stop), st.state, (unsigned long long)st.gensDone, cfg.totalGens,
               (unsigned long long)st.mailsSent, (unsigned long long)st.mailsRecv,
               (unsigned long long)expectedMessages);
        return AbortTestRun();
    }
    const int32_t destroyRet = static_cast<int32_t>(aclrtDestroyStream(stream));
    if (destroyRet != 0) {
        printf("[r%d ERROR] 销毁测试stream失败: aclrtDestroyStream ret=%d\n", g_rank, destroyRet);
        return AbortTestRun();
    }
    return 0;
}

/* 汇总两个 rank 的结果。失败时通过 MPI_Abort 退出，避免设备异常导致清理操作阻塞。 */
static int FinalVerdict(int localBad)
{
    int peerBad = 0;
    MPI_Barrier(MPI_COMM_WORLD);
    MPI_Sendrecv(&localBad, 1, MPI_INT, 1 - g_rank, 0, &peerBad, 1, MPI_INT, 1 - g_rank, 0,
                 MPI_COMM_WORLD, MPI_STATUS_IGNORE);
    const int bad = (localBad || peerBad) ? 1 : 0;
    if (g_rank == 0) {
        printf("=== EX09 测试结果: r0=%s r1=%s → %s ===\n", localBad ? "异常" : "正常",
               peerBad ? "异常" : "正常", bad ? "检测到异常，请检查状态码和调试日志" : "本次运行未检测到异常");
    }
    if (bad) {
        fflush(stdout);
        MPI_Abort(MPI_COMM_WORLD, 1); /* 设备异常时直接结束 MPI 任务。 */
    }
    return 0;
}

int main(int argc, char *argv[])
{
    (void)argv;
    int mpiRet = MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank);
    Step("MPI_Init", mpiRet);
    int worldSize = 0;
    MPI_Comm_size(MPI_COMM_WORLD, &worldSize);
    if (worldSize != 2) {
        printf("expect exactly 2 ranks (mpirun -np 2), got %d\n", worldSize);
        MPI_Finalize();
        return 1;
    }
    const Ex09Cfg cfg = LoadCfg();
    if (cfg.chunks == 0 || cfg.chunks > 128 || cfg.chunkBytes < 8 || cfg.chunkBytes % 4 ||
        cfg.chunkBytes > (16UL * 1024 * 1024) / cfg.chunks || cfg.batchGens == 0) {
        printf("[r%d ERROR] invalid chunks, chunk bytes or batch size\n", g_rank);
        MPI_Abort(MPI_COMM_WORLD, 1);
    }
    const int devId = static_cast<int>(cfg.deviceBase) + g_rank;
    printf("[r%d INFO] devId=%d totalGens=%u batch=%u chunks=%u chunk=%lluKB budget=%lluM\n", g_rank, devId,
           cfg.totalGens, cfg.batchGens, cfg.chunks, (unsigned long long)(cfg.chunkBytes / 1024),
           (unsigned long long)(cfg.waitBudget / 1000000ULL));
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1);
    signal(SIGINT, HandleSigint);

    Step("smem_init", smem_init(0));
    smem_shm_config_t sCfg;
    Step("smem_shm_config_init", smem_shm_config_init(&sCfg));
    sCfg.startConfigStoreServer = (g_rank == 0);
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, static_cast<uint32_t>(g_rank),
                                        static_cast<uint16_t>(devId), &sCfg));
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, 2, static_cast<uint32_t>(g_rank), EX_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) {
        printf("[r%d ERROR] smem_shm_create: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    Step("smem_shm_create(SDMA)", 0);
    void *ws = smem_shm_sdma_get_workspace(shm);
    if (ws == nullptr) {
        printf("[r%d ERROR] AICPU SDMA工作区尚未初始化\n", g_rank);
        return 1;
    }
    const uint64_t symm = smem_shm_get_symmetric_size(shm);
    uint8_t *resHost = static_cast<uint8_t *>(gva) + symm * g_rank +
                       (EX_LOCAL_SIZE - SMEM_SHM_SDMA_RESERVED);
    void *statDev = nullptr;
    Step("stat alloc", aclrtMalloc(&statDev, 4096, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS ? 0 : 1);
    Step("stat memset", aclrtMemset(statDev, 4096, 0, 4096) == ACL_SUCCESS ? 0 : 1);
    auto own = static_cast<uint8_t *>(gva) + symm * g_rank;
    Step("ready clear", aclrtMemset(own + EX09_READY_OFF, cfg.chunks * 128, 0, cfg.chunks * 128));
    Step("ack clear", aclrtMemset(own + EX09_ACK_OFF, cfg.chunks * 128, 0, cfg.chunks * 128));
    MPI_Barrier(MPI_COMM_WORLD);

    const int bad = RunStress(cfg, gva, resHost, statDev, ws);
    const int final = FinalVerdict(bad);

    (void)aclrtFree(statDev);
    Step("smem_shm_destroy", smem_shm_destroy(shm, 0));
    smem_shm_uninit(0);
    Step("smem_shm_uninit", 0);
    smem_uninit();
    Step("smem_uninit", 0);
    (void)aclrtResetDevice(devId);
    (void)aclFinalize();
    MPI_Finalize();
    return final;
}
