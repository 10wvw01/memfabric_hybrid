#include <cstdio>
#include <mpi.h>
#include <filesystem>
#include <cstdlib>
#include <cstdint>
#include <vector>
#include <unistd.h>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

extern "C" __global__ __aicore__ void exchange(__gm__ uint8_t *gva, __gm__ uint32_t *result,
                                             uint64_t bytes, uint64_t tag)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    const auto rank = smem_shm_get_global_rank(0);
    const auto symm = smem_shm_get_symmetric_size(0);
    auto src = gva + rank * symm;
    auto dst = gva + (1 - rank) * symm + bytes;
    result[0] = 1;
    if (!smem_shm_sdma_signal(gva, src, dst, bytes, tag)) return;
    result[0] = 2;
    auto mail = smem_shm_sdma_wait(gva, 1 - rank);
    if (mail.status != SMEM_SHM_SDMA_MAIL_OK || mail.len != bytes ||
        mail.imm != tag || mail.peer != 1 - rank ||
        mail.dst != reinterpret_cast<uint64_t>(src + bytes)) return;
    result[0] = 3;
    if (!smem_shm_sdma_quiet(gva)) return;
    result[0] = 0;
}

static int rankId;
static void check(const char *api, int ret)
{
    if (ret == 0) return;
    fprintf(stderr, "ERROR rank=%d api=%s ret=%d detail=%s\n",
            rankId, api, ret, smem_get_last_err_msg());
    exit(1);
}

static uint32_t pattern(int rank, size_t index, unsigned round)
{
    return 0x12340000u ^ (rank * 0x87654321u) ^ (index * 2654435761u) ^ round;
}

static void transfer(smem_shm_t shm, uint8_t *gva, aclrtStream stream,
                     uint32_t *status, size_t bytes, unsigned rounds)
{
    const auto symm = smem_shm_get_symmetric_size(shm);
    auto own = gva + rankId * symm;
    std::vector<uint32_t> input(bytes / 4), output(bytes / 4);
    for (unsigned r = 0; r < rounds; ++r) {
        for (size_t i = 0; i < input.size(); ++i) input[i] = pattern(rankId, i, r);
        check("upload", aclrtMemcpy(own, bytes, input.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
        check("clear receive", aclrtMemset(own + bytes, bytes, 0, bytes));
        check("barrier before", smem_shm_control_barrier(shm));
        exchange<<<1, 0, stream>>>(gva, status, bytes, r);
        check("stream sync", aclrtSynchronizeStreamWithTimeout(stream, 60000));
        uint32_t code = 99;
        check("read status", aclrtMemcpy(&code, 4, status, 4, ACL_MEMCPY_DEVICE_TO_HOST));
        check("signal/wait/quiet stage", code);
        check("download", aclrtMemcpy(output.data(), bytes, own + bytes, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
        for (size_t i = 0; i < output.size(); ++i) {
            if (output[i] != pattern(1 - rankId, i, r)) {
                fprintf(stderr, "ERROR rank=%d round=%u index=%zu actual=%x expected=%x\n",
                        rankId, r, i, output[i], pattern(1 - rankId, i, r));
                exit(1);
            }
        }
        check("barrier after", smem_shm_control_barrier(shm));
    }
    printf("PASS rank=%d bytes=%zu rounds=%u full_payload_checked=1\n", rankId, bytes, rounds);
}

static void FailedAttemptAndRepair(const char *kernelDir)
{
    void *base = nullptr;
    auto pool = smem_shm_create(0, 2, rankId, 32ULL * 1024 * 1024, SMEMS_DATA_OP_SDMA, 0, &base);
    int failed = pool == nullptr;
    int totalFailed = 0;
    check("failure agreement", MPI_Allreduce(&failed, &totalFailed, 1, MPI_INT, MPI_SUM, MPI_COMM_WORLD));
    if (pool) smem_shm_destroy(pool, 0);
    printf("FIRST rank=%d failed=%d allfailed=%d\n", rankId, failed, totalFailed);
    check("both ranks reject failed creation", totalFailed == 2 ? 0 : 1);
    if (rankId == 0) {
        const auto dir = std::filesystem::path(getenv("MF_SDMA_ORCH_JSON")).parent_path();
        for (const auto *name : {"libmf_sdma_orch.so", "libmf_sdma_orch.json", "libmf_sdma_orch_launch.json"}) {
            std::filesystem::copy_file(std::filesystem::path(kernelDir) / name, dir / name,
                                      std::filesystem::copy_options::overwrite_existing);
        }
    }
    unsetenv("TEST_DEPLOY_CHANNEL_FAIL");
    check("repair agreement", MPI_Barrier(MPI_COMM_WORLD));
}

int main(int argc, char **argv)
{
    check("MPI_Init", MPI_Init(&argc, &argv));
    check("rank", MPI_Comm_rank(MPI_COMM_WORLD, &rankId));
    if (argc != 4) {
        fprintf(stderr, "ERROR usage: retry kernel_dir store_url device_base\n");
        MPI_Abort(MPI_COMM_WORLD, 1);
    }
    const int device = atoi(argv[3]) + rankId;
    setvbuf(stdout, nullptr, _IOLBF, 0);
    check("aclInit", aclInit(nullptr));
    check("smem_init", smem_init(0));
    check("log level", smem_set_log_level(1));
    smem_shm_config_t cfg;
    check("config", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = rankId == 0;
    cfg.shmInitTimeout = cfg.shmCreateTimeout = cfg.controlOperationTimeout = 8;
    check("shm_init", smem_shm_init(argv[2], 2, rankId, device, &cfg));
    FailedAttemptAndRepair(argv[1]);
    void *base = nullptr;
    auto pool = smem_shm_create(0, 2, rankId, 32ULL * 1024 * 1024, SMEMS_DATA_OP_SDMA, 0, &base);
    check("retry create", pool && base ? 0 : 1);
    check("workspace", smem_shm_sdma_get_workspace(pool) ? 0 : 1);
    aclrtStream stream = nullptr;
    uint32_t *status = nullptr;
    check("stream", aclrtCreateStream(&stream));
    check("status", aclrtMalloc((void **)&status, 32, ACL_MEM_MALLOC_HUGE_FIRST));
    transfer(pool, static_cast<uint8_t *>(base), stream, status, 131072, 10);
    check("destroy stream", aclrtDestroyStream(stream));
    check("free status", aclrtFree(status));
    check("destroy pool", smem_shm_destroy(pool, 0));
    smem_shm_uninit(0);
    smem_uninit();
    check("reset", aclrtResetDevice(device));
    check("aclFinalize", aclFinalize());
    printf("PASS rank=%d same_process_retry=1\n", rankId);
    check("MPI_Finalize", MPI_Finalize());
}
