/* conflict_repro — 长稳并发丢件挂死（507014）(双 Rank 偶发挂死)并发丢件复现器
 *
 * 背景与检验目标(取证交接包 vllm-ascend 故障取证材料):
 *   V2 融合算子偶发单批邮件无声丢失——请求环全消费、SQ 排空、rc=0, 但对端
 *   到达戳永不落地(wait 死等 → 507014)。首要嫌疑: epoch(搬运工)换轮次数,
 *   老班最后一次 doorbell 丢失/延迟 → 新班 TAIL 活查询拿到落后值 →
 *   首批 SQE 覆写未执行任务/回退尾指针 → 整批邮件丢失且无任何错误码。
 *
 * 攻击设计(与历史故障现场逐项对齐):
 *   - 流量: 双 rank 对称, 每代 4 chunk 突发 signal → 按序 wait 4 封 → quiet
 *     (V2 同构: signal 先于 wait, 收发缓冲分离, 每代一次 launch)
 *   - 放大: MF_SDMA_ORCH_EPOCH_BUDGET_S=1(默认) → 换轮次数频率 ×15
 *   - 检出: 等待/quiet/满环自旋全部有界(单次 kernel 轮询总量封顶, 远低于 28s
 *     同步超时), 任何丢失在数秒内转化为显式状态码, 不再依赖 507014 暴露
 *   - 证据: kernel 卡点快照 + host 保留区全窗 dump(含被等槽邻柜（历史故障取证缺口
 *     缺口) + workspace 换轮时间线(边界与卡点时刻核对)
 *   - 判别: dump 时复查被等槽——仍为旧值=真丢失; 已为新值=预算不足的慢件
 *
 * 状态码: 0=运行 1=wait超时(对端丢件) 2=signal失败/满环(本端编排停摆)
 *         3=邮件字段失配 4=quiet超时(本端完成戳丢失) 5=完成 6=数据陈旧
 *         7=到达戳超前(溢出形态)
 */
#include <chrono>
#include <csignal>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>
#include <mpi.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
#include "smem_shm_aicore_base_sdma.h"

#define STORE_URL "tcp://127.0.0.1:8593"       /* 本示例独立端口(长跑不撞 08) */
#define EX_LOCAL_SIZE (64UL * 1024UL * 1024UL) /* 每 rank 物理贡献 64MB */
/* 每代 chunk 数由 EX09_CHUNKS 环境变量运行期注入(默认 4, V2 同构) */
#define EX_SEND_OFF (0UL)                      /* 发送区基址(own 段内) */
#define EX_RECV_OFF (16UL * 1024UL * 1024UL)   /* 接收区基址(与发送区不重叠, V2 ownC/ownPeerC 同构) */
#define EX_TAG 0x9Eu                           /* pattern 标识 */
#define EX_STAT_MAGIC 0x4558303953544154ULL    /* "EX09STAT" */
#define EX_STAT_PROGRESS_OFF 8                 /* offsetof(Ex09Stat, progress) */

static int g_rank = -1;
static volatile sig_atomic_t g_stop = 0;

/* ============================ AICore kernel(设备头原语) ============================ */
#define EX_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__

/* host D2H 轮询的状态块(逐 launch 累计; 卡点现场第一手快照) */
struct Ex09Stat {
    uint64_t magic;        /* 行 0: 存活与进度(host 高频轮询) */
    uint64_t progress;     /* 轮询心跳(所有自旋循环累计) */
    uint64_t gensDone;
    uint64_t mailsSent;
    uint64_t mailsRecv;
    uint64_t waitPollsTotal;
    uint64_t waitPollsMax;
    uint64_t waitPollsLast;
    uint32_t state;        /* 行 1: 终态与卡点 */
    uint32_t stuckGen;
    uint64_t stuckHead;    /* 卡点 arrHead */
    uint64_t stuckExpect;  /* 期待戳(= head+1) */
    uint64_t stuckSlot;    /* 被等槽(head%1024) */
    uint64_t stuckStamp;   /* 卡点槽实读 */
    uint64_t stuckMailF0;  /* 行 2: 邮件像与请求游标快照 */
    uint64_t stuckMailF1;
    uint64_t stuckMailF2;
    uint64_t stuckMailF3;
    uint64_t stuckReqTail; /* 本端已投递 */
    uint64_t stuckReqHead; /* 本端已被 AICPU 消费 */
    uint64_t stuckPolls;   /* 卡点自旋次数 */
    uint64_t reserved;
};

/* dcci 一行(host D2H 可见性正解, 与库内原语同姿势) */
EX_AICORE_INLINE void Ex09FlushLine(__gm__ void *p)
{
    AscendC::GlobalTensor<int32_t> t;
    t.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(p), 2);
    AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(t);
}

/* 轮询心跳: volatile 写 + 刷行(低频, 自旋 64K 次一跳) */
EX_AICORE_INLINE void Ex09Beat(__gm__ uint8_t *statBase, uint64_t v)
{
    *reinterpret_cast<__gm__ volatile uint64_t *>(statBase + EX_STAT_PROGRESS_OFF) = v;
    Ex09FlushLine(statBase + EX_STAT_PROGRESS_OFF);
}

/* 有界等待一封到达邮件(镜像 wait_at 语义): 0=到件 1=超时 2=戳超前(溢出形态) */
EX_AICORE_INLINE int Ex09BoundedWait(__gm__ uint8_t *res, uint64_t budget, uint64_t *pollsOut,
                                     uint64_t *headOut, uint64_t *stampOut, __gm__ uint8_t *statBase,
                                     uint64_t *progress)
{
    const uint64_t head = SdmaReadCell(res, SMEM_SHM_SDMA_RS_ARR_HEAD);
    const uint64_t expect = head + 1;
    const uint64_t slotOff = SMEM_SHM_SDMA_RS_ARR_STAMP + (head % SMEM_SHM_SDMA_RS_ARR_SLOTS) * 8;
    uint64_t stamp = 0;
    uint64_t polls = 0;
    while (polls < budget) {
        stamp = SdmaReadCell(res, slotOff);
        if (stamp == expect) {
            break;
        }
        polls++;
        if ((polls & 0xFFFFu) == 0u) {
            (*progress) += 0x10000u;
            Ex09Beat(statBase, *progress);
        }
    }
    *pollsOut = polls;
    *headOut = head;
    *stampOut = stamp;
    if (stamp == expect) {
        return 0;
    }
    return (stamp > expect) ? 2 : 1;
}

/* 有界 quiet(镜像 quiet_at 语义): 等本端末封完成戳。0=落地 1=超时 */
EX_AICORE_INLINE int Ex09BoundedQuiet(__gm__ uint8_t *res, uint64_t budget, uint64_t *pollsOut,
                                      __gm__ uint8_t *statBase, uint64_t *progress)
{
    const uint64_t tail = SdmaReadCell(res, SMEM_SHM_SDMA_RS_REQ_TAIL);
    if (tail == 0) {
        return 0;
    }
    const uint64_t off = SMEM_SHM_SDMA_RS_QUIET + ((tail - 1) % SMEM_SHM_SDMA_RS_QUIET_SLOTS) * 8;
    uint64_t polls = 0;
    while (polls < budget) {
        if (SdmaReadCell(res, off) == tail) {
            return 0;
        }
        polls++;
        if ((polls & 0xFFFFu) == 0u) {
            (*progress) += 0x10000u;
            Ex09Beat(statBase, *progress);
        }
    }
    *pollsOut = polls;
    return 1;
}

/* 有界请求环空位预检(规避 signal_at 内部无界背压自旋): 0=有空位 1=满环不退 */
EX_AICORE_INLINE int Ex09RingSpace(__gm__ uint8_t *res, uint64_t budget, __gm__ uint8_t *statBase,
                                   uint64_t *progress)
{
    const uint64_t tail = SdmaReadCell(res, SMEM_SHM_SDMA_RS_REQ_TAIL);
    uint64_t polls = 0;
    while (polls < budget) {
        const uint64_t head = SdmaReadCell(res, SMEM_SHM_SDMA_RS_REQ_HEAD);
        if (tail - head < SMEM_SHM_SDMA_RS_REQ_SLOTS - 1) {
            return 0;
        }
        polls++;
        if ((polls & 0xFFFFu) == 0u) {
            (*progress) += 0x10000u;
            Ex09Beat(statBase, *progress);
        }
    }
    return 1;
}

/* 卡点现场写回(一次性, 全结构刷出) */
EX_AICORE_INLINE void Ex09CommitStuck(__gm__ uint8_t *statBase, __gm__ uint8_t *res, uint32_t state,
                                      uint32_t gen, uint64_t head, uint64_t stamp, uint64_t polls)
{
    __gm__ Ex09Stat *st = reinterpret_cast<__gm__ Ex09Stat *>(statBase);
    const uint64_t slot = head % SMEM_SHM_SDMA_RS_ARR_SLOTS;
    __gm__ uint8_t *mail = res + SMEM_SHM_SDMA_RS_ARR_MAIL + slot * 32;
    uint64_t f0 = 0, f1 = 0, f2 = 0, f3 = 0;
    SdmaReadMail(mail, &f0, &f1, &f2, &f3);
    st->state = state;
    st->stuckGen = gen;
    st->stuckHead = head;
    st->stuckExpect = head + 1;
    st->stuckSlot = slot;
    st->stuckStamp = stamp;
    st->stuckPolls = polls;
    st->stuckReqTail = SdmaReadCell(res, SMEM_SHM_SDMA_RS_REQ_TAIL);
    st->stuckReqHead = SdmaReadCell(res, SMEM_SHM_SDMA_RS_REQ_HEAD);
    st->stuckMailF0 = f0;
    st->stuckMailF1 = f1;
    st->stuckMailF2 = f2;
    st->stuckMailF3 = f3;
    for (uint64_t off = 0; off < sizeof(Ex09Stat); off += 64) {
        Ex09FlushLine(statBase + off);
    }
}

/* 邮件字段+数据双重校验: true=通过(已写卡点现场为 false 场景) */
EX_AICORE_INLINE bool Ex09ValidateMail(__gm__ uint8_t *gva, __gm__ uint8_t *res, __gm__ uint8_t *statBase,
                                       uint32_t gen, uint32_t chunkIdx, uint64_t chunkBytes, uint64_t head)
{
    __gm__ uint8_t *mail = res + SMEM_SHM_SDMA_RS_ARR_MAIL + (head % SMEM_SHM_SDMA_RS_ARR_SLOTS) * 32;
    uint64_t f0 = 0, f1 = 0, f2 = 0, f3 = 0;
    SdmaReadMail(mail, &f0, &f1, &f2, &f3);
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    const uint64_t dstExp = reinterpret_cast<uint64_t>(gva) + symm * rank + EX_RECV_OFF +
                            static_cast<uint64_t>(chunkIdx) * chunkBytes;
    const uint64_t immExp = (static_cast<uint64_t>(gen) << 8) | chunkIdx;
    if (f0 != head + 1 || f1 != dstExp || f2 != chunkBytes || f3 != immExp) {
        Ex09CommitStuck(statBase, res, 3, gen, head, head + 1, 0);
        return false;
    }
    __gm__ uint32_t *dst = reinterpret_cast<__gm__ uint32_t *>(f1);
    Ex09FlushLine(dst); /* SDMA 写 → AICore 读, 先失效 */
    if (dst[0] != ((EX_TAG << 24) | (gen << 8) | chunkIdx)) {
        Ex09CommitStuck(statBase, res, 6, gen, head, head + 1, 0);
        return false;
    }
    return true;
}

/* 收件内循环: 每代收 EX_CHUNKS 封(有界等待+校验+推进游标)。false=已写卡点应退出 */
EX_AICORE_INLINE bool Ex09RecvLoop(__gm__ uint8_t *gva, __gm__ uint8_t *res, __gm__ uint8_t *statBase,
                                   uint32_t gen, uint32_t chunks, uint64_t chunkBytes, uint64_t budget, uint64_t *recv,
                                   uint64_t *pollsTotal, uint64_t *pollsMax, uint64_t *progress)
{
    for (uint32_t c = 0; c < chunks; c++) {
        uint64_t polls = 0, head = 0, stamp = 0;
        const int wr = Ex09BoundedWait(res, budget, &polls, &head, &stamp, statBase, progress);
        *pollsTotal += polls;
        if (polls > *pollsMax) {
            *pollsMax = polls;
        }
        __gm__ Ex09Stat *st = reinterpret_cast<__gm__ Ex09Stat *>(statBase);
        st->waitPollsLast = polls;
        if (wr != 0) {
            Ex09CommitStuck(statBase, res, (wr == 2) ? 7 : 1, gen, head, stamp, polls);
            return false;
        }
        if (!Ex09ValidateMail(gva, res, statBase, gen, c, chunkBytes, head)) {
            return false;
        }
        SdmaWriteCell(res, SMEM_SHM_SDMA_RS_ARR_HEAD, head + 1); /* 取件推进游标 */
        (*recv)++;
    }
    return true;
}

/* 突发发送内循环: 每代产 tag + signal EX_CHUNKS 封。false=已写卡点应退出 */
EX_AICORE_INLINE bool Ex09SendBurst(__gm__ uint8_t *ownSeg, __gm__ uint8_t *peerSeg, __gm__ uint8_t *res,
                                    __gm__ uint8_t *statBase, uint32_t gen, uint32_t chunks, uint64_t chunkBytes,
                                    uint64_t budget, uint64_t *sent, uint64_t *progress)
{
    for (uint32_t c = 0; c < chunks; c++) {
        __gm__ uint32_t *src = reinterpret_cast<__gm__ uint32_t *>(ownSeg + EX_SEND_OFF +
                                                                   static_cast<uint64_t>(c) * chunkBytes);
        src[0] = (EX_TAG << 24) | (gen << 8) | c; /* tag word(校验溯源) */
        src[1] = gen;
        Ex09FlushLine(src);
        if (Ex09RingSpace(res, budget, statBase, progress) != 0) {
            Ex09CommitStuck(statBase, res, 2, gen, 0, 0, budget);
            return false;
        }
        const bool ok = smem_shm_sdma_signal_at(
            res, reinterpret_cast<__gm__ uint8_t *>(src),
            peerSeg + EX_RECV_OFF + static_cast<uint64_t>(c) * chunkBytes, chunkBytes,
            (static_cast<uint64_t>(gen) << 8) | c);
        if (!ok) {
            Ex09CommitStuck(statBase, res, 2, gen, 0, 0, 0);
            return false;
        }
        (*sent)++;
    }
    return true;
}

/* 压力 kernel: 每次 launch 执行 batchGens 代; 环/游标/计数全落段与状态块,
 * launch 间无 kernel 态(换轮/重拉零影响)。轮询总量封顶 = waitBudget */
extern "C" __global__ __aicore__ void ex09Kernel(__gm__ uint8_t *gva, __gm__ Ex09Stat *stat,
                                                 uint64_t chunkBytes, uint32_t batchGens,
                                                 uint64_t waitBudget, uint32_t chunks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单 block 纪律(单 signal owner, V2 同构) */
    }
    __gm__ uint8_t *statBase = reinterpret_cast<__gm__ uint8_t *>(stat);
    for (uint64_t off = 0; off < sizeof(Ex09Stat); off += 64) {
        Ex09FlushLine(statBase + off); /* 入口失效取最新(host/上轮残留) */
    }
    __gm__ Ex09Stat *st = stat;
    uint64_t gensDone = 0, sent = 0, recv = 0, pollsTotal = 0, pollsMax = 0, progress = 0;
    if (st->magic == EX_STAT_MAGIC) { /* 延续累计计数(逐 launch 累加) */
        gensDone = st->gensDone;
        sent = st->mailsSent;
        recv = st->mailsRecv;
        pollsTotal = st->waitPollsTotal;
        pollsMax = st->waitPollsMax;
        progress = st->progress;
    } else {
        st->magic = EX_STAT_MAGIC;
        st->state = 0;
        st->gensDone = 0;
        st->mailsSent = 0;
        st->mailsRecv = 0;
        st->waitPollsTotal = 0;
        st->waitPollsMax = 0;
        st->waitPollsLast = 0;
        st->progress = 0;
        for (uint64_t off = 0; off < sizeof(Ex09Stat); off += 64) {
            Ex09FlushLine(statBase + off);
        }
    }
    const uint32_t rank = smem_shm_get_global_rank(0);
    const uint64_t symm = smem_shm_get_symmetric_size(0);
    __gm__ uint8_t *ownSeg = gva + symm * rank;
    __gm__ uint8_t *peerSeg = gva + symm * (1 - rank);
    __gm__ uint8_t *res = smem_shm_sdma_reserved(gva);
    const uint32_t startGen = static_cast<uint32_t>(gensDone);
    uint64_t budgetUsed = 0; /* 轮询预算按 launch 归零(跨 launch 只累计统计, 不吃预算) */
    for (uint32_t g = startGen; g < startGen + batchGens; g++) {
        const uint64_t budget = (waitBudget > budgetUsed) ? (waitBudget - budgetUsed) : 0;
        if (!Ex09SendBurst(ownSeg, peerSeg, res, statBase, g, chunks, chunkBytes, budget, &sent, &progress)) {
            return;
        }
        if (!Ex09RecvLoop(gva, res, statBase, g, chunks, chunkBytes, budget, &recv, &pollsTotal, &pollsMax,
                          &progress)) {
            return;
        }
        uint64_t qpolls = 0;
        const uint64_t qbudget = (waitBudget > budgetUsed) ? (waitBudget - budgetUsed) : 0;
        if (Ex09BoundedQuiet(res, qbudget, &qpolls, statBase, &progress) != 0) {
            Ex09CommitStuck(statBase, res, 4, g, 0, 0, qpolls);
            return;
        }
        pollsTotal += qpolls;
        budgetUsed += qpolls;
        gensDone++;
        st->gensDone = gensDone;
        st->mailsSent = sent;
        st->mailsRecv = recv;
        st->waitPollsTotal = pollsTotal;
        st->waitPollsMax = pollsMax;
        st->progress = progress;
        for (uint64_t off = 0; off < sizeof(Ex09Stat); off += 64) {
            Ex09FlushLine(statBase + off);
        }
    }
}

/* ============================ host 侧(监控/证据/裁决) ============================ */

/* workspace 结果区 wire 常量(hybm_sdma_contract.h 锁定; 镜像避免拉入 hybm 内部头) */
struct Ex09WsResult {
    uint32_t magic;
    uint32_t mainRet;
    uint32_t consumed;
    uint32_t exitReason;
    uint64_t headAfter;
};
#define EX09_WS_HEARTBEAT_OFF 136
#define EX09_EXIT_RUNNING 0xFFFFFFFFu

struct Ex09Cfg {
    uint32_t deviceBase; /* DEVICE_ID = base + rank */
    uint32_t chunks;     /* 每代 chunk 数(批步长鉴别旋钮) */
    uint32_t genDelayUs; /* 每代间隔(节流; 20000=V2 真实速率 ~50 代/秒) */
    uint32_t totalGens;
    uint32_t batchGens;
    uint64_t waitBudget; /* 单次 launch 轮询总量上限 */
    uint64_t chunkBytes;
    uint32_t stallSec;   /* 心跳停滞判定 */
};

static void Step(const char *name, int32_t ret)
{
    if (ret != 0) {
        printf("[r%d FAIL] %-28s ret=%d\n", g_rank, name, ret);
        exit(1);
    }
    printf("[r%d OK]   %-28s\n", g_rank, name);
}

static double NowMs()
{
    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch())
        .count();
}

static uint64_t EnvU64(const char *name, uint64_t dft)
{
    const char *v = getenv(name);
    return (v != nullptr) ? strtoull(v, nullptr, 0) : dft;
}

static Ex09Cfg LoadCfg()
{
    Ex09Cfg c = {};
    c.deviceBase = static_cast<uint32_t>(EnvU64("EX09_DEVICE_BASE", 4)); /* 默认 dev4/dev5 */
    c.chunks = static_cast<uint32_t>(EnvU64("EX09_CHUNKS", 4));
    c.genDelayUs = static_cast<uint32_t>(EnvU64("EX09_GEN_DELAY_US", 0)); /* 0=加压模式(不限速) */
    c.totalGens = static_cast<uint32_t>(EnvU64("EX09_TOTAL_GENS", 10000000));
    c.batchGens = static_cast<uint32_t>(EnvU64("EX09_BATCH_GENS", 1)); /* 每代一launch(V2 同构) */
    c.waitBudget = EnvU64("EX09_WAIT_BUDGET", 10000000ULL);            /* ~1-10s 按轮询单价 */
    c.chunkBytes = EnvU64("EX09_CHUNK_BYTES", 128UL * 1024UL);
    c.stallSec = static_cast<uint32_t>(EnvU64("EX09_STALL_S", 60));
    return c;
}

static bool D2H(void *dst, uint64_t size, const void *devSrc)
{
    return aclrtMemcpy(dst, size, const_cast<void *>(devSrc), size, ACL_MEMCPY_DEVICE_TO_HOST) == 0;
}

/* 保留区游标/窗口 dump(host 视角, 与 kernel 卡点快照互补; 历史故障取证缺口全覆盖) */
static void DumpReserved(const char *tag, Ex09Stat *st, uint8_t *resHost)
{
    uint64_t reqTail = 0, reqHead = 0, arrHead = 0;
    if (!D2H(&reqTail, 8, resHost + SMEM_SHM_SDMA_RS_REQ_TAIL) ||
        !D2H(&reqHead, 8, resHost + SMEM_SHM_SDMA_RS_REQ_HEAD) ||
        !D2H(&arrHead, 8, resHost + SMEM_SHM_SDMA_RS_ARR_HEAD)) {
        printf("[r%d] %s D2H 游标读失败\n", g_rank, tag);
        return;
    }
    printf("[r%d] %s 游标: reqTail=%llu reqHead=%llu(消费差 %llu) arrHead=%llu\n", g_rank, tag,
           (unsigned long long)reqTail, (unsigned long long)reqHead,
           (unsigned long long)(reqTail - reqHead), (unsigned long long)arrHead);
    printf("[r%d] %s 戳窗(槽[序号]=值; F=超前已落地 变体L特征 | <<<被等槽 | 空=0):\n", g_rank, tag);
    for (int64_t i = -4; i <= 12; i++) {
        const int64_t idx = static_cast<int64_t>(arrHead) + i;
        const uint64_t slot = static_cast<uint64_t>(((idx % 1024) + 1024) % 1024);
        uint64_t v = 0;
        (void)D2H(&v, 8, resHost + SMEM_SHM_SDMA_RS_ARR_STAMP + slot * 8);
        char mark[64] = "";
        if (i == 0) {
            snprintf(mark, sizeof(mark), " <<< 被等槽(期待%llu)", (unsigned long long)(arrHead + 1));
        } else if (v > arrHead && v <= arrHead + 1024) {
            snprintf(mark, sizeof(mark), " F(值超前%lld)", (long long)(v - arrHead));
        } else if (v == 0) {
            snprintf(mark, sizeof(mark), " 空");
        }
        printf("[r%d]   stamp[%4llu]=%-8llu%s\n", g_rank, (unsigned long long)slot,
               (unsigned long long)v, mark);
    }
    printf("[r%d] %s 完成戳窗(quiet):\n", g_rank, tag);
    for (uint64_t i = 16; i >= 1; i--) {
        const uint64_t slot = (reqTail >= i) ? ((reqTail - i) % 64) : 0;
        uint64_t v = 0;
        (void)D2H(&v, 8, resHost + SMEM_SHM_SDMA_RS_QUIET + slot * 8);
        printf("[r%d]   quiet[%2llu]=%llu%s\n", g_rank, (unsigned long long)slot,
               (unsigned long long)v, (i == 1) ? " (末封期待值=tail)" : "");
    }
    /* 请求环末两槽原始内容(鉴别"消费侧读到空请求→对端段基址算 0→写到错误地址"假设:
     * 若槽内容完整(src/dst/len/imm 非 0), 说明生产侧写入正常, 问题在消费或执行) */
    for (uint64_t i = 2; i >= 1; i--) {
        const uint64_t seq = (reqTail >= i) ? (reqTail - i) : 0;
        const uint64_t slot = seq % SMEM_SHM_SDMA_RS_REQ_SLOTS;
        uint64_t f[4] = {0, 0, 0, 0};
        (void)D2H(f, 32, resHost + SMEM_SHM_SDMA_RS_REQ_RING + slot * 32);
        printf("[r%d] %s 请求槽[%llu](seq=%llu): src=0x%llx dst=0x%llx len=%llu imm=0x%llx\n", g_rank, tag,
               (unsigned long long)slot, (unsigned long long)seq, (unsigned long long)f[0],
               (unsigned long long)f[1], (unsigned long long)f[2], (unsigned long long)f[3]);
    }
}

/* dump 时复查被等槽: 区分真丢失与预算不足的慢件(防误报) */
static void VerdictStuck(Ex09Stat *st, uint8_t *resHost)
{
    if (st->state == 0 || st->state == 5) {
        return;
    }
    uint64_t now = 0;
    const uint64_t off = (st->state == 4)
        ? SMEM_SHM_SDMA_RS_QUIET + (st->stuckReqTail > 0 ? ((st->stuckReqTail - 1) % 64) : 0) * 8
        : SMEM_SHM_SDMA_RS_ARR_STAMP + st->stuckSlot * 8;
    (void)D2H(&now, 8, resHost + off);
    const uint64_t expect = (st->state == 4) ? st->stuckReqTail : st->stuckExpect;
    printf("[r%d] 复查(state=%u 期待=%llu 现值=%llu): %s\n", g_rank, st->state,
           (unsigned long long)expect, (unsigned long long)now,
           now == expect ? "慢件(预算不足, 非丢失)" : "*** 真丢失(旧值未变) ***");
}

/* v15 编排诊断逐单日志 dump(workspace 尾段, 逐单消费原文/计算地址/SQ 游标/doorbell) */
static void DumpOrchDbg(void *ws)
{
    uint8_t *w = static_cast<uint8_t *>(ws);
    uint64_t doorbell = 0, dbRet = 0, epoch = 0, launches = 0, ringCnt = 0;
    if (!D2H(&doorbell, 8, w + 144) || !D2H(&dbRet, 8, w + 152) || !D2H(&epoch, 8, w + 160) ||
        !D2H(&launches, 8, w + 168) || !D2H(&ringCnt, 8, w + 176)) {
        printf("[r%d] 诊断区 D2H 读失败\n", g_rank);
        return;
    }
    printf("[r%d] 编排诊断: doorbell尾值=%llu(ret=%llu) 入口SQ快照(head=%u tail=%u) launch=%llu 逐单日志=%llu条\n",
           g_rank, (unsigned long long)doorbell, (unsigned long long)dbRet,
           (unsigned)(epoch >> 32), (unsigned)(epoch & 0xFFFFFFFFu), (unsigned long long)launches,
           (unsigned long long)ringCnt);
    const uint64_t n = (ringCnt < 48) ? ringCnt : 48;
    const uint64_t first = ringCnt - n; /* 环形: 只看最新 60 条 */
    for (uint64_t i = 0; i < n; i++) {
        const uint64_t idx = first + i;
        uint64_t e[8] = {0, 0, 0, 0, 0, 0, 0, 0};
        (void)D2H(e, 64, w + 184 + (idx % 48) * 64);
        const bool emptyReq = (e[1] == 0 && e[2] == 0 && e[3] == 0 && e[4] == 0);
        printf("[r%d]   逐单日志 seq=%llu req={0x%llx,0x%llx,%llu,0x%llx}%s arrSlot=0x%llx sqTail=%llu→%llu\n",
               g_rank, (unsigned long long)e[0], (unsigned long long)e[1], (unsigned long long)e[2],
               (unsigned long long)e[3], (unsigned long long)e[4],
               emptyReq ? "  <<< 读回空请求!(写到错误地址根因特征)" : "", (unsigned long long)e[5],
               (unsigned long long)e[6], (unsigned long long)e[7]);
    }
    /* SQ 环现场快照检查: 读内核入口快照的尾 13 槽 SQE 原文(固件到底拿到了什么) */
    uint64_t sqBase = 0, snapBase = 0, sqDepthPack = 0;
    if (D2H(&sqBase, 8, w + 4024) && D2H(&snapBase, 8, w + 4032) && D2H(&sqDepthPack, 8, w + 4040) &&
        sqBase != 0) {
        const uint32_t sqDepth = static_cast<uint32_t>(sqDepthPack);
        printf("[r%d] SQ 环现场快照检查(固件 head-2 起 12 槽, head=固件冻结点):\n", g_rank);
        for (uint32_t i = 0; i < 12; i++) {
            uint8_t sqe[64] = {0};
            if (!D2H(sqe, 64, w + 3256 + i * 64)) {
                break;
            }
            uint32_t len = 0, lo32 = 0, hi32 = 0;
            memcpy(&len, sqe + 28, 4);
            memcpy(&lo32, sqe + 40, 4);
            memcpy(&hi32, sqe + 44, 4);
            const uint64_t slot = (snapBase + i) % (sqDepth ? sqDepth : 1024);
            printf("[r%d]   SQE[%4llu] type=0x%02x opcode=0x%02x len=%u dst=0x%x%08x\n", g_rank,
                   (unsigned long long)slot, sqe[0], sqe[16], len, hi32, lo32);
        }
    }
}

static void DumpStat(const char *tag, Ex09Stat *st)
{
    printf("[r%d] %s stat: state=%u gen=%u gensDone=%llu sent=%llu recv=%llu pollsMax=%llu "
           "pollsLast=%llu stuck(head=%llu expect=%llu slot=%llu stamp=%llu reqTail=%llu reqHead=%llu)\n",
           g_rank, tag, st->state, st->stuckGen, (unsigned long long)st->gensDone,
           (unsigned long long)st->mailsSent, (unsigned long long)st->mailsRecv,
           (unsigned long long)st->waitPollsMax, (unsigned long long)st->waitPollsLast,
           (unsigned long long)st->stuckHead, (unsigned long long)st->stuckExpect,
           (unsigned long long)st->stuckSlot, (unsigned long long)st->stuckStamp,
           (unsigned long long)st->stuckReqTail, (unsigned long long)st->stuckReqHead);
    printf("[r%d] %s 邮件像: f0=%llu f1=0x%llx f2=%llu f3=0x%llx\n", g_rank, tag,
           (unsigned long long)st->stuckMailF0, (unsigned long long)st->stuckMailF1,
           (unsigned long long)st->stuckMailF2, (unsigned long long)st->stuckMailF3);
}

static void HandleSigint(int)
{
    g_stop = 1;
}

/* 监控主循环: 逐 launch + 逐代 MPI 栅栏(同步步调, 收尾无双端漂移误报) */
static int RunStress(const Ex09Cfg &cfg, void *gva, uint8_t *resHost, void *statDev, void *ws)
{
    aclrtStream stream = nullptr;
    (void)aclrtCreateStream(&stream);
    Ex09Stat st = {};
    Ex09WsResult wsR = {};
    double t0 = NowMs();
    double tStat = t0;
    double tStall = t0;
    uint64_t lastProgress = 0, lastGens = 0, boundaries = 0;
    uint32_t lastExit = EX09_EXIT_RUNNING;
    while (!g_stop) {
        const uint32_t remaining = (st.gensDone < cfg.totalGens) ? (cfg.totalGens - st.gensDone) : 0;
        const uint32_t batch = (remaining < cfg.batchGens) ? remaining : cfg.batchGens;
        if (batch == 0) {
            break;
        }
        ex09Kernel<<<1, 0, stream>>>(static_cast<uint8_t *>(gva), static_cast<Ex09Stat *>(statDev),
                                     cfg.chunkBytes, batch, cfg.waitBudget, cfg.chunks);
        const int32_t syncRet = static_cast<int32_t>(aclrtSynchronizeStream(stream));
        if (syncRet != 0) { /* 逐轮静默同步(失败才打印, 免日志洪泛) */
            printf("[r%d FAIL] sync(kernel) ret=%d\n", g_rank, syncRet);
            break;
        }
        if (!D2H(&st, sizeof(st), statDev)) {
            printf("[r%d FAIL] D2H stat 失败\n", g_rank);
            return 1;
        }
        (void)D2H(&wsR, sizeof(wsR), ws);
        if (lastExit != EX09_EXIT_RUNNING && wsR.exitReason == EX09_EXIT_RUNNING) {
            boundaries++; /* 新班上岗 = 一次换轮次数 */
        }
        lastExit = wsR.exitReason;
        if (st.state != 0) {
            break;
        }
        if (cfg.batchGens <= 1) {
            MPI_Barrier(MPI_COMM_WORLD); /* 逐代同步步调(防收尾漂移误报) */
        }
        if (cfg.genDelayUs > 0) { /* 节流: 模拟 V2 真实速率(加压模式不限速) */
            usleep(cfg.genDelayUs);
        }
        const double now = NowMs();
        if (st.progress != lastProgress || st.gensDone != lastGens) {
            lastProgress = st.progress;
            lastGens = st.gensDone;
            tStall = now;
        } else if ((now - tStall) / 1000.0 > cfg.stallSec) {
            printf("[r%d FAIL] 心跳停滞 >%us(state=%u), 判定卡死\n", g_rank, cfg.stallSec, st.state);
            break;
        }
        if (now - tStat > 5000.0) {
            tStat = now;
            printf("[r%d] %6.0fs gens=%llu (%.0f/s) pollsMax=%llu pollsLast=%llu 换轮=%llu\n", g_rank,
                   (now - t0) / 1000.0, (unsigned long long)st.gensDone,
                   st.gensDone / ((now - t0) / 1000.0), (unsigned long long)st.waitPollsMax,
                   (unsigned long long)st.waitPollsLast, (unsigned long long)boundaries);
        }
    }
    printf("[r%d] 运行结束: %.0fs 换轮次数=%llu 次\n", g_rank, (NowMs() - t0) / 1000.0,
           (unsigned long long)boundaries);
    DumpStat("终态", &st);
    DumpReserved("终态", &st, resHost);
    DumpOrchDbg(ws);
    VerdictStuck(&st, resHost);
    (void)aclrtDestroyStream(stream);
    return (st.state == 0 || st.state == 5) ? 0 : 1;
}

/* 双端证据交换与最终裁决(r0 汇总); 失败走 MPI_Abort 跳过清理路径
 * (挂死的 epoch kernel 会卡住 destroy 的流同步——SIGKILL 留泄漏, 事故教训) */
static int FinalVerdict(int localBad)
{
    int peerBad = 0;
    MPI_Barrier(MPI_COMM_WORLD);
    MPI_Sendrecv(&localBad, 1, MPI_INT, 1 - g_rank, 0, &peerBad, 1, MPI_INT, 1 - g_rank, 0,
                 MPI_COMM_WORLD, MPI_STATUS_IGNORE);
    const int bad = (localBad || peerBad) ? 1 : 0;
    if (g_rank == 0) {
        printf("=== EX09 裁决: r0=%s r1=%s → %s ===\n", localBad ? "异常" : "正常",
               peerBad ? "异常" : "正常", bad ? "复现(邮件丢失/编排异常)" : "窗口内未复现");
    }
    if (bad) {
        fflush(stdout);
        MPI_Abort(MPI_COMM_WORLD, 1); /* 失败即强退: 不走 destroy(挂死+泄漏风险) */
    }
    return 0;
}

int main(int argc, char *argv[])
{
    (void)argv;
    int mpiRet = MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &g_rank);
    Step("MPI_Init", mpiRet);
    int worldSize = 0;
    MPI_Comm_size(MPI_COMM_WORLD, &worldSize);
    if (worldSize != 2) {
        printf("expect exactly 2 ranks (mpirun -np 2), got %d\n", worldSize);
        MPI_Finalize();
        return 1;
    }
    const Ex09Cfg cfg = LoadCfg();
    const int devId = static_cast<int>(cfg.deviceBase) + g_rank;
    printf("[r%d INFO] devId=%d totalGens=%u batch=%u chunks=%u chunk=%lluKB budget=%lluM\n", g_rank, devId,
           cfg.totalGens, cfg.batchGens, cfg.chunks, (unsigned long long)(cfg.chunkBytes / 1024),
           (unsigned long long)(cfg.waitBudget / 1000000ULL));
    Step("aclInit", aclInit(nullptr) == ACL_SUCCESS ? 0 : 1);
    signal(SIGINT, HandleSigint);

    Step("smem_init", smem_init(0));
    smem_shm_config_t sCfg;
    Step("smem_shm_config_init", smem_shm_config_init(&sCfg));
    sCfg.startConfigStoreServer = (g_rank == 0);
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, static_cast<uint32_t>(g_rank),
                                        static_cast<uint16_t>(devId), &sCfg));
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, 2, static_cast<uint32_t>(g_rank), EX_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) {
        printf("[r%d FAIL] smem_shm_create: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    Step("smem_shm_create(SDMA)", 0);
    void *ws = smem_shm_sdma_get_workspace(shm);
    if (ws == nullptr) {
        printf("[r%d FAIL] sdma orchestration not ready\n", g_rank);
        return 1;
    }
    const uint64_t symm = smem_shm_get_symmetric_size(shm);
    uint8_t *resHost = static_cast<uint8_t *>(gva) + symm * g_rank +
                       (EX_LOCAL_SIZE - SMEM_SHM_SDMA_RESERVED);
    void *statDev = nullptr;
    Step("stat alloc", aclrtMalloc(&statDev, 4096, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS ? 0 : 1);
    Step("stat memset", aclrtMemset(statDev, 4096, 0, 4096) == ACL_SUCCESS ? 0 : 1);
    MPI_Barrier(MPI_COMM_WORLD);

    const int bad = RunStress(cfg, gva, resHost, statDev, ws);
    const int final = FinalVerdict(bad);

    (void)aclrtFree(statDev);
    Step("smem_shm_destroy", smem_shm_destroy(shm, 0));
    smem_shm_uninit(0);
    Step("smem_shm_uninit", 0);
    smem_uninit();
    Step("smem_uninit", 0);
    (void)aclrtResetDevice(devId);
    (void)aclFinalize();
    MPI_Finalize();
    return final;
}
