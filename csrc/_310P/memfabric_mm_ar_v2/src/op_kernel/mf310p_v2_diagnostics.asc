// 调试/诊断/验证设备核：T0 分阶段探针、T1 小 M 及 T2 非融合 AR。
#include "mf310p_v2_kernel_common.h"

namespace {
/* 以下是阶段性诊断代码，不属于正式通信协议。 */

/* 诊断 A：单 Chunk 的每核 M 维分片 MM 直接写入 y；无通信，验证 Tiling、UB、NZ 权重处理。 */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagMmKernel(
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    TPipe pipe;
    TBuf<> mmUb;
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE);  /* 诊断采用与 V1 相同的完整 UB。 */
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t coreOff =
        static_cast<uint64_t>(core) * rowsPerCore * kRowBytes;
    GlobalTensor<float16_t> ag, cg;
    ag.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x + coreOff), rowsPerCore * kK);
    cg.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(y + coreOff), rowsPerCore * kN);
    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    mm.SetTensorA(ag, false);
    mm.SetTensorB(wg, true);
    mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cg);
}

/* 诊断 C：MM 写入 ownC 并交换第 0 个 Chunk 后 Add，但跳过核间 IB 会合；Core0 仅等待自身 MM+Clean 完成便发送，隔离 SDMA 通路与 IB 调度。 */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagNoIbKernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* status, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t perCoreBytes =
        static_cast<uint64_t>(rowsPerCore) * kRowBytes;
    const uint64_t chunkBytes =
        static_cast<uint64_t>(CHUNK) * kRowBytes;
    const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    GlobalTensor<float16_t> ag, cg;
    ag.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x + coreOff), rowsPerCore * kK);
    cg.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(ownC + coreOff), rowsPerCore * kN);
    mm.SetTensorA(ag, false);
    mm.SetTensorB(wg, true);
    mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cg);
    CleanLines(ownC + coreOff, perCoreBytes);

    if (core == 0) {
        const bool ok = smem_shm_sdma_signal_at(
            reserved, ownC, peerDst, chunkBytes, kTagBase);
        CheckOrTrap(ok, status, 1);
        auto mail = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
            mail.dst == expectedRecvDst &&
            mail.len == chunkBytes && mail.imm == kTagBase, status, 2);
    }
    const uint64_t base = coreOff;
    CleanLines(ownPeerC + base, perCoreBytes);
    GlobalTensor<float16_t> a, b, dst;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                      perCoreBytes / 2);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                      perCoreBytes / 2);
    dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                        perCoreBytes / 2);
    for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
        LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
        LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
        DataCopy(la, a[off], kAddTile);
        DataCopy(lb, b[off], kAddTile);
        in0.EnQue(la); in1.EnQue(lb);
        LocalTensor<float16_t> va = in0.DeQue<float16_t>();
        LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
        LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
        Add(res, va, vb, kAddTile);
        outQ.EnQue(res);
        LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
        DataCopy(dst[off], result, kAddTile);
        outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
    }
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
    }
}


/* 诊断 IB：为无 IB 流程的每个 Chunk 增加官方 WaitReady/ReleaseAdd/WaitAddDone，会合后不执行 DONE 邮件。 */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagIbKernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                         kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t perCoreBytes =
        static_cast<uint64_t>(rowsPerCore) * kRowBytes;
    const uint64_t chunkBytes = static_cast<uint64_t>(CHUNK) * kRowBytes;
    const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    GlobalTensor<float16_t> ag, cg;
    ag.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x + coreOff), rowsPerCore * kK);
    cg.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(ownC + coreOff), rowsPerCore * kN);
    mm.SetTensorA(ag, false);
    mm.SetTensorB(wg, true);
    mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cg);
    CleanLines(ownC + coreOff, perCoreBytes);

    WaitReady(ibGm, ibUb, core);
    if (core == 0) {
        const bool ok = smem_shm_sdma_signal_at(
            reserved, ownC, peerDst, chunkBytes, kTagBase);
        CheckOrTrap(ok, status, 1);
        auto mail = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
            mail.dst == expectedRecvDst &&
            mail.len == chunkBytes && mail.imm == kTagBase, status, 2);
    }
    ReleaseAdd(ibGm, ibUb, core);
    const uint64_t base = coreOff;
    CleanLines(ownPeerC + base, perCoreBytes);
    GlobalTensor<float16_t> a, b, dst;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                      perCoreBytes / 2);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                      perCoreBytes / 2);
    dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                        perCoreBytes / 2);
    for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
        LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
        LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
        DataCopy(la, a[off], kAddTile);
        DataCopy(lb, b[off], kAddTile);
        in0.EnQue(la); in1.EnQue(lb);
        LocalTensor<float16_t> va = in0.DeQue<float16_t>();
        LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
        LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
        Add(res, va, vb, kAddTile);
        outQ.EnQue(res);
        LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
        DataCopy(dst[off], result, kAddTile);
        outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
    }
    WaitAddDone(ibGm, ibUb, core);
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
    }
}

/* 诊断 IBDONE16：复制 16 参数的试验 Kernel 签名，隔离参数数量影响。 */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagIbDone16Kernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status,
    __gm__ uint8_t* ctrlSrc, __gm__ uint8_t* peerCtrlDst,
    uint64_t expectedCtrlDst,
    uint32_t chunks, uint32_t overlap, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (enable == 0 || chunks == 0) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    (void)overlap;
    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                         kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t perCoreBytes =
        static_cast<uint64_t>(rowsPerCore) * kRowBytes;
    const uint64_t chunkBytes = static_cast<uint64_t>(CHUNK) * kRowBytes;
    const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    GlobalTensor<float16_t> ag, cg;
    ag.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x + coreOff), rowsPerCore * kK);
    cg.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(ownC + coreOff), rowsPerCore * kN);
    mm.SetTensorA(ag, false);
    mm.SetTensorB(wg, true);
    mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cg);
    CleanLines(ownC + coreOff, perCoreBytes);

    WaitReady(ibGm, ibUb, core);
    if (core == 0) {
        const bool ok = smem_shm_sdma_signal_at(
            reserved, ownC, peerDst, chunkBytes, kTagBase);
        CheckOrTrap(ok, status, 1);
        auto mail = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
            mail.dst == expectedRecvDst &&
            mail.len == chunkBytes && mail.imm == kTagBase, status, 2);
    }
    ReleaseAdd(ibGm, ibUb, core);
    const uint64_t base = coreOff;
    CleanLines(ownPeerC + base, perCoreBytes);
    GlobalTensor<float16_t> a, b, dst;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                      perCoreBytes / 2);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                      perCoreBytes / 2);
    dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                        perCoreBytes / 2);
    for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
        LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
        LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
        DataCopy(la, a[off], kAddTile);
        DataCopy(lb, b[off], kAddTile);
        in0.EnQue(la); in1.EnQue(lb);
        LocalTensor<float16_t> va = in0.DeQue<float16_t>();
        LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
        LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
        Add(res, va, vb, kAddTile);
        outQ.EnQue(res);
        LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
        DataCopy(dst[off], result, kAddTile);
        outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
    }
    WaitAddDone(ibGm, ibUb, core);
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone), status, 5);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(done.status == SMEM_SHM_SDMA_MAIL_OK &&
            done.imm == kTagDone && done.len == 8 &&
            done.dst == expectedCtrlDst, status, 6);
    }
}

/* 诊断 LOOP：将 IbDone16 放入 Chunk 循环，不启用交叠，定位循环影响。 */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagLoopKernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status,
    __gm__ uint8_t* ctrlSrc, __gm__ uint8_t* peerCtrlDst,
    uint64_t expectedCtrlDst,
    uint32_t chunks, uint32_t overlap, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (enable == 0 || chunks == 0) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    (void)overlap;
    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                         kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t perCoreBytes =
        static_cast<uint64_t>(rowsPerCore) * kRowBytes;
    const uint64_t chunkBytes = static_cast<uint64_t>(CHUNK) * kRowBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);
    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);

    for (uint32_t k = 0; k < chunks; ++k) {
        const uint64_t start = static_cast<uint64_t>(k) * chunkBytes;
        const uint64_t coreOff =
            static_cast<uint64_t>(core) * perCoreBytes;
        GlobalTensor<float16_t> ag, cg;
        ag.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(x + start + coreOff),
            rowsPerCore * kK);
        cg.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(ownC + start + coreOff),
            rowsPerCore * kN);
        mm.SetTensorA(ag, false);
        mm.SetTensorB(wg, true);
        mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
        mm.IterateAll(cg);
        CleanLines(ownC + start + coreOff, perCoreBytes);
        WaitReady(ibGm, ibUb, core);
        if (core == 0) {
            const bool ok = smem_shm_sdma_signal_at(
                reserved, ownC + start, peerDst + start, chunkBytes,
                kTagBase | k);
            CheckOrTrap(ok, status, 1);
            auto mail = smem_shm_sdma_wait_at(reserved);
            CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
                mail.dst == expectedRecvDst + start &&
                mail.len == chunkBytes && mail.imm == (kTagBase | k),
                status, 2);
        }
        ReleaseAdd(ibGm, ibUb, core);
        const uint64_t base = start + coreOff;
        CleanLines(ownPeerC + base, perCoreBytes);
        GlobalTensor<float16_t> a, b, dst;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                          perCoreBytes / 2);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                          perCoreBytes / 2);
        dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                            perCoreBytes / 2);
        for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
            LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
            LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
            DataCopy(la, a[off], kAddTile);
            DataCopy(lb, b[off], kAddTile);
            in0.EnQue(la); in1.EnQue(lb);
            LocalTensor<float16_t> va = in0.DeQue<float16_t>();
            LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
            LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
            Add(res, va, vb, kAddTile);
            outQ.EnQue(res);
            LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
            DataCopy(dst[off], result, kAddTile);
            outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
        }
    }
    WaitAddDone(ibGm, ibUb, core);
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone), status, 5);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(done.status == SMEM_SHM_SDMA_MAIL_OK &&
            done.imm == kTagDone && done.len == 8 &&
            done.dst == expectedCtrlDst, status, 6);
    }
}

/* 诊断 IBDONE：在 IB 会合后加入双方对称 DONE 握手。 */
template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagIbDoneKernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status,
    __gm__ uint8_t* ctrlSrc, __gm__ uint8_t* peerCtrlDst,
    uint64_t expectedCtrlDst, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                         kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();
    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t perCoreBytes =
        static_cast<uint64_t>(rowsPerCore) * kRowBytes;
    const uint64_t chunkBytes = static_cast<uint64_t>(CHUNK) * kRowBytes;
    const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    GlobalTensor<float16_t> ag, cg;
    ag.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x + coreOff), rowsPerCore * kK);
    cg.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(ownC + coreOff), rowsPerCore * kN);
    mm.SetTensorA(ag, false);
    mm.SetTensorB(wg, true);
    mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cg);
    CleanLines(ownC + coreOff, perCoreBytes);

    WaitReady(ibGm, ibUb, core);
    if (core == 0) {
        const bool ok = smem_shm_sdma_signal_at(
            reserved, ownC, peerDst, chunkBytes, kTagBase);
        CheckOrTrap(ok, status, 1);
        auto mail = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
            mail.dst == expectedRecvDst &&
            mail.len == chunkBytes && mail.imm == kTagBase, status, 2);
    }
    ReleaseAdd(ibGm, ibUb, core);
    const uint64_t base = coreOff;
    CleanLines(ownPeerC + base, perCoreBytes);
    GlobalTensor<float16_t> a, b, dst;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                      perCoreBytes / 2);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                      perCoreBytes / 2);
    dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                        perCoreBytes / 2);
    for (uint32_t off = 0; off < perCoreBytes / 2; off += kAddTile) {
        LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
        LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
        DataCopy(la, a[off], kAddTile);
        DataCopy(lb, b[off], kAddTile);
        in0.EnQue(la); in1.EnQue(lb);
        LocalTensor<float16_t> va = in0.DeQue<float16_t>();
        LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
        LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
        Add(res, va, vb, kAddTile);
        outQ.EnQue(res);
        LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
        DataCopy(dst[off], result, kAddTile);
        outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
    }
    WaitAddDone(ibGm, ibUb, core);
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone), status, 5);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(done.status == SMEM_SHM_SDMA_MAIL_OK &&
            done.imm == kTagDone && done.len == 8 &&
            done.dst == expectedCtrlDst, status, 6);
    }
}

template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2DiagV1MmKernel(
    __gm__ uint8_t* xGm, __gm__ uint8_t* wGm, __gm__ uint8_t* yGm,
    uint32_t generation)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (generation == 0) return;
    const uint32_t block = GetBlockIdx();
    if (block >= kCores) return;

    constexpr uint32_t kRowsPerCore = CHUNK / kCores;
    const uint64_t rowOff = static_cast<uint64_t>(block) * kRowsPerCore;

    TPipe pipe;
    TCubeTiling rt{};
    rt.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &rt);
    TBuf<> ubBuf;
    pipe.InitBuffer(ubBuf, TOTAL_UB_SIZE);
    mm.SetLocalWorkspace(ubBuf.Get<uint8_t>());

    GlobalTensor<float16_t> aGm;
    GlobalTensor<float16_t> bGm;
    GlobalTensor<float16_t> cGm;
    aGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(xGm) + rowOff * kK,
        kRowsPerCore * kK);
    bGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(wGm), kN * kK);
    cGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(
            yGm + rowOff * kN * sizeof(float16_t)),
        kRowsPerCore * kN);

    mm.SetTensorA(aGm, false);
    mm.SetTensorB(bGm, true);
    mm.SetOrgShape(kRowsPerCore, kN, kK, kK, kN);
    mm.IterateAll(cGm);
}


/* T1 直接 NZ→ND 路径：按 MatmulBlock 方法沿 N 维分核，直接消费完整原始 NZ 权重并写 ND 输出；不切片权重、不暂存输入、不散排输出，M 精确为 1～256。转置 NZ 的 B 列偏移为 colOffset*16 个 FP16，ND 的 C 列偏移为 colOffset；SetOrgShape 使用完整 2048 行跨度，SetSingleShape 与 NZ 子视图须在 dav-2002 验证。 */
constexpr uint64_t kDirectSmallTag = 0x4D4632564E5A4E44ULL; // 通信标记 MF2VN ZND
template <uint32_t T, uint32_t MM_CORES>
struct DirectNsplit {
    static constexpr uint32_t NC = kN / MM_CORES;
    /* dav-2002 实测 UB 约束：enableUBReuse 下 NZ2ND 输出暂存的 transLength=basicM*basicN*sizeof(fp16)，总需求 2 倍。basicM=256、basicN=256 需 256KB，无法同时容纳约 6KB 的 Add/IB；发布构建可能去掉 ASCENDC_ASSERT 而触发片上越界。因此 basicM 上限 128，T=256 分两块执行。 */
    static constexpr uint32_t BASIC_M = T < 128 ? T : 128;
    static constexpr MatmulShapeParams shape =
        {T, NC, kK, BASIC_M, 256, 64};
    static constexpr MatmulConfig cfg =
        GetMMConfig<MatmulConfigMode::CONFIG_NORM>(
            shape, kQuant, kBatch, kFunc);
    static constexpr MatmulApiStaticTiling tiling =
        GetMatmulApiTiling<AT, BT, CT, BiasT>(cfg, Impl::L1_SIZE);
};

template <uint32_t T, uint32_t MM_CORES>
__global__ __aicore__ void V2NzDirectSmallKernel(
    __gm__ uint8_t* gva, __gm__ uint8_t* x, __gm__ uint8_t* w,
    __gm__ uint8_t* y, __gm__ uint8_t* ownC,
    __gm__ uint8_t* ownPeerC, __gm__ uint8_t* peerDst,
    uint64_t expectedRecvDst, __gm__ uint8_t* ibWorkspace,
    __gm__ uint8_t* status, __gm__ uint8_t* ctrlSrc,
    __gm__ uint8_t* peerCtrlDst, uint64_t expectedCtrlDst,
    uint32_t m, uint32_t addCores, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable || m == 0) return;
    constexpr uint32_t NC = kN / MM_CORES;
    const uint32_t core = GetBlockIdx();
    if (core >= MM_CORES && core >= addCores) return;
    const uint32_t blockCols = core * NC;
    const uint64_t chunkBytes = static_cast<uint64_t>(m) * kRowBytes;

    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
        kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    if (core < MM_CORES) {
        // 只有参加 MM 的核构造 Matmul 对象；
        // 仅执行 Add 的核可能编号不小于 MM_CORES，
        // 但不得访问 MM 的 Tiling 状态或本地工作区。
        TCubeTiling runtime{};
        runtime.usedCoreNum = MM_CORES;
        Matmul<AT, BT, CT, BiasT, DirectNsplit<T, MM_CORES>::tiling> mm;
        REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
        mm.SetLocalWorkspace(mmUb.Get<uint8_t>());
        GlobalTensor<float16_t> a, b, c;
        a.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(x),
            static_cast<uint64_t>(m) * kK);
        // B 使用 V1 已验证的 [K/16][N/16][16*16 FP16] NZ 排列。
        // 转置 NZ 的 B 列偏移为 nIndex*BLOCK_CUBE(16)。
        const uint64_t nzElements =
            static_cast<uint64_t>(blockCols) * 16;
        b.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(w) + nzElements,
            static_cast<uint64_t>(kN) * kK - nzElements);
        c.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(ownC) + blockCols,
            static_cast<uint64_t>(m) * kN - blockCols);

        // orgN=2048 表示原始 NZ 权重的 K 分块跨度。
        // orgKc=2048 表示 ND 输出完整行跨度。
        // 必须先设置这些参数，再调用 SetTensorB 和 SetSingleShape。
        mm.SetOrgShape(m, kN, kK, kK, kN);
        mm.SetSingleShape(m, NC, kK);
        mm.SetTensorA(a, false);
        mm.SetTensorB(b, true);
        mm.IterateAll(c);
        // 各 AI Core 只清理自己写出的 [M,NC] 条带。
        // MM_CORES=8 时条带宽 512B，缓存行互不重叠。
        for (uint32_t row = 0; row < m; ++row) {
            CleanLines(ownC + static_cast<uint64_t>(row) * kRowBytes +
                           blockCols * sizeof(float16_t),
                       static_cast<uint64_t>(NC) * sizeof(float16_t));
        }
        if (core != 0) {
            IBSet<true>(ibGm, ibUb, core, kIBReady);
        }
    }

    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);
    if (core == 0) {
        for (uint32_t bcore = 1; bcore < MM_CORES; ++bcore) {
            IBWait<true>(ibGm, ibUb, bcore, kIBReady);
        }
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ownC, peerDst, chunkBytes, kDirectSmallTag),
            status, 41);
        const auto mail = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
                        mail.dst == expectedRecvDst &&
                        mail.len == chunkBytes &&
                        mail.imm == kDirectSmallTag,
                    status, 42);
        for (uint32_t bcore = 1; bcore < addCores; ++bcore) {
            IBSet<true>(ibGm, ibUb, 0, kIBReleaseBase + bcore);
        }
    } else if (core < addCores) {
        IBWait<true>(ibGm, ibUb, 0, kIBReleaseBase + core);
    }

    if (core < addCores) {
        // Add 与 MM 分核独立，每个工作核完整拥有若干输出行，
        // 从而避免不同核对同一输出缓存行写入。
        for (uint32_t row = core; row < m; row += addCores) {
            const uint64_t rowOffset = static_cast<uint64_t>(row) * kRowBytes;
            CleanLines(ownPeerC + rowOffset, kRowBytes);
            GlobalTensor<float16_t> a, b, dst;
            a.SetGlobalBuffer(
                reinterpret_cast<__gm__ float16_t*>(ownC + rowOffset), kN);
            b.SetGlobalBuffer(
                reinterpret_cast<__gm__ float16_t*>(ownPeerC + rowOffset), kN);
            dst.SetGlobalBuffer(
                reinterpret_cast<__gm__ float16_t*>(y + rowOffset), kN);
            for (uint32_t col = 0; col < kN; col += kAddTile) {
                LocalTensor<float16_t> lhs = in0.AllocTensor<float16_t>();
                LocalTensor<float16_t> rhs = in1.AllocTensor<float16_t>();
                DataCopy(lhs, a[col], kAddTile);
                DataCopy(rhs, b[col], kAddTile);
                in0.EnQue(lhs); in1.EnQue(rhs);
                LocalTensor<float16_t> la = in0.DeQue<float16_t>();
                LocalTensor<float16_t> lb = in1.DeQue<float16_t>();
                LocalTensor<float16_t> sum = outQ.AllocTensor<float16_t>();
                Add(sum, la, lb, kAddTile);
                outQ.EnQue(sum);
                LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
                DataCopy(dst[col], result, kAddTile);
                outQ.FreeTensor(result);
                in0.FreeTensor(la); in1.FreeTensor(lb);
            }
        }
        if (core != 0) {
            IBSet<true>(ibGm, ibUb, core, kIBDone);
        }
    }
    if (core == 0) {
        for (uint32_t bcore = 1; bcore < addCores; ++bcore) {
            IBWait<true>(ibGm, ibUb, bcore, kIBDone);
        }
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 43);
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone), status, 44);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(done.status == SMEM_SHM_SDMA_MAIL_OK &&
                        done.dst == expectedCtrlDst &&
                        done.len == 8 && done.imm == kTagDone,
                    status, 45);
    }
}

/* T1 MM 单卡诊断：只执行 V2NzDirectSmallKernel 的 N 分片 MM，直接将 [m,NC] 写入 ND y；不访问对称内存、MemFabric、IB、Add。UB 布局与正式内核一致，用于核验 NZ 子视图以及 SetOrgShape/SetSingleShape。 */
template <uint32_t T, uint32_t MM_CORES>
__global__ __aicore__ void V2DiagNzDirectMmKernel(
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    uint32_t m, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable || m == 0) return;
    constexpr uint32_t NC = kN / MM_CORES;
    const uint32_t core = GetBlockIdx();
    if (core >= MM_CORES) return;
    const uint32_t blockCols = core * NC;

    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kUBForVector - kUBForIB);
    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    TCubeTiling runtime{};
    runtime.usedCoreNum = MM_CORES;
    Matmul<AT, BT, CT, BiasT, DirectNsplit<T, MM_CORES>::tiling> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    GlobalTensor<float16_t> a, b, c;
    a.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x),
        static_cast<uint64_t>(m) * kK);
    const uint64_t nzElements =
        static_cast<uint64_t>(blockCols) * 16;
    b.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(w) + nzElements,
        static_cast<uint64_t>(kN) * kK - nzElements);
    c.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(y) + blockCols,
        static_cast<uint64_t>(m) * kN - blockCols);
    mm.SetOrgShape(m, kN, kK, kK, kN);
    mm.SetSingleShape(m, NC, kK);
    mm.SetTensorA(a, false);
    mm.SetTensorB(b, true);
    mm.IterateAll(c);
    /* 诊断采用与正式内核相同的 MM 后缓存维护，以观察 SDMA/Add 能看到的 GM 状态。 */
    for (uint32_t row = 0; row < m; ++row) {
        CleanLines(y + static_cast<uint64_t>(row) * kRowBytes +
                       blockCols * sizeof(float16_t),
                   static_cast<uint64_t>(NC) * sizeof(float16_t));
    }
}

} // 诊断 Kernel 内部命名空间
using namespace AscendC;
#define V2_DIAG_CASE(K, ROWS)                                                   \
    case ROWS:                                                                  \
        K<tiling##ROWS, ROWS><<<kCores, 0, stream>>>(                           \
            reinterpret_cast<uint8_t*>(x),                                      \
            reinterpret_cast<uint8_t*>(w),                                      \
            reinterpret_cast<uint8_t*>(y), enable);                             \
        return 0;

/* 16 参数最小 Kernel：复刻 V2TrialKernel 发射形状，验证 <<<>>> 参数编组限制。 */
__global__ __aicore__ void V2ArgCountProbeKernel(
    __gm__ uint8_t* a0, __gm__ uint8_t* a1, __gm__ uint8_t* a2,
    __gm__ uint8_t* a3, __gm__ uint8_t* a4, __gm__ uint8_t* a5,
    __gm__ uint8_t* a6, uint64_t a7, __gm__ uint8_t* a8, __gm__ uint8_t* a9,
    __gm__ uint8_t* a10, __gm__ uint8_t* a11, uint64_t a12,
    uint32_t a13, uint32_t a14, uint32_t a15)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() != 0 || a15 == 0) return;
    /* 将所有实参写入 a9 的 64B 区域，供 Host 校验 16 参数槽。 */
    __gm__ volatile uint64_t* out =
        reinterpret_cast<__gm__ volatile uint64_t*>(a9);
    out[0] = reinterpret_cast<uint64_t>(a0);
    out[1] = reinterpret_cast<uint64_t>(a1);
    out[2] = reinterpret_cast<uint64_t>(a2);
    out[3] = reinterpret_cast<uint64_t>(a3);
    out[4] = reinterpret_cast<uint64_t>(a4);
    out[5] = reinterpret_cast<uint64_t>(a5);
    out[6] = reinterpret_cast<uint64_t>(a6);
    out[7] = a7;
    out[8] = reinterpret_cast<uint64_t>(a8);
    out[9] = 0xABCD000000000000ULL | (static_cast<uint64_t>(a13) << 32) |
        (static_cast<uint64_t>(a14) << 16) | a15;
    out[10] = reinterpret_cast<uint64_t>(a10);
    out[11] = reinterpret_cast<uint64_t>(a11);
    out[12] = a12;
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(a9), 8);
    DataCacheCleanAndInvalid<int32_t, CacheLine::SINGLE_CACHE_LINE>(g);
}

extern "C" int mf310p_v2_argcount_probe_async(
    uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t a4,
    uint64_t a5, uint64_t a6, uint64_t a7, uint64_t a8, uint64_t a9,
    uint64_t a10, uint64_t a11, uint64_t a12, uint32_t a13, uint32_t a14,
    uint32_t a15, aclrtStream stream)
{
    if (!stream || !a9) return -1;
    V2ArgCountProbeKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(a0), reinterpret_cast<uint8_t*>(a1),
        reinterpret_cast<uint8_t*>(a2), reinterpret_cast<uint8_t*>(a3),
        reinterpret_cast<uint8_t*>(a4), reinterpret_cast<uint8_t*>(a5),
        reinterpret_cast<uint8_t*>(a6), a7, reinterpret_cast<uint8_t*>(a8),
        reinterpret_cast<uint8_t*>(a9), reinterpret_cast<uint8_t*>(a10),
        reinterpret_cast<uint8_t*>(a11), a12, a13, a14, a15);
    return 0;
}

extern "C" int mf310p_v2_diag_mm_async(
    uint64_t x, uint64_t w, uint64_t y, uint32_t chunkRows, uint32_t enable,
    aclrtStream stream)
{
    if (!stream || (enable && (!x || !w || !y))) return -1;
    switch (chunkRows) {
        V2_DIAG_CASE(V2DiagMmKernel, 256)
        V2_DIAG_CASE(V2DiagMmKernel, 512)
        V2_DIAG_CASE(V2DiagMmKernel, 1024)
        default: return -1;
    }
}

extern "C" int mf310p_v2_diag_v1mm_async(
    uint64_t x, uint64_t w, uint64_t y, uint32_t chunkRows, uint32_t enable,
    aclrtStream stream)
{
    if (!stream || (enable && (!x || !w || !y))) return -1;
    switch (chunkRows) {
        V2_DIAG_CASE(V2DiagV1MmKernel, 256)
        V2_DIAG_CASE(V2DiagV1MmKernel, 512)
        V2_DIAG_CASE(V2DiagV1MmKernel, 1024)
        default: return -1;
    }
}

/* T1 单卡隔离测试：原始 NZ 权重、N 分核 MM、直接 ND 输出。 */
extern "C" int mf310p_v2_diag_nzdirect_mm_async(
    uint64_t x, uint64_t w, uint64_t y, uint32_t templateRows,
    uint32_t validRows, uint32_t mmCores, uint32_t enable,
    aclrtStream stream)
{
    if (!stream || (templateRows != 16 && templateRows != 32 &&
                    templateRows != 64 && templateRows != 128 &&
                    templateRows != 256) ||
        (mmCores != 1 && mmCores != 2 && mmCores != 4 && mmCores != 8) ||
        validRows > templateRows ||
        (enable && (!x || !w || !y || !validRows)))
        return -1;
#define V2_NZDIRECT_DIAG_CASE(T, CORES)                                         \
    case T:                                                                     \
        V2DiagNzDirectMmKernel<T, CORES><<<CORES, 0, stream>>>(                 \
            reinterpret_cast<uint8_t*>(x),                                      \
            reinterpret_cast<uint8_t*>(w),                                      \
            reinterpret_cast<uint8_t*>(y), validRows, enable);                  \
        return 0;
#define V2_NZDIRECT_DIAG_SWITCH(CORES)                                          \
    switch (templateRows) {                                                     \
        V2_NZDIRECT_DIAG_CASE(16, CORES)                                        \
        V2_NZDIRECT_DIAG_CASE(32, CORES)                                        \
        V2_NZDIRECT_DIAG_CASE(64, CORES)                                        \
        V2_NZDIRECT_DIAG_CASE(128, CORES)                                       \
        V2_NZDIRECT_DIAG_CASE(256, CORES)                                       \
        default: return -1;                                                     \
    }
    switch (mmCores) {
    case 1: { V2_NZDIRECT_DIAG_SWITCH(1) }
    case 2: { V2_NZDIRECT_DIAG_SWITCH(2) }
    case 4: { V2_NZDIRECT_DIAG_SWITCH(4) }
    case 8: { V2_NZDIRECT_DIAG_SWITCH(8) }
    default: return -1;
    }
#undef V2_NZDIRECT_DIAG_SWITCH
#undef V2_NZDIRECT_DIAG_CASE
}

extern "C" int mf310p_v2_diag_ib_async(
    uint64_t gva, uint64_t x, uint64_t w, uint64_t y,
    uint64_t ownC, uint64_t ownPeerC, uint64_t peerDst,
    uint64_t expectedRecvDst, uint64_t ibWorkspace, uint64_t status,
    uint32_t chunkRows, uint32_t enable, aclrtStream stream)
{
    if (!stream || (enable && (!gva || !x || !w || !y || !ownC || !ownPeerC ||
                               !peerDst || !expectedRecvDst || !ibWorkspace ||
                               !status)))
        return -1;
#define V2_IB_DIAG_CASE(K, ROWS)                                                \
    case ROWS:                                                                  \
        K<tiling##ROWS, ROWS><<<kCores, 0, stream>>>(                           \
            reinterpret_cast<uint8_t*>(gva),                                    \
            reinterpret_cast<uint8_t*>(x),                                      \
            reinterpret_cast<uint8_t*>(w),                                      \
            reinterpret_cast<uint8_t*>(y),                                      \
            reinterpret_cast<uint8_t*>(ownC),                                   \
            reinterpret_cast<uint8_t*>(ownPeerC),                               \
            reinterpret_cast<uint8_t*>(peerDst), expectedRecvDst,               \
            reinterpret_cast<uint8_t*>(ibWorkspace),                            \
            reinterpret_cast<uint8_t*>(status), enable);                        \
        return 0;
    switch (chunkRows) {
        V2_IB_DIAG_CASE(V2DiagIbKernel, 256)
        V2_IB_DIAG_CASE(V2DiagIbKernel, 512)
        V2_IB_DIAG_CASE(V2DiagIbKernel, 1024)
        default: return -1;
    }
#undef V2_IB_DIAG_CASE
}

