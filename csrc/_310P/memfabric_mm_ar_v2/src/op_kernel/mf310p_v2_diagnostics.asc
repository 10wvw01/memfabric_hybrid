extern "C" int mf310p_v2_diag_noib_async(
    uint64_t gva, uint64_t x, uint64_t w, uint64_t y,
    uint64_t ownC, uint64_t ownPeerC, uint64_t peerDst,
    uint64_t expectedRecvDst, uint64_t status,
    uint32_t chunkRows, uint32_t enable, aclrtStream stream)
{
    if (!stream || (enable && (!gva || !x || !w || !y || !ownC || !ownPeerC ||
                               !peerDst || !expectedRecvDst || !status)))
        return -1;
    switch (chunkRows) {
        case 256:
            V2DiagNoIbKernel<tiling256, 256><<<kCores, 0, stream>>>(
                reinterpret_cast<uint8_t*>(gva),
                reinterpret_cast<uint8_t*>(x),
                reinterpret_cast<uint8_t*>(w),
                reinterpret_cast<uint8_t*>(y),
                reinterpret_cast<uint8_t*>(ownC),
                reinterpret_cast<uint8_t*>(ownPeerC),
                reinterpret_cast<uint8_t*>(peerDst), expectedRecvDst,
                reinterpret_cast<uint8_t*>(status), enable);
            return 0;
        case 512:
            V2DiagNoIbKernel<tiling512, 512><<<kCores, 0, stream>>>(
                reinterpret_cast<uint8_t*>(gva),
                reinterpret_cast<uint8_t*>(x),
                reinterpret_cast<uint8_t*>(w),
                reinterpret_cast<uint8_t*>(y),
                reinterpret_cast<uint8_t*>(ownC),
                reinterpret_cast<uint8_t*>(ownPeerC),
                reinterpret_cast<uint8_t*>(peerDst), expectedRecvDst,
                reinterpret_cast<uint8_t*>(status), enable);
            return 0;
        case 1024:
            V2DiagNoIbKernel<tiling1024, 1024><<<kCores, 0, stream>>>(
                reinterpret_cast<uint8_t*>(gva),
                reinterpret_cast<uint8_t*>(x),
                reinterpret_cast<uint8_t*>(w),
                reinterpret_cast<uint8_t*>(y),
                reinterpret_cast<uint8_t*>(ownC),
                reinterpret_cast<uint8_t*>(ownPeerC),
                reinterpret_cast<uint8_t*>(peerDst), expectedRecvDst,
                reinterpret_cast<uint8_t*>(status), enable);
            return 0;
        default: return -1;
    }
}


/* 实验入口：原始 NZ、直接 ND 的小 M Kernel。 */
extern "C" int mf310p_v2_nz_direct_small_launch_async(
    uint64_t gva, uint64_t x, uint64_t w, uint64_t y,
    uint64_t ownC, uint64_t ownPeerC, uint64_t peerDst,
    uint64_t expectedRecvDst, uint64_t ibWorkspace, uint64_t status,
    uint64_t ctrlSrc, uint64_t peerCtrlDst, uint64_t expectedCtrlDst,
    uint32_t templateRows, uint32_t validRows,
    uint32_t mmCores, uint32_t addCores, uint32_t enable,
    aclrtStream stream)
{
    if (!stream || (templateRows != 16 && templateRows != 32 &&
                    templateRows != 64 && templateRows != 128 &&
                    templateRows != 256) ||
        (mmCores != 1 && mmCores != 2 &&
         mmCores != 4 && mmCores != 8) ||
        (addCores != 1 && addCores != 2 &&
         addCores != 4 && addCores != 8) ||
        validRows > templateRows ||
        (enable && (!validRows || !gva || !x || !w || !y ||
                    !ownC || !ownPeerC || !peerDst ||
                    !expectedRecvDst || !ibWorkspace || !status ||
                    !ctrlSrc || !peerCtrlDst || !expectedCtrlDst)))
        return -1;

#define V2_NZ_DIRECT_CASE(T, CORES)                                            \
    case T: {                                                                 \
        V2NzDirectSmallKernel<T, CORES><<<                                    \
            (CORES > addCores ? CORES : addCores), 0, stream>>>(                \
            reinterpret_cast<uint8_t*>(gva),                                  \
            reinterpret_cast<uint8_t*>(x),                                    \
            reinterpret_cast<uint8_t*>(w),                                    \
            reinterpret_cast<uint8_t*>(y),                                    \
            reinterpret_cast<uint8_t*>(ownC),                                  \
            reinterpret_cast<uint8_t*>(ownPeerC),                              \
            reinterpret_cast<uint8_t*>(peerDst), expectedRecvDst,              \
            reinterpret_cast<uint8_t*>(ibWorkspace),                           \
            reinterpret_cast<uint8_t*>(status),                                \
            reinterpret_cast<uint8_t*>(ctrlSrc),                               \
            reinterpret_cast<uint8_t*>(peerCtrlDst), expectedCtrlDst,          \
            validRows, addCores, enable);                                      \
        return 0;                                                              \
    }
#define V2_NZ_DIRECT_SWITCH(CORES)                                             \
    switch (templateRows) {                                                   \
        V2_NZ_DIRECT_CASE(16, CORES)                                           \
        V2_NZ_DIRECT_CASE(32, CORES)                                           \
        V2_NZ_DIRECT_CASE(64, CORES)                                           \
        V2_NZ_DIRECT_CASE(128, CORES)                                          \
        V2_NZ_DIRECT_CASE(256, CORES)                                          \
        default: return -1;                                                    \
    }
    switch (mmCores) {
    case 1: { V2_NZ_DIRECT_SWITCH(1) }
    case 2: { V2_NZ_DIRECT_SWITCH(2) }
    case 4: { V2_NZ_DIRECT_SWITCH(4) }
    case 8: { V2_NZ_DIRECT_SWITCH(8) }
    default: return -1;
    }
#undef V2_NZ_DIRECT_SWITCH
#undef V2_NZ_DIRECT_CASE
}


/* T2 非融合基线：原生 MM 在 Kernel 外产生 ND FP16，Host 在同一 Stream 将其 D2D 搬到对称 ownC，再调用 AR-only Kernel；搬运必须计入对比 Stock 的耗时。Core0 每次提交不超过 4MiB 连续包并等待收件；Add 核按整行分配，避免共享输出缓存行。每轮 quiet+DONE 保护对称缓冲，内部绝不执行 MM。 */
namespace {
constexpr uint64_t kArOnlyTag = 0x4D46324152000000ULL; // 通信标记 MF2AR 与 Chunk 序号

__global__ __aicore__ void V2MemfabricArOnlyKernel(
    __gm__ uint8_t* gva, __gm__ uint8_t* localPartial,
    __gm__ uint8_t* remotePartial, __gm__ uint8_t* result,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status,
    __gm__ uint8_t* ctrlSrc, __gm__ uint8_t* peerCtrlDst,
    uint64_t expectedCtrlDst, uint32_t m, uint32_t chunkRows,
    uint32_t addCores, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable || !m) return;
    const uint32_t core = GetBlockIdx();
    if (core >= addCores) return;

    TPipe pipe;
    TBuf<> ibBuf;
    pipe.InitBuffer(ibBuf, kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
        kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = ibBuf.Get<int32_t>();
    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kAddBytes);
    pipe.InitBuffer(in1, 1, kAddBytes);
    pipe.InitBuffer(outQ, 1, kAddBytes);

    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);
    uint32_t chunk = 0;
    for (uint32_t startRow = 0; startRow < m;
         startRow += chunkRows, ++chunk) {
        const uint32_t rows =
            m - startRow < chunkRows ? m - startRow : chunkRows;
        const uint64_t byteOffset =
            static_cast<uint64_t>(startRow) * kRowBytes;
        const uint64_t packetBytes =
            static_cast<uint64_t>(rows) * kRowBytes;
        const uint64_t tag = kArOnlyTag | chunk;

        if (core == 0) {
            // 同一 Stream 保证此前 D2D 拷贝已经完成；
            // 发送地址必须指向池内对称缓冲，
            // 不能直接发送未注册的普通 Tensor 指针。
            CheckOrTrap(smem_shm_sdma_signal_at(
                reserved, localPartial + byteOffset,
                peerDst + byteOffset, packetBytes, tag),
                status, 61);
            const auto mail = smem_shm_sdma_wait_at(reserved);
            CheckOrTrap(
                mail.status == SMEM_SHM_SDMA_MAIL_OK &&
                mail.dst == expectedRecvDst + byteOffset &&
                mail.len == packetBytes && mail.imm == tag,
                status, 62);
            for (uint32_t worker = 1; worker < addCores; ++worker)
                IBSet<true>(
                    ibGm, ibUb, 0, kIBReleaseBase + worker);
        } else {
            IBWait<true>(ibGm, ibUb, 0, kIBReleaseBase + core);
        }

        for (uint32_t row = startRow + core;
             row < startRow + rows; row += addCores) {
            const uint64_t rowBytes =
                static_cast<uint64_t>(row) * kRowBytes;
            // D2D 和 SDMA 属于外部 GM 写入，
            // AICore 读取前需失效旧 L1 缓存行。
            CleanLines(localPartial + rowBytes, kRowBytes);
            CleanLines(remotePartial + rowBytes, kRowBytes);
            GlobalTensor<float16_t> a, b, y;
            a.SetGlobalBuffer(
                reinterpret_cast<__gm__ float16_t*>(
                    localPartial + rowBytes), kN);
            b.SetGlobalBuffer(
                reinterpret_cast<__gm__ float16_t*>(
                    remotePartial + rowBytes), kN);
            y.SetGlobalBuffer(
                reinterpret_cast<__gm__ float16_t*>(
                    result + rowBytes), kN);
            for (uint32_t col = 0; col < kN; col += kAddTile) {
                LocalTensor<float16_t> lhs =
                    in0.AllocTensor<float16_t>();
                LocalTensor<float16_t> rhs =
                    in1.AllocTensor<float16_t>();
                DataCopy(lhs, a[col], kAddTile);
                DataCopy(rhs, b[col], kAddTile);
                in0.EnQue(lhs); in1.EnQue(rhs);
                LocalTensor<float16_t> va = in0.DeQue<float16_t>();
                LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
                LocalTensor<float16_t> sum =
                    outQ.AllocTensor<float16_t>();
                Add(sum, va, vb, kAddTile);
                outQ.EnQue(sum);
                LocalTensor<float16_t> out = outQ.DeQue<float16_t>();
                DataCopy(y[col], out, kAddTile);
                outQ.FreeTensor(out);
                in0.FreeTensor(va); in1.FreeTensor(vb);
            }
        }
        if (core != 0)
            IBSet<true>(ibGm, ibUb, core, kIBDone);
        else
            for (uint32_t worker = 1; worker < addCores; ++worker)
                IBWait<true>(ibGm, ibUb, worker, kIBDone);
    }

    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 63);
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone),
            status, 64);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(
            done.status == SMEM_SHM_SDMA_MAIL_OK &&
            done.dst == expectedCtrlDst && done.len == 8 &&
            done.imm == kTagDone,
            status, 65);
    }
}
} // 匿名命名空间

/* T2 AICore 暂存：通过 GM→UB→GM 将原生 MM 结果写入 ownC，之后按核 CleanLines。2026-10-18 实测 aclrtMemcpyAsync 引擎与同 Stream AICore 写入不一致，可能读到旧数据且 status=0；这里改用 AICore 暂存和 T0 已验证的写入清缓存后再 signal 纪律。 */
namespace {
__global__ __aicore__ void V2ArStageKernel(
    __gm__ uint8_t* dst, __gm__ uint8_t* src, uint64_t bytes,
    uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enable || !bytes) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;
    const uint64_t per = (bytes + kCores - 1) / kCores;
    const uint64_t begin = per * core;
    if (begin >= bytes) return;
    const uint64_t end = begin + per < bytes ? begin + per : bytes;

    TPipe pipe;
    TQue<TPosition::VECIN, 2> inQ;
    TQue<TPosition::VECOUT, 2> outQ;
    pipe.InitBuffer(inQ, 2, kAddBytes);
    pipe.InitBuffer(outQ, 2, kAddBytes);
    /* 源数据来自此前 MM Kernel；dav-2002 不会自动失效跨 Kernel 的 L1 缓存，因此先清理本核旧缓存行再加载。 */
    CleanLines(src + begin, end - begin);
    GlobalTensor<float16_t> gsrc, gdst;
    const uint64_t elems = (end - begin) / sizeof(float16_t);
    gsrc.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(src + begin), elems);
    gdst.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(dst + begin), elems);
    for (uint64_t off = 0; off < elems; off += kAddTile) {
        const uint32_t n = elems - off < kAddTile
            ? static_cast<uint32_t>(elems - off) : kAddTile;
        /* MTE1 读入与上游 Kernel 的缓存写入未必一致：小 M 连续调用时可读到上一轮数据，M=1 曾约 1/128 复现。调用方需在原生 MM 与本内核之间同步 Stream；上方 CleanLines 也负责清理本核先前的 L1。 */
        LocalTensor<float16_t> v = inQ.AllocTensor<float16_t>();
        DataCopy(v, gsrc[off], n);
        inQ.EnQue(v);
        LocalTensor<float16_t> got = inQ.DeQue<float16_t>();
        /* 关键队列约束：MTE1 读入不能直接交给 MTE3 写出；VECIN DeQue 只通知 MTE1→V 完成，不保证 V→MTE3 交接。必须经过 Vector Adds(x,0) 生成 VECOUT，避免 MTE3 提前写出旧 UB 数据。 */
        LocalTensor<float16_t> o = outQ.AllocTensor<float16_t>();
        Adds(o, got, static_cast<float16_t>(0), n);
        outQ.EnQue(o);
        LocalTensor<float16_t> vo = outQ.DeQue<float16_t>();
        DataCopy(gdst[off], vo, n);
        outQ.FreeTensor(vo);
        inQ.FreeTensor(got);
    }
    /* 等待全部 MTE3 写出完成，再 Clean 缓存，保证后续 AR-only 的 AICPU SDMA 从 DDR 视图看到最新内容。 */
    {
        event_t fenceId = static_cast<event_t>(
            GetTPipePtr()->FetchEventID(HardEvent::MTE3_S));
        SetFlag<HardEvent::MTE3_S>(fenceId);
        WaitFlag<HardEvent::MTE3_S>(fenceId);
    }
    CleanLines(dst + begin, end - begin);
}
} // 匿名命名空间

extern "C" int mf310p_v2_ar_stage_launch_async(
    uint64_t dst, uint64_t src, uint64_t bytes, uint32_t enable,
    aclrtStream stream)
{
    if (!stream || bytes > 8192ULL * kRowBytes ||
        (enable && (!dst || !src || bytes == 0 || bytes % 64)))
        return -1;
    V2ArStageKernel<<<kCores, 0, stream>>>(
        reinterpret_cast<uint8_t*>(dst), reinterpret_cast<uint8_t*>(src),
        bytes, enable);
    return 0;
}

extern "C" int mf310p_v2_ar_only_launch_async(
    uint64_t gva, uint64_t localPartial, uint64_t remotePartial,
    uint64_t result, uint64_t peerDst, uint64_t expectedRecvDst,
    uint64_t ibWorkspace, uint64_t status,
    uint64_t ctrlSrc, uint64_t peerCtrlDst, uint64_t expectedCtrlDst,
    uint32_t m, uint32_t chunkRows, uint32_t addCores,
    uint32_t enable, aclrtStream stream)
{
    if (!stream || (chunkRows != 256 && chunkRows != 512 &&
                    chunkRows != 1024) ||
        (addCores != 1 && addCores != 2 &&
         addCores != 4 && addCores != 8) ||
        m > 8192 ||
        (enable && (!m || !gva || !localPartial || !remotePartial ||
                    !result || !peerDst || !expectedRecvDst ||
                    !ibWorkspace || !status || !ctrlSrc ||
                    !peerCtrlDst || !expectedCtrlDst)))
        return -1;
    V2MemfabricArOnlyKernel<<<addCores, 0, stream>>>(
        reinterpret_cast<uint8_t*>(gva),
        reinterpret_cast<uint8_t*>(localPartial),
        reinterpret_cast<uint8_t*>(remotePartial),
        reinterpret_cast<uint8_t*>(result),
        reinterpret_cast<uint8_t*>(peerDst), expectedRecvDst,
        reinterpret_cast<uint8_t*>(ibWorkspace),
        reinterpret_cast<uint8_t*>(status),
        reinterpret_cast<uint8_t*>(ctrlSrc),
        reinterpret_cast<uint8_t*>(peerCtrlDst), expectedCtrlDst,
        m, chunkRows, addCores, enable);
    return 0;
}

