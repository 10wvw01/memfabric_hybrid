// 正式算子设备核：仅包含 T0 MM+MemFabric+Add 及 Serving 必须的 IB 自检。
#include "mf310p_v2_kernel_common.h"

namespace {
// D3/C2 单变量实验：仅正式 V2 的 Vector Add 批量从 1024→2048 个 FP16。
// 诊断 Kernel 仍使用 kernel_common.h 中的 kAddTile=1024，避免污染对照组。
// 不变更 MM tiling、通信顺序、IB、DCCI、DONE 或 Torch ABI。
constexpr uint32_t kProductionAddTile = 2048;
constexpr uint32_t kProductionAddBytes = kProductionAddTile * sizeof(float16_t);
constexpr uint32_t kProductionUBForVector = 3 * kProductionAddBytes;
static_assert(kProductionAddBytes % 32 == 0, "Vector buffer must be 32B aligned");
static_assert((256 / kCores) * kN % kProductionAddTile == 0,
              "The smallest supported Chunk must be divisible by the Add tile");

template <const MatmulApiStaticTiling& TILING, uint32_t CHUNK>
__global__ __aicore__ void V2TrialKernel(
    __gm__ uint8_t* gva,
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* y,
    __gm__ uint8_t* ownC, __gm__ uint8_t* ownPeerC,
    __gm__ uint8_t* peerDst, uint64_t expectedRecvDst,
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* status,
    __gm__ uint8_t* ctrlSrc, __gm__ uint8_t* peerCtrlDst,
    uint64_t expectedCtrlDst,
    uint32_t chunks, uint32_t overlap, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (enable == 0 || chunks == 0) return;
    const uint32_t core = GetBlockIdx();
    if (core >= kCores) return;

    TPipe pipe;
    TBuf<> syncBuf, mmUb;
    pipe.InitBuffer(syncBuf, kUBForIB);
    // CANN 9.1 头文件中 TOTAL_UB_SIZE 仅在核函数(device)上下文可见，
    // 因此 UB 预算断言必须与被守护的 InitBuffer 同处设备侧。
    static_assert(TOTAL_UB_SIZE > kUBForIB + kProductionUBForVector,
                  "Not enough UB for IB, Vector queues and Matmul local workspace");
    // Matmul SetLocalWorkspace 的最小临时空间仍需 310P3 BiSheng 实机编译/资源核验。
    pipe.InitBuffer(mmUb, TOTAL_UB_SIZE - kProductionUBForVector - kUBForIB);
    GlobalTensor<int32_t> ibGm;
    ibGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                         kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ibUb = syncBuf.Get<int32_t>();

    TCubeTiling runtime{};
    runtime.usedCoreNum = kCores;
    Matmul<AT, BT, CT, BiasT, TILING> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &runtime);
    mm.SetLocalWorkspace(mmUb.Get<uint8_t>());

    TQue<TPosition::VECIN, 1> in0, in1;
    TQue<TPosition::VECOUT, 1> outQ;
    pipe.InitBuffer(in0, 1, kProductionAddBytes);
    pipe.InitBuffer(in1, 1, kProductionAddBytes);
    pipe.InitBuffer(outQ, 1, kProductionAddBytes);

    GlobalTensor<float16_t> wg;
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w), kN * kK);
    const uint64_t perCoreBytes = CHUNK * kRowBytes / kCores;
    const uint32_t rowsPerCore = CHUNK / kCores;
    const uint64_t chunkBytes = CHUNK * kRowBytes;
    __gm__ uint8_t* reserved = smem_shm_sdma_reserved(gva);

    for (uint32_t k = 0; k < chunks; ++k) {
        const uint64_t start = static_cast<uint64_t>(k) * chunkBytes;
        const uint64_t coreOff = static_cast<uint64_t>(core) * perCoreBytes;
        GlobalTensor<float16_t> ag, cg;
        ag.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(x + start + coreOff),
            rowsPerCore * kK);
        cg.SetGlobalBuffer(
            reinterpret_cast<__gm__ float16_t*>(ownC + start + coreOff),
            rowsPerCore * kN);
        mm.SetTensorA(ag, false);
        mm.SetTensorB(wg, true);
        mm.SetOrgShape(rowsPerCore, kN, kK, kK, kN);
        mm.IterateAll(cg);
        CleanLines(ownC + start + coreOff, perCoreBytes);
        WaitReady(ibGm, ibUb, core);

        if (core == 0) {
            const bool ok = smem_shm_sdma_signal_at(
                reserved, ownC + start, peerDst + start,
                chunkBytes, kTagBase | k);
            CheckOrTrap(ok, status, 1);
        }

        const bool doAdd = (overlap == 0 || k > 0);
        if (doAdd) {
            const uint32_t prev = overlap == 0 ? k : k - 1;
            if (core == 0) {
                auto mail = smem_shm_sdma_wait_at(reserved);
                const bool good =
                    mail.status == SMEM_SHM_SDMA_MAIL_OK &&
                    mail.dst == expectedRecvDst + static_cast<uint64_t>(prev) * chunkBytes &&
                    mail.len == chunkBytes && mail.imm == (kTagBase | prev);
                CheckOrTrap(good, status, 2);
            }
            ReleaseAdd(ibGm, ibUb, core);
            const uint64_t base = static_cast<uint64_t>(prev) * chunkBytes + coreOff;
            // SDMA 写入了对端局部结果，精确失效本核即将读取的缓存行，
            // Graph 重放时同样不能省略。
            CleanLines(ownPeerC + base, perCoreBytes);
            GlobalTensor<float16_t> a, b, dst;
            a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                              perCoreBytes / 2);
            b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                              perCoreBytes / 2);
            dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                                perCoreBytes / 2);
            for (uint32_t off = 0; off < perCoreBytes / 2; off += kProductionAddTile) {
                LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
                LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
                DataCopy(la, a[off], kProductionAddTile);
                DataCopy(lb, b[off], kProductionAddTile);
                in0.EnQue(la); in1.EnQue(lb);
                LocalTensor<float16_t> va = in0.DeQue<float16_t>();
                LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
                LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
                Add(res, va, vb, kProductionAddTile);
                outQ.EnQue(res);
                LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
                DataCopy(dst[off], result, kProductionAddTile);
                outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
            }
        }
    }

    if (overlap != 0) {
        const uint32_t last = chunks - 1;
        if (core == 0) {
            auto mail = smem_shm_sdma_wait_at(reserved);
            CheckOrTrap(mail.status == SMEM_SHM_SDMA_MAIL_OK &&
                mail.dst == expectedRecvDst + static_cast<uint64_t>(last) * chunkBytes &&
                mail.len == chunkBytes && mail.imm == (kTagBase | last),
                status, 3);
        }
        ReleaseAdd(ibGm, ibUb, core);
        const uint64_t base = static_cast<uint64_t>(last) * chunkBytes +
                              static_cast<uint64_t>(core) * perCoreBytes;
        CleanLines(ownPeerC + base, perCoreBytes);
        GlobalTensor<float16_t> a, b, dst;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownC + base),
                          perCoreBytes / 2);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(ownPeerC + base),
                          perCoreBytes / 2);
        dst.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(y + base),
                            perCoreBytes / 2);
        for (uint32_t off = 0; off < perCoreBytes / 2; off += kProductionAddTile) {
            LocalTensor<float16_t> la = in0.AllocTensor<float16_t>();
            LocalTensor<float16_t> lb = in1.AllocTensor<float16_t>();
            DataCopy(la, a[off], kProductionAddTile);
            DataCopy(lb, b[off], kProductionAddTile);
            in0.EnQue(la); in1.EnQue(lb);
            LocalTensor<float16_t> va = in0.DeQue<float16_t>();
            LocalTensor<float16_t> vb = in1.DeQue<float16_t>();
            LocalTensor<float16_t> res = outQ.AllocTensor<float16_t>();
            Add(res, va, vb, kProductionAddTile);
            outQ.EnQue(res);
            LocalTensor<float16_t> result = outQ.DeQue<float16_t>();
            DataCopy(dst[off], result, kProductionAddTile);
            outQ.FreeTensor(result); in0.FreeTensor(va); in1.FreeTensor(vb);
        }
    }

    WaitAddDone(ibGm, ibUb, core);
    if (core == 0) {
        CheckOrTrap(smem_shm_sdma_quiet_at(reserved), status, 4);
        // 双方均先发送 DONE 再等待；收到对端 DONE 表示
        // 对端 Add 已结束读取本端 C 缓冲区。
        CheckOrTrap(smem_shm_sdma_signal_at(
            reserved, ctrlSrc, peerCtrlDst, 8, kTagDone), status, 5);
        const auto done = smem_shm_sdma_wait_at(reserved);
        CheckOrTrap(done.status == SMEM_SHM_SDMA_MAIL_OK &&
            done.imm == kTagDone && done.len == 8 &&
            done.dst == expectedCtrlDst, status, 6);
    }
}

} // 正式 Kernel 内部命名空间
using namespace AscendC;
// 调用方应保证：
// 两个 Rank 的 CHUNK、数量、模式和对端指针一致；
// ownC 与 ownPeerC 是对称内存内不重叠区域；
// 本地 IB 工作区不小于 kIBBytes 且首次调用前清零；
// ctrlSrc 不可修改，peerCtrlDst 位于 C0/C1 区域外；
// y 与 C0/C1 不重叠，同一池不得并发使用；
// 本原型仅支持完整 CHUNK 倍数，最多 8192 行；
// 每个已实例化 Kernel 符号先进行两次 enable=0 预热。
extern "C" int mf310p_v2_trial_launch_async(
    uint64_t gva, uint64_t x, uint64_t w, uint64_t y,
    uint64_t ownC, uint64_t ownPeerC,
    uint64_t peerDst, uint64_t expectedRecvDst,
    uint64_t ibWorkspace, uint64_t status,
    uint64_t ctrlSrc, uint64_t peerCtrlDst, uint64_t expectedCtrlDst,
    uint32_t chunkRows, uint32_t chunks, uint32_t overlap,
    uint32_t enable, aclrtStream stream)
{
    if (stream == nullptr || (enable != 0 &&
        (gva == 0 || x == 0 || w == 0 || y == 0 || ownC == 0 ||
         ownPeerC == 0 || peerDst == 0 || expectedRecvDst == 0 ||
         ibWorkspace == 0 || status == 0 || ctrlSrc == 0 ||
         peerCtrlDst == 0 || expectedCtrlDst == 0))) return -1;
    if (chunkRows == 0 || chunks > 8192 / chunkRows || (enable != 0 && chunks == 0) ||
        overlap > 1) return -1;
#define V2_CASE(ROWS)                                                         \
    case ROWS: {                                                              \
        V2TrialKernel<tiling##ROWS, ROWS><<<kCores, 0, stream>>>(              \
            reinterpret_cast<uint8_t*>(gva),                                 \
            reinterpret_cast<uint8_t*>(x),                                   \
            reinterpret_cast<uint8_t*>(w),                                   \
            reinterpret_cast<uint8_t*>(y),                                   \
            reinterpret_cast<uint8_t*>(ownC),                                \
            reinterpret_cast<uint8_t*>(ownPeerC),                             \
            reinterpret_cast<uint8_t*>(peerDst), expectedRecvDst,             \
            reinterpret_cast<uint8_t*>(ibWorkspace),                          \
            reinterpret_cast<uint8_t*>(status),                               \
            reinterpret_cast<uint8_t*>(ctrlSrc),                              \
            reinterpret_cast<uint8_t*>(peerCtrlDst), expectedCtrlDst,         \
            chunks, overlap, enable);                                        \
        return 0;                                                             \
    }
    switch (chunkRows) {
        V2_CASE(256)
        V2_CASE(512)
        V2_CASE(1024)
        default: return -1;
    }
#undef V2_CASE
}

extern "C" uint32_t mf310p_v2_trial_ib_workspace_bytes()
{
    return kIBBytes;
}

/* 官方 IB 独立探针，须先于 V2TrialKernel 验证通过。 */
extern "C" __global__ __aicore__ void mf310p_v2_ib_probe_kernel(
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* result,
    uint32_t repetitions, uint32_t enabled)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enabled || GetBlockIdx() >= 2) return;
    TPipe pipe;
    TBuf<> syncBuf;
    pipe.InitBuffer(syncBuf, 32);
    GlobalTensor<int32_t> gm;
    gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace), 640);
    LocalTensor<int32_t> ub = syncBuf.Get<int32_t>();
    for (uint32_t k = 0; k < repetitions; ++k) {
        if (GetBlockIdx() == 0) {
            IBSet<true>(gm, ub, 0, 0);
            IBWait<true>(gm, ub, 1, 1);
        } else {
            IBWait<true>(gm, ub, 0, 0);
            IBSet<true>(gm, ub, 1, 1);
        }
    }
    WriteResultSlot(result, GetBlockIdx(), repetitions);
}
extern "C" int mf310p_v2_ib_probe_async(
    uint64_t ibWorkspace, uint64_t result, uint32_t repetitions,
    uint32_t enabled, aclrtStream stream)
{
    if (!stream || (enabled && (!ibWorkspace || !result || !repetitions)))
        return -1;
    mf310p_v2_ib_probe_kernel<<<2, 0, stream>>>(
        reinterpret_cast<uint8_t*>(ibWorkspace),
        reinterpret_cast<uint8_t*>(result),
        repetitions, enabled);
    return 0;
}

/* G0 第二阶段模拟 MM Kernel 的 8→1、1→7 核间事件模式。 */
extern "C" __global__ __aicore__ void mf310p_v2_ib_fan_probe_kernel(
    __gm__ uint8_t* ibWorkspace, __gm__ uint8_t* result,
    uint32_t repetitions, uint32_t enabled)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (!enabled) return;
    const uint32_t core = GetBlockIdx();
    if (core >= 8) return;
    TPipe pipe;
    TBuf<> syncBuf;
    pipe.InitBuffer(syncBuf, 32);
    GlobalTensor<int32_t> gm;
    gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ibWorkspace),
                       kIBBytes / sizeof(int32_t));
    LocalTensor<int32_t> ub = syncBuf.Get<int32_t>();
    for (uint32_t i = 0; i < repetitions; ++i) {
        WaitReady(gm, ub, core);
        ReleaseAdd(gm, ub, core);
        WaitAddDone(gm, ub, core);
    }
    WriteResultSlot(result, core, repetitions);
}
using namespace AscendC;

extern "C" int mf310p_v2_ib_fan_probe_async(
    uint64_t ibWorkspace, uint64_t result, uint32_t repetitions,
    uint32_t enabled, aclrtStream stream)
{
    if (!stream || (enabled && (!ibWorkspace || !result || !repetitions)))
        return -1;
    mf310p_v2_ib_fan_probe_kernel<<<8, 0, stream>>>(
        reinterpret_cast<uint8_t*>(ibWorkspace),
        reinterpret_cast<uint8_t*>(result), repetitions, enabled);
    return 0;
}

