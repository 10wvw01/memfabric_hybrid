/* probe_e0c — E0c 池上协同最小复现：AICore×AICPU 八步语义全链（双 die HBM 池）
 *
 * 在 E0a(SQE 直投闭环) + E0b(池 GVA 可译) 之上, 加入 AICore 参与方, 复刻协同模式全链:
 *   ① r0 AICore 产 pattern 到 own 池 GVA(GM 写 + ENTIRE clean)
 *   ② r0 AICore 写本端邮箱(普通设备内存, 16B 描述符 + 行 clean)
 *   ③ r0 AICPU 编排(mode13 role0): 轮询邮箱 → SQE 对(数据 own池GVA→peer池GVA +
 *      标志 哨兵→peer池GVA+FLAG_OFF) → doorbell
 *   ④ r1 AICore dcci 轮询 own 池 GVA+FLAG_OFF(对端 SDMA 写入)
 *   ⑤ r1 AICore 读 own 池数据 +INC 写回(GM RMW + ENTIRE clean)
 *   ⑥ r1 AICore 写本端回程邮箱 → r1 AICPU 编排(role0): SQE 对(数据 own池GVA→
 *      peer池GVA + 标志→peer池GVA+RESULT_OFF) → doorbell
 *   ⑦ r0 AICore dcci 轮询 own 池 GVA+RESULT_OFF
 *   ⑧ r0 host G2H 读 own 池数据校验 == pattern+INC
 *
 * 与 xcclpp demo 的结构差异(均为已证事实支撑的简化):
 *   - 两侧 AICPU 均用 mode13 role0(邮箱轮询→SQE 对→doorbell), 不用 role1 —— 把
 *     "到达轮询+ready 通知"上移给 AICore 直接 dcci 轮询池内标志, 规避 AICPU 解引用
 *     池 VA(D9 纪律); 数据与标志全部走池 GVA(E0b 已证 SDMA 可译)
 *   - 无 MPI, 双进程 + 文件标记同步(07 示例纪律)
 *
 * 本实验同时裁决新未知点: AICore GM 访问 AclVmm 窗口 VA(①⑤ 的写与⑤的读)。
 *
 * 用法: ./probe_e0c <0|1> [json]   (两进程分别以 0/1 启动)
 */
#include <cstdio>
#include <cstring>
#include <cstdlib>
#include <cstdint>
#include <unistd.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_bm.h"
#include "hybm_overlap_contract.h"

// libruntime 内部符号(CP 流 sqId 查询)
extern "C" {
typedef void* rtStream_t;
typedef int32_t rtError_t;
rtError_t rtStreamGetSqid(const rtStream_t stm, uint32_t* sqId);
}

#define STORE_URL "tcp://127.0.0.1:8578"
#define HBM_POOL_SIZE (32UL * 1024UL * 1024UL)
#define E0C_WORDS 1024u                 /* 数据量: 1024 字(4KB) */
#define E0C_INC 0x100u                  /* r1 AICore 增量(校验可见) */
#define E0C_TAG 0x7Au                   /* pattern 标识 */
#define FLAG_OFF (16UL * 1024UL * 1024UL)      /* 池内到达标志偏移(r1 轮询) */
#define RESULT_OFF (16UL * 1024UL * 1024UL + 64UL) /* 池内结果标志偏移(r0 轮询) */
#define SENT_A 0xE0ECA001ULL            /* r0→r1 到达哨兵 */
#define SENT_B 0xE0ECA002ULL            /* r1→r0 结果哨兵 */
#define WORK_DIR "/tmp/e0c_pool"
#define JOIN_TIMEOUT 120

// AICore 内联修饰(memfabric hybm_copy_kernel 同款)
#define E0C_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__

static int g_rank = -1;

/* ============================ 设备侧: AICore kernel ============================ */

// 状态槽写 + 行 clean(host G2H 经 SDMA 只认 GM)
E0C_AICORE_INLINE void E0cStatusSet(__gm__ uint32_t* status, uint32_t slot, uint32_t val)
{
    status[slot] = val;
    AscendC::GlobalTensor<int32_t> stGm;
    stGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(status + slot), 1);
    AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(stGm);
}

// dcci 轮询池内 8B 标志(命中返回非零值, 超时返回 0; 迭代数写 *iters 供诊断)
E0C_AICORE_INLINE uint64_t E0cPollFlag(__gm__ uint8_t* base, uint64_t off, uint64_t maxIter, uint64_t* iters)
{
    __gm__ volatile uint64_t* f = reinterpret_cast<__gm__ volatile uint64_t*>(base + off);
    AscendC::GlobalTensor<int32_t> fg;
    fg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(base + off), 2);
    for (uint64_t i = 0; i < maxIter; i++) {
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(fg);
        uint64_t v = *f;
        if (v != 0) {
            *iters = i;
            return v;
        }
    }
    *iters = maxIter;
    return 0;
}

// AICore 协同 kernel: role2=r0(产+等结果) / role3=r1(等到达+INC+回程邮箱)
// 状态面包屑: 0xA0/0xA1/0xA2/0xA3 = r0 各阶段完成, 0xEE = 超时;
//            0xB0/0xB1/0xB2/0xB3 = r1 各阶段完成
extern "C" __global__ __aicore__ void e0cAiCoreKernel(
    __gm__ uint8_t* poolOwn, /* 本端池 GVA(数据+标志载体) */
    __gm__ uint8_t* mailbox, /* 本端普通设备内存邮箱(16B {dataAddr, words}) */
    uint64_t words,          /* 数据字数 */
    uint64_t flagOff,        /* 到达标志偏移(仅 role3 用) */
    uint64_t resultOff,      /* 结果标志偏移(仅 role2 用) */
    uint32_t role,           /* 2=r0 / 3=r1 */
    __gm__ uint32_t* status, /* 状态区(普通内存, host G2H 读) */
    uint32_t incVal,         /* INC 增量(仅 role3 用) */
    uint32_t tag)            /* pattern 标识(仅 role2 用) */
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE); // dav-m200(310P3) 仅支持 AICORE 类型
    if (AscendC::GetBlockIdx() != 0) {
        return; // 单 block 纪律
    }
    __gm__ uint32_t* data = reinterpret_cast<__gm__ uint32_t*>(poolOwn);
    __gm__ uint64_t* mb = reinterpret_cast<__gm__ uint64_t*>(mailbox);
    const uint64_t kMaxIter = 100000000ull; // 纯自旋轮询上限(dcci 迭代数近似计时)

    if (role == 2) {
        E0cStatusSet(status, 0, 0xA0u); // [r0] 入口
        // ① 产 pattern 到 own 池 GVA(GM 直写)
        for (uint64_t i = 0; i < words; i++) {
            data[i] = (tag << 24) | static_cast<uint32_t>(i);
        }
        {
            AscendC::GlobalTensor<int32_t> dataGm;
            dataGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(data), words);
            AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::ENTIRE_DATA_CACHE>(dataGm);
        }
        E0cStatusSet(status, 0, 0xA1u); // ① 完成
        // ② 写邮箱 + 行 clean
        mb[0] = reinterpret_cast<uint64_t>(poolOwn);
        mb[1] = words;
        {
            AscendC::GlobalTensor<int32_t> mbGm;
            mbGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(mb), 4);
            AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(mbGm);
        }
        E0cStatusSet(status, 0, 0xA2u); // ② 完成
        // ⑦ dcci 轮询结果标志(对端 r1 的 SQE 写入)
        uint64_t iters = 0;
        uint64_t v = E0cPollFlag(poolOwn, resultOff, kMaxIter, &iters);
        E0cStatusSet(status, 1, static_cast<uint32_t>(iters & 0xFFFFFFFFu));
        E0cStatusSet(status, 2, static_cast<uint32_t>(v & 0xFFFFFFFFu));
        E0cStatusSet(status, 0, (v != 0) ? 0xA3u : 0xEEu); // 0xEE = 结果超时
        return;
    }
    if (role == 3) {
        E0cStatusSet(status, 0, 0xB0u); // [r1] 入口
        // ④ dcci 轮询到达标志(对端 r0 的 SQE 写入)
        uint64_t iters = 0;
        uint64_t v = E0cPollFlag(poolOwn, flagOff, kMaxIter, &iters);
        E0cStatusSet(status, 1, static_cast<uint32_t>(iters & 0xFFFFFFFFu));
        E0cStatusSet(status, 2, static_cast<uint32_t>(v & 0xFFFFFFFFu));
        if (v == 0) {
            E0cStatusSet(status, 0, 0xEEu); // 到达超时
            return;
        }
        E0cStatusSet(status, 0, 0xB1u); // ④ 完成
        // ⑤ 读 own 池数据 + INC 写回(首读 demand-fill, SDMA 写后值可见)
        for (uint64_t i = 0; i < words; i++) {
            data[i] = data[i] + incVal;
        }
        {
            AscendC::GlobalTensor<int32_t> dataGm;
            dataGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(data), words);
            AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::ENTIRE_DATA_CACHE>(dataGm);
        }
        E0cStatusSet(status, 0, 0xB2u); // ⑤ 完成
        // ⑥ 写回程邮箱 + 行 clean
        mb[0] = reinterpret_cast<uint64_t>(poolOwn);
        mb[1] = words;
        {
            AscendC::GlobalTensor<int32_t> mbGm;
            mbGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(mb), 4);
            AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(mbGm);
        }
        E0cStatusSet(status, 0, 0xB3u); // ⑥ 完成
        return;
    }
}

/* ============================ host 侧 ============================ */

static void Step(const char* name, int32_t ret)
{
    if (ret != 0) {
        printf("[r%d FAIL] %-32s ret=%d\n", g_rank, name, ret);
        exit(1);
    }
    printf("[r%d OK]   %-32s\n", g_rank, name);
}

static void WriteDone(const char* name)
{
    char path[128];
    (void)snprintf(path, sizeof(path), "%s/%s%d", WORK_DIR, name, g_rank);
    FILE* fp = fopen(path, "w");
    if (fp != nullptr) {
        (void)fprintf(fp, "1\n");
        (void)fclose(fp);
    }
}

static void WaitPeerDone(const char* name)
{
    char path[128];
    (void)snprintf(path, sizeof(path), "%s/%s%d", WORK_DIR, name, 1 - g_rank);
    for (int i = 0; i < JOIN_TIMEOUT * 1000; i++) {
        if (access(path, F_OK) == 0) {
            return;
        }
        usleep(1000);
    }
    printf("[r%d FAIL] wait %s timeout\n", g_rank, name);
    exit(1);
}

static void PrepareWorkDir(void)
{
    const char* marker = WORK_DIR "/dir_ready";
    if (g_rank == 0) {
        (void)system("rm -rf " WORK_DIR " && mkdir -p " WORK_DIR);
        FILE* fp = fopen(marker, "w");
        if (fp != nullptr) {
            (void)fprintf(fp, "%d\n", static_cast<int>(getpid()));
            (void)fclose(fp);
        }
        return;
    }
    for (int i = 0; i < JOIN_TIMEOUT * 1000; i++) {
        if (access(marker, F_OK) == 0) {
            return;
        }
        usleep(1000);
    }
    printf("[r1 FAIL] wait workdir ready timeout\n");
    exit(1);
}

#define CHECK_ACL(expr, what)                                                                        \
    do {                                                                                             \
        aclError _ret = (expr);                                                                      \
        if (_ret != ACL_SUCCESS) {                                                                  \
            printf("[r%d FAIL] %s ret=%d\n", g_rank, what, (int)_ret);                              \
            exit(1);                                                                                \
        }                                                                                            \
    } while (0)

int main(int argc, char* argv[])
{
    if (argc < 2 || (strcmp(argv[1], "0") != 0 && strcmp(argv[1], "1") != 0)) {
        printf("usage: %s <0|1> [json]\n", argv[0]);
        return 1;
    }
    g_rank = atoi(argv[1]);
    const char* json = argc >= 3 ? argv[2] : "aicpu_kernel/libmf_overlap_v1.json";
    PrepareWorkDir();
    CHECK_ACL(aclInit(nullptr), "aclInit");

    /* ---- 建池(07 同款) ---- */
    Step("smem_init", smem_init(0));
    smem_bm_config_t cfg;
    Step("smem_bm_config_init", smem_bm_config_init(&cfg));
    cfg.autoRanking = false;
    cfg.rankId = static_cast<uint32_t>(g_rank);
    cfg.startConfigStoreServer = (g_rank == 0);
    Step("smem_bm_init", smem_bm_init(STORE_URL, 2, static_cast<uint16_t>(g_rank), &cfg));
    smem_bm_create_option_t hbmOpt = {};
    hbmOpt.maxHbmSize = HBM_POOL_SIZE;
    hbmOpt.localHBMSize = HBM_POOL_SIZE;
    hbmOpt.dataOpType = SMEMB_DATA_OP_SDMA;
    smem_bm_t hbm = smem_bm_create2(0, &hbmOpt);
    if (hbm == nullptr) {
        printf("[r%d FAIL] smem_bm_create2\n", g_rank);
        return 1;
    }
    Step("smem_bm_create2(HBM)", 0);
    Step("smem_bm_join(HBM)", smem_bm_join(hbm, 0));
    uint8_t* ownPool = static_cast<uint8_t*>(
        smem_bm_ptr_by_mem_type(hbm, SMEM_MEM_TYPE_DEVICE, static_cast<uint16_t>(g_rank)));
    uint8_t* peerPool = static_cast<uint8_t*>(
        smem_bm_ptr_by_mem_type(hbm, SMEM_MEM_TYPE_DEVICE, static_cast<uint16_t>(1 - g_rank)));
    printf("[r%d INFO] HBM own=%p peer=%p\n", g_rank, ownPool, peerPool);
    if (ownPool == nullptr || peerPool == nullptr) {
        printf("[r%d FAIL] gva null\n", g_rank);
        return 1;
    }
    WriteDone("joined");
    WaitPeerDone("joined");

    /* ---- 普通设备内存资源(HUGE_FIRST): 邮箱/哨兵/result/ovf/status ---- */
    void *mailbox = nullptr, *sentBuf = nullptr, *resultBuf = nullptr, *ovfBuf = nullptr, *statusBuf = nullptr;
    CHECK_ACL(aclrtMalloc(&mailbox, 16, ACL_MEM_MALLOC_HUGE_FIRST), "malloc(mailbox)");
    CHECK_ACL(aclrtMalloc(&sentBuf, 8, ACL_MEM_MALLOC_HUGE_FIRST), "malloc(sentinel)");
    CHECK_ACL(aclrtMalloc(&resultBuf, 4096, ACL_MEM_MALLOC_HUGE_FIRST), "malloc(result)");
    CHECK_ACL(aclrtMalloc(&ovfBuf, 64, ACL_MEM_MALLOC_HUGE_FIRST), "malloc(ovf)");
    CHECK_ACL(aclrtMalloc(&statusBuf, 64, ACL_MEM_MALLOC_HUGE_FIRST), "malloc(status)");
    CHECK_ACL(aclrtMemset(mailbox, 16, 0, 16), "memset(mailbox)");
    CHECK_ACL(aclrtMemset(resultBuf, 4096, 0, 4096), "memset(result)");
    CHECK_ACL(aclrtMemset(statusBuf, 64, 0, 64), "memset(status)");
    uint64_t sent = (g_rank == 0) ? SENT_A : SENT_B;
    CHECK_ACL(aclrtMemcpy(sentBuf, 8, &sent, 8, ACL_MEMCPY_HOST_TO_DEVICE), "H2D(sentinel)");

    /* ---- CP 流 + kernel 加载 ---- */
    aclrtStream cpStream = nullptr;
    CHECK_ACL(aclrtCreateStreamWithConfig(&cpStream, 0, ACL_STREAM_DEVICE_USE_ONLY), "create CP stream");
    uint32_t cpSqId = 0;
    int32_t cpStreamId = 0;
    CHECK_ACL(aclrtStreamGetId(cpStream, &cpStreamId), "aclrtStreamGetId(CP)");
    if (rtStreamGetSqid(cpStream, &cpSqId) != 0) {
        printf("[r%d FAIL] rtStreamGetSqid\n", g_rank);
        return 1;
    }
    const uint32_t dieId = static_cast<uint32_t>(g_rank % 2);
    printf("[r%d INFO] CP 流: streamId=%d sqId=%u dieId=%u\n", g_rank, cpStreamId, cpSqId, dieId);

    aclrtBinaryLoadOptions lo = {};
    aclrtBinaryLoadOption opt = {};
    opt.type = ACL_RT_BINARY_LOAD_OPT_CPU_KERNEL_MODE;
    opt.value.cpuKernelMode = 0;
    lo.numOpt = 1;
    lo.options = &opt;
    aclrtBinHandle bh = nullptr;
    CHECK_ACL(aclrtBinaryLoadFromFile(json, &lo, &bh), "BinaryLoadFromFile");
    aclrtFuncHandle fh = nullptr;
    CHECK_ACL(aclrtBinaryGetFunction(bh, "HybmOverlapRun", &fh), "BinaryGetFunction");

    /* ---- 双流并发 launch: AICore(计算) + AICPU(编排, 两侧均 role0) ---- */
    aclrtStream aiCoreStream = nullptr;
    aclrtStream launchStream = nullptr;
    CHECK_ACL(aclrtCreateStream(&aiCoreStream), "create aiCoreStream");
    CHECK_ACL(aclrtCreateStream(&launchStream), "create launchStream");

    // AICore kernel: r0=role2(产+等结果), r1=role3(等到达+INC+回程邮箱)
    printf("[r%d] launch AICore kernel (role=%u) ...\n", g_rank, (g_rank == 0) ? 2u : 3u);
    e0cAiCoreKernel<<<1, 0, aiCoreStream>>>(ownPool, static_cast<uint8_t*>(mailbox), E0C_WORDS,
                                            FLAG_OFF, RESULT_OFF, (g_rank == 0) ? 2u : 3u,
                                            static_cast<uint32_t*>(statusBuf), E0C_INC, E0C_TAG);

    // AICPU 编排(两侧同构 role0: 轮询本端邮箱 → SQE 对 → doorbell)
    HybmOverlapParam p = {};
    p.devId = dieId;
    p.sqId = cpSqId;
    p.streamId = cpStreamId;
    p.submitMode = SUBMIT_MODE_CHAIN;
    p.dstAddr = reinterpret_cast<uint64_t>(peerPool); // 数据目的 = 对端池 GVA
    if (g_rank == 0) {
        p.flagDoneAddr = reinterpret_cast<uint64_t>(peerPool) + FLAG_OFF; // 到达标志 → r1 池
    } else {
        p.flagDoneAddr = reinterpret_cast<uint64_t>(peerPool) + RESULT_OFF; // 结果标志 → r0 池
    }
    p.overflowAddr = reinterpret_cast<uint64_t>(ovfBuf);
    p.flagSentinelAddr = reinterpret_cast<uint64_t>(sentBuf);
    p.resultAddr = reinterpret_cast<uint64_t>(resultBuf);
    p.reserved[1] = 0x8u; // doorbell 强制走 HAL
    p.mailboxAddr = reinterpret_cast<uint64_t>(mailbox); // 本端普通内存邮箱(AICore 写)
    p.role = 0;
    printf("[r%d] launch AICPU 编排 (mode13 role0) ...\n", g_rank);
    CHECK_ACL(aclrtLaunchKernelWithHostArgs(fh, 1, launchStream, nullptr, &p, sizeof(p), nullptr, 0),
              "launch AICPU");
    CHECK_ACL(aclrtSynchronizeStream(aiCoreStream), "sync(aiCoreStream)");
    CHECK_ACL(aclrtSynchronizeStream(launchStream), "sync(launchStream)");
    printf("[r%d] 双流同步完成\n", g_rank);

    /* ---- 读回诊断(AICore 状态 + AICPU result) ---- */
    uint32_t status[8] = {0};
    HybmOverlapResult kr = {};
    CHECK_ACL(aclrtMemcpy(status, sizeof(status), statusBuf, sizeof(status), ACL_MEMCPY_DEVICE_TO_HOST),
              "D2H(status)");
    CHECK_ACL(aclrtMemcpy(&kr, sizeof(kr), resultBuf, sizeof(kr), ACL_MEMCPY_DEVICE_TO_HOST), "D2H(kresult)");
    printf("[r%d] AICore status: stage=0x%X pollIters=%u flagVal=0x%X | AICPU: mainRet=%d stage=%u "
           "headBefore=%u headAfter=%u ssid=0x%X\n",
           g_rank, status[0], status[1], status[2], kr.mainRet, kr.stage, kr.sqTail, kr.headAfter,
           kr.pad & 0xFFFFu);

    WriteDone("done");
    WaitPeerDone("done");

    /* ---- 校验 ---- */
    int overall = 1;
    if (status[0] == 0xEEu) {
        printf("[r%d FAIL] AICore 轮询超时(标志未到)\n", g_rank);
        overall = 0;
    }
    if (kr.mainRet != 0 || kr.stage != STAGE_DONE || kr.headAfter == kr.sqTail) {
        printf("[r%d FAIL] AICPU 编排异常(mainRet=%d head %u→%u)\n", g_rank, kr.mainRet, kr.sqTail,
               kr.headAfter);
        overall = 0;
    }
    if (g_rank == 0) {
        // ⑧ G2H 读 own 池数据: 期望 pattern+INC(经 r1 计算后回程覆写)
        uint32_t host[E0C_WORDS];
        smem_copy_params_t rp = {};
        rp.src = ownPool;
        rp.dest = host;
        rp.dataSize = E0C_WORDS * 4;
        rp.stream = nullptr;
        Step("G2H read own HBM", smem_bm_copy(hbm, &rp, SMEMB_COPY_G2H, 0));
        uint32_t bad = 0;
        for (uint32_t i = 0; i < E0C_WORDS; i++) {
            if (host[i] != ((E0C_TAG << 24) | i) + E0C_INC) {
                bad++;
            }
        }
        printf("[r0] 终态数据 mismatch=%u/%u (期望 pattern+0x%X) → %s\n", bad, E0C_WORDS, E0C_INC,
               bad == 0 ? "PASS" : "FAIL");
        overall &= (bad == 0) ? 1 : 0;
        // 结果标志值复核
        uint64_t flagVal = 0;
        smem_copy_params_t fp = {};
        fp.src = ownPool + RESULT_OFF;
        fp.dest = &flagVal;
        fp.dataSize = 8;
        fp.stream = nullptr;
        Step("G2H read result flag", smem_bm_copy(hbm, &fp, SMEMB_COPY_G2H, 0));
        if (flagVal != SENT_B) {
            printf("[r0 FAIL] 结果标志 0x%llX != 0x%llX\n", (unsigned long long)flagVal,
                   (unsigned long long)SENT_B);
            overall = 0;
        } else {
            printf("[r0 OK]   结果标志 == SENT_B\n");
        }
    }

    /* ---- 收尾 ---- */
    CHECK_ACL(aclrtDestroyStream(aiCoreStream), "destroy aiCore");
    CHECK_ACL(aclrtDestroyStream(launchStream), "destroy launch");
    CHECK_ACL(aclrtDestroyStream(cpStream), "destroy cp");
    CHECK_ACL(aclrtFree(mailbox), "free mailbox");
    CHECK_ACL(aclrtFree(sentBuf), "free sentinel");
    CHECK_ACL(aclrtFree(resultBuf), "free result");
    CHECK_ACL(aclrtFree(ovfBuf), "free ovf");
    CHECK_ACL(aclrtFree(statusBuf), "free status");
    smem_bm_destroy(hbm);
    Step("smem_bm_destroy", 0);
    smem_bm_uninit(0);
    Step("smem_bm_uninit", 0);
    smem_uninit();
    Step("smem_uninit", 0);
    (void)aclrtResetDevice(g_rank);
    (void)aclFinalize();
    printf("=== E0c r%d %s ===\n", g_rank, overall ? "PASS" : "FAIL");
    return overall ? 0 : 1;
}
