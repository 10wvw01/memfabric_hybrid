/* probe_p1_overlap — P1 验收：E0c 场景产品化重跑(八步协同全链, 全部走产品 API)
 *
 * 与 E0c 探针的差异(产品化点): 建池走 smem_shm_create(SDMA 位→InitTransManager
 * 310P 协同分支) / AICore 原语走设备头文件 smem_shm_aicore_overlap.h /
 * AICPU 编排提交走 smem_shm_overlap_launch|wait|get_result —— 探针自身不再
 * 直接构造 HybmOverlapParam 或调用任何 ACL VMM/流原语。
 *
 * 八步(两侧同构, 通知链全内存方案 D5):
 *   r0: AICore 产 pattern 到 own 段(ENTIRE clean) → notify 邮箱 →
 *       host overlap_launch(数据→r1 段, 标志→r1 到达槽) → AICore 轮询 own 结果槽
 *   r1: AICore 轮询 own 到达槽 → 读 own 段 +INC 写回(ENTIRE clean) → notify 邮箱 →
 *       host overlap_launch(数据→r0 段, 标志→r0 结果槽)
 *   验收: r0 host 读 own 段数据 == pattern+INC(逐字), 标志非零, kernel mainRet=0
 *
 * 用法: MF_310P_SHM_OVERLAP=1 ./probe_p1_overlap <0|1>   (双进程)
 */
#include <cstdio>
#include <cstring>
#include <cstdlib>
#include <cstdint>
#include <unistd.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "smem.h"
#include "smem_shm.h"
/* 310P 协同模式设备侧原语(产品设备头文件) */
#include "smem_shm_aicore_overlap.h"

#define STORE_URL "tcp://127.0.0.1:8580"
#define P1_LOCAL_SIZE (32UL * 1024UL * 1024UL) /* 每 rank 物理贡献 32MB */
#define P1_WORDS 1024u                         /* 数据量 4KB */
#define P1_INC 0x100u                          /* r1 AICore 增量 */
#define P1_TAG 0x7Bu                           /* pattern 标识 */
#define WORK_DIR "/tmp/p1_overlap"
#define JOIN_TIMEOUT 120

static int g_rank = -1;

/* ============================ AICore kernel(用设备头原语) ============================ */
/* AICore 内联修饰; AICore 不支持 lambda, 辅助函数用文件级内联(E0c 同款纪律) */
#define P1_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__

P1_AICORE_INLINE void P1StatusSet(__gm__ uint32_t *status, uint32_t slot, uint32_t val)
{
    status[slot] = val;
    AscendC::GlobalTensor<int32_t> stGm;
    stGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(status + slot), 1);
    AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(stGm);
}

P1_AICORE_INLINE void P1CleanData(__gm__ uint32_t *data, uint64_t words)
{
    AscendC::GlobalTensor<int32_t> dataGm;
    dataGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(data), words);
    AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::ENTIRE_DATA_CACHE>(dataGm);
}

extern "C" __global__ __aicore__ void p1OverlapKernel(
    __gm__ uint8_t *ownSeg,        /* 本端 rank 段基址(gva + symSize*rankId) */
    uint64_t physSize,             /* 段物理大小(localSize, 标志保留区定位) */
    uint64_t words,                /* 数据字数 */
    uint32_t role,                 /* 2=r0(产+等结果) / 3=r1(等到达+INC+回程) */
    uint32_t incVal,               /* INC 增量(仅 role3) */
    uint32_t tag,                  /* pattern 标识(仅 role2) */
    __gm__ uint8_t *workspace,     /* 协同工作区(设备头原语读写邮箱) */
    __gm__ uint32_t *status)       /* 状态区(面包屑, host D2H 读) */
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (AscendC::GetBlockIdx() != 0) {
        return; /* 单 block 纪律 */
    }
    __gm__ uint32_t *data = reinterpret_cast<__gm__ uint32_t *>(ownSeg);
    __gm__ uint8_t *flagArrival = static_cast<__gm__ uint8_t *>(smem_shm_overlap_get_flag_addr(
        ownSeg, physSize, SMEM_SHM_OVERLAP_FLAG_ARRIVAL_IDX));
    __gm__ uint8_t *flagResult = static_cast<__gm__ uint8_t *>(smem_shm_overlap_get_flag_addr(
        ownSeg, physSize, SMEM_SHM_OVERLAP_FLAG_RESULT_IDX));

    if (role == 2) {
        P1StatusSet(status, 0, 0xA0u); /* 入口 */
        /* ① 产 pattern(大块 GM 写后 ENTIRE clean, D6 纪律) */
        for (uint64_t i = 0; i < words; i++) {
            data[i] = (tag << 24) | static_cast<uint32_t>(i);
        }
        P1CleanData(data, words);
        P1StatusSet(status, 0, 0xA1u);
        /* ② 邮箱通知(设备头原语) */
        smem_shm_overlap_notify(workspace + SMEM_SHM_OVERLAP_WS_MAILBOX_OFF,
                                reinterpret_cast<uint64_t>(ownSeg), words);
        P1StatusSet(status, 0, 0xA2u);
        /* ⑦ 轮询结果标志(设备头原语, dcci) */
        uint64_t iters = 0;
        uint64_t v = smem_shm_overlap_poll_flag(flagResult, &iters);
        P1StatusSet(status, 1, static_cast<uint32_t>(iters & 0xFFFFFFFFu));
        P1StatusSet(status, 2, static_cast<uint32_t>(v & 0xFFFFFFFFu));
        P1StatusSet(status, 0, (v != 0) ? 0xA3u : 0xEEu); /* 0xEE=结果超时 */
        return;
    }
    if (role == 3) {
        P1StatusSet(status, 0, 0xB0u);
        /* ④ 轮询到达标志 */
        uint64_t iters = 0;
        uint64_t v = smem_shm_overlap_poll_flag(flagArrival, &iters);
        P1StatusSet(status, 1, static_cast<uint32_t>(iters & 0xFFFFFFFFu));
        P1StatusSet(status, 2, static_cast<uint32_t>(v & 0xFFFFFFFFu));
        if (v == 0) {
            P1StatusSet(status, 0, 0xEEu); /* 到达超时 */
            return;
        }
        P1StatusSet(status, 0, 0xB1u);
        /* ⑤ 读改写 INC + ENTIRE clean */
        for (uint64_t i = 0; i < words; i++) {
            data[i] = data[i] + incVal;
        }
        P1CleanData(data, words);
        P1StatusSet(status, 0, 0xB2u);
        /* ⑥ 回程邮箱通知 */
        smem_shm_overlap_notify(workspace + SMEM_SHM_OVERLAP_WS_MAILBOX_OFF,
                                reinterpret_cast<uint64_t>(ownSeg), words);
        P1StatusSet(status, 0, 0xB3u);
        return;
    }
}

/* ============================ host 侧 ============================ */
static void Step(const char *name, int32_t ret)
{
    if (ret != 0) {
        printf("[r%d FAIL] %-28s ret=%d\n", g_rank, name, ret);
        exit(1);
    }
    printf("[r%d OK]   %-28s\n", g_rank, name);
}

static void WriteDone(const char *name)
{
    char path[128];
    (void)snprintf(path, sizeof(path), "%s/%s%d", WORK_DIR, name, g_rank);
    FILE *fp = fopen(path, "w");
    if (fp != nullptr) {
        (void)fprintf(fp, "1\n");
        (void)fclose(fp);
    }
}

static void WaitPeerDone(const char *name)
{
    char path[128];
    (void)snprintf(path, sizeof(path), "%s/%s%d", WORK_DIR, name, 1 - g_rank);
    for (int i = 0; i < JOIN_TIMEOUT * 1000; i++) {
        if (access(path, F_OK) == 0) {
            return;
        }
        usleep(1000);
    }
    printf("[r%d FAIL] wait %s timeout\n", g_rank, name);
    exit(1);
}

static void PrepareWorkDir(void)
{
    const char *marker = WORK_DIR "/dir_ready";
    if (g_rank == 0) {
        (void)system("rm -rf " WORK_DIR " && mkdir -p " WORK_DIR);
        FILE* fp = fopen(marker, "w");
        if (fp != nullptr) {
            (void)fprintf(fp, "%d\n", static_cast<int>(getpid()));
            (void)fclose(fp);
        }
        return;
    }
    for (int i = 0; i < JOIN_TIMEOUT * 1000; i++) {
        if (access(marker, F_OK) == 0) {
            return;
        }
        usleep(1000);
    }
    printf("[r1 FAIL] wait workdir timeout\n");
    exit(1);
}

int main(int argc, char *argv[])
{
    if (argc < 2 || (strcmp(argv[1], "0") != 0 && strcmp(argv[1], "1") != 0)) {
        printf("usage: MF_310P_SHM_OVERLAP=1 %s <0|1>\n", argv[0]);
        return 1;
    }
    g_rank = atoi(argv[1]);
    PrepareWorkDir();
    if (aclInit(nullptr) != ACL_SUCCESS) {
        printf("[r%d FAIL] aclInit\n", g_rank);
        return 1;
    }

    /* ---- 产品路径建池 ---- */
    Step("smem_init", smem_init(0));
    smem_shm_config_t cfg;
    Step("smem_shm_config_init", smem_shm_config_init(&cfg));
    cfg.startConfigStoreServer = (g_rank == 0);
    Step("smem_shm_init", smem_shm_init(STORE_URL, 2, static_cast<uint32_t>(g_rank),
                                        static_cast<uint16_t>(g_rank), &cfg));
    void *gva = nullptr;
    smem_shm_t shm = smem_shm_create(0, 2, static_cast<uint32_t>(g_rank), P1_LOCAL_SIZE,
                                     SMEMS_DATA_OP_SDMA, 0, &gva);
    if (shm == nullptr || gva == nullptr) {
        printf("[r%d FAIL] smem_shm_create: %s\n", g_rank, smem_get_last_err_msg());
        return 1;
    }
    Step("smem_shm_create(SDMA)", 0);
    const uint64_t symSize = smem_shm_get_symmetric_size(shm);
    const uint64_t ownSegBase = reinterpret_cast<uint64_t>(gva) + symSize * g_rank;
    const uint64_t peerSegBase = reinterpret_cast<uint64_t>(gva) + symSize * (1 - g_rank);
    /* 标志保留区按"物理段"末尾定位(symSize 含 1G 对齐, 尾部未映射) */
    const uint64_t ownFlagBase = ownSegBase + P1_LOCAL_SIZE - 2UL * 1024UL * 1024UL;
    const uint64_t peerFlagBase = peerSegBase + P1_LOCAL_SIZE - 2UL * 1024UL * 1024UL;
    void *workspace = smem_shm_overlap_get_workspace(shm);
    if (workspace == nullptr) {
        printf("[r%d FAIL] overlap not ready(workspace null)\n", g_rank);
        return 1;
    }
    printf("[r%d INFO] gva=%p symSize=0x%llx ws=%p own=0x%llx peer=0x%llx\n", g_rank, gva,
           (unsigned long long)symSize, workspace, (unsigned long long)ownSegBase,
           (unsigned long long)peerSegBase);
    WriteDone("joined");
    WaitPeerDone("joined");

    /* ---- AICore kernel(用户计算) + host 协同提交(产品 API) ---- */
    void *statusBuf = nullptr;
    if (aclrtMalloc(&statusBuf, 64, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMemset(statusBuf, 64, 0, 64) != ACL_SUCCESS) {
        printf("[r%d FAIL] status alloc\n", g_rank);
        return 1;
    }
    aclrtStream aiCoreStream = nullptr;
    aclrtCreateStream(&aiCoreStream);
    printf("[r%d] launch AICore kernel (role=%u) ...\n", g_rank, (g_rank == 0) ? 2u : 3u);
    p1OverlapKernel<<<1, 0, aiCoreStream>>>(reinterpret_cast<uint8_t *>(ownSegBase), P1_LOCAL_SIZE,
                                            P1_WORDS, (g_rank == 0) ? 2u : 3u, P1_INC, P1_TAG,
                                            static_cast<uint8_t *>(workspace),
                                            static_cast<uint32_t *>(statusBuf));

    /* 双方都提交 overlap: r0 → r1 段(数据)+r1 到达槽(标志); r1 → r0 段+r0 结果槽 */
    void *dstGva = reinterpret_cast<void *>(peerSegBase);
    void *flagGva = reinterpret_cast<void *>((g_rank == 0) ? (peerFlagBase + 0 * 8)    /* r1 到达槽 */
                                                           : (peerFlagBase + 1 * 8)); /* r0 结果槽 */
    printf("[r%d] smem_shm_overlap_launch dst=0x%llx flag=0x%llx ...\n", g_rank,
           (unsigned long long)reinterpret_cast<uint64_t>(dstGva),
           (unsigned long long)reinterpret_cast<uint64_t>(flagGva));
    Step("smem_shm_overlap_launch", smem_shm_overlap_launch(shm, dstGva, flagGva));
    Step("smem_shm_overlap_wait", smem_shm_overlap_wait(shm));
    Step("aclrtSynchronizeStream(aiCore)", aclrtSynchronizeStream(aiCoreStream));
    uint32_t mainRet = 0;
    uint32_t stage = 0;
    uint32_t headAfter = 0;
    Step("smem_shm_overlap_get_result", smem_shm_overlap_get_result(shm, &mainRet, &stage, &headAfter));
    uint32_t status[8] = {0};
    (void)aclrtMemcpy(status, sizeof(status), statusBuf, sizeof(status), ACL_MEMCPY_DEVICE_TO_HOST);
    printf("[r%d] AICore status: stage=0x%X pollIters=%u flagVal=0x%X | kernel mainRet=%u stage=%u headAfter=%u\n",
           g_rank, status[0], status[1], status[2], mainRet, stage, headAfter);

    WriteDone("done");
    WaitPeerDone("done");

    /* ---- 校验 ---- */
    int overall = 1;
    if (status[0] == 0xEEu || mainRet != 0 || stage != 5) {
        printf("[r%d FAIL] 超时或 kernel 异常(stage=0x%X mainRet=%u st=%u)\n", g_rank, status[0], mainRet, stage);
        overall = 0;
    }
    if (g_rank == 0) {
        /* r0: own 段数据应 == pattern+INC(r1 计算后回程覆写); 结果标志非零 */
        uint32_t host[P1_WORDS];
        if (aclrtMemcpy(host, sizeof(host), reinterpret_cast<void *>(ownSegBase), sizeof(host),
                        ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            printf("[r0 FAIL] D2H 读池数据失败\n");
            overall = 0;
        } else {
            uint32_t bad = 0;
            for (uint32_t i = 0; i < P1_WORDS; i++) {
                if (host[i] != ((P1_TAG << 24) | i) + P1_INC) {
                    bad++;
                }
            }
            printf("[r0] 终态数据 mismatch=%u/%u (期望 pattern+0x%X) → %s\n", bad, P1_WORDS, P1_INC,
                   bad == 0 ? "PASS" : "FAIL");
            overall &= (bad == 0) ? 1 : 0;
        }
        uint64_t flagVal = 0;
        (void)aclrtMemcpy(&flagVal, 8, reinterpret_cast<void *>(ownFlagBase + 1 * 8), 8, ACL_MEMCPY_DEVICE_TO_HOST);
        printf("[r0] 结果标志=0x%llX → %s\n", (unsigned long long)flagVal, flagVal != 0 ? "PASS" : "FAIL");
        overall &= (flagVal != 0) ? 1 : 0;
    }

    (void)aclrtDestroyStream(aiCoreStream);
    (void)aclrtFree(statusBuf);
    Step("smem_shm_destroy", smem_shm_destroy(shm, 0));
    smem_shm_uninit(0);
    Step("smem_shm_uninit", 0);
    smem_uninit();
    Step("smem_uninit", 0);
    (void)aclrtResetDevice(g_rank);
    (void)aclFinalize();
    printf("=== P1-OVERLAP r%d %s ===\n", g_rank, overall ? "PASS" : "FAIL");
    return overall ? 0 : 1;
}
